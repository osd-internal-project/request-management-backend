{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/pm/projects": {
      "get": {
        "description": "`opportunity_id` = โครงการของดีลนั้น · `scope=mine` = ที่ผู้ใช้เป็นผู้จัดการหรืออยู่ในทีม",
        "operationId": "ExternalProjectsController_list",
        "parameters": [
          {
            "name": "X-Acting-User",
            "in": "header",
            "description": "อีเมลของผู้ใช้ที่ทำรายการ — ระบบจะทำงานในนามของคนนี้",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "เลขหน้าที่ต้องการ เริ่มที่ 1",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "จำนวนรายการต่อหน้า",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "`sort=field` เรียงขึ้น, `sort=-field` เรียงลง",
            "schema": {
              "example": "-createdAt",
              "type": "string",
              "pattern": "^-?[a-zA-Z_][a-zA-Z0-9_]*$"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "เลขที่ ชื่อโครงการ หรือเลขที่สัญญา",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "on_hold",
                "closed",
                "cancelled"
              ]
            }
          },
          {
            "name": "scope",
            "required": false,
            "in": "query",
            "description": "mine = ที่ฉันเป็นผู้จัดการหรืออยู่ในทีม",
            "schema": {
              "type": "string",
              "enum": [
                "mine"
              ]
            }
          },
          {
            "name": "opportunity_id",
            "required": false,
            "in": "query",
            "description": "id โอกาสการขายที่โครงการนี้มาจาก",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Company-Id",
            "in": "header",
            "required": false,
            "description": "บริษัทที่คำขอนี้ทำงานอยู่ (§11.1) — ว่าง = บริษัทหลัก",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "ค้นโครงการ",
        "tags": [
          "pm"
        ],
        "x-permission": [
          "integration.pm.project.read"
        ],
        "x-acting-permission": [
          "notification.read"
        ]
      },
      "post": {
        "description": "ออกเลขที่โครงการ ดึงหมุดหมาย/งวดจากสัญญา แจ้งผู้จัดการและทีม · สัญญายังไม่ลงนาม หรือเปิดโครงการไปแล้ว = `409 CONFLICT` พร้อมเหตุผล · `manager_user_id` เป็น uuid หาได้จาก `GET request/users`",
        "operationId": "ExternalProjectsController_open",
        "parameters": [
          {
            "name": "X-Acting-User",
            "in": "header",
            "description": "อีเมลของผู้ใช้ที่ทำรายการ — ระบบจะทำงานในนามของคนนี้",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "ควรส่งทุกครั้ง — หนึ่งค่าต่อหนึ่งเจตนา ยิงซ้ำด้วยค่าเดิมและ body เดิมจะได้ผลลัพธ์เดิมกลับไป ไม่เกิดรายการที่สอง",
            "required": false,
            "schema": {
              "type": "string",
              "example": "6f6bd3a7-7308-4d2e-a4de-75e1f89b6871"
            }
          },
          {
            "name": "X-Company-Id",
            "in": "header",
            "required": false,
            "description": "บริษัทที่คำขอนี้ทำงานอยู่ (§11.1) — ว่าง = บริษัทหลัก",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenProjectDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "เปิดโครงการจากสัญญาที่ลงนามแล้ว (CD-175)",
        "tags": [
          "pm"
        ],
        "x-permission": [
          "integration.pm.project.manage"
        ],
        "x-acting-permission": [
          "pm.project.manage"
        ]
      }
    },
