{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/process/logs": {
      "post": {
        "description": "ไม่ต้องส่ง `X-Acting-User` — บริษัทมาจาก API key (หรือ `X-Company-Id` ถ้ากุญแจไม่ได้ผูกบริษัท) · ส่ง `event_id` เพื่อให้ยิงซ้ำได้แถวเดิม",
        "operationId": "ExternalProcessLogController_create",
        "parameters": [
          {
            "name": "X-Company-Id",
            "in": "header",
            "required": false,
            "description": "บริษัทที่คำขอนี้ทำงานอยู่ (§11.1) — ว่าง = บริษัทหลัก",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProcessLogDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessLogRowDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "บันทึกหนึ่งเหตุการณ์ของกระบวนการ 7 ขั้น",
        "tags": [
          "process"
        ],
        "x-permission": [
          "integration.process.log"
        ]
      },
      "get": {
        "operationId": "ExternalProcessLogController_list",
        "parameters": [
          {
            "name": "instance_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stage_no",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 7,
              "type": "integer"
            }
          },
          {
            "name": "ref_no",
            "required": false,
            "in": "query",
            "description": "ค้นจากเลขเอกสารอ้างอิง (บางส่วน)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "started",
                "completed",
                "approved",
                "rejected",
                "returned",
                "skipped",
                "failed",
                "info"
              ]
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "ตั้งแต่ (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "ถึง (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 200,
              "default": 50,
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-Company-Id",
            "in": "header",
            "required": false,
            "description": "บริษัทที่คำขอนี้ทำงานอยู่ (§11.1) — ว่าง = บริษัทหลัก",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessLogPageDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "อ่านบันทึกย้อนหลัง เช่น ทั้งหมดของ instance หนึ่ง",
        "tags": [
          "process"
        ],
        "x-permission": [
          "integration.process.log"
        ]
      }
    },
    "/api/v1/process/refs": {
      "get": {
        "description": "ส่ง `lead_id` (หรือ `opportunity_no`) · ทุกช่องเป็นข้อความ ไม่มี = `-` · `*_url` เปิดหน้าที่ทำงานนั้น หรือหน้าที่ใช้สร้างเมื่อยังไม่มี",
        "operationId": "ExternalProcessRefsController_resolve",
        "parameters": [
          {
            "name": "lead_id",
            "required": false,
            "in": "query",
            "description": "Lead ที่เริ่มกระบวนการ (ctd-flow-s1 รับมาจาก CTD)",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "opportunity_no",
            "required": false,
            "in": "query",
            "description": "ใช้เมื่อไม่มี lead_id — เลขโอกาสการขาย",
            "schema": {
              "example": "OPP-OSD-0001",
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "X-Company-Id",
            "in": "header",
            "required": false,
            "description": "บริษัทที่คำขอนี้ทำงานอยู่ (§11.1) — ว่าง = บริษัทหลัก",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessRefsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "เลขเอกสารและลิงก์หน้าจอ CTD ของดีลทั้งสาย (Lead → โครงการ)",
        "tags": [
          "process"
        ],
        "x-permission": [
          "integration.process.log"
        ]
      }
    }
  },
  "info": {
    "title": "Request Form — External API · process",
    "description": "**ทุก route มีสองประตู** และ Swagger ของแต่ละ route บอกไว้ทั้งคู่: bearer ต้องถือสิทธิ์ `integration.*` ของ route นั้น (ประตูของเครื่อง) และคนที่ระบุใน header `X-Acting-User` ต้องถือสิทธิ์ของงานนั้นเอง (ประตูของคน) — ระบบทำงานในนามคนนั้น timeline จึงบันทึกชื่อคนจริง ไม่ใช่ชื่อบัญชีบริการ\n\n**bearer รับได้สองแบบ**\n\n1. access token ของ service account จาก Keycloak (client_credentials) อายุสั้น ต้องขอใหม่เมื่อหมดอายุ\n2. **API key** ที่ขึ้นต้นด้วย `rfk_` — ไม่มีวันหมดอายุ ไม่ต้องต่ออายุ ระบบแลกเป็น token ให้เองตอนใช้ ออกด้วย `yarn apikey:issue` และเพิกถอนด้วย `yarn apikey:revoke` (มีผลทันที)\n\nทั้งสองแบบส่งเหมือนกัน: `Authorization: Bearer <ค่า>` และได้สิทธิ์ชุดเดียวกัน — key ตัดสินว่า *เข้าได้ไหม* token บอกว่า *ทำอะไรได้*",
    "version": "1.0"
  },
  "tags": [],
  "servers": [
    {
      "url": "http://192.168.31.52:3503",
      "description": "เครื่องภายใน OSD"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProcessLogDto": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "description": "ค่ากันซ้ำ — ยิงซ้ำด้วยค่าเดิมได้แถวเดิม ไม่เกิดแถวที่สอง (แนะนำ `<instance_id>:<step_code>:<status>`)",
            "example": "b3c1…:qualification:completed",
            "maxLength": 200
          },
          "instance_id": {
            "type": "string",
            "description": "instance id บน OSD Workflow",
            "maxLength": 100,
            "minLength": 1
          },
          "workflow_key": {
            "type": "string",
            "example": "ctd-s1-market-to-lead",
            "maxLength": 100,
            "minLength": 1
          },
          "stage_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "example": 1
          },
          "step_code": {
            "type": "string",
            "example": "qualification",
            "maxLength": 80,
            "minLength": 1
          },
          "step_name": {
            "type": "string",
            "example": "คัดกรองเบื้องต้น",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "approved",
              "rejected",
              "returned",
              "skipped",
              "failed",
              "info"
            ],
            "example": "completed"
          },
          "decision": {
            "type": "string",
            "example": "ต้องทำ NDA",
            "maxLength": 120
          },
          "ref_type": {
            "type": "string",
            "example": "lead",
            "maxLength": 60
          },
          "ref_no": {
            "type": "string",
            "example": "LEAD-OSDD-000123",
            "maxLength": 100
          },
          "actor_email": {
            "type": "string",
            "example": "somchai@osd.co.th",
            "maxLength": 200,
            "format": "email"
          },
          "actor_name": {
            "type": "string",
            "maxLength": 200
          },
          "comment": {
            "type": "string",
            "maxLength": 2000
          },
          "payload": {
            "type": "object",
            "description": "ข้อมูลอื่นของขั้นนี้ (JSON) — ไม่เกิน 16 KB",
            "additionalProperties": true
          },
          "occurred_at": {
            "type": "string",
            "description": "เวลาที่เกิดจริง (ISO 8601) — ว่าง = เวลาที่รับ",
            "format": "date-time"
          }
        },
        "required": [
          "instance_id",
          "stage_no",
          "status",
          "step_code",
          "workflow_key"
        ]
      },
      "ProcessLogPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProcessLogRowDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "page_size": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "total",
          "page",
          "page_size"
        ]
      },
      "ProcessLogRowDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_id": {
            "type": "string",
            "nullable": true
          },
          "instance_id": {
            "type": "string"
          },
          "workflow_key": {
            "type": "string"
          },
          "stage_no": {
            "type": "number"
          },
          "stage_code": {
            "type": "string"
          },
          "stage_name": {
            "type": "string"
          },
          "team_code": {
            "type": "string",
            "nullable": true
          },
          "step_code": {
            "type": "string"
          },
          "step_name": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "nullable": true
          },
          "ref_type": {
            "type": "string",
            "nullable": true
          },
          "ref_no": {
            "type": "string",
            "nullable": true
          },
          "actor_email": {
            "type": "string",
            "nullable": true
          },
          "actor_name": {
            "type": "string",
            "nullable": true
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "payload": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "occurred_at": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_id",
          "instance_id",
          "workflow_key",
          "stage_no",
          "stage_code",
          "stage_name",
          "team_code",
          "step_code",
          "step_name",
          "status",
          "decision",
          "ref_type",
          "ref_no",
          "actor_email",
          "actor_name",
          "comment",
          "payload",
          "occurred_at",
          "created_at"
        ]
      },
      "ProcessRefsDto": {
        "type": "object",
        "properties": {
          "lead_id": {
            "type": "string"
          },
          "lead_name": {
            "type": "string"
          },
          "lead_status": {
            "type": "string"
          },
          "lead_url": {
            "type": "string"
          },
          "opportunity_id": {
            "type": "string"
          },
          "opportunity_no": {
            "type": "string",
            "example": "OPP-OSD-0001"
          },
          "opportunity_stage": {
            "type": "string"
          },
          "opportunity_url": {
            "type": "string"
          },
          "solution_request_no": {
            "type": "string",
            "description": "คำขอ Solution (ประเภทตามตั้งค่า CRM)"
          },
          "solution_request_status": {
            "type": "string"
          },
          "solution_request_url": {
            "type": "string"
          },
          "solution_url": {
            "type": "string"
          },
          "quotation_no": {
            "type": "string",
            "example": "QT-OSD-0001"
          },
          "quotation_version": {
            "type": "string"
          },
          "quotation_status": {
            "type": "string"
          },
          "quotation_url": {
            "type": "string"
          },
          "sale_order_no": {
            "type": "string",
            "example": "SO-OSD-0001"
          },
          "sale_order_status": {
            "type": "string"
          },
          "sale_order_erp_no": {
            "type": "string",
            "description": "เลขเอกสารใน SAP เมื่อส่งสำเร็จ"
          },
          "sale_order_url": {
            "type": "string"
          },
          "contract_request_no": {
            "type": "string",
            "description": "คำขอจัดทำสัญญา (ประเภทตามตั้งค่า CRM)"
          },
          "contract_request_url": {
            "type": "string"
          },
          "contract_no": {
            "type": "string",
            "description": "สัญญาหลัก (ไม่นับ NDA)"
          },
          "contract_status": {
            "type": "string"
          },
          "contract_url": {
            "type": "string"
          },
          "nda_no": {
            "type": "string"
          },
          "nda_url": {
            "type": "string"
          },
          "project_no": {
            "type": "string",
            "example": "PRJ-OSD-0001"
          },
          "project_status": {
            "type": "string"
          },
          "project_url": {
            "type": "string"
          },
          "acceptance_no": {
            "type": "string",
            "example": "AC-PRJ-OSD-0001-01"
          },
          "acceptance_status": {
            "type": "string"
          }
        },
        "required": [
          "lead_id",
          "lead_name",
          "lead_status",
          "lead_url",
          "opportunity_id",
          "opportunity_no",
          "opportunity_stage",
          "opportunity_url",
          "solution_request_no",
          "solution_request_status",
          "solution_request_url",
          "solution_url",
          "quotation_no",
          "quotation_version",
          "quotation_status",
          "quotation_url",
          "sale_order_no",
          "sale_order_status",
          "sale_order_erp_no",
          "sale_order_url",
          "contract_request_no",
          "contract_request_url",
          "contract_no",
          "contract_status",
          "contract_url",
          "nda_no",
          "nda_url",
          "project_no",
          "project_status",
          "project_url",
          "acceptance_no",
          "acceptance_status"
        ]
      }
    }
  }
}
