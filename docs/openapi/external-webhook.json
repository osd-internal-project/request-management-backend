{
  "openapi": "3.1.0",
  "info": {
    "title": "Request Form — Webhooks (ระบบส่งออก)",
    "description": "ระบบส่ง `POST` ไปยัง URL ที่ผู้ดูแลตั้งไว้ในหน้า **ผู้ดูแล → Webhook** ทุกครั้งที่เกิด event ที่เลือกไว้ของบริษัทนั้น\n\n**payload บาง** — มีแค่ id กับชนิด event ถ้าต้องการรายละเอียด ให้เรียก External API ด้วย API key ตามปกติ สิทธิ์จึงยังตรวจที่ API และข้อมูลส่วนบุคคลไม่ออกไปกับ webhook\n\n**ตรวจลายเซ็นก่อนเชื่อทุกครั้ง** ด้วย `HMAC-SHA256(secret, timestamp + \".\" + raw body)` ให้เทียบกับ `X-Webhook-Signature` แบบ constant-time และใช้ body ดิบก่อน parse JSON\n\n**ตอบ 2xx ภายใน 10 วินาที** แล้วค่อยทำงานต่อเบื้องหลัง ถ้าตอบอย่างอื่นหรือหมดเวลา ระบบจะส่งซ้ำหลัง 1 นาที, 5 นาที, 30 นาที, 2 ชั่วโมง และ 6 ชั่วโมง รวม 6 ครั้ง จากนั้นจะเลิกส่ง ระบบไม่ตาม redirect\n\n**ส่งอย่างน้อยหนึ่งครั้ง แบบ best-effort** — event อาจมาซ้ำหรือสลับลำดับ ให้ตัดรายการซ้ำด้วย `X-Webhook-Id` ถ้าบริการเคยล่ม ให้ตรวจสอบย้อนหลังด้วย GET ของ API เดิม",
    "version": "1.0"
  },
  "webhooks": {
    "request.submitted": {
      "post": {
        "summary": "ส่งคำขอแล้ว",
        "operationId": "webhook_request_submitted",
        "parameters": [
          {
            "name": "X-Webhook-Id",
            "in": "header",
            "required": true,
            "description": "id ของ event — ส่งซ้ำได้ ใช้ตัดรายการซ้ำ (ค่าเดียวกับ body.id)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Webhook-Event",
            "in": "header",
            "required": true,
            "description": "ชื่อ event",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Webhook-Timestamp",
            "in": "header",
            "required": true,
            "description": "วินาที unix ตอนส่ง — ปฏิเสธถ้าห่างจากเวลาปัจจุบันเกิน 5 นาที",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Webhook-Signature",
            "in": "header",
            "required": true,
            "description": "`sha256=` + hex(HMAC-SHA256(secret, `{X-Webhook-Timestamp}.{raw body}`))",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "event",
                  "created_at",
                  "data"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "event": {
                    "type": "string",
                    "const": "request.submitted"
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "data": {
                    "$ref": "#/components/schemas/RequestEventData"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "รับแล้ว — ไม่ส่งซ้ำ"
          },
          "default": {
            "description": "อย่างอื่นทั้งหมด — ส่งซ้ำตามรอบ"
          }
        }
      }
    },
