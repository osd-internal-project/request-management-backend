      }
    },
    "schemas": {
      "CloseDisbursementDto": {
        "type": "object",
        "properties": {
          "occurred_at": {
            "type": "string",
            "description": "วันที่คืนเงิน / จ่ายเพิ่มจริง (YYYY-MM-DD)",
            "format": "date-time"
          },
          "counterparty_user_id": {
            "type": "string",
            "description": "ผู้คืนเงิน (คืนเงิน) หรือผู้รับเงินเพิ่ม (จ่ายเพิ่ม) — ว่าง = ผู้ขอ"
          },
          "method": {
            "type": "string",
            "enum": [
              "transfer",
              "cash",
              "cheque"
            ]
          },
          "reference": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "DisbursementLineDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "cost_center": {
            "type": "string",
            "maxLength": 60
          },
          "amount": {
            "type": "number",
            "example": 4400,
            "minimum": 0.01
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "receipt_date": {
            "type": "string",
            "example": "2026-09-16",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "amount",
          "description"
        ]
      },
      "PayDisbursementDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "ยอดงวดนี้ (บาท) — รวมทุกงวดต้องไม่เกินยอดอนุมัติ",
            "example": 5000,
            "minimum": 0.01
          },
          "paid_at": {
            "type": "string",
            "description": "วันที่จ่ายจริง (YYYY-MM-DD) — ว่าง = วันนี้",
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "enum": [
              "transfer",
              "cash",
              "cheque"
            ]
          },
          "reference": {
            "type": "string",
            "description": "เลขที่อ้างอิงการโอน / เลขเช็ค",
            "maxLength": 120
          }
        },
        "required": [
          "amount",
          "method"
        ]
      },
      "ReturnClearingDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          }
        },
        "required": [
          "reason"
        ]
      },
      "SubmitClearingDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisbursementLineDto"
            },
            "maxItems": 50,
            "minItems": 1
          }
        },
        "required": [
          "items"
        ]
      },
      "VerifyDisbursementDto": {
        "type": "object",
        "properties": {
          "checked_cost_center": {
            "type": "boolean"
          },
          "checked_documents": {
            "type": "boolean"
          },
          "checked_authority": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "description": "ความเห็นของบัญชี",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "checked_authority",
          "checked_cost_center",
          "checked_documents",
          "note"
        ]
      },
      "VoidPaymentDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "เหตุผลที่ยกเลิกงวดนี้",
            "maxLength": 500,
            "minLength": 1
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
