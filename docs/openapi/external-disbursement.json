          },
          {
            "name": "kind",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ADVANCE",
                "PETTY_CASH"
              ]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "หนึ่งสถานะ หรือหลายสถานะคั่นด้วย ,",
            "schema": {
              "example": "PAID,CLEARING",
              "type": "string",
              "maxLength": 120
