{
  "name": "request-management-backend",
  "version": "1.3.11",
  "description": "npm workspaces monorepo: user-service and core-service, versioned independently.",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "libs/*",
    "services/*"
  ],
  "scripts": {
    "build": "yarn build:services",
    "build:services": "yarn workspace @request-management/user-service build && yarn workspace @request-management/core-service build && yarn workspace @request-management/external-service build && yarn workspace @request-management/run-number-service build",
    "build:user-service": "yarn workspace @request-management/user-service build",
    "build:core-service": "yarn workspace @request-management/core-service build",
    "build:external-service": "yarn workspace @request-management/external-service build",
    "build:run-number-service": "yarn workspace @request-management/run-number-service build",
    "start:user-service": "yarn workspace @request-management/user-service start",
    "start:user-service:dev": "yarn workspace @request-management/user-service start:dev",
    "start:user-service:debug": "yarn workspace @request-management/user-service start:debug",
    "start:core-service": "yarn workspace @request-management/core-service start",
    "start:core-service:dev": "yarn workspace @request-management/core-service start:dev",
    "start:core-service:debug": "yarn workspace @request-management/core-service start:debug",
    "start:external-service": "yarn workspace @request-management/external-service start",
    "start:external-service:dev": "yarn workspace @request-management/external-service start:dev",
    "start:external-service:debug": "yarn workspace @request-management/external-service start:debug",
    "start:run-number-service": "yarn workspace @request-management/run-number-service start",
    "start:run-number-service:dev": "yarn workspace @request-management/run-number-service start:dev",
    "start:run-number-service:debug": "yarn workspace @request-management/run-number-service start:debug",
    "test": "yarn workspace @request-management/share test && yarn workspace @request-management/user-service test && yarn workspace @request-management/core-service test && yarn workspace @request-management/external-service test && yarn workspace @request-management/run-number-service test",
    "test:e2e:user-service": "yarn workspace @request-management/user-service test:e2e",
    "test:e2e:core-service": "yarn workspace @request-management/core-service test:e2e",
    "test:e2e:external-service": "yarn workspace @request-management/external-service test:e2e",
    "test:e2e:run-number-service": "yarn workspace @request-management/run-number-service test:e2e",
    "lint": "eslint \"{libs,services}/**/*.ts\" --fix",
    "format": "prettier --write \"{libs,services}/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=libs/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=libs/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=libs/prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema=libs/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=libs/prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema=libs/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=libs/prisma/schema.prisma",
    "postinstall": "yarn prisma:generate",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' libs/prisma/seed.ts",
    "admin:grant": "ts-node --compiler-options '{\"module\":\"commonjs\"}' libs/prisma/grant-admin.ts",
    "matrix:clear-legacy": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/clear-legacy-matrices.ts",
    "org:adopt": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/adopt-org-chart.ts",
    "org:clear": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/clear-org-tree.ts",
    "org:flatten-positions": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/flatten-positions.ts",
    "uat:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-uat.ts",
    "presales:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-presales-type.ts",
    "user:add": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/add-user.ts",
    "apikey:issue": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/api-key.ts issue",
    "apikey:revoke": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/api-key.ts revoke",
    "apikey:list": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/api-key.ts list",
    "mcp:token": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config scripts/mcp-keycloak-token.ts",
    "kc:migrate": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/migrate-keycloak-users.ts dotenv_config_path=../.backend-env",
    "kc:relink": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/relink-keycloak-ids.ts dotenv_config_path=../.backend-env",
    "petty:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-petty-cash-type.ts",
    "petty-claim:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-petty-cash-claim-type.ts",
    "disbursement-flow:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-disbursement-flows.ts",
    "sop:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-sop-docreq-type.ts",
    "uat:users": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/seed-uat-users.ts",
    "keycloak:provision": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/keycloak-provision.ts",
    "openapi": "ts-node --project scripts/tsconfig.openapi.json -r tsconfig-paths/register -r dotenv/config scripts/generate-openapi.ts",
    "flows:convert-v2": "ts-node --project scripts/tsconfig.openapi.json -r tsconfig-paths/register -r dotenv/config scripts/convert-flows-v2.ts",
    "types:delete-inactive": "ts-node --project scripts/tsconfig.openapi.json -r tsconfig-paths/register -r dotenv/config scripts/delete-inactive-types.ts",
    "spec:extract": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/extract-spec.ts",
    "spec:check": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/spec-check.ts",
    "uat:disbursement": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/uat-disbursement.ts",
    "loadtest:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config scripts/seed-load-test.ts",
    "loadtest:clean": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config scripts/clean-load-test.ts",
    "data:extract": "python3 scripts/extract-request-log.py",
    "data:import-catalog": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/import-osd-catalog.ts",
    "data:import-users": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/import-users-csv.ts",
  "data:import-requests": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r dotenv/config libs/prisma/import-osd-requests.ts",
    "tools": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/generate-tools.ts",
    "crm:gen": "python3 scripts/generate-crm-controllers.py",
    "postman": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/generate-postman.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.3.1",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' libs/prisma/seed.ts"
  },
  "packageManager": "yarn@1.22.19"
}
