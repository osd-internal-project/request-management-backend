# Copy this file to .env before running any service in this monorepo.
# Services start from the repo root, so this single .env is shared by all of them.
#
# This file is COMMITTED — it must contain PLACEHOLDERS ONLY. Real hosts,
# passwords, and secrets belong in .env, which is git-ignored. If you find a
# real value here, rotate it: assume it has been read.

# --- user-service ---
# Leave unset to use the built-in default port (3001).
# USER_SERVICE_PORT=3001

# --- Keycloak (AUTH-01) ---
#
# Keycloak is a backend concern: only the backend holds these values, and the
# frontend receives cookies from user-service. Login is OIDC Authorization Code
# + PKCE — no endpoint here accepts a password.
KEYCLOAK_BASE_URL=http://keycloak.example.internal:8180
KEYCLOAK_REALM=enterprise-request

# Confidential client. The SAME client backs both login and the Admin REST API,
# so it needs "Client authentication" and "Service accounts roles" both ON, and
# its service account needs these realm-management roles:
#
#     view-users, query-users, query-groups, manage-users, view-realm
#
# Without them the Admin API returns 403 while still issuing a valid token — a
# failure mode that looks like everything is fine.
#
# Its redirect URIs must list the frontend callback as an ABSOLUTE url, e.g.
# http://localhost:3000/* — a bare "/*" is treated as relative to the client's
# root URL and login fails with "Invalid parameter: redirect_uri".
KEYCLOAK_CLIENT_ID=request-form
KEYCLOAK_CLIENT_SECRET=

# AUTH-06 — the client an API key is exchanged for.
# core-service mints a client_credentials token with these when an integration
# presents an `rfk_…` key, then forwards that token like any other bearer.
#
# These are normally the SAME two values as KEYCLOAK_CLIENT_ID/SECRET above.
# `yarn keycloak:provision` creates the realm roles `integration.request.create`
# and `integration.approval.create` and grants them to that client's own service
# account (`grantIntegrationRoles`). Pointing these at a *new* empty client
# instead earns FORBIDDEN, because nothing ever granted it those roles.
#
# The role names are the permissions, verbatim: a service account resolves
# through `keycloakRolesOf`, not through the `keycloak_role_mappings` table,
# which is for people. Renaming the role breaks the grant silently.
INTEGRATION_CLIENT_ID=
INTEGRATION_CLIENT_SECRET=

# --- Database ---
# One schema for the whole monorepo: libs/prisma/schema.prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Metabase (CD-10/CD-92, infra/metabase) ---
# Password of Metabase's OWN state database (the bundled container), not the
# application database. The app DB is read through the `metabase_ro` role
# created by infra/metabase/reporting.sql — see docs/metabase.md.
# METABASE_APP_DB_PASSWORD=

# Embedded BI menu (GET /bi/menu on core-service). siteUrl = where browsers
# reach Metabase; embedSecret = Admin → Settings → Embedding → secret key.
# Leave unset → menu answers configured:false and the frontend hides the
# section.
#
# The dashboard LIST now lives in the `bi_dashboards` table, managed from the
# "ตั้งค่า Dashboard" admin screen (per-team visibility included). The three
# ids below are only a fallback for a company with no rows configured yet.
METABASE_SITE_URL=http://192.168.31.51:3400/
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_REQUEST=2
METABASE_DASHBOARD_APPROVAL=3
METABASE_DASHBOARD_SLA=4

# --- core-service ---
# Leave unset to use the built-in default port (3002).
# CORE_SERVICE_PORT=3002

# core-service holds no identity tables; it resolves callers by asking
# user-service at GET /internal/policy/resolve.
#
# ต้องมี `/api/v1` ต่อท้าย — ผู้เรียกต่อ path เข้าไปตรง ๆ ไม่ได้เติม prefix ให้
# ค่าที่ไม่มี prefix ทำให้ทุกคำขอตอบ `NOT_FOUND: ไม่พบผู้ใช้ที่ระบุ` ซึ่งอ่านเหมือน
# ข้อมูลผิด ไม่ใช่ตั้งค่าผิด
USER_SERVICE_URL=http://localhost:3001/api/v1

# ที่ที่ core-service และ external-service ขอเลขรัน — ต้องขึ้น service นี้ก่อน
# ไม่งั้นการสร้างเอกสารทุกชนิดจะล้มพร้อมกัน
RUN_NUMBER_SERVICE_URL=http://localhost:3004/api/v1

# --- Object storage (ไฟล์แนบคำขอ) — core-service และ external-service ---
# minio (ค่าตั้งต้น) = ต่อ MinIO · memory = เก็บใน process หายเมื่อ restart (dev เท่านั้น)
# STORAGE_MODE=minio
MINIO_ENDPOINT=
MINIO_PORT=9000
# MINIO_USE_SSL=false
MINIO_BUCKET=
MINIO_ACCESSKEY=
MINIO_SECRETKEY=

# --- ERP: SAP Business One (on-premise) ---
# mock (ค่าตั้งต้น) = ตัวจำลองในหน่วยความจำ · sapb1 = ต่อ B1 Service Layer จริง
# ตั้ง sapb1 แต่ค่าด้านล่างไม่ครบ → core-service ไม่ยอม start และบอกว่าขาดตัวไหน
# เปลี่ยนจาก mock เป็น sapb1 ครั้งแรก: เลขที่ mock ออกไว้ (MOCK-…) ถูกเก็บพ้นทางเอง
# ตอน start (ErpMockRetirementService) แล้วระบบส่งลูกค้า/ใบสั่งขายเข้า B1 จริงใหม่
# ERP_MODE=mock
# ERP_RETRY_INTERVAL_MS=300000
# ERP_REFRESH_INTERVAL_MS=3600000
# ดึงรายการสินค้าจาก SAP (CD-27) — ครั้งแรก ~15 วินาทีหลัง start แล้วทุกรอบนี้; 0 = ปิด
# ERP_ITEMS_REFRESH_INTERVAL_MS=3600000
# ERP_B1_BASE_URL=https://b1.example.local:50000/b1s/v1
# ERP_B1_USERNAME=
# ERP_B1_PASSWORD=
# รหัสบริษัทใน CTD (companies.code) = CompanyDB ของ B1 คั่นด้วย comma
# ERP_B1_COMPANY_DBS=OSD=SBO_OSD,LEXTECH=SBO_LEX,BCO=SBO_BCO
# ItemCode สำหรับบรรทัดบริการ/ค่าแรงที่ไม่มีรหัสสินค้า
# ERP_B1_SERVICE_ITEM=SERVICE
# ERP_B1_WAREHOUSE=
# ERP_B1_VAT_GROUP=
# certificate ของ Service Layer ที่ออกเอง (self-signed) — ใส่ไฟล์ CA ดีกว่าปิดการตรวจ
# ERP_B1_CA_FILE=/etc/ssl/b1-ca.pem
# ERP_B1_TLS_INSECURE=false
# ERP_B1_TIMEOUT_MS=30000

# --- Microsoft Teams: แจ้งเตือนผ่านแชทส่วนตัวกับบอท (CD-51) ---
# off (ค่าตั้งต้น) = ไม่มีช่องทาง Teams · mock = บันทึก log ไม่ส่งจริง · botframework = ส่งจริง
# ตั้ง botframework แต่ค่าไม่ครบ → core-service ไม่ยอม start (บอกว่าขาดตัวไหน)
# external-service ต้องตั้ง TEAMS_MODE ให้ตรงกับ core-service (มันแค่เข้าคิว core เป็นคนส่ง)
# ขั้นตอนฝั่ง IT อยู่ใน docs/teams-notifications.md
# TEAMS_MODE=off
# TEAMS_TENANT_ID=
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_PASSWORD=
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/apac/
# ปุ่ม "เปิดใน Connect the Dot" บนการ์ด → <PUBLIC_WEB_URL>/pages/notifications
# CD-278 — ลิงก์แหล่งที่มาในคำตอบของผู้ช่วย (MCP) ใช้ค่าเดียวกันบน external-service
# PUBLIC_WEB_URL=https://ctd.example.co.th
# TEAMS_DELIVERY_INTERVAL_MS=15000

# --- Reserve-phone: คลังเลขหมาย (CD-78) ---
# มีแต่ mock (ตัวจำลอง) — ยังไม่ได้ API จริง ตั้งค่าอื่น core-service ไม่ยอม start
# ดู docs/reserve-phone.md ว่าตัวเชื่อมจริงต้องมีอะไร
# RESERVE_PHONE_MODE=mock
# จองครั้งแรกกี่วัน / จองหรือต่อได้นานสุดกี่วัน
# RESERVE_PHONE_HOLD_DAYS=14
# RESERVE_PHONE_MAX_HOLD_DAYS=60
# รอบปล่อยเบอร์ของดีลที่แพ้ + ทำเครื่องหมายหมดอายุ + เตือนเจ้าของดีล (ms); 0 = ปิด
# CRM_PHONE_RESERVATION_INTERVAL_MS=3600000

# --- ตั้งค่าระบบของโครงการ (CD-217) ---
# กุญแจเข้ารหัสค่าลับ (รหัสผ่าน, API key) แบบ AES-256-GCM — บังคับใน production
# ตั้งครั้งเดียวแล้วห้ามเปลี่ยน: เปลี่ยนแล้วค่าลับที่เก็บไว้จะถอดรหัสไม่ได้
# CONFIG_SECRET_KEY=

# --- external-service ---
# The only port an external system or MCP client reaches. Leave unset to use
# the built-in default port (3003).
# EXTERNAL_SERVICE_PORT=3003

# Where callers outside this machine reach external-service. Needed only by
# the MCP OAuth discovery document, which has to state its own address — a
# client is told "this resource lives at X", and X must be the URL *it* used.
# Docker maps 3503 -> 3003, so this is the published port, not the internal
# one. Origin only, no path.
# PUBLIC_BASE_URL=http://192.168.31.52:3503

# Where `yarn openapi` points the servers[] entry of every docs/openapi/external-*.json,
# which is the file integrators import into Postman. Prefix-free for the same
# reason: setGlobalPrefix already put /api/v1 into every path.
# EXTERNAL_API_PUBLIC_URL=http://192.168.31.52:3503

# CD-90 — the Data Lake: a separate PostgreSQL warehouse database fed by
# core-service (changed rows hourly, SAP invoices daily). Unset = no lake.
# LAKE_DATABASE_URL=postgresql://lake_writer:<password>@<host>:5432/ctd_lake
# LAKE_EXTRACT_INTERVAL_MS=3600000
# LAKE_SAP_INTERVAL_MS=86400000

# CD-275 — the company LLM Gateway (OpenAI-compatible). mock = no network.
LLM_MODE=mock
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_MS=60000
LLM_DEFAULT_CHAT_MODEL=default-chat
LLM_DEFAULT_EMBED_MODEL=default-embed
# CD-279 — ลบบันทึก AI (mcp_calls/llm_calls) ที่เก่ากว่าอายุที่บริษัทตั้ง ทุกกี่ ms (0 = ปิด)
# AI_AUDIT_SWEEP_INTERVAL_MS=86400000

# CD-267 — knowledge articles searched by meaning (embeddings via the gateway
# above, task kb.embed). The minimum cosine depends on the embedding model.
# KB_EMBED_INTERVAL_MS=300000
# KB_SEMANTIC_MIN_SIMILARITY=0.35

# CD-16 AI SMART (CD-289) — ตัวเชื่อมแหล่งกวาด Lead: mock (ข้อมูลจำลอง) | off
# SMART_CONNECTOR_MODE=mock
# ตรวจแหล่งที่ถึงรอบกวาดทุกกี่ ms (0 = ปิด)
# SMART_SWEEP_INTERVAL_MS=900000

# CD-280/281 — AI CARE conversations. CARE_AUTO_REPLY=off when a channel
# connector brings its own AI (it then posts replies to care/conversations/:id/replies).
# Answers link cited articles to <PUBLIC_WEB_URL>/f/portal?article=<id>.
# CARE_AUTO_REPLY=on
# CARE_IDLE_HOURS=24
# CARE_RETENTION_DAYS=180
# CD-282 — words in a customer's messages that make an AI CARE case critical /
# high / low (comma-separated; unset = the standard lists in care-case-rules.ts).
# CARE_SEVERITY_CRITICAL=ระบบล่ม,ทั้งบริษัท
# CARE_SEVERITY_HIGH=ใช้งานไม่ได้,ล่ม
# CARE_SEVERITY_LOW=สอบถาม,ขอข้อมูล
# CD-292 — โทรออกอัตโนมัติ: ตรวจรายการโทรที่เปิดใช้ทุกกี่ ms (0 = ปิด) และจำนวนสายพร้อมกันต่อบริษัท
# SMART_DIAL_INTERVAL_MS=60000
# SMART_MAX_CONCURRENT_CALLS=5
# D-Callcenter: mock (ผลจำลองตามเลขท้ายเบอร์) | off — ตัวเชื่อมจริงรอสเปก
# DCALLCENTER_MODE=mock
