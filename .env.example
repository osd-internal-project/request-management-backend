# Copy this file to .env before running any service in this monorepo.
# Services start from the repo root, so this single .env is shared by all of them.
#
# This file is COMMITTED — it must contain PLACEHOLDERS ONLY. Real hosts,
# passwords, and secrets belong in .env, which is git-ignored. If you find a
# real value here, rotate it: assume it has been read.

# --- user-service ---
# Leave unset to use the built-in default port (3001).
# USER_SERVICE_PORT=3001

# --- Keycloak (AUTH-01) ---
#
# Keycloak is a backend concern: only the backend holds these values, and the
# frontend receives cookies from user-service. Login is OIDC Authorization Code
# + PKCE — no endpoint here accepts a password.
KEYCLOAK_BASE_URL=http://keycloak.example.internal:8180
KEYCLOAK_REALM=enterprise-request

# Confidential client. The SAME client backs both login and the Admin REST API,
# so it needs "Client authentication" and "Service accounts roles" both ON, and
# its service account needs these realm-management roles:
#
#     view-users, query-users, query-groups, manage-users, view-realm
#
# Without them the Admin API returns 403 while still issuing a valid token — a
# failure mode that looks like everything is fine.
#
# Its redirect URIs must list the frontend callback as an ABSOLUTE url, e.g.
# http://localhost:3000/* — a bare "/*" is treated as relative to the client's
# root URL and login fails with "Invalid parameter: redirect_uri".
KEYCLOAK_CLIENT_ID=request-form
KEYCLOAK_CLIENT_SECRET=

# AUTH-06 — the client an API key is exchanged for.
# core-service mints a client_credentials token with these when an integration
# presents an `rfk_…` key, then forwards that token like any other bearer.
# The client must hold `integration.request.create` and nothing more.
INTEGRATION_CLIENT_ID=
INTEGRATION_CLIENT_SECRET=

# --- Database ---
# One schema for the whole monorepo: libs/prisma/schema.prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Metabase (CD-10/CD-92, infra/metabase) ---
# Password of Metabase's OWN state database (the bundled container), not the
# application database. The app DB is read through the `metabase_ro` role
# created by infra/metabase/reporting.sql — see docs/metabase.md.
# METABASE_APP_DB_PASSWORD=

# Embedded BI menu (GET /bi/menu on core-service). siteUrl = where browsers
# reach Metabase; embedSecret = Admin → Settings → Embedding → secret key.
# Leave unset → menu answers configured:false and the frontend hides the
# section.
#
# The dashboard LIST now lives in the `bi_dashboards` table, managed from the
# "ตั้งค่า Dashboard" admin screen (per-team visibility included). The three
# ids below are only a fallback for a company with no rows configured yet.
METABASE_SITE_URL=http://192.168.31.51:3400/
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_REQUEST=2
METABASE_DASHBOARD_APPROVAL=3
METABASE_DASHBOARD_SLA=4

# --- core-service ---
# Leave unset to use the built-in default port (3002).
# CORE_SERVICE_PORT=3002

# core-service holds no identity tables; it resolves callers by asking
# user-service at GET /api/internal/policy/resolve.
#
# The `/api/v1` prefix is PART OF THIS VALUE — core-service appends only the
# path that follows it. The frontend reads a variable of the same name that
# means the opposite (origin only, because src/lib/backend.ts adds the prefix
# itself), so the two must never share an env file.
USER_SERVICE_URL=http://localhost:3001/api/v1
