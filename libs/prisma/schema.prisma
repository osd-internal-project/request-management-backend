// Single Prisma schema for the whole monorepo. The generated client is
// consumed through libs/prisma by every service in services/*.
//
// Models follow the CTD Foundation Sprint spec §10. Rules that hold
// throughout, and that reviews should enforce:
//
//   * every transactional table carries companyId + created/updated audit columns
//   * transactional data is NEVER hard-deleted — status columns only
//   * per-request form data is Json validated against the JSON Schema declared
//     in RequestType, so adding a request type needs no migration
//   * OrgClosure is recomputed on org edits, never traversed at query time

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// The five levels of the chart: บริษัท → ฝ่าย → แผนก → ทีม → ตำแหน่ง.
///
/// **The order is declared in `libs/share/src/org/org-levels.ts`, not here.**
/// This list is not in chart order — `TEAM` predates `DIVISION` and `POSITION`,
/// which were appended as the chart grew, and Postgres cannot reorder an enum
/// without swapping the whole type. Anything that needs to know which level is
/// above which reads `ORG_UNIT_LEVELS`; reading this declaration instead ranks
/// ทีม below ตำแหน่ง, which is wrong.
///
/// `OrgService` enforces two rules over those levels on every write: a unit's
/// parent is the level immediately above it, and people sit at แผนก or below.
/// ทีม and ตำแหน่ง are optional — a chart that stops at แผนก is complete.
enum OrgUnitKind {
  COMPANY
  DIVISION
  DEPARTMENT
  POSITION
  TEAM
}

/// How a role reached a user: mapped from a Keycloak claim (ROLE-03) or bound
/// by hand in the admin screen (ROLE-02). Mapped grants are re-evaluated on
/// every login; manual ones persist until removed.
enum RoleGrantSource {
  KEYCLOAK_MAPPING
  MANUAL
}

/// §6.1 data scope levels.
enum ScopeLevel {
  own
  team
  department
  company
  all
}

/// §7.1 request state machine. Transitions outside the declared paths must be
/// impossible through every channel, including direct API calls.
enum RequestStatus {
  draft
  submitted
  returned
  pending_approval
  approved
  rejected
  in_progress
  on_hold
  completed
  closed
  cancelled
}

/// REQ-10: requests raised by an integration are marked, so "who started
/// this" is answerable without guessing.
enum RequestSource {
  USER
  SYSTEM
}

/// CD-66 — the channels customers submit through (user decision 29 ก.ย.
/// 2569: the public web form first, LINE and AI CARE as connectors).
enum IntakeChannel {
  web_form
  line
  ai_care
}

enum ApprovalCaseStatus {
  pending
  approved
  rejected
  returned
  voided
  cancelled
}

enum ApprovalStepStatus {
  waiting
  pending
  approved
  rejected
  returned
  skipped
}

enum ApprovalDecision {
  approve
  reject
  return
}

/// How much of the clock counts, per request type (SUP-01).
///
/// `H24X7` is elapsed time, the only mode the clock ever actually implemented.
/// The other two count `HolidayCalendar`'s working window, and `H8X5` also
/// skips non-working weekdays and holidays.
///
/// Replaces the boolean `businessHours` on 31 Aug 2026: it could not tell
/// "office hours every day" from "office hours on working days", which the
/// support desk and the back office need to mean different things.
enum SlaCoverage {
  H24X7
  H8X7
  H8X5
}

/// CD-67 — ระดับความรุนแรงของเคส/ข้อร้องเรียน. กำหนดเวลาตอบกลับและแก้ไขของแต่ละ
/// ระดับตั้งต่อประเภทคำขอใน `SlaConfig.severityTargets` — ประเภทที่ตั้งไว้ = ประเภทเคส
/// (ต้องเลือกระดับตอนยื่น).
enum RequestSeverity {
  critical
  high
  medium
  low
}

enum SlaState {
  running
  paused
  met
  breached
  cancelled
}

enum NotificationChannel {
  in_app
  email
  /// CD-51 — Microsoft Teams, a bot's 1:1 chat with the recipient.
  teams
}

enum DeliveryStatus {
  queued
  sent
  failed
}

/// CD-55 — how a notification became read. `opened` = the person clicked it;
/// `mark_all` = "อ่านทั้งหมด", which is not evidence anyone saw the message.
enum NotificationReadVia {
  opened
  mark_all
}

/// CM-01: นิติบุคคล / บุคคลธรรมดา / หน่วยงานรัฐ.
enum CustomerType {
  corporate
  individual
  government
}

/// CM-04 customer lifecycle. KYC is deliberately NOT a status: the PO
/// confirmed (8 ก.ย. 2569) that a customer is active the moment it is
/// created, and KYC is forced per product via the `kycVerified` flag —
/// a `pending_kyc` state would block customers who never touch a KYC
/// product.
enum CustomerStatus {
  draft
  active
  suspended
  inactive
}

/// CD-62 — อนุมัติเปิดลูกค้าใหม่ก่อนส่งเข้า SAP. ลูกค้าที่มีอยู่ก่อนเปิดใช้ และที่ import
/// มา ถือว่า approved; pending/rejected = ยังไม่ส่งลูกค้าและใบสั่งขายของเขาเข้า SAP.
enum CustomerApprovalStatus {
  approved
  pending
  rejected
}

/// CM-06 — สถานะงานในคิว sync ของชั้น integration (SAP + workflow วันนี้ ระบบอื่นภายหลัง).
enum IntegrationJobStatus {
  pending
  succeeded
  failed
}

/// CRM — ชนิดของสถานะ Lead. ตัวสถานะเองเป็น **ข้อมูล** ไม่ใช่ enum (ตั้งค่า CRM →
/// แท็บ "สถานะ Lead" เพิ่ม/ลบได้เอง, D-09); ชนิดคือสิ่งที่โค้ดตัดสินใจด้วย —
/// `open` = ยังทำงานต่อได้, `won` = ปลายทางเมื่อแปลงเป็นโอกาสการขาย,
/// `lost` = ปลายทางเมื่อคัดออก. หนึ่งบริษัทมี `won`/`lost` อย่างละหนึ่งเสมอ.
enum LeadStatusKind {
  open
  won
  lost
}

/// CRM — กิจกรรมบน Lead: โทร / อีเมล / นัดหมาย / งาน / บันทึก.
enum LeadActivityType {
  call
  email
  meeting
  task
  note
  /// CD-85 — ช่องทางเข้าหาเพิ่ม: เข้าพบ, LINE, โซเชียล.
  visit
  line
  social
}

/// CD-85 — ผลของการติดต่อหนึ่งครั้ง (Prospecting). ว่าง = ไม่ใช่การติดต่อ
/// (งาน/บันทึก) หรือยังไม่ได้ติดต่อ.
enum ActivityOutcome {
  reached
  no_answer
  interested
  not_interested
}

/// CD-85 — ลำดับความสำคัญของบริษัทเป้าหมาย.
enum TargetAccountPriority {
  high
  medium
  low
}

/// CD-85 — บริษัทเป้าหมาย: เล็งไว้ → เริ่มเข้าหา (เกิด Lead) → เปิดดีลแล้ว
/// (Lead แปลงเป็นโอกาสการขาย) หรือตัดออกพร้อมเหตุผล.
enum TargetAccountStatus {
  targeting
  approaching
  converted
  dropped
}

/// CD-86 — ลำดับความสำคัญของบัญชีลูกค้าเดิม (Keeper): A ดูแลใกล้ชิดที่สุด.
enum AccountTier {
  a
  b
  c
}

/// CD-86 — ชนิดของโอกาสการขาย: ลูกค้าใหม่, ขายเพิ่ม (Upgrade/Upsell),
/// ขายข้าม (Cross-sell), ต่ออายุ (CD-70 ตั้งให้อัตโนมัติ).
enum OpportunityDealType {
  new_business
  upsell
  cross_sell
  renewal
}

/// CD-86 — การติดต่อลูกค้าเดิม: ทบทวนตามรอบ (review) หรือเข้าหาเชิงรุก.
enum CustomerTouchType {
  review
  call
  email
  meeting
  visit
  line
  social
}

/// CRM — ขั้นของโอกาสการขาย. `won`/`lost` เป็นสถานะปิด; ปิดแพ้ต้องมีเหตุผลมาตรฐาน
/// (spec: "ปิดแพ้ต้องระบุเหตุผลจากรายการมาตรฐานเพื่อนำมาวิเคราะห์ได้").
enum OpportunityStage {
  qualifying
  proposing
  negotiating
  won
  lost
}

/// CRM — สถานะใบสั่งขาย (Sale Order). PO 10 ก.ย. 2569: ลูกค้าในทะเบียน "เกิด"
/// ที่จุดเปิดใบสั่งขายเท่านั้น — ขั้นตอนก่อนหน้า (Lead, โอกาสการขาย) เป็นผู้มุ่งหวัง.
enum SaleOrderStatus {
  open
  cancelled
}

/// สถานะการส่งใบสั่งขายเข้า SAP (CD-88) — แยกจากสถานะของใบเอง: ใบเปิดอยู่แต่ยัง
/// ไม่ถึง SAP ได้ และ SAP ล่มต้องไม่ทำให้ใบหายหรือเปิดไม่ได้.
///   not_ready — ยังไม่มีรายการสินค้า ส่งไม่ได้ (เปิดตรงจากโอกาสการขาย)
///   pending   — อยู่ในคิว (รวมถึงรอลูกค้าได้เลข BP ก่อน)
///   synced    — SAP ตอบเลขใบสั่งขายแล้ว (ถ้าใบถูกยกเลิก = SAP ยกเลิกแล้วด้วย)
///   failed    — ลองครบรอบแล้วไม่สำเร็จ ต้องให้ผู้ดูแลดู `erpLastError`
///   skipped   — ใบถูกยกเลิกก่อนถึง SAP ไม่มีอะไรต้องส่ง
/// CD-82 — เป้าขายเป็นของใคร: พนักงานคนเดียว หรือกลุ่มในผังองค์กร (ทีม/ฝ่าย —
/// นับยอดของกลุ่มนั้นและทุกกลุ่มใต้มัน).
enum SalesTargetScope {
  user
  org_unit
}

/// CD-82 — สถานะของการเปลี่ยนเป้าหนึ่งครั้ง.
///   applied          — มีผลแล้ว (ตั้งครั้งแรก, งวดยังไม่เริ่ม, หรืออนุมัติแล้ว)
///   pending_approval — งวดเริ่มแล้ว รอคำขออนุมัติ `approvalRequestId`
///   rejected / cancelled — คำขอไม่ผ่าน/ถูกยกเลิก เป้าคงค่าเดิม
enum SalesTargetRevisionStatus {
  applied
  pending_approval
  rejected
  cancelled
}

enum ErpSyncStatus {
  not_ready
  pending
  synced
  failed
  skipped
}

/// CRM — สถานะใบเสนอราคา (CD-76). แก้ได้เฉพาะ `draft`; ส่งลูกค้าแล้วแก้ไม่ได้ ต้อง
/// ออกเวอร์ชันใหม่ (`superseded` คือฉบับที่ถูกเวอร์ชันใหม่แทน). margin ต่ำกว่าเกณฑ์ =
/// `pending_approval` รอคำขออนุมัติ (ประเภทตาม CrmCompanyConfig) ผ่านก่อนเป็น `approved`.
enum QuotationStatus {
  draft
  pending_approval
  approved
  sent
  accepted
  declined
  superseded
  cancelled
}

/// CM-05: บทบาทผู้ติดต่อตามสเปค.
enum CustomerContactRole {
  decision_maker
  user
  procurement
  finance
  other
}

/// รอบที่ลำดับเลขรันกลับไปเริ่มที่ `startNumber` ใหม่ — คุมค่า `periodKey` ของ
/// `RunNumberCounter`. `none` = นับต่อไปเรื่อย ๆ ไม่มีรีเซ็ต.
enum RunNumberResetPeriod {
  none
  yearly
  monthly
  daily
}

// ---------------------------------------------------------------------------
// Identity & Org
// ---------------------------------------------------------------------------

/// D-11: multi-company from day one. `docPrefix` feeds the request number
/// (REQ-02, e.g. the OSD in OSD-DSC-202608-0042).
model Company {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  docPrefix    String
  baseCurrency String   @default("THB")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                   UserCompany[]
  primaryUsers            User[]                     @relation("PrimaryCompany")
  lastActiveUsers         User[]                     @relation("LastCompany")
  orgUnits                OrgUnit[]
  roles                   Role[]
  userRoles               UserRole[]
  keycloakMappings        KeycloakRoleMapping[]
  requestTypes            RequestTypeCompany[]
  requests                Request[]
  docNumberConfigs        DocNumberConfig[]
  docNumberCounter        DocNumberCounter[]
  runNumberSettings       RunNumberSetting[]
  runNumberCounters       RunNumberCounter[]
  approvalMatrices        ApprovalMatrix[]
  requestFlowVersions     RequestFlowVersion[]
  approvalCases           ApprovalCase[]
  delegations             Delegation[]
  slaConfigs              SlaConfig[]
  holidayCalendar         HolidayCalendar?
  notifications           Notification[]
  auditLogs               AuditLog[]
  biDashboards            BiDashboard[]
  orgUnitScopes           OrgUnitScope[]
  notificationPreferences NotificationPreference[]
  notificationTemplates   NotificationTemplate[]
  notificationRules       NotificationRule[]
  intakeChannels          RequestIntakeChannel[]
  targetAccounts          TargetAccount[]
  customers               Customer[]
  customerSegmentDims     CustomerSegmentDimension[]
  customerCodeCounter     CustomerCodeCounter?
  crmConfig               CrmCompanyConfig?
  tradeTermStandards      TradeTermStandard[]
  handoverChecklistItems  HandoverChecklistItem[]
  kycWatchlist            KycWatchlistEntry[]
  kycProductRules         KycProductRule[]
  leadStatuses            LeadStatusSetting[]
  leads                   Lead[]
  opportunities           Opportunity[]
  opportunityLostReasons  OpportunityLostReason[]
  opportunityCodeCounter  OpportunityCodeCounter?
  saleOrders              SaleOrder[]
  products                Product[]
  saleOrderCodeCounter    SaleOrderCodeCounter?
  quotations              Quotation[]
  quotationCodeCounter    QuotationCodeCounter?
  salesTargets            SalesTarget[]
  campaigns               Campaign[]

  @@map("companies")
}

/// Local mirror of the Keycloak-authenticated user (AUTH-04, JIT-provisioned
/// on first login). Keycloak owns credentials and roles; org placement —
/// `orgUnitId` and `supervisorUserId` — is owned *here* and edited through the
/// admin screen, because LDAP is used for authentication only (D-07/D-08).
model User {
  id          String     @id @default(uuid())
  keycloakId  String     @unique
  username    String     @unique
  email       String?    @unique
  displayName String
  firstName   String?
  lastName    String?
  status      UserStatus @default(ACTIVE)

  primaryCompanyId String?
  primaryCompany   Company? @relation("PrimaryCompany", fields: [primaryCompanyId], references: [id])

  /// บริษัทที่ผู้ใช้สลับไปล่าสุด — บริษัทตั้งต้นเมื่อ login ครั้งถัดไป (AUTH-05).
  ///
  /// คนละความหมายกับ `primaryCompanyId` ซึ่งเป็นสังกัดหลักที่ผู้ดูแลกำหนดให้ อันนี้คือ
  /// ที่ที่เจ้าตัวเลือกทำงานอยู่ตอนนี้ และเปลี่ยนเองได้จาก company switcher
  /// null = ยังไม่เคยสลับ จึงตกไปใช้ `primaryCompanyId` เหมือนเดิม
  lastCompanyId String?
  lastCompany   Company? @relation("LastCompany", fields: [lastCompanyId], references: [id])

  /// Job title as HR records it, e.g. `Senior Purchasing Officer`.
  ///
  /// Kept as text *as well as* being a level of the chart (31 Aug 2026). The
  /// title is a fact about the person — `roleForPosition` maps it to a system
  /// role at import, and the user directory prints it — while `OrgUnitKind.
  /// POSITION` is where that person sits, scoped to one department.
  ///
  /// The two are not the same thing and must not be collapsed: the staff
  /// register holds 67 distinct titles across 102 people, so the same title
  /// appears under several departments and each is its own box on the chart.
  position String?

  /// HR's own staff number, e.g. `EMP-094`.
  ///
  /// Not unique and not validated, because the source register genuinely is not
  /// uniform: 98 of 101 rows are `EMP-NNN`, the rest are `Consult-005`, `M-008`
  /// and a bare `888`. A format check here would reject real people.
  ///
  /// `import-osd-catalog.ts` already reads this concept as `employeeCode` but
  /// only as a join key — it was never persisted. This column is its home; do
  /// not add a third name for it.
  employeeId String?

  /// Desk phone extension, four digits.
  ///
  /// Deliberately **not** unique: 14 of the 75 known values are shared, because
  /// a team sitting around one handset all give out the same number.
  extension String?

  /// The day the person started work.
  ///
  /// Only the date carries meaning — every value in the source register is
  /// midnight — but stored as a timestamp because nothing else in this schema
  /// uses `@db.Date` and one exception would be the surprising thing.
  startWork DateTime?

  /// Contact number carried over from the previous system.
  ///
  /// Stored exactly as the source wrote it, without normalising: the register
  /// mixes `66` country prefixes with bare nine-digit numbers, and guessing
  /// which is which would invent data.
  phone String?

  /// Null until an admin assigns the user — these are the "รอจัดสังกัด" queue.
  orgUnitId String?
  orgUnit   OrgUnit? @relation("OrgUnitMembers", fields: [orgUnitId], references: [id])

  supervisorUserId String?
  supervisor       User?   @relation("Supervision", fields: [supervisorUserId], references: [id])
  subordinates     User[]  @relation("Supervision")

  /// Realm roles seen on the token at the last login (ROLE-03).
  ///
  /// Cached here so screen A3 can show "role จาก Keycloak: sales" for someone
  /// who has not been assigned yet — it comes free from the token and needs no
  /// Admin API call. Never authoritative: permissions always resolve through
  /// keycloak_role_mappings, this is display only.
  keycloakRoles String[] @default([])

  firstLoginAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companies               UserCompany[]
  roles                   UserRole[]               @relation("RoleHolder")
  grantedRoles            UserRole[]               @relation("RoleGranter")
  managedUnits            OrgUnit[]                @relation("OrgUnitManager")
  requests                Request[]                @relation("Requester")
  intakeChannels          RequestIntakeChannel[]
  receivedRequests        Request[]                @relation("Receiver")
  receiverOfTypes         RequestType[]            @relation("TypeReceiver")
  assignedRequests        Request[]                @relation("Assignee")
  requestEvents           RequestEvent[]
  requestComments         RequestComment[]
  attachments             RequestAttachment[]
  approvalSteps           ApprovalStep[]           @relation("StepApprover")
  decidedSteps            ApprovalStep[]           @relation("StepDecider")
  delegationsOut          Delegation[]             @relation("Delegator")
  delegationsIn           Delegation[]             @relation("Delegate")
  notifications           Notification[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  scopesGranted           OrgUnitScope[]           @relation("ScopeViewerUser")
  scopesOn                OrgUnitScope[]           @relation("ScopeTargetUser")
  ownedCustomers          Customer[]               @relation("CustomerAccountOwner")

  @@index([orgUnitId])
  @@index([supervisorUserId])
  @@index([lastCompanyId])
  @@map("users")
}

/// AUTH-05: one person can belong to several companies, with exactly one
/// primary. Roles are held per company (ROLE-04), never globally.
model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

/// The org chart, maintained in this system (D-08). It is the source of truth
/// for "who reports to whom", which drives data scope (§6), approval step 1
/// (§8.1), and escalation (SUP-02).
model OrgUnit {
  id        String      @id @default(uuid())
  companyId String
  code      String
  name      String
  kind      OrgUnitKind @default(TEAM)

  parentId String?
  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgTree")

  managerUserId String?
  manager       User?   @relation("OrgUnitManager", fields: [managerUserId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company       Company               @relation(fields: [companyId], references: [id])
  members       User[]                @relation("OrgUnitMembers")
  ancestors     OrgClosure[]          @relation("ClosureDescendant")
  descendants   OrgClosure[]          @relation("ClosureAncestor")
  receivedTypes RequestType[]         @relation("ReceiverUnit")
  eligibleTypes RequestTypeOrgUnit[]
  biAudiences   BiDashboardAudience[]
  scopesGranted OrgUnitScope[]        @relation("ScopeViewer")
  scopesOn      OrgUnitScope[]        @relation("ScopeTarget")

  @@unique([companyId, code])
  @@index([parentId])
  @@map("org_units")
}

/// Transitive closure of `OrgUnit`, recomputed inside the same transaction as
/// any org edit. Scope `team` and `department` resolve to an `IN (…)` against
/// this table rather than walking the tree per query (§6.2 note) — the reason
/// list endpoints can still meet NFR-02 at 100k rows.
model OrgClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   OrgUnit @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant OrgUnit @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("org_closure")
}

/// One group may see — and optionally work on — another group's requests.
///
/// The replacement for `ScopeRule`, which tied visibility to a *role* and was
/// withdrawn on 31 ส.ค. 2569 because a `(role, resource) → level` rule cannot
/// say "ฝ่ายขาย sees ฝ่ายการตลาด's work". This says exactly that, and nothing
/// more general.
///
/// The level an administrator picks on screen (บริษัท / ฝ่าย / แผนก / ตำแหน่ง)
/// is `OrgUnit.kind` of the viewer, so it is not stored again here — a group's
/// level is already a property of the group.
///
/// A grant is inherited downwards: it is matched against the viewer's own unit
/// **and every unit above it**, which is what makes a grant written at the
/// company level apply to everybody in the company.
model OrgUnitScope {
  id        String @id @default(uuid())
  companyId String

  /// The group being granted the view, when the grant is written to a group.
  ///
  /// Exactly one of `viewerOrgUnitId` / `viewerUserId` is set — a CHECK
  /// constraint enforces it, because a row with neither reaches nobody and a
  /// row with both would have to pick one silently.
  viewerOrgUnitId String?
  /// The one person being granted the view, when the grant is written to a
  /// person rather than to their whole group (4 ก.ย. 2569).
  viewerUserId    String?

  /// The group whose work becomes visible, when the target is a group.
  ///
  /// Exactly one of `targetOrgUnitId` / `targetUserId` is set.
  targetOrgUnitId String?
  /// The one person whose work becomes visible — "ให้คนนี้เห็นงานของคนนั้น",
  /// which naming a whole group could never express.
  targetUserId    String?

  /// Whether the grant reaches the groups beneath `target`.
  ///
  /// Defaults to true because the org chart is บริษัท → ฝ่าย → แผนก and naming
  /// a ฝ่าย almost always means its แผนก too. Turning it off is the narrow
  /// case, so it is the one that has to be asked for.
  ///
  /// Meaningless when the target is a person — a person has no subtree — so
  /// the service forces it to `false` there rather than storing a flag that
  /// reads as if it did something.
  includeDescendants Boolean @default(true)

  /// What the viewer may *do* with those requests, beyond reading them.
  ///
  /// Codes from `SCOPE_PERMISSIONS` in
  /// `libs/share/src/policy/permissions.ts` — a closed set drawn from the
  /// catalog, validated at the DTO. Empty is the default and means read-only:
  /// `assertMayAct` in core-service is the only thing standing between a person
  /// and somebody else's ticket, and a grant that silently widened it would
  /// hand the whole chart to whoever was granted a view.
  ///
  /// Always intersected with what the holder's roles already grant, never added
  /// to them — that is what keeps `assertSeparationOfDuties` meaningful, since
  /// it runs on role permission sets and never sees this column.
  ///
  /// A `String[]` rather than a join table like `RolePermission`, because
  /// `scopedAccessOf` reads these on **every request** while resolving the
  /// principal, and the codes are declared in code rather than by an admin.
  /// `ApprovalStep.candidateUserIds` and `User.keycloakRoles` are stored the
  /// same way for the same reason.
  permissions String[] @default([])

  /// Whether the viewer may move those requests, or only read them.
  ///
  /// **Derived from `permissions` since 7 ก.ย. 2569** and kept only so that a
  /// core-service still running the previous release answers as it did during a
  /// rolling deploy. Nothing decides anything from it in this release; the next
  /// one drops the column.
  canAct Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company    Company  @relation(fields: [companyId], references: [id])
  viewer     OrgUnit? @relation("ScopeViewer", fields: [viewerOrgUnitId], references: [id], onDelete: Cascade)
  viewerUser User?    @relation("ScopeViewerUser", fields: [viewerUserId], references: [id], onDelete: Cascade)
  target     OrgUnit? @relation("ScopeTarget", fields: [targetOrgUnitId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ScopeTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// The uniqueness of a grant is four partial indexes, created in
  /// `20260904120000_scope_user_grants` — not `@@unique`. Postgres treats every
  /// NULL as distinct, so a composite unique over four nullable columns would
  /// permit the same grant to be written any number of times.
  @@index([companyId, viewerOrgUnitId])
  @@index([companyId, viewerUserId])
  @@map("org_unit_scopes")
}

/// ROLE-02. `companyId` null means a group-wide template role; bound roles are
/// deactivated, never deleted.
model Role {
  id          String  @id @default(uuid())
  companyId   String?
  code        String
  name        String
  description String?
  /// Seed roles from §5.2 — cannot be renamed away or removed.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  /// How far up the holder's own branch their view starts, `null` for none.
  ///
  /// **Not the `ScopeLevel` withdrawn on 31 ส.ค. 2569.** That was an absolute
  /// rank per `(role, resource)` — it could say "this role sees its
  /// department" but never "ฝ่ายขาย sees ฝ่ายการตลาด", which is why
  /// `OrgUnitScope` replaced it and still owns every cross-branch grant.
  ///
  /// This is relative to whoever holds the role: walk up the holder's own
  /// ancestors, take the nearest unit whose `kind` matches, and read that
  /// unit's whole subtree. Somebody under `ตำแหน่ง: software dev` with
  /// `DEPARTMENT` sees all of RND; with `DIVISION`, all of INF. It follows
  /// them when they move, which a grant naming a target unit cannot.
  ///
  /// No ancestor of that kind means **no extra units at all** — never a wider
  /// one. When `POSITION` nodes leave the chart, a role set to `POSITION` goes
  /// quiet rather than silently widening to the department above it.
  ///
  /// Read only. Acting on somebody else's request still comes from leading
  /// their group or from a scope grant ticked to allow it.
  visibilityLevel OrgUnitKind?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company          Company?              @relation(fields: [companyId], references: [id])
  permissions      RolePermission[]
  users            UserRole[]
  scopeRules       ScopeRule[]
  keycloakMappings KeycloakRoleMapping[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Mirror of the code-declared catalog in `libs/share/src/policy/permissions.ts`,
/// synced at boot. The table exists for referential integrity only — admins
/// compose roles from these but cannot create new ones (§11.3).
model Permission {
  code        String  @id
  module      String
  /// human = สิทธิ์ของคนใน role · service = scope ของบัญชีบริการ (AUTH-06)
  type        String  @default("human")
  description String?

  roles RolePermission[]

  @@index([module])
  @@index([type])
  @@map("permissions")
}

model RolePermission {
  roleId         String
  permissionCode String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

/// ROLE-04: a role binding is always scoped to one company.
model UserRole {
  id        String          @id @default(uuid())
  userId    String
  roleId    String
  companyId String
  source    RoleGrantSource @default(MANUAL)

  grantedByUserId String?
  grantedAt       DateTime @default(now())

  user      User    @relation("RoleHolder", fields: [userId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  grantedBy User?   @relation("RoleGranter", fields: [grantedByUserId], references: [id])

  @@unique([userId, roleId, companyId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// ROLE-03: "Keycloak role → role in this system", per company. Re-evaluated
/// on every login and refresh, so revoking in Keycloak revokes here within one
/// access-token lifetime.
model KeycloakRoleMapping {
  id             String   @id @default(uuid())
  /// The realm role's **name** — what a token carries, so this is what
  /// `syncFromKeycloakRoles` matches on at sign-in.
  keycloakRole   String
  /// The realm role's **id**, which a rename does not change.
  ///
  /// Without it a rename in Keycloak was invisible here: the next token
  /// carried the new name, this row still held the old one, no mapping
  /// matched, and every holder of that role lost it with nothing on screen to
  /// say why. Nullable because rows written before 2 ก.ย. 2569 have no id yet
  /// — `syncNamesFromKeycloak` fills it in on its first run.
  keycloakRoleId String?
  roleId         String
  companyId      String
  createdAt      DateTime @default(now())
  createdBy      String?

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([keycloakRole, roleId, companyId])
  @@index([companyId])
  @@index([keycloakRoleId])
  @@map("keycloak_role_mappings")
}

/// SCOPE-01: (role, resource) → scope level, editable from the admin screen
/// with no deploy.
model ScopeRule {
  id       String     @id @default(uuid())
  roleId   String
  resource String
  scope    ScopeLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("scope_rules")
}

/// SCOPE-04: which fields of which resource are sensitive, and the permission
/// that unmasks them. Enforced on the API response, not just the UI.
model SensitiveFieldRule {
  id                  String @id @default(uuid())
  resource            String
  field               String
  visibleToPermission String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([resource, field])
  @@map("sensitive_field_rules")
}

// ---------------------------------------------------------------------------
// Request
// ---------------------------------------------------------------------------

/// REQ-01: a request type is *configuration*, not code. Adding the 3rd..30th
/// type is an admin screen action.
model RequestType {
  id                String  @id @default(uuid())
  code              String  @unique
  name              String
  receiverOrgUnitId String?
  receiverUserId    String?

  /// JSON Schema for the form the **requester** fills in.
  formSchema         Json
  /// JSON Schema for the form the **receiver** fills in before completing.
  ///
  /// Null means the type has no second form, and `complete` then asks for
  /// nothing extra — which is most of the forty imported types, so this stays
  /// optional rather than defaulting to an empty schema that would render as
  /// a blank required step.
  receiverFormSchema Json?
  /// [{ code, name }] — attachments that block submit (REQ-03).
  requiredDocs       Json  @default("[]")
  /// [{ code, name }] — the standard return reasons (REQ-04).
  returnReasonCodes  Json  @default("[]")
  /// [{ code, required }] — child types the receiver raises under this request;
  /// a required one must exist before `complete`.
  subRequestTypes    Json  @default("[]")
  /// { mode: "standard_chain", amount_field: "deal_value" } — how APV-02
  /// derives the approval chain.
  approvalPolicy     Json

  slaHours    Int?
  slaCoverage SlaCoverage @default(H24X7)

  /// Whether ยื่นคำขอ demands `refId` — §16 marks it required, but only on the
  /// DSC mockup, and most types have no opportunity to point at. Per type rather than
  /// hard-coded on the screen, which is what it was until 1 ก.ย. 2569.
  refRequired Boolean @default(false)

  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  receiverOrgUnit OrgUnit?             @relation("ReceiverUnit", fields: [receiverOrgUnitId], references: [id])
  receiverUser    User?                @relation("TypeReceiver", fields: [receiverUserId], references: [id], onDelete: SetNull)
  companies       RequestTypeCompany[]
  eligibleUnits   RequestTypeOrgUnit[]
  requests        Request[]
  flowVersions    RequestFlowVersion[]

  @@map("request_types")
}

/// Which groups may raise a request of this type.
///
/// **No rows means every group may.** That is the default and what all forty
/// imported types carry, so switching this on is opt-in per type rather than a
/// migration that has to guess.
///
/// A group named here covers its whole subtree: naming a department lets every
/// position under it raise the type, resolved through `OrgClosure` rather than
/// listing descendants, so moving a group in the chart cannot silently revoke
/// what it could raise.
model RequestTypeOrgUnit {
  requestTypeId String
  orgUnitId     String

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([requestTypeId, orgUnitId])
  @@index([orgUnitId])
  @@map("request_type_org_units")
}

/// Which companies have a given request type switched on.
model RequestTypeCompany {
  requestTypeId String
  companyId     String
  active        Boolean @default(true)

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id])

  @@id([requestTypeId, companyId])
  @@map("request_type_companies")
}

model Request {
  id String @id @default(uuid())

  /// Issued at submit, never before (REQ-02). Null while draft.
  requestNo String? @unique

  requestTypeId String
  typeCode      String
  companyId     String

  requesterId        String
  /// Snapshotted at submit so later org moves do not rewrite history or
  /// silently change who can see the row.
  requesterOrgUnitId String?

  /// The person the requester sent this to, named when the request is raised.
  ///
  /// A request is a ticket handed to somebody, not a job dropped in a
  /// department's queue: `06_EXAMPLE` shows every row being received by a named
  /// person and the source keeps a `ผู้รับผิดชอบที่แผนกปลายทาง` column for it.
  /// Only this person can accept the request (`submitted → in_progress`).
  receiverUserId String?

  /// Who is actually doing the work, once the receiver hands it on.
  ///
  /// Separate from `receiverUserId` because the source records `ASSIGNED` and
  /// `HANDOVER` as their own events — the person who accepted a ticket and the
  /// person who finished it are frequently not the same, and the timeline has
  /// to keep both.
  assigneeUserId String?

  /// The team this request was sent to.
  ///
  /// Seeded from `RequestType.receiverOrgUnitId` when the request is created,
  /// but the requester may pick a different team — the type's value is a
  /// starting point, not a routing rule. Held on the request so that editing
  /// the type later cannot re-route work already in flight (REQ-01).
  ///
  /// Deliberately a plain column with no relation, exactly like
  /// `requesterOrgUnitId` above it: both record where the work sat at the
  /// time, and a foreign key would let an org-chart edit rewrite that.
  receiverOrgUnitId String?

  /// Every request above this one, root first.
  ///
  /// Written once at create from the parent's own path, so "everything under
  /// request 1" is a single indexed lookup rather than a query per level. The
  /// screen draws several levels at once — `06_EXAMPLE` traces ten requests
  /// across eight departments from one customer order — and walking that a
  /// level at a time is a query per level on every page view.
  ///
  /// Empty for a request nobody spawned.
  ancestorIds String[] @default([])

  /// The request this one was spawned from, if any.
  ///
  /// One piece of work commonly breaks into several across departments —
  /// `06_EXAMPLE` traces ten requests over eight of them from a single customer
  /// order. A parent cannot be completed while any child is still open, which
  /// is what stops a chain being closed from the top while work continues
  /// underneath it.
  parentRequestId String?

  /// The step of the parent's flow this request was raised in, if any.
  parentStepCode String?

  /// The flow version pinned at submit; null runs the fixed lifecycle only.
  flowVersionId    String?
  /// The step the work is on while `in_progress` (or awaiting its exit approval).
  currentStepCode  String?
  /// Answers to each step's form, keyed by step code.
  stepFormData     Json    @default("{}")
  /// v2: who holds a requester step when the requester handed it on.
  stepHolderUserId String?

  /// When the requester accepted the result. `completedAt` is when the work
  /// finished; the two are different moments and the gap between them is how
  /// long an answer sat unread.
  closedAt DateTime?

  status   RequestStatus @default(draft)
  formData Json          @default("{}")

  /// Answers to the type's `receiverFormSchema`, filled in at `complete`.
  ///
  /// Its own column rather than more keys in `formData`: the two forms are
  /// authored separately, answered by different people at different moments,
  /// and masking rules are declared per field — merging them would make
  /// "who wrote this value" unanswerable from the row.
  ///
  /// `{}` for a type with no second form, which is most of them.
  receiverFormData Json @default("{}")

  /// REQ-06: link back to the originating entity (opportunity, customer, …).
  /// CD-67 — ระดับความรุนแรง (เฉพาะประเภทเคส). เลือกได้ตอนร่าง/ตีกลับ ล็อกเมื่อยื่น.
  severity RequestSeverity?

  refType String?
  refId   String?

  /// The RequestType config as it stood at submit — a running request keeps
  /// its rules even after an admin edits the type (REQ-01).
  typeSnapshot Json?

  source RequestSource @default(USER)

  /// CD-66 — raised by a customer through a channel. The requester is then the
  /// channel's designated staff user; the customer is the contact below, and
  /// `refType/refId` point at the customer when their tax id or email matched.
  channel           IntakeChannel?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  contactCompany    String?
  contactTaxId      String?
  /// LINE connector: who to reply to (LINE has no email or phone).
  contactLineUserId String?
  /// sha256 of the private status link's token — the token itself is shown
  /// to the customer once and never stored.
  statusTokenHash   String?        @unique

  submittedAt  DateTime?
  dueAt        DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  requestType   RequestType           @relation(fields: [requestTypeId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requester     User                  @relation("Requester", fields: [requesterId], references: [id])
  receiver      User?                 @relation("Receiver", fields: [receiverUserId], references: [id])
  assignee      User?                 @relation("Assignee", fields: [assigneeUserId], references: [id])
  parent        Request?              @relation("RequestTree", fields: [parentRequestId], references: [id])
  children      Request[]             @relation("RequestTree")
  attachments   RequestAttachment[]
  events        RequestEvent[]
  comments      RequestComment[]
  returnReasons RequestReturnReason[]
  approvalCases ApprovalCase[]
  slaClock      SlaClock?
  flowVersion   RequestFlowVersion?   @relation(fields: [flowVersionId], references: [id])
  stepRuns      RequestStepRun[]

  @@index([companyId, status])
  @@index([companyId, requesterId])
  /// The receiver's queue — "what is waiting for me to accept".
  @@index([companyId, receiverUserId, status])
  /// A team's queue — "what has been sent to us".
  @@index([companyId, receiverOrgUnitId, status])
  @@index([companyId, assigneeUserId, status])
  /// Counting a parent's open children on every complete.
  @@index([parentRequestId])
  /// "Everything under this request", for the สายคำขอ panel.
  @@index([ancestorIds], type: Gin)
  @@index([companyId, requesterOrgUnitId])
  @@index([companyId, dueAt])
  @@index([refType, refId])
  @@map("requests")
}

/// The steps a request of one type walks inside `in_progress`, per company.
/// Immutable once published; an edit publishes the next version.
model RequestFlowVersion {
  id            String   @id @default(uuid())
  companyId     String
  requestTypeId String
  version       Int
  publishedAt   DateTime @default(now())
  publishedBy   String?
  /// 1: steps inside in_progress only. 2: steps cover the whole lifecycle, each under a status scope.
  schemaVersion Int      @default(1)

  company     Company                 @relation(fields: [companyId], references: [id])
  requestType RequestType             @relation(fields: [requestTypeId], references: [id])
  steps       RequestFlowStep[]
  transitions RequestFlowTransition[]
  requests    Request[]

  @@unique([companyId, requestTypeId, version])
  @@map("request_flow_versions")
}

model RequestFlowStep {
  id               String        @id @default(uuid())
  flowVersionId    String
  code             String
  name             String
  sortOrder        Int
  /// JSON Schema answered before leaving the step; null asks nothing.
  formSchema       Json?
  /// [{ code, required }] — child types raised in this step.
  subRequestTypes  Json          @default("[]")
  /// Leaving the step opens a case on `request:<TYPE>:step:<CODE>`.
  requiresApproval Boolean       @default(false)
  /// { type: "keep" | "requester" | "user", userId? } applied on entry.
  assigneeRule     Json?
  slaHours         Int?
  /// v2: the status this step sits under; who holds it follows from the scope.
  scopeStatus      RequestStatus @default(in_progress)
  /// v2 work steps: who receives on entry { type: "keep" | "receiver" | "user" | "step", userId?, stepCode? }.
  receiverRule     Json?
  /// v2 approval steps: where a send-back goes.
  returnToStepCode String?
  /// v2 approval steps: the ladder, levels as in `ApprovalMatrix.levels` plus `chartOf`.
  approvalLevels   Json?
  /// v2 requester steps: [{ code, name, required }] attachments that block leaving.
  requiredDocs     Json          @default("[]")

  flowVersion RequestFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)

  @@unique([flowVersionId, code])
  @@map("request_flow_steps")
}

/// A way out of a step. Forward exits are tried in `sortOrder`; the first
/// whose `condition` holds wins, so the last forward exit carries none.
model RequestFlowTransition {
  id            String  @id @default(uuid())
  flowVersionId String
  fromStepCode  String
  toStepCode    String
  sortOrder     Int
  /// { field, op, value } over the request's answers; null always holds.
  condition     Json?
  backward      Boolean @default(false)

  flowVersion RequestFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)

  @@index([flowVersionId, fromStepCode])
  @@map("request_flow_transitions")
}

/// One stay of a request in one step — what the stepper and step reports read.
model RequestStepRun {
  id        String    @id @default(uuid())
  requestId String
  stepCode  String
  enteredAt DateTime  @default(now())
  enteredBy String?
  /// Who held the step when it was left — what a "same person as step X" rule reads.
  heldBy    String?
  leftAt    DateTime?
  /// forward | backward | completed | cancelled
  outcome   String?

  request Request @relation(fields: [requestId], references: [id])

  @@index([requestId, enteredAt])
  @@map("request_step_runs")
}

/// A note somebody left on a request (H2.2).
///
/// Separate from `RequestEvent` because the two answer different questions: an
/// event is something the system recorded happening, a comment is something a
/// person chose to say. They are drawn on one timeline, in time order, which is
/// how the people on a request read them — but merging them into one table
/// would mean either events with an author who did not write them, or comments
/// that pretend to be state changes.
///
/// Append-only, like the audit log: no update path, no delete path, no route
/// that reaches one. What was said on a request is part of its history.
model RequestComment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_comments")
}

model RequestAttachment {
  id        String  @id @default(uuid())
  requestId String
  /// Matches a code in RequestType.requiredDocs, or null for extra files.
  docCode   String?

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedById String
  uploadedAt   DateTime  @default(now())
  /// Soft delete — draft/returned only; the row survives for the audit trail.
  deletedAt    DateTime?

  request    Request @relation(fields: [requestId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@map("request_attachments")
}

/// REQ-04: return reasons are picked from a standard list, not free text, so
/// "why do requests bounce" is a reportable question.
model RequestReturnReason {
  id        String   @id @default(uuid())
  requestId String
  eventId   String?
  code      String
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  request Request       @relation(fields: [requestId], references: [id])
  event   RequestEvent? @relation(fields: [eventId], references: [id])

  @@index([requestId])
  @@index([code])
  @@map("request_return_reasons")
}

/// REQ-07: the append-only timeline. No update or delete path exists for these
/// rows — that is the acceptance criterion, not an implementation detail.
model RequestEvent {
  id        String @id @default(uuid())
  requestId String
  seq       Int

  type       String
  actorId    String?
  /// Set when the actor is the system (escalation, auto-transition).
  actorLabel String?

  fromStatus RequestStatus?
  toStatus   RequestStatus?
  data       Json?

  createdAt DateTime @default(now())

  request       Request               @relation(fields: [requestId], references: [id])
  actor         User?                 @relation(fields: [actorId], references: [id])
  returnReasons RequestReturnReason[]

  @@unique([requestId, seq])
  @@index([requestId, createdAt])
  @@map("request_events")
}

/// D-02/D-19 + REQ-02: the number format is configuration per company and
/// document type, e.g. `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}`.
model DocNumberConfig {
  id         String  @id @default(uuid())
  companyId  String
  typeCode   String
  /// `REQ-OSD-PS01-26090001`. `{YYYYMM}` is still understood, for rows an
  /// administrator set to the older `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}` form.
  pattern    String  @default("REQ-{PREFIX}-{TYPE}-{YYMM}{SEQ}")
  seqPadding Int     @default(4)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode])
  @@map("doc_number_configs")
}

/// The sequence itself, reset every month. Incremented inside the submit
/// transaction under a row lock — this is what makes 50 concurrent submits
/// produce 50 distinct numbers (REQ-02, NFR-03).
model DocNumberCounter {
  id        String @id @default(uuid())
  companyId String
  typeCode  String
  /// `YYYYMM`, e.g. 202608.
  yearMonth Int
  lastSeq   Int    @default(0)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode, yearMonth])
  @@map("doc_number_counters")
}

// ---------------------------------------------------------------------------
// Run number  (เลขรันทุกชนิดเอกสาร — run-number-service เท่านั้นที่แตะสองตารางนี้)
// ---------------------------------------------------------------------------

/// รูปแบบเลขรันต่อบริษัทต่อชนิดเอกสาร แก้ได้จากหน้าตั้งค่าโดยไม่ deploy.
///
/// §03: เจ้าของตารางนี้คือ `run-number-service` — service อื่นออกเลขผ่าน
/// `POST internal/run-numbers/issue` ห้าม query ตรง. `doc_number_configs` และ
/// `crm_company_configs.codePrefix/codePadding` คือที่เก่าของข้อมูลนี้ ยังไม่ถูกลบ
/// (ดู docs/run-number.md).
model RunNumberSetting {
  id        String @id @default(uuid())
  companyId String
  /// `REQUEST` | `CUSTOMER` | `OPPORTUNITY` | `SALE_ORDER` | `QUOTATION`
  docType   String
  /// แยกรูปแบบย่อยในชนิดเดียวกัน — `typeCode` ของคำขอ, หรือ `*` = ใช้กับทุกตัว
  scopeKey  String @default("*")

  /// เช่น `REQ-{COMPANY_PREFIX}-{M:REQUEST_TYPE}-{BYY}{MM}{SEQ}`
  pattern     String
  seqPadding  Int                  @default(4)
  startNumber Int                  @default(1)
  resetPeriod RunNumberResetPeriod @default(none)
  active      Boolean              @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, docType, scopeKey])
  @@index([companyId, docType])
  @@map("run_number_settings")
}

/// ลำดับเลขเอง หนึ่งแถวต่อหนึ่งช่วงรีเซ็ต.
///
/// **ไม่มี FK ไป `RunNumberSetting` โดยตั้งใจ** — ถ้าผูกไว้ การลบ setting แล้วสร้าง
/// ใหม่จะพาลำดับกลับไปเริ่มที่ 1 แล้วออกเลขซ้ำกับเอกสารที่ส่งออกไปแล้ว (NFR-03).
model RunNumberCounter {
  id        String @id @default(uuid())
  companyId String
  docType   String
  scopeKey  String
  /// `-` (ไม่รีเซ็ต) | `2026` | `202609` | `20260922`
  periodKey String
  lastSeq   Int    @default(0)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, docType, scopeKey, periodKey])
  @@map("run_number_counters")
}

// ---------------------------------------------------------------------------
// Approval  (D-31: a central service, callable without a Platform Request)
// ---------------------------------------------------------------------------

/// APV-01. Published versions are immutable — a change is a new version with
/// its own effective date, so a running case keeps the rules it started under
/// (D-18: each company has its own set).
model ApprovalMatrix {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  currency    String @default("THB")
  version     Int

  /// **Superseded by `levels` (31 Aug 2026).** Kept so versions published
  /// before that date still read, and so the cases routed under them can still
  /// be explained: `[{ upto: "100000.00" | null, chain: ["team_lead","cfo"] }]`
  /// ordered by ceiling ascending, `upto: null` being the top tier.
  tiers Json

  /// The approval ladder, one entry per level, in order.
  ///
  /// ```jsonc
  /// [ { "type": "supervisor", "up": 1 },
  ///   { "type": "org", "orgUnitIds": ["…"], "userIds": ["…"] } ]
  /// ```
  ///
  /// `supervisor.up` counts levels of the chart above the requester: 1 is the
  /// head of the group they sit in, 2 the department, and so on. `org` names
  /// groups; with `userIds` those people approve, without it the groups' heads
  /// do. Either way a level may resolve to **several** people, any one of whom
  /// can decide — see `ApprovalStep.candidateUserIds`.
  ///
  /// Null on a version published before the change, which is what makes this a
  /// new column rather than a rewrite of `tiers`: nothing already published is
  /// migrated, and a case in flight keeps the ladder it was routed under
  /// (§7 — running work keeps the rules it started under).
  levels Json?

  /// CD-80 — a version that ends the ladder: from its `effectiveFrom` the
  /// subject has **no** approval stage (DSC moving from after-work to
  /// before-work retires `request:DSC`). A new version, not an edit, so every
  /// published version stays as it was and cases in flight keep theirs;
  /// publishing a later ordinary version turns the stage back on.
  retired Boolean @default(false)

  effectiveFrom DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  createdBy     String?

  company Company        @relation(fields: [companyId], references: [id])
  cases   ApprovalCase[]

  @@unique([companyId, subjectType, version])
  @@index([companyId, subjectType, effectiveFrom])
  @@map("approval_matrices")
}

/// One thing awaiting approval. `subjectType`/`subjectId` keep this generic:
/// APV-07 lets any module raise a case without creating a Request.
model ApprovalCase {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  subjectId   String

  /// Null for subjects with no monetary dimension (e.g. lead handover).
  amount   Decimal? @db.Decimal(18, 2)
  currency String?

  /// APV-05: hash of the approved payload. A material edit voids approvals.
  snapshotHash    String
  snapshotVersion Int    @default(1)

  matrixId      String?
  matrixVersion Int?

  status      ApprovalCaseStatus @default(pending)
  currentStep Int                @default(1)

  /// APV-07: event name published when the outcome lands.
  callbackEvent String?
  payload       Json?

  requestId String?

  createdAt DateTime  @default(now())
  createdBy String?
  decidedAt DateTime?

  company Company         @relation(fields: [companyId], references: [id])
  matrix  ApprovalMatrix? @relation(fields: [matrixId], references: [id])
  request Request?        @relation(fields: [requestId], references: [id])
  steps   ApprovalStep[]

  @@index([companyId, status])
  @@index([subjectType, subjectId])
  @@index([requestId])
  @@map("approval_cases")
}

/// The resolved chain, frozen at submit (APV-02). Changing the matrix later
/// does not reroute a case already in flight.
model ApprovalStep {
  id     String @id @default(uuid())
  caseId String
  stepNo Int

  /// Position in the matrix chain: `team_lead`, `cfo`, `ceo`, …
  approverRole   String
  /// The person that position resolved to at submit time.
  approverUserId String?

  /// Everyone allowed to decide this step. Any one of them is enough.
  ///
  /// A level can name several people — the heads of two groups, or a list
  /// chosen on screen A1 — and `approverUserId` holds only the first, for
  /// display and for the cases routed before this column existed.
  /// `authorise` reads this; `decidedByUserId` records who actually acted.
  candidateUserIds String[] @default([])

  status   ApprovalStepStatus @default(waiting)
  decision ApprovalDecision?
  note     String?

  /// APV-03: set when someone decided under a delegation — the history shows
  /// both names, never just the delegate's.
  decidedByUserId String?
  delegationId    String?

  dueAt     DateTime?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  /// Copied from the matrix level at open, so a republished ladder cannot re-judge it.
  /// `any`: one candidate decides; `all`: every candidate must approve.
  mode            String  @default("any")
  /// `always` | `reject_or_return` — when a decision must carry a note.
  noteRequired    String  @default("always")
  slaHours        Int?
  /// How many escalation tiers have fired for this step's own deadline.
  escalationLevel Int     @default(0)
  /// Why a `skipped` step was never asked: `condition` or `same_approver`.
  skipReason      String?

  votes ApprovalVote[]

  case       ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approver   User?        @relation("StepApprover", fields: [approverUserId], references: [id])
  decidedBy  User?        @relation("StepDecider", fields: [decidedByUserId], references: [id])
  delegation Delegation?  @relation(fields: [delegationId], references: [id])

  @@unique([caseId, stepNo])
  @@index([candidateUserIds], type: Gin)
  @@index([approverUserId, status])
  @@map("approval_steps")
}

/// One candidate's decision on a step; an `all` step closes when every candidate approved.
model ApprovalVote {
  id           String           @id @default(uuid())
  stepId       String
  /// The candidate this vote counts for (the delegator when cast under a delegation).
  userId       String
  decidedBy    String
  delegationId String?
  decision     ApprovalDecision
  note         String?
  decidedAt    DateTime         @default(now())

  step ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
  @@map("approval_votes")
}

/// APV-03: temporary hand-over of approval authority. Sub-delegation is
/// rejected, and overlapping windows for the same delegator are rejected.
model Delegation {
  id              String   @id @default(uuid())
  companyId       String
  delegatorUserId String
  delegateUserId  String
  fromDate        DateTime
  toDate          DateTime
  note            String?
  active          Boolean  @default(true)

  createdAt DateTime  @default(now())
  createdBy String?
  revokedAt DateTime?

  company   Company        @relation(fields: [companyId], references: [id])
  delegator User           @relation("Delegator", fields: [delegatorUserId], references: [id])
  delegate  User           @relation("Delegate", fields: [delegateUserId], references: [id])
  steps     ApprovalStep[]

  @@index([companyId, delegatorUserId, fromDate, toDate])
  @@map("delegations")
}

// ---------------------------------------------------------------------------
// Support  (SLA / notification / audit — minimum viable per §09)
// ---------------------------------------------------------------------------

/// D-09/SUP-01: SLA is configuration, never hardcoded.
model SlaConfig {
  id               String      @id @default(uuid())
  companyId        String
  requestTypeCode  String
  hours            Int
  coverage         SlaCoverage @default(H24X7)
  warnBeforeHours  Int         @default(4)
  /// Overdue tiers as % of the budget; each notifies one level further up.
  escalatePercents Int[]       @default([100, 150])

  /// CD-67 — เป้าเวลาตามระดับความรุนแรง `{ critical: { responseHours, resolutionHours }, … }`
  /// (ชั่วโมงตาม coverage เดียวกับ `hours`). NULL = ประเภทนี้ไม่ใช่เคส ใช้ `hours` ตามเดิม.
  severityTargets Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, requestTypeCode])
  @@map("sla_configs")
}

/// SUP-01: the clock stops while a request sits returned with the requester,
/// so the elapsed time reported in REQ-09 is time the request was actually
/// somebody's to act on.
model SlaClock {
  id        String @id @default(uuid())
  requestId String @unique

  startedAt       DateTime
  pausedAt        DateTime?
  accumulatedMs   Int       @default(0)
  dueAt           DateTime
  state           SlaState  @default(running)
  warnedAt        DateTime?
  breachedAt      DateTime?
  escalatedAt     DateTime?
  /// Overdue tiers already fired (`SlaConfig.escalatePercents`); 0 = none.
  escalationLevel Int       @default(0)

  /// CD-67 — นาฬิกาเวลาตอบกลับ แยกจากเวลาแก้ไข (`dueAt`). มีเฉพาะคำขอประเภทเคส.
  /// ตอบกลับ = ทีมผู้รับรับเรื่อง มอบหมาย หรือคอมเมนต์ครั้งแรก (ไม่นับผู้ยื่น).
  responseDueAt      DateTime?
  respondedAt        DateTime?
  responseBreachedAt DateTime?

  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id])

  @@index([state, dueAt])
  @@index([respondedAt, responseDueAt])
  @@map("sla_clocks")
}

/// One working-hours + holiday set per company for this sprint; shifts and
/// multiple calendars are explicitly out of scope (§09).
model HolidayCalendar {
  id        String @id @default(uuid())
  companyId String @unique
  name      String @default("default")

  /// Minutes from midnight, e.g. 510 = 08:30.
  workdayStartMinute Int   @default(510)
  workdayEndMinute   Int   @default(1050)
  /// ISO weekday numbers that are working days (1 = Monday).
  workingWeekdays    Int[] @default([1, 2, 3, 4, 5])
  /// ["2026-01-01", …]
  holidays           Json  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("holiday_calendars")
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  companyId String

  eventType String
  title     String
  body      String

  resourceType String?
  resourceId   String?

  /// The FIRST time it was read — never overwritten (CD-55 evidence).
  readAt  DateTime?
  readVia NotificationReadVia?

  /// CD-52 — the recipient chose a daily digest for this kind of event: the
  /// row exists (and is logged) but stays out of the bell until the digest.
  heldForDigest Boolean @default(false)
  /// The digest notification that carried it; null while still held.
  digestId      String?

  createdAt DateTime @default(now())

  user       User                      @relation(fields: [userId], references: [id])
  company    Company                   @relation(fields: [companyId], references: [id])
  deliveries NotificationDeliveryLog[]

  @@index([userId, readAt])
  @@index([companyId, createdAt])
  @@index([heldForDigest, digestId])
  @@map("notifications")
}

/// SUP-03: which optional channels a person wants, per company.
///
/// In-app delivery is deliberately **not** representable here — §09 makes it
/// mandatory, because a request that nobody can be told about is a request
/// that silently misses its SLA. Only email is a choice, and while SMTP is
/// unresolved (open question B) the value is recorded and honoured by nothing.
model NotificationPreference {
  id        String @id @default(uuid())
  userId    String
  companyId String

  emailEnabled Boolean @default(true)
  /// CD-51 — Teams master switch (the channel exists only when TEAMS_MODE is set).
  teamsEnabled Boolean @default(true)

  /// CD-52 — per category `{ approval: { email: true, frequency: "daily" }, … }`;
  /// a category not listed is email on, immediate.
  categorySettings Json?
  /// Hour (Bangkok, 0–23) the daily digest goes out on working days.
  digestHour       Int     @default(8)
  /// `YYYY-MM-DD` of the last digest sent — the once-a-day claim.
  lastDigestDate   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("notification_preferences")
}

/// CD-54 — a company's own wording for one event. No row = the standard
/// wording declared in code (`notification-templates.ts`); deleting the row
/// is "reset to standard". `{{name}}` placeholders are checked on save.
model NotificationTemplate {
  id        String @id @default(uuid())
  companyId String
  eventType String
  title     String
  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, eventType])
  @@map("notification_templates")
}

/// CD-53 — a company's setting for one reminder rule (contract renewal, overdue
/// invoice, KYC expiry, quiet deal). The rules and their standard values are
/// declared in code (`notification-rules.ts`); no row = the standard. Params
/// are checked against that catalog on save.
model NotificationRule {
  id        String  @id @default(uuid())
  companyId String
  code      String
  enabled   Boolean @default(true)
  params    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("notification_rules")
}

/// CD-53 — one row per (invoice, step) already told to the customer's owner,
/// so each overdue step is sent once. Invoices live in SAP; `docNo` is B1's.
model InvoiceOverdueAlert {
  id         String   @id @default(uuid())
  companyId  String
  customerId String
  docNo      String
  /// The rule step reached — days past the due date.
  step       Int
  dueOn      DateTime @db.Date
  alertedAt  DateTime @default(now())

  @@unique([customerId, docNo, step])
  @@index([companyId])
  @@map("invoice_overdue_alerts")
}

/// SUP-03: every send is logged, which is what settles "I never got notified".
model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  target         String
  status         DeliveryStatus      @default(queued)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  /// CD-51 — channels sent by the background worker (Teams): tries so far,
  /// and not before when the next one may run (backoff, and the claim lease).
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status, nextAttemptAt])
  @@map("notification_delivery_logs")
}

/// CD-51 — a person's 1:1 chat with the Teams bot, found once and reused:
/// their Microsoft 365 object id and the Bot Framework conversation id.
model TeamsChatLink {
  userId         String   @id
  aadObjectId    String
  conversationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("teams_chat_links")
}

/// SUP-04: one append-only log for permission changes, status transitions,
/// approvals, sensitive-field reads, and admin configuration. There is no API
/// that updates or deletes a row here, by design.
model AuditLog {
  id        String  @id @default(uuid())
  companyId String?

  actorId       String?
  actorUsername String?

  eventType    String
  resourceType String?
  resourceId   String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  actor   User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// CD-92 v2: BI dashboards are configuration rows, not env constants — an
/// admin adds or retires dashboards and scopes each to org units without a
/// deploy (configuration over code). `active` is the soft-delete flag; a
/// retired dashboard stays findable, per the no-hard-delete rule.
model BiDashboard {
  id                  String  @id @default(uuid())
  companyId           String
  title               String
  /// The numeric id Metabase shows in the dashboard URL.
  metabaseDashboardId Int
  sortOrder           Int     @default(0)
  active              Boolean @default(true)
  /// CD-92 — sign the embed with the viewer's company as a locked `company`
  /// parameter, so a dashboard over the Data Mart shows only that company's
  /// rows. The dashboard must declare the parameter (see docs/metabase.md);
  /// one that does not would reject the token, hence off by default.
  lockCompany         Boolean @default(false)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company   Company               @relation(fields: [companyId], references: [id])
  audiences BiDashboardAudience[]

  @@index([companyId])
  @@map("bi_dashboards")
}

/// Which org units may see a dashboard. No rows = the whole company sees it.
/// An assigned unit covers its entire subtree (`OrgClosure`), so a department
/// row includes every team beneath it — the same maths as data scope (§6.2).
model BiDashboardAudience {
  dashboardId String
  orgUnitId   String

  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([dashboardId, orgUnitId])
  @@index([orgUnitId])
  @@map("bi_dashboard_audiences")
}

/// NFR-03: replay protection for state-changing POSTs carrying an
/// `Idempotency-Key`.
model IdempotencyKey {
  key         String   @id
  requestHash String
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// AUTH-06 — a credential an integration holds instead of fetching a Keycloak
/// token before every burst of calls.
///
/// The key is **not** a token and is never presented to user-service: core-
/// service exchanges it for a real client-credentials token and forwards that,
/// so token verification stays in one place (§03) and every downstream rule is
/// unchanged.
///
/// Only the hash is stored. A key is shown once, at issue, and is
/// unrecoverable afterwards — a database dump does not yield a working
/// credential.
model ApiKey {
  id      String @id @default(uuid())
  /// Who holds it, in words a person can act on: "Aiyara chatbot (prod)".
  name    String
  /// The first characters of the key, so a key can be named in a ticket or a
  /// log without quoting the secret. Display only — lookup is by hash.
  prefix  String @unique
  /// sha256 of the whole key. Unique, and the only thing looked up.
  keyHash String @unique

  active    Boolean   @default(true)
  /// Null means it never expires — the property this table exists to provide.
  ///
  /// Revocation, not expiry, is how such a key is taken away, and it takes
  /// effect on the very next request: the key is read from this table before
  /// the 60-second principal cache is consulted, so nothing cached can keep a
  /// revoked key working. The migration comment beside this table says
  /// "within the 60-second principal cache" — it was written before that was
  /// measured, and is left as-is because editing an applied migration changes
  /// its checksum.
  expiresAt DateTime?

  /// บริษัทที่ key นี้ทำงานแทน (14 ก.ย. 2569).
  ///
  /// ย้ายมาไว้ที่ key เพราะช่องทางภายนอก — เว็บฟอร์ม, LINE OA — ยิงเข้ามาโดยไม่มี
  /// คนคอยใส่ header ให้ และ `X-Company-Id` ที่ผู้เรียกกรอกเองคือช่องที่กรอกผิด
  /// แล้วข้อมูลไปโผล่ผิดบริษัท. ตั้งที่นี่ = ผู้ถือ key เลือกไม่ได้.
  ///
  /// NULL = key แบบเดิมที่ผู้เรียกต้องส่ง `X-Company-Id` เอง (chatbot ซึ่งทำงาน
  /// ให้หลายบริษัทผ่าน key ใบเดียว) — ยังใช้ได้เหมือนเดิมทุกประการ.
  companyId String?

  /// ช่องทางที่ key ใบนี้ *เป็น* — `website`, `line-oa`, `event-2026-q4`.
  ///
  /// หนึ่ง key ต่อหนึ่งช่องทาง คือเหตุผลที่คอลัมน์นี้อยู่ตรงนี้: แหล่งที่มาของ
  /// Lead เป็นข้อเท็จจริงที่ *กุญแจ* รู้ ไม่ใช่ค่าที่ผู้เรียกพิมพ์มาใน body
  /// ซึ่งพิมพ์ผิดได้ พิมพ์ปลอมได้ และพอตัวเลขการตลาดผิดก็ไล่ไม่ได้ว่าใบไหนมาจากไหน.
  sourceCode String?

  /// สิทธิ์ที่ key ใบนี้ใช้ได้ — ตัดจากสิทธิ์ที่บัญชีบริการถืออยู่ ไม่ใช่เพิ่มให้.
  ///
  /// ว่าง = ไม่จำกัด คือ key เดิมทุกใบก่อน 14 ก.ย. 2569 ซึ่งได้สิทธิ์เต็มชุดของ
  /// integration client ตามเดิม. ใส่ค่า = key ใบนั้นทำได้เท่าที่ระบุ เช่น key ของ
  /// เว็บฟอร์มถือแค่ `integration.crm.lead.create` — หลุดออกไปก็เปิด Lead ได้
  /// อย่างเดียว อ่านคำขอของบริษัทไม่ได้.
  ///
  /// **ตัดอย่างเดียว ไม่เคยเพิ่ม** — คำตอบว่า "ทำอะไรได้" ยังมาจาก role ของ
  /// บัญชีบริการที่เดียวเหมือนเดิม (ดู `ApiKeyService`); คอลัมน์นี้เป็น intersect
  /// ไม่ใช่แหล่งสิทธิ์ที่สอง จึงไม่มีทางที่สองที่จะขัดกัน.
  scopes String[] @default([])

  /// Written at most once a minute, not on every call: an audit trail worth
  /// having, not a write amplifier on the hot path.
  lastUsedAt DateTime?

  revokedAt DateTime?
  revokedBy String?

  createdBy String
  createdAt DateTime @default(now())

  @@index([active])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// CRM — Customer Master (CM-xx) + มุมมอง 360° (C360-xx)
// Spec: artifact 856c08fd (8 ก.ย. 2569). One customer registry for every
// module and for SAP — no module may keep its own (D-30).
// ---------------------------------------------------------------------------

/// CM-01/02/04 — the single customer registry.
///
/// `customerCode` is issued by THIS system (PO decision #1, 8 ก.ย. 2569):
/// SAP receives it and answers with its Business Partner number, stored in
/// `CustomerExternalCode` — never the other way round.
///
/// No hard delete: `inactive` + `deactivateReason` is the only way out, and a
/// deactivated customer still blocks its tax id (CM-03) — the duplicate rule
/// points at the existing row so it can be reactivated instead of recreated.
model Customer {
  id String @id @default(uuid())

  /// Issued atomically at create (CM-02) — unique across the whole database,
  /// like `Request.requestNo`, because SAP and 7 accounting systems key on it.
  customerCode String @unique

  companyId String
  type      CustomerType

  nameTh String
  nameEn String?

  /// `nameTh` with the legal-form prefixes (บจก./บมจ./หจก./…) and whitespace
  /// stripped — written on every create/update so the CM-03 similarity check
  /// is a column comparison, not a per-row computation at query time.
  normalizedName String

  /// เลขผู้เสียภาษี 13 หลัก, checksum-validated at the API (CM-01). Optional:
  /// a walk-in individual may not have provided one yet.
  taxId String?

  /// รหัสสาขาสรรพากร 5 หลัก. `00000` = สำนักงานใหญ่ (redesign #2, 8 ก.ย. 2569:
  /// the PO wants each branch to BE a customer row — separate opportunities, separate
  /// billing identity — not a child record under one customer).
  branchCode String @default("00000")

  /// ชื่อสาขาเพื่อการแสดงผล เช่น "สาขาราชวงศ์" — the legal name (`nameTh`)
  /// is identical across an entity's branches, this is what tells them apart.
  branchName String?

  /// สาขาผูกกับรายหลัก (สำนักงานใหญ่) อัตโนมัติด้วยเลขภาษีตอนสร้าง — the HQ
  /// page lists its branches through this, and the future 360° rollup sums
  /// across it. NULL = รายหลักเอง หรือรายเดี่ยวที่ไม่มีเครือ.
  headOfficeId String?

  status CustomerStatus @default(draft)

  /// CD-62 — ผลการขออนุมัติเปิดลูกค้าใหม่ และคำขอล่าสุดที่ใช้ขอ.
  approvalStatus    CustomerApprovalStatus @default(approved)
  approvalRequestId String?

  /// CM-04: set by the KYC request callback (ชุดงาน B), never directly by a
  /// screen. A customer is usable without it until a KYC-flagged product
  /// enters a opportunity.
  kycVerified   Boolean       @default(false)
  kycVerifiedAt DateTime?
  /// CD-61 — copied from the latest verified KYC record, so lists and the
  /// expiry sweep read a column rather than joining.
  kycRiskLevel  KycRiskLevel?
  /// CD-61 — the earlier of the review date and the first document expiry.
  kycExpiresOn  DateTime?     @db.Date

  /// CM-01/08 — ผู้รับผิดชอบบัญชี. Scope pivots on this and on
  /// `ownerOrgUnitId` below.
  accountOwnerUserId String?

  /// Where the account owner sat when assigned — a snapshot column with no FK,
  /// exactly like `Request.requesterOrgUnitId`: team visibility must not be
  /// rewritten by a later org-chart edit.
  ownerOrgUnitId String?

  deactivatedAt    DateTime?
  deactivateReason String?
  suspendReason    String?

  /// CM-09 / CD-122 (ทำแล้ว 29 ก.ย. 2569, `CustomerMergeService`): when a
  /// duplicate slips through and is later merged, the losing row stays as an
  /// alias pointing at the survivor. Lookups by the old code follow this.
  mergedIntoCustomerId String?
  mergedAt             DateTime?

  /// CM-03: a similar-name warning that was overridden records who confirmed
  /// and why — beside the audit row, so the fact travels with the customer.
  dedupOverrideReason String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company         Company    @relation(fields: [companyId], references: [id])
  accountOwner    User?      @relation("CustomerAccountOwner", fields: [accountOwnerUserId], references: [id])
  mergedInto      Customer?  @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id])
  aliases         Customer[] @relation("CustomerMerge")
  headOffice      Customer?  @relation("CustomerHeadOffice", fields: [headOfficeId], references: [id])
  branchCustomers Customer[] @relation("CustomerHeadOffice")

  leads          Lead[]
  opportunities  Opportunity[]
  saleOrders     SaleOrder[]
  quotations     Quotation[]
  locations      CustomerLocation[]
  contacts       CustomerContact[]
  externalCodes  CustomerExternalCode[]
  fieldChanges   CustomerFieldChange[]
  segments       CustomerSegmentAssignment[]
  timelineEvents CustomerTimelineEvent[]

  /// CM-03 hard block — the same juristic person appears once PER BRANCH
  /// (redesign #2: a branch is its own customer row, linked to the head
  /// office by `headOfficeId`). Postgres treats NULL tax ids as distinct, so
  /// customers without one never collide here.
  /// CD-61 every KYC verification of this customer, newest last.
  kycRecords  CustomerKycRecord[]
  /// CD-70 the customer's contracts (renewals are raised from their end date).
  contracts   CustomerContract[]
  /// CD-86 Keeper — แผนบัญชี และการติดต่อ/ทบทวน.
  accountPlan CustomerAccountPlan?
  touchpoints CustomerTouchpoint[]

  @@unique([companyId, taxId, branchCode])
  @@index([companyId, headOfficeId])
  @@index([companyId, status])
  @@index([companyId, accountOwnerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([companyId, normalizedName])
  @@map("customers")
}

/// CM-01 — ที่อยู่/ไซต์ของลูกค้ารายนั้น (redesign #2, 8 ก.ย. 2569: branches
/// became customer rows, so this table holds LOCATIONS — the addresses and
/// installation sites of one branch-customer). A branch-customer usually has
/// one billing address and any number of sites (a rented warehouse, a
/// customer's server room):
///
///   - `isBilling` — this address goes on the tax invoice of THIS customer.
///   - `isSite` — จุดติดตั้ง/รับของ. Both may be true on one row.
///
/// Installed-base rows (Service & Support, a later phase) will FK here, which
/// is why retirement is `active=false`, never delete: an asset's site and an
/// issued invoice's address must stay resolvable.
model CustomerLocation {
  id         String @id @default(uuid())
  customerId String

  /// ชื่อที่อยู่/ไซต์ — "สำนักงาน", "ไซต์โรงงานบางปู", "ห้องเซิร์ฟเวอร์ชั้น 3".
  name String?

  line1       String
  line2       String?
  subDistrict String?
  district    String?
  province    String?
  postalCode  String?
  country     String  @default("TH")

  /// ใช้ออกใบกำกับของลูกค้ารายนี้.
  isBilling Boolean @default(false)
  /// เป็นจุดติดตั้ง/รับของ.
  isSite    Boolean @default(true)
  /// ที่อยู่หลัก — the default pick on documents.
  isPrimary Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_locations")
}

/// CM-05 — ผู้ติดต่อ. Consent status is deliberately ABSENT: it is read live
/// from the central PDPA service and rendered as a badge, never copied here
/// (spec: "ห้ามเก็บซ้ำในตาราง contact").
model CustomerContact {
  id         String              @id @default(uuid())
  customerId String
  name       String
  role       CustomerContactRole @default(other)
  position   String?

  phone  String?
  email  String?
  lineId String?
  note   String?

  isPrimary Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_contacts")
}

/// CM-02 — รหัสภายนอก: `system` = `sap` for the BP number, plus the 7
/// accounting-line systems (D-30). `payload` keeps whatever else the external
/// system answered at create (PO decision #1) so nothing is lost to a
/// narrower column later.
model CustomerExternalCode {
  id           String @id @default(uuid())
  customerId   String
  system       String
  externalCode String
  payload      Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, system])
  @@index([system, externalCode])
  @@map("customer_external_codes")
}

/// CM-01 AC — "แก้ field ใดเก็บประวัติ ใคร–เมื่อไร–ค่าก่อน/หลัง". Append-only,
/// one row per changed field per edit, written in the same transaction as the
/// update. Kept beside (not instead of) the shared audit log: this one is the
/// per-customer history tab, queryable by field.
model CustomerFieldChange {
  id         String @id @default(uuid())
  customerId String
  field      String
  before     Json?
  after      Json?

  changedBy String?
  changedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, changedAt])
  @@map("customer_field_changes")
}

/// CM-07 — segmentation dimensions (ประเภท ขนาด อุตสาหกรรม ศักยภาพ …) are
/// rows, not code: adding the 5th dimension is an insert from the admin
/// screen, the same rule that governs request types (REQ-01 / D-09).
model CustomerSegmentDimension {
  id        String  @id @default(uuid())
  companyId String
  code      String
  nameTh    String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company                @relation(fields: [companyId], references: [id])
  values  CustomerSegmentValue[]

  @@unique([companyId, code])
  @@map("customer_segment_dimensions")
}

model CustomerSegmentValue {
  id          String  @id @default(uuid())
  dimensionId String
  code        String
  nameTh      String
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  dimension   CustomerSegmentDimension    @relation(fields: [dimensionId], references: [id])
  assignments CustomerSegmentAssignment[]

  @@unique([dimensionId, code])
  @@map("customer_segment_values")
}

/// Which segments a customer sits in. Several dimensions at once (CM-07 AC),
/// keyed so Pricing (ระยะ 2) can query "customers in value X" as one indexed
/// lookup.
model CustomerSegmentAssignment {
  customerId String
  valueId    String

  assignedAt DateTime @default(now())
  assignedBy String?

  customer Customer             @relation(fields: [customerId], references: [id])
  value    CustomerSegmentValue @relation(fields: [valueId], references: [id])

  @@id([customerId, valueId])
  @@index([valueId])
  @@map("customer_segment_assignments")
}

/// CM-02 — one continuously increasing counter per company, bumped by the
/// same single-statement upsert as `DocNumberCounter`. No monthly reset: a
/// customer code is permanent and 7 external systems key on it.
model CustomerCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("customer_code_counters")
}

/// Per-company CRM configuration, editable from the admin screen without a
/// deploy: the customer-code shape (CM-02 AC) and the similar-name threshold
/// (CM-03, PO decision #4 — "ระดับความคล้ายเป็นค่า config จูนได้").
model CrmCompanyConfig {
  id        String @id @default(uuid())
  companyId String @unique

  /// Code prefix, e.g. `CUS`. The company's `docPrefix` is appended by the
  /// pattern, so OSD gets `CUS-OSD-000001`.
  codePrefix  String @default("CUS")
  codePadding Int    @default(6)

  /// 0..1 — Dice-coefficient threshold above which two normalized names are
  /// reported as "similar" by check-duplicate.
  dedupThreshold Float @default(0.85)

  /// CD-76: margin ขั้นต่ำ (%) ของใบเสนอราคา — ต่ำกว่านี้ต้องผ่านคำขออนุมัติก่อนส่ง
  /// ลูกค้า. ตั้งค่าได้แทนการรอเกณฑ์จาก CD-26 (ยังไม่ยืนยัน).
  minMarginPct              Float  @default(15)
  /// จำนวนวันที่ใบเสนอราคาใหม่มีผล — ค่าตั้งต้นของ `Quotation.validUntil`.
  quotationValidityDays     Int    @default(30)
  vatPct                    Float  @default(7)
  /// CD-201 ประเภทคำขออนุมัติราคาที่ทุกใบเสนอราคายื่น — ต้องเปิดให้บริษัทนี้ใช้อยู่.
  quotationApprovalTypeCode String @default("PRA")
  /// CD-202 margin ขั้นต่ำต่อประเภทงาน {service: 20, ...} — ประเภทที่ไม่ระบุใช้ minMarginPct.
  minMarginByWorkType       Json   @default("{}")
  /// CD-206 ต้นทุนคู่ค้าจาก SAP ที่เก่ากว่านี้ (วัน) ถูกเตือนก่อนนำไปคิดราคา.
  costMaxAgeDays            Int    @default(90)

  /// CD-65: โอกาสการขายที่เปิดอยู่และไม่มีกิจกรรมเสร็จนานเกินจำนวนวันนี้ = "เงียบ"
  /// → แจ้งหัวหน้าของเจ้าของดีล. 0 = ปิดการแจ้งเตือน.
  staleOpportunityDays Int @default(14)

  /// CD-82: ประเภทคำขอที่ใช้ขออนุมัติการปรับเป้าขายระหว่างงวด (ผู้อนุมัติมาจากตาราง
  /// อำนาจอนุมัติของประเภทนั้น — ผู้อำนวยการ). NULL = ยังไม่ตั้ง → ปรับเป้าของงวดที่
  /// เริ่มแล้วไม่ได้ (ตั้งเป้างวดหน้ายังทำได้ตามปกติ).
  targetApprovalTypeCode String?

  /// CD-61 — how long a KYC stays valid before a review, by risk level.
  kycReviewMonthsHigh   Int @default(12)
  kycReviewMonthsMedium Int @default(24)
  kycReviewMonthsLow    Int @default(36)

  /// CD-81: ประเภทคำขอที่ฝ่ายกฎหมายรับทำ/แก้สัญญา — ปุ่ม "ขอจัดทำสัญญา" และการ์ด
  /// สัญญาบนหน้าดีลใช้ประเภทนี้. NULL = ยังไม่ตั้ง → หน้าดีลไม่แสดงการ์ดสัญญา.
  contractRequestTypeCode          String?
  /// CD-153 — the request type that asks executives to approve a liability
  /// cap above the contract's value (or unlimited). NULL = not set up; the
  /// contract then shows that approval is needed but could not be asked.
  liabilityApprovalRequestTypeCode String?
  /// CD-158 — the request type that asks executives for their opinion on a
  /// contract assessed high (or critical) legal risk, or with issues Legal
  /// marked for them. NULL = not set up; the card says so.
  legalRiskOpinionTypeCode         String?
  /// CD-159 — the request type that approves a contract draft version; its
  /// matrix may route on `contract_value` and `risk_level`. NULL = not set.
  contractApprovalTypeCode         String?
  /// CD-185 — the request type a project change request goes to the change
  /// board as; its matrix may route on `cost_change`, `price_change` and
  /// `margin_pct`. NULL = not set.
  projectChangeTypeCode            String?
  /// CD-191 — the request type that asks the project's executives to
  /// close a project; its matrix may route on `contract_value`. NULL = not set.
  projectCloseTypeCode             String?
  /// CD-211 — the request type a detailed design version is approved on;
  /// its matrix may route on `differs_from_solution`. NULL = not set.
  projectDesignTypeCode            String?
  /// CD-224 — the request type a technical change is approved under.
  projectTechChangeTypeCode        String?
  /// CD-180 — the request type a project asks for more people under (PM → Engineer).
  projectResourceTypeCode          String?
  /// CD-239 — the request type service work orders are raised as (a case type).
  serviceWorkOrderTypeCode         String?
  /// CD-241 — minutes the one on call has to receive an out-of-hours case
  /// before it goes to the backup; 0 = never handed on.
  serviceOnCallEscalateMinutes     Int      @default(30)
  /// CD-246 — repeated corrective jobs within this many days suggest one
  /// problem: on one unit, one model (any customer), one model at a customer.
  serviceRepeatDays                Int      @default(90)
  serviceRepeatAsset               Int      @default(3)
  serviceRepeatModel               Int      @default(5)
  serviceRepeatCustomerModel       Int      @default(3)
  /// CD-249 — the staff user a case raised in the Customer Portal is raised
  /// under (as a CD-66 channel's). NULL = the portal cannot open cases.
  servicePortalUserId              String?
  /// CD-272 — ประเภทคำขออนุมัติคอนเทนต์ · ว่าง = ส่งอนุมัติไม่ได้
  contentApprovalTypeCode String?
  /// CD-272 — true = ทุกคอนเทนต์ต้องอนุมัติ (ไม่ใช่เฉพาะที่พาดพิงลูกค้า/ราคา/คู่ค้า)
  contentApprovalAll      Boolean @default(false)
  /// CD-273 — ประเภทคำขออนุมัติไฟล์คลังแบรนด์ · ว่าง = อัปโหลดเวอร์ชันใหม่ไม่ได้
  brandApprovalTypeCode   String?
  /// CD-190 — actual cost as % of the reference budget: warn at, alert over.
  projectCostWarnPct               Int      @default(90)
  projectCostAlertPct              Int      @default(100)
  /// CD-191 — the documents every project must leave behind before it may
  /// be closed, by name; each needs a file on the close-out card.
  projectCloseDocuments            String[] @default(["ใบตรวจรับงาน", "เอกสารส่งมอบงาน"])
  /// CD-192 — the health score at which a project turns amber, and red.
  projectHealthAmber               Int      @default(20)
  projectHealthRed                 Int      @default(40)
  /// CD-225 — the readiness checklist every project starts its check from;
  /// the manager adds to or removes from it per project.
  projectReadinessChecklist        String[] @default(["หน้างานสะอาดเรียบร้อย", "ติดป้ายและฉลากอุปกรณ์ครบ", "อบรมผู้ใช้งานแล้ว", "สำรองค่าตั้งค่าระบบแล้ว"])
  /// CD-226 — the as-built documents every project must leave, by name.
  projectAsBuiltDocuments          String[] @default(["แบบติดตั้งจริง", "รายการอุปกรณ์และหมายเลขเครื่อง", "ผังการเชื่อมต่อระบบ"])
  /// CD-215 — the software documents a software project must leave, per version.
  projectSoftwareDocuments         String[] @default(["ข้อกำหนดซอฟต์แวร์", "คู่มือผู้ใช้", "คู่มือผู้ดูแลระบบ", "เอกสารจุดเชื่อมต่อ (API)"])
  /// CD-251 — เอกสารส่งมอบบังคับต่อประเภทงาน `{equipment|material|software|service: [ชื่อ]}`;
  /// ประเภทที่ไม่ได้ตั้ง = ค่าตั้งต้นในโค้ด (delivery-docs-rules.ts).
  deliveryDocuments                Json     @default("{}")
  /// CD-253 — ประเภทคำขอ "ยกเว้นวางบิลก่อนปิดรายการค้าง" (ผู้บริหารอนุมัติ); NULL = ขอยกเว้นไม่ได้.
  deliveryBillingExceptionTypeCode String?

  /// CD-130: ประเภทคำขอ "ขอ Solution และประเมินต้นทุน" (Sales → Pre-Sales) — การ์ด Solution
  /// บนหน้าดีลยื่นประเภทนี้. ช่องบังคับของฟอร์มประเภทนี้คือรายการตรวจความครบ (จุดส่งต่อที่ 2).
  /// NULL = ยังไม่ตั้ง → หน้าดีลไม่แสดงการ์ด.
  solutionRequestTypeCode String?

  /// CD-143 — ประเภทคำขอ "ขออนุมัติ Solution" (Pre-Sales → ฝ่ายเทคนิค); null = ยังไม่ตั้ง
  /// และปุ่มขออนุมัติบนหน้า Solution ไม่แสดง.
  solutionApprovalTypeCode String?

  /// CD-139 — ประเภทคำขอ "ขอจัด Demo หรือ POC" (Sales → Pre-Sales); null = ยังไม่ตั้ง
  /// และหน้าดีลไม่แสดงการ์ด Demo/POC.
  demoRequestTypeCode String?

  /// CD-136 — ประเภทคำขอ "ขอราคาจากคู่ค้า" (Pre-Sales → จัดซื้อ); null = ไม่แสดงปุ่มขอราคา.
  vendorQuoteTypeCode String?

  /// CD-136 — อัตราต้นทุนแรงงานต่อ manday ตามบทบาท `[{role, rate}]` — ใช้จนกว่าโมดูล HR
  /// (CD-17) จะให้อัตราจริง.
  presalesLaborRates Json @default("[]")

  /// CD-62: ประเภทคำขออนุมัติเปิดลูกค้าใหม่ ต่อประเภทลูกค้า — `{ corporate?, individual?,
  /// government? }` → รหัสประเภทคำขอ (เอกสารบังคับต่างกันตามประเภทลูกค้า). ไม่มีรหัส =
  /// ลูกค้าประเภทนั้นไม่ต้องขออนุมัติ.
  customerApprovalTypes Json @default("{}")

  /// CD-84: ทีมที่รับงานต่อจากฝ่ายขายโดยปริยาย (ผู้ขายเปลี่ยนได้ตอนส่ง). NULL = ผู้ขายต้องเลือกเอง.
  handoverOrgUnitId String?

  /// หัวกระดาษเอกสารขาย (ใบเสนอราคา) — ข้อมูลตามทะเบียนของบริษัทผู้ขาย ตั้งค่าได้
  /// ในหน้า admin CRM; ว่าง = ใช้ `Company.name` และไม่แสดงบรรทัดนั้น.
  letterheadNameTh  String?
  letterheadNameEn  String?
  letterheadTaxId   String?
  /// เช่น "สำนักงานใหญ่" หรือ "สาขาที่ 00001".
  letterheadBranch  String?
  letterheadAddress String?
  letterheadPhone   String?
  letterheadEmail   String?
  letterheadWebsite String?
  /// data URL (png/jpeg/webp base64) — เล็กพอเก็บในแถวได้ (จำกัด ~375KB).
  letterheadLogo    String?
  /// เงื่อนไขมาตรฐานท้ายใบเสนอราคา (หลายบรรทัด).
  quotationTerms    String?

  /// CD-85 — บริษัทนี้ต้องการ Discovery ครบก่อนเปิดดีลจาก Lead. เป็นค่าที่
  /// workflow `lwf-0001` อ่านจาก facts แล้วตัดสินเอง; หน้าจอเตือน.
  discoveryRequired Boolean @default(false)

  /// CD-86 — ไม่มีใครติดต่อลูกค้าเดิมเกินกี่วันจึงนับเป็นความเสี่ยง (เหลือง;
  /// เกินสองเท่า = แดง). 0 = ไม่ใช้สัญญาณนี้.
  healthNoContactDays Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@map("crm_company_configs")
}

/// C360-03 — the cross-module customer timeline, append-only. Modules publish
/// through `CustomerTimelineService`, never by writing this table directly;
/// there is no update or delete path. `requiredPermission` filters the feed:
/// an event whose source the viewer may not read does not appear.
///
/// Designed as the generic event schema the spec asks for because ระยะ 4
/// (AI CARE conversations) will land in this same feed.
model CustomerTimelineEvent {
  id         String @id @default(uuid())
  companyId  String
  customerId String

  /// What the event points back at: `customer`, `request`, `opportunity`, … plus the
  /// row id, the same ref mechanism as REQ-06.
  refType String
  refId   String?

  eventType String
  summary   String

  actorId   String?
  actorName String?

  /// Permission needed to see this event, or NULL for anyone who can open the
  /// customer.
  requiredPermission String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, occurredAt])
  @@index([companyId, occurredAt])
  @@map("customer_timeline_events")
}

/// CM-06 — the retry queue behind the ERP integration layer (PO 8 ก.ย. 2569;
/// ERP = SAP since 24 ก.ย. 2569: data is saved here first, then a customer
/// create calls SAP and gets the BP number back; when SAP is down the work
/// lands here instead of blocking the create, and a sweeper retries with
/// backoff). Rows are kept after they finish — the
/// "ทุกรอบ sync มี log" AC is answered by this table plus the audit trail.
model IntegrationSyncJob {
  id String @id @default(uuid())

  /// 'sap' | 'workflow' — one queue for every external system the layer fronts.
  system     String
  /// sap: 'customer_upsert' | 'receivables_refresh' | 'sale_order_create' | 'sale_order_cancel'
  /// workflow: 'lead_start'
  kind       String
  /// The row being synced — customerId for the sap customer kinds, saleOrderId
  /// for the sale_order kinds, leadId for 'lead_start'.
  resourceId String

  status    IntegrationJobStatus @default(pending)
  attempts  Int                  @default(0)
  /// The last failure, verbatim — what an operator reads first.
  lastError String?
  runAfter  DateTime             @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system, status, runAfter])
  @@index([system, kind, resourceId])
  @@map("integration_sync_jobs")
}

/// CM-04 (ชุดงาน B) — product ใดต้องยืนยันตัวตน (KYC). Configuration แก้จาก
/// หน้าจอผู้ดูแลไม่ต้อง deploy; PO ยืนยัน 8 ก.ย. 2569 ว่า KYC ไม่ block —
/// โมดูลโอกาสการขาย (CRM ระยะถัดไป) อ่านตารางนี้เพื่อ "แจ้งเตือน" เมื่อโอกาสการขายมี product
/// ที่เข้าเงื่อนไขและลูกค้ายังไม่ kycVerified. รายการจริงยังรอ PO/การเงิน —
/// นี่คือโครง + หน้าจอกรอกที่พร้อมรับค่าวันเปิดใช้.
model KycProductRule {
  id        String @id @default(uuid())
  companyId String

  /// รหัสสินค้า/บริการ — ต้องตรงกับรหัส material ใน SAP (D-30, งาน mapping ระยะ 0).
  productCode String
  name        String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, productCode])
  @@map("kyc_product_rules")
}

/// CRM — รายการสถานะของ Lead ต่อบริษัท. หน้า "ตั้งค่า CRM → สถานะ Lead" เพิ่ม
/// ลบ เปลี่ยนชื่อ สลับลำดับได้เอง โดยไม่ต้อง migrate (D-09).
///
/// ตารางนี้คือ **รายการขั้น** เท่านั้น — *กฎ* ว่าเลื่อนจากขั้นไหนไปขั้นไหนได้
/// เมื่อไร ไม่ได้อยู่ที่นี่และไม่ได้อยู่ใน core-service เลย: PO ตัดสิน 10 ก.ย. 2569
/// ว่า workflow ของ CRM อยู่บน service `workflowable` ตามหลัก "Workflow owns
/// Process, Core owns Data". ถ้ามีคนกำลังจะเพิ่มคอลัมน์ประเภท "ขั้นนี้ต้องมี X
/// ก่อน" หรือ "ขั้นนี้ไปต่อได้" ลงตารางนี้ — นั่นคือ process กำลังงอกที่สอง
/// และจะ drift กับ workflow แน่นอน.
///
/// สามแถวเป็น **สถานะระบบ** (`isSystem`): สถานะเริ่มต้นของ Lead ใหม่, ปลายทาง
/// `won` (แปลงเป็นโอกาสการขาย) และปลายทาง `lost` (คัดออก) — ลบไม่ได้และปิดไม่ได้
/// เพราะ `convert`/`disqualify` ต้องมีปลายทางเสมอ. ที่เหลือเป็นขั้นระหว่างทางที่
/// ผู้ดูแลกำหนดเองทั้งหมด.
model LeadStatusSetting {
  id        String @id @default(uuid())
  companyId String

  /// รหัสที่ `leads.status` เก็บ — ตั้งครั้งเดียว แก้ไม่ได้ (Lead เดิมอ้างอยู่).
  code   String
  nameTh String

  kind LeadStatusKind @default(open)

  /// สีป้ายบนหน้าจอ (ชื่อสีของ antd Tag เช่น `blue`, `green`).
  color String @default("default")

  /// สถานะตั้งต้นของ Lead ที่เพิ่งรับเข้า — มีได้หนึ่งเดียวต่อบริษัท.
  isDefault Boolean @default(false)

  /// สถานะระบบ: ลบไม่ได้ ปิดไม่ได้ เปลี่ยนชนิดไม่ได้.
  isSystem Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, sortOrder])
  @@map("lead_statuses")
}

/// CRM Lead — รับ Lead ทุกช่องทาง บันทึกแหล่งที่มา คัดกรอง แล้วแปลงเป็น
/// โอกาสการขายโดยข้อมูลไหลต่อ (spec CRM ฟีเจอร์ Lead). No hard delete:
/// `disqualified` + เหตุผล คือทางออกเดียว. Ownership columns mirror
/// customers so `visibleSalesWhere` scopes both the same way.
model Lead {
  id        String @id @default(uuid())
  companyId String

  name        String
  contactName String?
  phone       String?
  email       String?
  note        String?

  /// ตำแหน่ง/ฝ่ายของผู้ติดต่อ (หน้ารายละเอียด Lead, 10 ก.ย. 2569).
  contactPosition String?

  /// ข้อมูลบริษัท/ลูกค้าเป้าหมาย — กรอกได้ระหว่างคัดกรอง ก่อนที่ Lead จะกลาย
  /// เป็นลูกค้าในทะเบียน; free text ทั้งหมด ไม่ผูก master ใด.
  nameEn         String?
  taxId          String?
  industry       String?
  companySize    String?
  employeeCount  Int?
  productGroup   String?
  subProduct     String?
  projectRevenue Decimal? @db.Decimal(14, 2)

  /// ที่อยู่ 1 ชุด — พอสำหรับ Lead; ที่อยู่หลายชุดอยู่บนลูกค้า (CustomerLocation).
  addressLine String?
  district    String?
  province    String?
  postalCode  String?
  country     String  @default("TH")

  /// แหล่งที่มา — free code วันนี้ (LINE OA, เว็บไซต์, งานอีเวนต์, AI SMART
  /// จะเข้ามาเป็นค่าหนึ่งในระยะ 2).
  sourceCode String?

  /// CD-71 — แคมเปญการตลาดที่ Lead นี้มาจาก (ถ้ามี) — วัดผลแคมเปญได้ถึงยอดขาย.
  campaignId String?

  /// รหัสสถานะ — อ้าง `lead_statuses.code` ของบริษัทเดียวกัน. เก็บเป็น text
  /// ไม่ใช่ enum เพราะรายการสถานะแก้ได้จากหน้าตั้งค่าโดยไม่ต้อง migrate; ความ
  /// ถูกต้องบังคับที่ `LeadStatusService` (และการลบสถานะที่ยังมี Lead ใช้อยู่
  /// ถูกปฏิเสธ) แทน FK เพราะคีย์ต้องเป็นคู่ (companyId, code) ซึ่ง Prisma
  /// ผูกซ้ำกับ `company` ไม่ได้.
  status           String  @default("new")
  disqualifyReason String?

  /// CD-85 Discovery — สิ่งที่ต้องรู้ก่อนเปิดโอกาสการขาย: ความต้องการ/Pain
  /// Point, งบประมาณ, ผู้ตัดสินใจ, กรอบเวลา. ครบหรือไม่ = ข้อมูล
  /// (`discoveryMissing`); จะบังคับก่อนแปลงหรือไม่ = process ของ workflow
  /// `lwf-0001` อ่านจาก facts (PO 10 ก.ย. 2569).
  discoveryNeed          String?
  discoveryBudget        Decimal?  @db.Decimal(14, 2)
  discoveryBudgetNote    String?
  discoveryDecisionMaker String?
  discoveryTimeframe     DateTime? @db.Date

  /// ลูกค้าเดิมที่ Lead นี้เป็นเรื่องของเขา (ถ้า match ได้).
  customerId String?

  /// โอกาสการขายที่เกิดจากการแปลง — ข้อมูลไหลต่อ ไม่พิมพ์ซ้ำ.
  convertedOpportunityId String? @unique

  /// instance ของ workflow `lwf-0001` บน OSD Workflow ที่กำลังเดิน Lead ใบนี้
  /// (PO 10 ก.ย. 2569: "Workflow owns Process, Core owns Data").
  ///
  /// ต้องเก็บเพราะการส่ง signal เข้าไปบอกว่า "มีกิจกรรมเสร็จแล้ว" ยิงไปที่
  /// `POST /workflow-instances/{id}/signal` ซึ่งอ้าง instance ตรง ๆ ไม่ได้อ้าง
  /// business key. NULL = ยังไม่ได้ start (หรือ start ไม่สำเร็จและยังค้างในคิว
  /// `integration_sync_jobs`) — Lead ยังใช้งานได้ตามปกติ ไม่ผูกชะตากับ workflow.
  workflowInstanceId String?

  /// NULL = **กองกลาง** — ใบที่ยังไม่มีเจ้าของ. เกิดจาก Lead ที่ระบบภายนอกยิง
  /// เข้ามาเอง (`POST /integrations/crm/leads`, 14 ก.ย. 2569): ผู้ยิงเป็น
  /// service account ไม่ใช่คน จึงไม่มีพนักงานขายคนไหนที่จะเป็นเจ้าของได้ตอนนั้น
  /// และการยัดบัญชีบริการลงช่องนี้จะได้ Lead ที่ "มีเจ้าของ" ซึ่งไม่มีใครดูแลจริง.
  /// ใบกองกลางทุกคนในบริษัทที่อ่าน Lead ได้เห็น (`visibleSalesWhere`) จนกว่าจะ
  /// ถูก assign — ดู `LeadsService.assign`.
  ownerUserId    String?
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company              Company        @relation(fields: [companyId], references: [id])
  customer             Customer?      @relation(fields: [customerId], references: [id])
  convertedOpportunity Opportunity?   @relation(fields: [convertedOpportunityId], references: [id])
  campaign             Campaign?      @relation(fields: [campaignId], references: [id])
  activities           LeadActivity[]
  targetAccount        TargetAccount?

  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([campaignId])
  @@map("leads")
}

/// CRM — กิจกรรมที่ลงบน Lead (โทร / อีเมล / นัดหมาย / งาน / บันทึก). A row is
/// either a log of something done (no `dueAt`, completed on creation) or a
/// planned item (`dueAt` set, `completedAt` null until ticked). Nothing is
/// deleted: a wrong entry is completed or left as history.
model LeadActivity {
  id        String @id @default(uuid())
  companyId String
  leadId    String

  type    LeadActivityType
  subject String
  detail  String?
  /// CD-85 — ผลการติดต่อ (โทรติดไหม สนใจไหม).
  outcome ActivityOutcome?

  dueAt       DateTime?
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, dueAt])
  @@index([companyId, createdAt])
  @@map("lead_activities")
}

/// CRM โอกาสการขาย (Opportunity) — ขั้น มูลค่า ความน่าจะเป็น วันคาดปิด. `opportunityCode`
/// is what requests reference (`ref_type=opportunity`, e.g. the D-501 the request
/// form always suggested). Won/lost are closed states; reopening is a later
/// decision, not an accident.
model Opportunity {
  id              String @id @default(uuid())
  opportunityCode String @unique

  companyId String

  /// PO 10 ก.ย. 2569: การเปิดโอกาสการขาย **ยังไม่ถือเป็นลูกค้า** — NULL จนกว่าจะ
  /// เปิดใบสั่งขาย (`SaleOrder`) ซึ่งเป็นจุดเดียวที่สร้างลูกค้าในทะเบียนแล้วผูกกลับ
  /// มาที่นี่. ไม่ NULL ตั้งแต่ต้นได้เมื่อเป็นโอกาสการขายของลูกค้าเดิม (repeat business).
  customerId String?

  /// ผู้มุ่งหวัง (prospect) — ใช้แทนลูกค้าระหว่างที่ `customerId` ยัง NULL; copy มา
  /// จาก Lead ตอน convert หรือกรอกตรงเมื่อเปิดด้วยมือ. DB CHECK บังคับว่าต้องมี
  /// อย่างใดอย่างหนึ่ง (`customerId` หรือ `prospectName`). เมื่อเปิดใบสั่งขาย
  /// ค่าเหล่านี้กลายเป็นค่าตั้งต้นของทะเบียนลูกค้า แล้วคงไว้เป็นประวัติ.
  prospectName        String?
  prospectTaxId       String?
  prospectContactName String?
  prospectPhone       String?
  prospectEmail       String?

  title String

  stage           OpportunityStage    @default(qualifying)
  /// CD-86 — ลูกค้าใหม่ / ขายเพิ่ม / ขายข้าม / ต่ออายุ.
  dealType        OpportunityDealType @default(new_business)
  amount          Decimal?            @db.Decimal(14, 2)
  currency        String              @default("THB")
  /// 0–100.
  probability     Int?
  expectedCloseAt DateTime?

  wonAt          DateTime?
  lostAt         DateTime?
  /// From `OpportunityLostReason` — เหตุผลมาตรฐาน วิเคราะห์ได้.
  lostReasonCode String?
  lostReasonText String?

  ownerUserId    String
  ownerOrgUnitId String?

  /// CD-65 — กิจกรรมที่ทำเสร็จล่าสุด (NULL = ยังไม่เคยมี นับความเงียบจาก `createdAt`).
  /// เก็บซ้ำไว้บนแถวเพื่อให้ sweeper และหน้ารายการหาดีลเงียบได้ด้วย index เดียว
  /// แทนการ group กิจกรรมทุกครั้ง. เขียนโดย `OpportunityActivitiesService` เท่านั้น.
  lastActivityAt DateTime?
  /// กำหนดติดตามที่ใกล้ที่สุดของกิจกรรมที่ยังไม่เสร็จ — NULL = ไม่มีนัดค้าง.
  nextFollowUpAt DateTime?
  /// ครั้งล่าสุดที่แจ้งหัวหน้าว่าดีลนี้เงียบ; ล้างเป็น NULL เมื่อมีกิจกรรมใหม่
  /// ทำเสร็จ — กันแจ้งซ้ำทุกรอบ sweep แบบเดียวกับ `SlaClock.escalatedAt`.
  staleAlertedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company           Company                       @relation(fields: [companyId], references: [id])
  customer          Customer?                     @relation(fields: [customerId], references: [id])
  activities        OpportunityActivity[]
  /// CD-79 รอบการต่อรองเงื่อนไขการค้า.
  negotiationRounds NegotiationRound[]
  /// CD-78 เลขหมายที่จองจาก Reserve-phone ผูกกับดีลนี้.
  phoneReservations OpportunityPhoneReservation[]
  handover          SalesHandover?
  /// CD-132 Solution ที่ Pre-Sales ออกแบบให้ดีลนี้.
  solutions         Solution[]
  products          OpportunityProduct[]
  saleOrders        SaleOrder[]
  quotations        Quotation[]
  fromLead          Lead?

  @@index([companyId, stage])
  @@index([companyId, customerId])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([stage, lastActivityAt])
  @@map("opportunities")
}

/// CD-65 กิจกรรมบนโอกาสการขาย — รูปเดียวกับ `LeadActivity` (ใช้ enum เดียวกัน):
/// ไม่มี `dueAt` = บันทึกสิ่งที่ทำไปแล้ว (เสร็จทันที), มี `dueAt` = นัดติดตาม.
/// append-mostly: ติ๊กเสร็จ/เปิดกลับได้ ไม่มีการลบ.
/// CD-79 — เงื่อนไขการค้ามาตรฐานของบริษัท (ตั้งค่าที่หน้า CRM). การต่อรองที่ตกลง
/// ค่าต่างจาก `standardValue` ถูกทำเครื่องหมายว่านอกมาตรฐานและส่งฝ่ายกฎหมาย.
/// ปิดใช้ด้วย `active = false` — รอบการต่อรองเก่าเก็บค่ามาตรฐาน ณ วันนั้นไว้เองแล้ว.
model TradeTermStandard {
  id            String  @id @default(uuid())
  companyId     String
  code          String
  name          String
  standardValue String
  sortOrder     Int     @default(0)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("trade_term_standards")
}

/// CD-79 — หนึ่งรอบการต่อรองบนโอกาสการขาย. บันทึกแล้วไม่แก้ (ประวัติการต่อรอง):
/// `terms` เก็บค่ามาตรฐาน ณ วันบันทึกไว้ในแถว เพื่อให้การเปลี่ยนมาตรฐานภายหลัง
/// ไม่ตัดสินรอบเก่าใหม่.
/// `terms`: `[{ code|null, name, agreed, standard|null, nonStandard, note|null }]`
/// CD-84 — หมวดของรายการตรวจก่อนส่งมอบงาน.
enum HandoverItemCategory {
  commercial
  requirement
  commitment
}

/// CD-84 — draft → submitted → accepted, or → returned → (แก้แล้ว) submitted.
enum SalesHandoverStatus {
  draft
  submitted
  accepted
  returned
}

/// CD-84 — รายการตรวจก่อนส่งงานต่อ ที่ผู้ดูแลตั้งเอง (หน้าตั้งค่า CRM). ใบส่งมอบ
/// เก็บสำเนารายการ ณ วันส่ง แก้รายการภายหลังไม่กระทบใบที่ส่งไปแล้ว.
model HandoverChecklistItem {
  id             String               @id @default(uuid())
  companyId      String
  code           String
  category       HandoverItemCategory
  label          String
  /// ต้องกรอกรายละเอียดด้วย ไม่ใช่แค่ติ๊ก.
  requiresDetail Boolean              @default(false)
  sortOrder      Int                  @default(0)
  active         Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("handover_checklist_items")
}

/// CD-84 — การส่งมอบงานของดีลที่ชนะแล้วให้ทีมถัดไป — หนึ่งใบต่อดีล.
model SalesHandover {
  id                String              @id @default(uuid())
  companyId         String
  opportunityId     String              @unique
  status            SalesHandoverStatus @default(draft)
  toOrgUnitId       String?
  /// [{code, category, label, requiresDetail, checked, detail}] — สำเนารายการ ณ วันบันทึก.
  items             Json                @default("[]")
  note              String?
  /// ครั้งที่ส่ง (ส่งใหม่หลังถูกตีกลับ = +1).
  round             Int                 @default(0)
  submittedBy       String?
  submittedAt       DateTime?
  decidedBy         String?
  decidedAt         DateTime?
  returnReason      String?
  /// [{action, at, by, byName, reason}] — ประวัติส่ง/รับ/ตีกลับ ให้ทั้งสองฝั่งเห็น.
  history           Json                @default("[]")
  /// CD-144 — ชุดเอกสารเทคนิคที่แนบไป: Solution เวอร์ชันที่อนุมัติแล้ว (ล่าสุด)
  /// ของดีล ผูกตอนส่ง. ดีลที่มี Solution ส่งไม่ได้จนกว่าจะมีเวอร์ชันที่อนุมัติ.
  solutionVersionId String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id])
  solutionVersion SolutionVersion? @relation(fields: [solutionVersionId], references: [id])

  @@index([companyId, toOrgUnitId, status])
  @@map("sales_handovers")
}

model NegotiationRound {
  id               String   @id @default(uuid())
  companyId        String
  opportunityId    String
  roundNo          Int
  occurredOn       DateTime @db.Date
  summary          String?
  terms            Json
  nonStandardCount Int      @default(0)

  /// คำขอตรวจสัญญาที่ระบบสร้างส่งฝ่ายกฎหมาย (เมื่อมีเงื่อนไขนอกมาตรฐาน).
  legalRequestId String?
  /// ทำไมยังไม่ถึงฝ่ายกฎหมาย — ไม่ได้ตั้งประเภทคำขอ / ยื่นไม่ผ่าน (เหลือเป็นร่าง).
  legalSendError String?

  createdBy String
  createdAt DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([opportunityId, roundNo])
  @@map("negotiation_rounds")
}

/// CD-78 — สถานะการจองเลขหมายของดีล. คลังเบอร์อยู่ที่ Reserve-phone; ที่นี่เก็บ
/// เฉพาะว่าการจองไหนเป็นของดีลไหน หมดเมื่อไร.
enum PhoneReservationStatus {
  reserved
  released
  expired
}

/// CD-78 — การจองเลขหมายหนึ่งเบอร์ที่ผูกกับโอกาสการขาย. ไม่ใช่ทะเบียนเบอร์: เบอร์
/// ว่าง/ไม่ว่างถาม Reserve-phone เสมอ แถวนี้เป็นแค่ความผูกพันกับดีล + วันหมดอายุ.
model OpportunityPhoneReservation {
  id            String @id @default(uuid())
  companyId     String
  opportunityId String

  /// ตัวเลขล้วน เช่น 021234567.
  number                String
  category              String
  fee                   Decimal?               @db.Decimal(14, 2)
  /// id การจองของ Reserve-phone — ใช้ต่ออายุ/ปล่อย.
  externalReservationId String
  status                PhoneReservationStatus @default(reserved)
  expiresAt             DateTime

  /// ครั้งล่าสุดที่เตือนเจ้าของดีลว่าใกล้หมด (ต่ออายุแล้ว = เตือนใหม่ได้).
  expiryWarnedFor DateTime?

  releasedAt    DateTime?
  releasedBy    String?
  /// manual / deal_lost — ปล่อยเองหรือระบบปล่อยเพราะดีลแพ้.
  releaseReason String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@index([status, expiresAt])
  @@map("opportunity_phone_reservations")
}

model OpportunityActivity {
  id            String @id @default(uuid())
  companyId     String
  opportunityId String

  type    LeadActivityType
  subject String
  detail  String?

  dueAt       DateTime?
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  opportunity Opportunity                @relation(fields: [opportunityId], references: [id])
  /// CD-75 รูปที่แนบจากมือถือหลังเข้าพบลูกค้า.
  photos      OpportunityActivityPhoto[]

  @@index([opportunityId, dueAt])
  @@index([companyId, createdAt])
  @@map("opportunity_activities")
}

/// CD-75 — a photo taken at the customer (whiteboard, site, signed sheet),
/// kept in object storage like request attachments. Soft delete only: the row
/// stays for the trail; the object is removed.
model OpportunityActivityPhoto {
  id         String @id @default(uuid())
  companyId  String
  activityId String

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  activity OpportunityActivity @relation(fields: [activityId], references: [id])

  @@index([activityId])
  @@map("opportunity_activity_photos")
}

/// สินค้า/บริการที่เกี่ยวกับโอกาสการขาย — รหัสต้องตรง material ใน SAP (D-30). ชุดงาน B ใช้คู่กับ
/// `kyc_product_rules`: โอกาสการขายที่มี product เข้าเงื่อนไข + ลูกค้ายังไม่
/// kycVerified = banner แจ้งเตือน (ไม่ block).
model OpportunityProduct {
  id            String  @id @default(uuid())
  opportunityId String
  productCode   String
  name          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([opportunityId, productCode])
  @@map("opportunity_products")
}

/// เหตุผลปิดแพ้มาตรฐาน — configuration ต่อบริษัท seeded with defaults.
model OpportunityLostReason {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("opportunity_lost_reasons")
}

/// ตัวนับ opportunityCode ต่อบริษัท — atomic แบบเดียวกับ CustomerCodeCounter.
model OpportunityCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("opportunity_code_counters")
}

/// CRM ใบสั่งขาย (Sale Order) — โครงระยะ 1 (CD-77): ออกเลข SO-{docPrefix}-xxxxxx
/// จากโอกาสการขายที่เปิดอยู่, และเป็น **จุดเดียวที่สร้างลูกค้าในทะเบียน** (PO 10 ก.ย.
/// 2569): ถ้าโอกาสการขายยังไม่มีลูกค้า ระบบสร้างจากข้อมูลผู้มุ่งหวังแล้วผูกกลับ
/// ทั้งโอกาสการขายและ Lead ต้นทาง; เปิดใบสั่งขายถือว่าปิดโอกาสการขายแบบชนะ.
/// รายการสินค้า/ราคาต่อบรรทัดยังไม่อยู่ที่นี่ — มาจากใบเสนอราคา/BOQ ของโมดูล Sales
/// (ระยะถัดไป) และการส่งเข้า SAP ใช้คิว integration_sync_jobs เดิม.
model SaleOrder {
  id            String @id @default(uuid())
  saleOrderCode String @unique

  companyId     String
  opportunityId String
  customerId    String

  status SaleOrderStatus @default(open)

  amount   Decimal? @db.Decimal(14, 2)
  currency String   @default("THB")
  note     String?

  orderedAt    DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  /// Scope columns identical to Opportunity/Lead so `visibleSalesWhere` applies.
  ownerUserId    String
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  /// CD-77: ใบเสนอราคาที่ลูกค้ายอมรับซึ่งใบสั่งขายนี้เปิดตาม — ว่างได้ (ใบสั่งขายที่
  /// เปิดก่อนมีโมดูลใบเสนอราคา หรือเปิดตรงจากโอกาสการขาย).
  quotationId String?

  /// CD-88 — การส่งเข้า SAP. เก็บที่ CTD ก่อนเสมอ แล้วค่อยส่งผ่านคิว
  /// `integration_sync_jobs` (kind `sale_order_create` / `sale_order_cancel`).
  erpStatus    ErpSyncStatus @default(not_ready)
  /// เลขใบสั่งขายที่ SAP ตอบกลับ.
  erpOrderNo   String?
  erpSyncedAt  DateTime?
  /// ข้อผิดพลาดล่าสุดตามที่ได้รับ — สิ่งแรกที่ผู้ดูแลอ่าน.
  erpLastError String?

  company     Company         @relation(fields: [companyId], references: [id])
  opportunity Opportunity     @relation(fields: [opportunityId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  quotation   Quotation?      @relation(fields: [quotationId], references: [id])
  lines       SaleOrderLine[]

  @@index([companyId, opportunityId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([quotationId])
  @@index([erpStatus])
  @@map("sale_orders")
}

/// CD-88 — รายการสินค้าของใบสั่งขาย: snapshot จาก `QuotationLine` ตอนเปิดใบ
/// (แก้ใบเสนอราคาภายหลังต้องไม่เปลี่ยนสิ่งที่สั่งไปแล้ว). ไม่มีต้นทุน — ใบสั่งขาย
/// คือสิ่งที่ส่งให้ SAP และลูกค้า ต้นทุน/margin อยู่ที่ใบเสนอราคา.
model SaleOrderLine {
  id              String  @id @default(uuid())
  saleOrderId     String
  lineNo          Int
  /// รหัส material ใน SAP — ว่างได้สำหรับบรรทัดบริการ/ค่าแรง.
  productCode     String?
  description     String
  quantity        Decimal @db.Decimal(14, 3)
  unit            String?
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPct     Decimal @default(0) @db.Decimal(5, 2)
  /// จำนวน × ราคา × (1 − ส่วนลด%) — ค่าเดียวกับบรรทัดต้นทาง.
  lineTotal       Decimal @db.Decimal(14, 2)
  /// บรรทัดใบเสนอราคาที่ copy มา.
  quotationLineId String?

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@unique([saleOrderId, lineNo])
  @@map("sale_order_lines")
}

model SaleOrderCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("sale_order_code_counters")
}

/// CRM ใบเสนอราคา (CD-76) — เลข QT-{docPrefix}-xxxxxx ต่อโอกาสการขาย, **หนึ่งเลขมี
/// หลายเวอร์ชัน** (`@@unique([quotationNo, version])`). แก้ได้เฉพาะ draft; ฉบับที่
/// ส่ง/อนุมัติแล้วแก้ไม่ได้ — `revise` ออกเวอร์ชันใหม่เป็น draft และติด `superseded`
/// ให้ฉบับเดิม. ยอดรวม/ต้นทุน/margin คำนวณตอนบันทึกแล้วเก็บเป็น snapshot ของเวอร์ชัน
/// นั้น (ต้นทุนกรอกเองต่อบรรทัดจนกว่าจะมี BOQ/ทะเบียนสินค้า, ผู้ใช้ 15 ก.ย. 2569).
/// ต้นทุนและ margin เป็นข้อมูลอ่อนไหว — ปกปิดผ่าน sensitive_field_rules resource `quotation`.
model Quotation {
  id          String @id @default(uuid())
  quotationNo String
  version     Int    @default(1)

  companyId     String
  opportunityId String
  /// ลูกค้าในทะเบียน ถ้าโอกาสการขายผูกอยู่แล้วตอนสร้างเวอร์ชันนี้ — ผู้มุ่งหวังเป็น NULL.
  customerId    String?

  /// คู่ค้าที่พิมพ์บนเอกสาร — snapshot จากลูกค้า/ผู้มุ่งหวังตอนสร้างเวอร์ชัน.
  partyName   String
  partyTaxId  String?
  contactName String?

  title        String
  status       QuotationStatus @default(draft)
  currency     String          @default("THB")
  validUntil   DateTime?
  paymentTerms String?
  note         String?

  /// ผลรวม จำนวน × ราคาต่อหน่วย ก่อนส่วนลด.
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  /// หลังส่วนลด ก่อน VAT — ฐานของ margin และมูลค่าที่ส่งต่อไปใบสั่งขาย.
  netTotal      Decimal  @default(0) @db.Decimal(14, 2)
  vatPct        Decimal  @default(7) @db.Decimal(5, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal  @default(0) @db.Decimal(14, 2)
  costTotal     Decimal  @default(0) @db.Decimal(14, 2)
  marginAmount  Decimal  @default(0) @db.Decimal(14, 2)
  /// NULL เมื่อ netTotal = 0 (หารไม่ได้).
  marginPct     Decimal? @db.Decimal(7, 2)

  /// เกณฑ์ที่ใช้ตัดสินตอนยื่น — เก็บไว้ เพราะแก้ค่าในหน้าตั้งค่าภายหลังต้องไม่ตัดสินใหม่.
  minMarginPct      Decimal? @db.Decimal(5, 2)
  approvalRequired  Boolean  @default(false)
  /// คำขอขออนุมัติ margin ต่ำ (`requests.id`) — sync กลับด้วย request.approved/rejected.
  approvalRequestId String?

  submittedAt       DateTime?
  approvedAt        DateTime?
  /// CD-198 Solution เวอร์ชันที่ใบนี้สร้างจาก (จุดส่งต่อที่ 3 Pre-Sales → Pricing).
  solutionId        String?
  solutionVersionNo Int?
  sentAt            DateTime?
  respondedAt       DateTime?
  /// หมายเหตุตอนลูกค้าตอบรับ/ปฏิเสธ (เช่น เลข PO ลูกค้า).
  responseNote      String?
  cancelledAt       DateTime?
  cancelReason      String?

  /// Scope columns identical to Opportunity so `visibleSalesWhere` applies.
  ownerUserId    String
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company     Company         @relation(fields: [companyId], references: [id])
  opportunity Opportunity     @relation(fields: [opportunityId], references: [id])
  customer    Customer?       @relation(fields: [customerId], references: [id])
  lines       QuotationLine[]
  saleOrders  SaleOrder[]

  @@unique([quotationNo, version])
  @@index([companyId, opportunityId])
  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([approvalRequestId])
  @@map("quotations")
}

/// บรรทัดใบเสนอราคา — แทนที่ทั้งชุดได้เฉพาะตอนใบยังเป็น draft (แก้ร่าง ไม่ใช่ลบธุรกรรม).
model QuotationLine {
  id          String   @id @default(uuid())
  quotationId String
  lineNo      Int
  /// รหัสสินค้า/บริการ (ตรง material ใน SAP ถ้ามี) — ว่างได้สำหรับบรรทัดบริการ/ค่าแรง.
  productCode String?
  description String
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal  @db.Decimal(14, 2)
  unitCost    Decimal  @default(0) @db.Decimal(14, 2)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  /// จำนวน × ราคา × (1 − ส่วนลด%).
  lineTotal   Decimal  @db.Decimal(14, 2)
  lineCost    Decimal  @db.Decimal(14, 2)
  /// CD-195 ราคามาตรฐานที่บรรทัดนี้ใช้ (`product_prices.id`) — ว่าง = ราคาที่กรอกเอง.
  /// ยื่นใบไม่ได้ถ้าราคานั้นไม่มีผลแล้วในวันที่ยื่น.
  priceId     String?
  /// CD-196 unit | lump_sum | monthly — เหมา = จำนวน 1 เสมอ; รายเดือน = × termMonths.
  priceModel  String   @default("unit")
  /// CD-196 จำนวนเดือนของบรรทัดรายเดือน (1–120) — ว่างสำหรับรูปแบบอื่น.
  termMonths  Int?
  /// CD-198 ที่มาของต้นทุนเมื่อสร้างจาก Solution — "ใบเสนอราคาคู่ค้า: …",
  /// "ต้นทุนอ้างอิง", "อัตราแรงงาน" — ว่าง = กรอกเอง.
  costSource  String?
  /// CD-200 ประเภทงาน equipment | material | software | service (เหมือน BOQ).
  workType    String?
  /// CD-200 markup ที่ให้ราคานี้ — คงไว้เฉพาะเมื่อราคา = ต้นทุน × (1 + markup).
  markupPct   Decimal? @db.Decimal(7, 2)

  /// CD-204 แก้ราคาด้วยมือ: ราคาในระบบที่ใช้ได้กับดีล (ตอนบันทึก) เมื่อใส่ราคาต่ำกว่า — null = ไม่ได้แก้.
  systemPrice    Decimal? @db.Decimal(14, 2)
  overrideReason String?
  /// ผู้ที่ใส่ราคาต่ำกว่าระบบ (ต้องมี pricing.price.override).
  overriddenBy   String?

  /// CD-206 วันที่ของต้นทุนเมื่อมาจาก SAP (ใบสั่งซื้อ/ราคาพิเศษผู้ขาย) — ว่าง = กรอกเอง.
  costDate DateTime? @db.Date

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, lineNo])
  @@map("quotation_lines")
}

/// ตัวนับ quotationNo ต่อบริษัท — atomic แบบเดียวกับ SaleOrderCodeCounter.
model QuotationCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("quotation_code_counters")
}

/// CD-27 — สินค้า/บริการที่ดึงสำเนามาจาก SAP (B1 `Items`, เฉพาะที่ขายได้) ต่อบริษัท.
/// SAP เป็นเจ้าของ — ที่นี่อ่านอย่างเดียว เติมด้วยรอบ sync (รายชั่วโมง + ปุ่มในหน้า
/// ผู้ดูแล). เก็บไว้ที่ CTD เพื่อให้ออกใบเสนอราคา/ใบสั่งขายได้แม้ SAP ล่ม และให้รหัส
/// บนบรรทัดเป็นรหัสที่ SAP รู้จักจริง. หายไปจาก SAP = `active = false` ไม่ลบ.
model Product {
  id        String @id @default(uuid())
  companyId String

  /// B1 `ItemCode` — ค่าที่ใส่ใน `productCode` ของบรรทัดใบเสนอราคา/ใบสั่งขาย.
  code      String
  name      String
  /// หน่วยขาย (B1 `SalesUnit`) — เติมลงบรรทัดตอนเลือกสินค้า.
  unit      String?
  /// CD-200 กลุ่มสินค้าใน SAP (B1 `ItemsGroupCode` / `ItemGroups.GroupName`).
  groupCode String?
  groupName String?
  active    Boolean @default(true)

  /// รอบ sync ล่าสุดที่เห็นรายการนี้ใน SAP.
  syncedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("products")
}

// ---------------------------------------------------------------------------
// CD-82 เป้าและพยากรณ์
// ---------------------------------------------------------------------------

/// เป้ายอดขายรายเดือน (มูลค่าใบสั่งขายที่ไม่ยกเลิก — นิยามเดียวกับรายงานยอดขาย CD-83)
/// ของพนักงานหนึ่งคนหรือกลุ่มหนึ่งในผังองค์กร. หนึ่งแถวต่อ (บริษัท, ขอบเขต, เจ้าของ, เดือน).
///
/// `amount` คือค่าที่มีผลอยู่ตอนนี้เสมอ ค่าที่รออนุมัติอยู่ใน `SalesTargetRevision`
/// เท่านั้น — ตัวเลขบนหน้าจอจึงไม่เคยเป็นค่าที่ยังไม่มีใครอนุมัติ.
model SalesTarget {
  id        String           @id @default(uuid())
  companyId String
  scope     SalesTargetScope
  /// `users.id` เมื่อ scope = user, `org_units.id` เมื่อ scope = org_unit.
  subjectId String
  /// `YYYY-MM` ตามปฏิทินไทย.
  period    String
  amount    Decimal          @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company   Company               @relation(fields: [companyId], references: [id])
  revisions SalesTargetRevision[]

  @@unique([companyId, scope, subjectId, period])
  @@index([companyId, period])
  @@map("sales_targets")
}

/// ประวัติทุกการเปลี่ยนเป้า รวมค่าเดิม — "ปรับเป้าระหว่างงวดต้องผ่านผู้อำนวยการและเก็บ
/// ค่าเดิมไว้". append-only: แถวเปลี่ยนได้แค่สถานะของตัวเองตอนคำขอได้ผล.
model SalesTargetRevision {
  id        String @id @default(uuid())
  companyId String
  targetId  String

  /// NULL = ตั้งครั้งแรก.
  previousAmount Decimal?                  @db.Decimal(14, 2)
  newAmount      Decimal                   @db.Decimal(14, 2)
  reason         String?
  status         SalesTargetRevisionStatus

  /// คำขออนุมัติบน Platform Request — มีเฉพาะการปรับงวดที่เริ่มแล้ว.
  approvalRequestId String?   @unique
  decidedAt         DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  target SalesTarget @relation(fields: [targetId], references: [id])

  @@index([targetId, createdAt])
  @@map("sales_target_revisions")
}

// ---------------------------------------------------------------------------
// CD-71 แคมเปญ
// ---------------------------------------------------------------------------

/// แคมเปญ/กิจกรรมการตลาดต่อบริษัท — Lead ผูกด้วย `campaign_code` จากหน้าจอ,
/// ไฟล์นำเข้า หรือเว็บฟอร์ม แล้ววัดผลได้ถึงโอกาสการขายและใบสั่งขาย.
model Campaign {
  id        String    @id @default(uuid())
  companyId String
  /// รหัสที่เว็บฟอร์ม/ไฟล์นำเข้าอ้าง — ตั้งครั้งเดียว แก้ไม่ได้.
  code      String
  name      String
  /// ช่องทาง เช่น งานอีเวนต์, Facebook Ads, อีเมล — ข้อความอิสระ.
  channel   String?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  budget    Decimal?  @db.Decimal(14, 2)
  note      String?
  /// ปิดแล้ว = ผูก Lead ใหม่ไม่ได้ แต่ผลเดิมยังดูได้.
  active    Boolean   @default(true)

  /// CD-268 — แกนขายที่แคมเปญป้อน: getter | government | partner | keeper.
  salesAxis          String?
  /// CD-268 — ทีมที่รับ Lead ของแคมเปญ (CD-269 ใช้ส่ง Lead เข้าทีมนี้).
  receivingOrgUnitId String?
  /// CD-268 — เป้าหมาย: จำนวน Lead, ดีลที่ปิดได้, ยอดขาย.
  targetLeads        Int?
  targetDeals        Int?
  targetSales        Decimal?  @db.Decimal(14, 2)
  /// CD-269 — ฟอร์มสาธารณะของแคมเปญ (/f/lead/<formToken>) · token สุ่ม เดาไม่ได้.
  formEnabled        Boolean   @default(false)
  formToken          String?   @unique
  formIntro          String?
  /// CD-269 — id ฟอร์ม Lead Ads (Facebook/TikTok) ที่ส่ง Lead เข้าแคมเปญนี้.
  adFormIds          String[]  @default([])
  /// CD-270 — `campaign` | `event`. อีเวนต์: ฟอร์มสาธารณะรับลงทะเบียน (ไม่ใช่ Lead)
  /// แล้วหลังงานแปลงเฉพาะผู้เข้าร่วมที่สนใจเป็น Lead.
  kind               String    @default("campaign")
  eventStartsAt      DateTime?
  eventEndsAt        DateTime?
  eventVenue         String?
  eventOnlineUrl     String?
  /// ที่นั่ง — เต็มแล้วผู้ลงทะเบียนต่อไปเข้ารายชื่อสำรอง. null = ไม่จำกัด.
  eventCapacity      Int?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company       Company                @relation(fields: [companyId], references: [id])
  leads         Lead[]
  budgetLines   CampaignBudgetLine[]
  spends        CampaignSpend[]
  registrations CampaignRegistration[]
  contents      ContentItem[]

  @@unique([companyId, code])
  @@map("campaigns")
}

/// CD-273 — ไฟล์ในคลังแบรนด์ (โลโก้ เทมเพลตข้อเสนอ เอกสารนำเสนอ …) ·
/// ทุกคนเห็นเฉพาะฉบับปัจจุบัน (`currentVersionId`), ฉบับเก่าเก็บไว้ให้ MACOM.
model BrandAsset {
  id               String    @id @default(uuid())
  companyId        String
  /// logo | proposal_template | presentation | guideline | graphic | other
  category         String
  name             String
  description      String?
  tags             String[]  @default([])
  currentVersionId String?
  retiredAt        DateTime?
  retiredBy        String?
  retireReason     String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  versions BrandAssetVersion[]

  @@index([companyId, category])
  @@map("brand_assets")
}

/// CD-273 — ฉบับหนึ่งของไฟล์แบรนด์ · ขึ้นเป็นฉบับปัจจุบันเมื่ออนุมัติ (คำขอตามประเภทในตั้งค่า CRM).
model BrandAssetVersion {
  id                String    @id @default(uuid())
  companyId         String
  assetId           String
  versionNo         Int
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  note              String?
  /// pending | approved | rejected | cancelled
  status            String    @default("pending")
  approvalRequestId String?
  decidedAt         DateTime?
  decisionNote      String?
  uploadedBy        String?
  createdAt         DateTime  @default(now())

  asset BrandAsset @relation(fields: [assetId], references: [id])

  @@unique([assetId, versionNo])
  @@index([approvalRequestId])
  @@map("brand_asset_versions")
}

/// CD-271 — คอนเทนต์หนึ่งชิ้น = โพสต์หนึ่งครั้งบนช่องทางเดียว (ปฏิทินคอนเทนต์).
/// draft → ready → published | cancelled (CD-272 แทรกขั้นรออนุมัติ).
model ContentItem {
  id            String    @id @default(uuid())
  companyId     String
  campaignId    String?
  /// line_oa | facebook | tiktok | instagram | website | email
  channel       String
  title         String
  caption       String    @default("")
  ownerUserId   String
  plannedAt     DateTime
  status        String    @default("draft")
  publishedAt   DateTime?
  publishedUrl  String?
  cancelReason  String?
  /// ทุกครั้งที่แก้เนื้อหา +1 — CD-272 ผูกการอนุมัติกับเวอร์ชันนี้
  version       Int       @default(1)
  remindedAt    DateTime?
  overdueAt     DateTime?
  copiedFromId  String?
  /// CD-272 — พาดพิงลูกค้า / ราคา / คู่ค้า → ต้องอนุมัติก่อนพร้อมเผยแพร่
  mentionsCustomer  Boolean @default(false)
  mentionsPrice     Boolean @default(false)
  mentionsPartner   Boolean @default(false)
  /// none | pending | approved | rejected | cancelled
  approvalStatus    String  @default("none")
  approvalRequestId String?
  /// เวอร์ชันที่อนุมัติ — แก้เนื้อหาหลังอนุมัติ (version เปลี่ยน) ต้องขอใหม่
  approvedVersion   Int?
  approvalNote      String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  campaign Campaign?     @relation(fields: [campaignId], references: [id])
  files    ContentFile[]

  @@index([companyId, plannedAt])
  @@index([companyId, status])
  @@map("content_items")
}

/// CD-271 — สื่อของคอนเทนต์ (รูป/วิดีโอ/PDF) บน MinIO · ไม่ลบไฟล์จริง.
model ContentFile {
  id         String    @id @default(uuid())
  companyId  String
  contentId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String?
  createdAt  DateTime  @default(now())
  removedAt  DateTime?

  content ContentItem @relation(fields: [contentId], references: [id])

  @@index([contentId])
  @@map("content_files")
}

/// CD-270 — ผู้ลงทะเบียนอีเวนต์ (จากฟอร์มสาธารณะ หรือ walk-in หน้างาน).
/// ไม่ใช่ Lead — หลังงานแปลงเฉพาะคนที่มาและสนใจ (`leadId`).
model CampaignRegistration {
  id          String    @id @default(uuid())
  companyId   String
  campaignId  String
  company     String?
  contactName String
  position    String?
  phone       String?
  email       String?
  need        String?
  consentAt   DateTime?
  /// registered | waitlisted | cancelled
  status      String    @default("registered")
  walkIn      Boolean   @default(false)
  attendedAt  DateTime?
  attendedBy  String?
  /// interested | later | not_interested — ตั้งหลังงาน
  interest    String?
  followNote  String?
  leadId      String?
  leadOutcome String?
  convertedAt DateTime?
  convertedBy String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, status])
  @@map("campaign_registrations")
}

/// CD-268 — งบแคมเปญรายช่องทาง. งบรวมของแคมเปญ (`campaigns.budget`) = ผลรวม
/// บรรทัดเมื่อมีบรรทัด.
model CampaignBudgetLine {
  id         String  @id @default(uuid())
  companyId  String
  campaignId String
  channel    String
  planned    Decimal @db.Decimal(14, 2)
  note       String?
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  campaign Campaign        @relation(fields: [campaignId], references: [id])
  spends   CampaignSpend[]

  @@index([campaignId])
  @@map("campaign_budget_lines")
}

/// CD-268 — ค่าใช้จ่ายจริงของแคมเปญ พร้อมใบเสร็จ · ไม่ลบ — ยกเลิกพร้อมเหตุผล.
model CampaignSpend {
  id           String    @id @default(uuid())
  companyId    String
  campaignId   String
  budgetLineId String?
  spentOn      DateTime  @db.Date
  amount       Decimal   @db.Decimal(14, 2)
  vendor       String?
  note         String?
  receiptKey   String?
  receiptName  String?
  receiptType  String?
  voidedAt     DateTime?
  voidedBy     String?
  voidReason   String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  campaign   Campaign            @relation(fields: [campaignId], references: [id])
  budgetLine CampaignBudgetLine? @relation(fields: [budgetLineId], references: [id])

  @@index([campaignId])
  @@index([budgetLineId])
  @@map("campaign_spends")
}

/// CD-61 — ระดับความเสี่ยงลูกค้า.
enum KycRiskLevel {
  low
  medium
  high
}

/// CD-61 — what became of one KYC verification.
enum KycRecordStatus {
  /// Verified; in force until `expiresOn`.
  verified
  /// The prohibited list matched and nobody cleared it — not verified.
  screening_hit
  /// A later verification replaced it.
  superseded
  /// Its review date or a document passed — the customer is unverified again.
  expired
}

/// CD-61 — the company's own prohibited list (รายชื่อต้องห้าม), kept by
/// compliance in CRM settings. Deactivated, never deleted: a KYC record keeps
/// the entry it matched.
model KycWatchlistEntry {
  id             String  @id @default(uuid())
  companyId      String
  name           String
  /// `normalizeCustomerName(name)` — screening compares this.
  normalizedName String
  taxId          String?
  reason         String
  source         String?
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, active])
  @@map("kyc_watchlist_entries")
}

/// CD-61 — one KYC verification of a customer, written when its KYC request
/// completes. Append-only apart from `status` (superseded / expired) and the
/// warning stamp: what was checked, and what was decided, stays as it was.
model CustomerKycRecord {
  id         String          @id @default(uuid())
  companyId  String
  customerId String
  requestId  String?
  status     KycRecordStatus

  riskLevel     KycRiskLevel
  /// What the system suggested — kept beside the reviewer's choice.
  suggestedRisk KycRiskLevel
  /// `{ checkedAt, matches: [{ entryId, name, taxId, reason, score, byTaxId }] }`
  screening     Json
  /// Why a match was accepted anyway — required to verify despite a match.
  clearanceNote String?

  documentsExpireOn DateTime? @db.Date
  signatories       String?
  reviewDueOn       DateTime  @db.Date
  /// The earlier of `reviewDueOn` and `documentsExpireOn`.
  expiresOn         DateTime  @db.Date
  /// When the 30-day warning went out; null = not yet.
  warnedAt          DateTime?

  recordedAt DateTime @default(now())
  recordedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, recordedAt])
  @@index([status, expiresOn])
  @@map("customer_kyc_records")
}

/// CD-70 — where a contract stands.
enum CustomerContractStatus {
  active
  /// The renewal deal was won.
  renewed
  /// Its end date passed without a won renewal.
  ended
  /// Withdrawn by hand.
  cancelled
}

/// CD-70 — a light register of customer contracts until the Legal module
/// (CD-13) owns them: written when a contract request (CD-81) completes, or
/// by hand for contracts made before the system. Renewals are raised from
/// `endOn` — a renewal deal at 90 days, reminders at 60 and 30.
model CustomerContract {
  id         String  @id @default(uuid())
  companyId  String
  /// CD-161 — NULL for a contract with someone not in the customer register
  /// (a partner, a vendor, a prospect's NDA): `counterpartyName` then names
  /// them. A DB CHECK requires one or the other.
  customerId String?

  counterpartyName  String?
  counterpartyTaxId String?
  /// CD-161 — สัญญาซื้อขาย/บริการ (standard) · NDA · ข้อตกลงหลัก (MSA) · อื่น ๆ.
  kind              ContractKind @default(standard)
  /// CD-161 — ลับพิเศษ: seen only by legal.contract.manage, its owner, its
  /// creator and the people on `access` — not by everyone who can read
  /// contracts or the customer.
  confidential      Boolean      @default(false)

  /// CD-148 NDA — what information is protected, and which way it flows:
  /// mutual · disclosing (we disclose) · receiving (we receive).
  ndaScope     String?
  ndaDirection String?

  /// CD-149 — the master agreement (MSA) this contract is made under; same
  /// party, kind `msa`. Changing the MSA tells every active sub-contract's
  /// owner.
  masterContractId String?

  contractNo String
  title      String
  startOn    DateTime?              @db.Date
  endOn      DateTime               @db.Date
  value      Decimal?               @db.Decimal(14, 2)
  currency   String                 @default("THB")
  status     CustomerContractStatus @default(active)

  /// The deal it was made for, and the contract request that produced it.
  opportunityId String?
  requestId     String? @unique

  /// Who the renewal belongs to — its deal is created under them.
  ownerUserId    String
  ownerOrgUnitId String?

  renewalOpportunityId String?
  renewalCreatedAt     DateTime?
  /// CD-53 — the reminder steps (days before `endOn`) already sent. The steps
  /// are the company's `contract.renewal` rule, so they are a list, not a
  /// column per step. Emptied when the end date moves.
  remindedDays         Int[]     @default([])

  /// CD-175 — when every party had signed: set by e-sign on completion
  /// (`esign`), or by Legal for a paper contract with its signed copy
  /// (`manual`). A project opens only on a signed contract.
  signedOn         DateTime? @db.Date
  signedVia        String?
  signedDocumentId String?
  signedRecordedBy String?

  note      String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// CD-175 — the project opened from it (one per contract).
  project      Project?
  documents    ContractDocument[]
  access       ContractAccess[]
  /// CD-153..156 — ข้อกำหนดที่วัดได้ของสัญญา.
  terms        ContractTerms?
  master       CustomerContract?    @relation("ContractMaster", fields: [masterContractId], references: [id], onDelete: Restrict)
  subContracts CustomerContract[]   @relation("ContractMaster")
  /// CD-163 — ข้อผูกพันที่แตกจากสัญญา.
  obligations  ContractObligation[]
  /// CD-164 — แผนการวางบิลตามงวด.
  installments ContractInstallment[]
  /// CD-158 — ประเมินความเสี่ยงกฎหมาย (ฉบับปัจจุบัน).
  riskAssessment ContractRiskAssessment?

  @@unique([companyId, contractNo])
  @@index([customerId])
  @@index([masterContractId])
  @@index([status, endOn])
  @@map("customer_contracts")
}

/// CD-161 — ชนิดของสัญญาในคลังสัญญา.
enum ContractKind {
  standard
  nda
  msa
  other
}

/// CD-161 — a file of a contract (the signed PDF, an annex). The text of a
/// PDF is extracted once on upload into `textContent`, so the repository can
/// search inside contracts; a scanned PDF has no text layer (no OCR).
model ContractDocument {
  id          String  @id @default(uuid())
  companyId   String
  contractId  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  /// extracted · empty (no text layer — likely a scan) · failed · not_pdf
  textStatus  String
  textContent String?

  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  contract CustomerContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_documents")
}

/// CD-153..156 — a contract's terms as values, not prose: the liability
/// cap against the contract's value, the penalty rate/basis/cap, the warranty
/// counted from the real acceptance date, and what termination takes.
model ContractTerms {
  contractId String @id
  companyId  String

  // CD-153 ความรับผิด
  liabilityUnlimited         Boolean  @default(false)
  liabilityCapAmount         Decimal? @db.Decimal(14, 2)
  liabilityNote              String?
  /// The executives' approval for a cap above the contract value — the
  /// request raised for the cap as it is now; a new cap raises a new one.
  liabilityApprovalRequestId String?
  /// Why it could not be asked (no request type set, submit refused).
  liabilityApprovalError     String?

  // CD-154 ค่าปรับ
  /// ร้อยละต่อ `penaltyPeriod` ของ `penaltyBasis`.
  penaltyRatePct   Decimal? @db.Decimal(7, 4)
  /// day · week · month · occurrence
  penaltyPeriod    String?
  /// contract_value · undelivered_value · monthly_fee · other
  penaltyBasis     String?
  penaltyBasisNote String?
  /// เพดาน: ร้อยละของมูลค่าสัญญา หรือเป็นจำนวนเงิน (อย่างใดอย่างหนึ่ง).
  penaltyCapPct    Decimal? @db.Decimal(7, 4)
  penaltyCapAmount Decimal? @db.Decimal(14, 2)

  // CD-155 การรับประกัน
  warrantyMonths     Int?
  warrantyScope      String?
  warrantyExclusions String?
  /// วันตรวจรับจริง — the warranty starts here, never on the signing date.
  /// Entered by hand until Delivery (CD-20) records acceptance.
  acceptedOn         DateTime? @db.Date

  // CD-151 ระดับบริการ
  /// Response/resolution hours per severity — the same shape as a case
  /// type's targets (CD-67). A case raised against this contract is clocked
  /// on these instead of its type's.
  serviceLevels      Json?
  /// Hours the clock counts (24×7 support, office hours); null = the type's.
  serviceCoverage    SlaCoverage?
  /// Committed availability, e.g. 99.5 (%).
  availabilityPct    Decimal?     @db.Decimal(6, 3)
  /// How often a service report is owed: monthly · quarterly · null.
  serviceReportEvery String?

  // CD-156 การยกเลิก
  terminationNoticeDays   Int?
  terminationConditions   String?
  terminationConsequences String?
  /// What to do when it actually happens, in order.
  terminationSteps        String[] @default([])

  updatedAt DateTime @updatedAt
  updatedBy String?

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contract_terms")
}

/// CD-163 — ติดตามข้อผูกพัน: one thing the contract commits us to, with an
/// owner and a date — handed to whoever does it (project, service team), who
/// sees it under "ข้อผูกพันของฉัน" and marks it done. Reminders follow the
/// `contract.obligation` rule.
model ContractObligation {
  id         String @id @default(uuid())
  companyId  String
  contractId String

  title  String
  detail String?
  /// Clause or annex it comes from, e.g. "ข้อ 7.2".
  clause String?

  ownerUserId String
  dueOn       DateTime? @db.Date
  /// open · done · waived
  status      String    @default("open")
  doneAt      DateTime?
  doneBy      String?
  doneNote    String?

  /// The due date last warned about (a new date warns again) and whether
  /// the overdue notice went out for it.
  warnedFor  DateTime? @db.Date
  overdueFor DateTime? @db.Date

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([ownerUserId, status])
  @@index([status, dueOn])
  @@map("contract_obligations")
}

/// CD-164 — one billing installment of a contract: เงินมัดจำ / งวดตามความ
/// คืบหน้า / งวดสุดท้าย / เงินประกันผลงาน. The schedule is saved whole and
/// must add up to the contract value to the satang; an advance (deposit) is
/// saved with the guarantee issued against it.
model ContractInstallment {
  id         String @id @default(uuid())
  companyId  String
  contractId String
  /// Order in the schedule, from 1.
  seq        Int

  /// deposit · progress · final · retention
  kind   String
  label  String
  amount Decimal @db.Decimal(14, 2)

  /// When it is billed: a date, a condition ("30 วันหลังตรวจรับ"), and/or
  /// the milestone that unlocks it (free text until PM milestones exist).
  dueOn     DateTime? @db.Date
  dueNote   String?
  milestone String?

  /// The guarantee issued with an advance: bank_guarantee · cheque · cash.
  guaranteeType      String?
  guaranteeAmount    Decimal?  @db.Decimal(14, 2)
  guaranteeRef       String?
  guaranteeExpiresOn DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract         CustomerContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// CD-182 — the project milestone that unlocks it, once PM set one.
  projectMilestone ProjectMilestone?

  @@unique([contractId, seq])
  @@map("contract_installments")
}

/// CD-158 — the legal risk assessment of a contract: its level and the
/// issues behind it, some marked to go to executives. A high or critical
/// level, or any issue marked, needs the executives' opinion (a Platform
/// Request of the type CRM settings name) before the contract is signed.
/// One current assessment per contract; earlier ones live in the audit log.
model ContractRiskAssessment {
  id         String  @id @default(uuid())
  /// The contract it is about — or, while the contract is still being
  /// drafted (CD-159), the draft; the draft's assessment moves onto the
  /// contract its request produces. A DB CHECK requires one of the two.
  contractId String? @unique
  draftId    String? @unique
  companyId  String

  /// low · medium · high · critical
  level   String
  summary String?
  /// [{ title, detail?, clause?, severity: low|medium|high, escalate }]
  issues  Json    @default("[]")

  /// The opinion asked for the assessment as it is now; a new level or a
  /// changed set of escalated issues asks again.
  opinionRequestId String?
  opinionError     String?

  assessedBy String
  assessedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract CustomerContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  draft    ContractDraft?    @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([companyId, level])
  @@map("contract_risk_assessments")
}

/// CD-146 — a contract template: numbered clauses whose text carries
/// `{{variables}}` filled from the deal, the customer, the negotiated terms
/// and the company's letterhead when a draft is started. Editing a template
/// never changes a draft already started from it.
model ContractTemplate {
  id        String       @id @default(uuid())
  companyId String
  code      String
  name      String
  kind      ContractKind @default(standard)
  /// [{ key, heading, body }] in order
  clauses   Json         @default("[]")
  active    Boolean      @default(true)

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String?

  drafts ContractDraft[]

  @@unique([companyId, code])
  @@map("contract_templates")
}

/// CD-146 — the draft of the contract a contract request (CD-81) asks for.
/// One per request; its text lives in versions.
model ContractDraft {
  id         String @id @default(uuid())
  companyId  String
  requestId  String @unique
  templateId String

  /// The template's clauses as rendered when the draft started — what each
  /// version is compared with to mark the clauses changed from the template.
  templateClauses Json @default("[]")
  /// The values the variables were filled with, and the ones not found.
  variables       Json @default("{}")
  missing         String[] @default([])

  latestVersionNo Int @default(1)

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  template ContractTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  versions ContractDraftVersion[]
  /// CD-147 — รอบตรวจสัญญา.
  reviews  ContractReviewRound[]
  /// CD-159 — ความเสี่ยงที่ประเมินบนร่าง และการขออนุมัติรายฉบับ.
  riskAssessment ContractRiskAssessment?
  approvals      ContractDraftApproval[]
  /// CD-150 — การตรวจขอบเขตงานรายฉบับ.
  scopeChecks    ContractScopeCheck[]

  @@index([companyId])
  @@map("contract_drafts")
}

/// CD-146 — one saved version of a draft. Never changed once written: CD-147
/// compares versions and CD-159 approves one.
model ContractDraftVersion {
  id        String @id @default(uuid())
  draftId   String
  versionNo Int
  /// [{ key, heading, body }] — a key from the template, or `new-…`
  clauses   Json
  note      String?

  createdAt DateTime @default(now())
  createdBy String

  draft ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, versionNo])
  @@map("contract_draft_versions")
}

/// CD-147 — one review round of a draft: opened on a version, commented
/// clause by clause, and closed only when every comment is answered.
model ContractReviewRound {
  id        String @id @default(uuid())
  companyId String
  draftId   String
  roundNo   Int
  /// The version under review.
  versionNo Int
  note      String?

  /// open · closed
  status          String    @default("open")
  openedBy        String
  openedAt        DateTime  @default(now())
  closedBy        String?
  closedAt        DateTime?
  /// The latest version when the round closed.
  closedVersionNo Int?

  draft    ContractDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  comments ContractReviewComment[]

  @@unique([draftId, roundNo])
  @@map("contract_review_rounds")
}

/// CD-147 — a reviewer's comment on one clause, and the drafter's answer:
/// resolved (with the version it was fixed in) or declined with a reason.
model ContractReviewComment {
  id            String @id @default(uuid())
  roundId       String
  clauseKey     String
  /// The clause heading when commented — the clause may be renamed later.
  clauseHeading String
  body          String

  createdBy String
  createdAt DateTime @default(now())

  /// open · resolved · declined
  status            String    @default("open")
  response          String?
  respondedBy       String?
  respondedAt       DateTime?
  resolvedInVersion Int?

  round ContractReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, status])
  @@map("contract_review_comments")
}

/// CD-159 — the approval asked for one version of a draft. A later
/// version voids it (`voidedAt`): what was approved is no longer the text.
model ContractDraftApproval {
  id        String @id @default(uuid())
  companyId String
  draftId   String
  versionNo Int

  /// The Platform Request carrying it; NULL when it could not be raised.
  requestId String?
  error     String?
  /// The risk level it was asked with.
  riskLevel String?

  requestedBy String
  requestedAt DateTime @default(now())
  voidedAt    DateTime?
  voidReason  String?

  draft ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, voidedAt])
  @@map("contract_draft_approvals")
}

/// CD-145 — what a contract request brings Legal, captured when it is
/// submitted: the terms agreed in the deal's latest negotiation round (CD-79)
/// and the scope of work of the deal's approved Solution (CD-134/143), so
/// Legal does not chase documents and later deal edits do not change what
/// was asked. Legal may capture it again while the request is open.
model ContractRequestPackage {
  requestId     String @id
  companyId     String
  opportunityId String

  negotiationRoundNo Int?
  /// RecordedTerm[] of that round
  tradeTerms         Json  @default("[]")

  solutionId        String?
  solutionTitle     String?
  solutionVersionNo Int?
  inScope           Json    @default("[]")
  outOfScope        Json    @default("[]")
  deliverables      Json    @default("[]")
  assumptionsText   String?

  /// What was not there to capture (no negotiation, no approved Solution).
  missing String[] @default([])

  capturedAt DateTime @default(now())
  /// NULL = captured on submit; otherwise who captured it again.
  capturedBy String?

  @@index([companyId])
  @@map("contract_request_packages")
}

/// CD-150 — Legal's check of one draft version against the scope of work the
/// request brought (CD-145): each item — in scope, out of scope, deliverable,
/// acceptance criterion — found in the text or not, and Legal's verdict on
/// those not found. An inconsistent (or unchecked) latest version cannot be
/// sent for approval (CD-159).
model ContractScopeCheck {
  id        String @id @default(uuid())
  draftId   String
  versionNo Int
  /// [{ key, kind, text, found, verdict: match|mismatch, note }]
  items     Json
  /// consistent · inconsistent
  status    String
  checkedBy String
  checkedAt DateTime @default(now())

  draft ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, versionNo])
  @@map("contract_scope_checks")
}

/// CD-161 — who else may open a confidential contract.
model ContractAccess {
  contractId String
  userId     String
  grantedBy  String
  grantedAt  DateTime @default(now())

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([contractId, userId])
  @@index([userId])
  @@map("contract_access")
}

/// CD-85 — บริษัทเป้าหมายของแกน Getter: รายชื่อที่จะเปิดตลาด จัดลำดับก่อนหลัง
/// ก่อนมีใครติดต่อ. "เริ่มเข้าหา" สร้าง Lead ผูกไว้ (`leadId`) — จากนั้นงานเดิน
/// บน Lead ตามปกติ ไม่มี pipeline ชุดที่สอง. ไม่มีการลบ: ตัดออกพร้อมเหตุผล.
model TargetAccount {
  id        String @id @default(uuid())
  companyId String

  name        String
  nameEn      String?
  taxId       String?
  industry    String?
  companySize String?
  province    String?
  website     String?
  note        String?

  priority   TargetAccountPriority @default(medium)
  status     TargetAccountStatus   @default(targeting)
  dropReason String?

  /// NULL = ยังไม่มีคนรับ (เหมือนกองกลางของ Lead).
  ownerUserId    String?
  ownerOrgUnitId String?

  leadId String? @unique

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id])

  @@index([companyId, status, priority])
  @@index([companyId, ownerUserId])
  @@map("target_accounts")
}

/// CD-86 — แผนบัญชีของลูกค้าเดิม (Customer Portfolio & Account Plan): ลำดับ
/// ความสำคัญ เป้าการเติบโต และรอบทบทวน. หนึ่งลูกค้าหนึ่งแผน; ไม่มีแผน = ยังไม่
/// ได้วางแผน (ลูกค้ายังอยู่ใน portfolio ของเจ้าของตามปกติ).
model CustomerAccountPlan {
  id         String @id @default(uuid())
  companyId  String
  customerId String @unique

  tier          AccountTier @default(b)
  goals         String?
  targetRevenue Decimal?    @db.Decimal(14, 2)

  /// ทบทวนทุกกี่เดือน; การบันทึก review เลื่อน `nextReviewOn` ต่อให้เอง.
  reviewEveryMonths Int       @default(3)
  nextReviewOn      DateTime? @db.Date
  /// `nextReviewOn` ที่เตือนเจ้าของไปแล้ว — เตือนครั้งเดียวต่อรอบ.
  reviewRemindedOn  DateTime? @db.Date

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId, nextReviewOn])
  @@map("customer_account_plans")
}

/// CD-86 — การติดต่อ/ทบทวนลูกค้าเดิม (Review & Reconnect). Append-only:
/// review มีคะแนนความพึงพอใจ 1–5 ที่ health ใช้.
model CustomerTouchpoint {
  id           String            @id @default(uuid())
  companyId    String
  customerId   String
  type         CustomerTouchType
  occurredAt   DateTime
  summary      String
  /// 1–5, review เท่านั้น.
  satisfaction Int?
  nextSteps    String?

  createdAt DateTime @default(now())
  createdBy String

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, occurredAt])
  @@index([companyId, occurredAt])
  @@map("customer_touchpoints")
}

/// CD-66 — one company's setting for one intake channel: whether it is open,
/// which staff user stands as the requester, which request types a customer
/// may raise through it, and (web form) the public link and wording.
/// Connector secrets (LINE) are not stored here — see docs/customer-intake.md.
model RequestIntakeChannel {
  id              String        @id @default(uuid())
  companyId       String
  channel         IntakeChannel
  enabled         Boolean       @default(false)
  requesterUserId String
  typeCodes       String[]      @default([])
  /// web form: the unguessable part of /f/<slug>.
  slug            String?       @unique
  title           String?
  intro           String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company   Company @relation(fields: [companyId], references: [id])
  requester User    @relation(fields: [requesterUserId], references: [id])

  @@unique([companyId, channel])
  @@map("request_intake_channels")
}

/// CD-132 — draft → locked (ยืนยันเวอร์ชัน แก้ไม่ได้อีก) → superseded เมื่อมีเวอร์ชันใหม่
/// ยืนยันแทน. การอนุมัติ (CD-143) ต่อยอดจากเวอร์ชันที่ locked.
enum SolutionVersionStatus {
  draft
  locked
  superseded
}

/// CD-132 — ทางออกทางเทคนิคที่ Pre-Sales ออกแบบให้ดีล เริ่มจากคำขอ "ขอ Solution"
/// ที่รับเรื่องแล้วเท่านั้น (หนึ่งคำขอ หนึ่ง Solution) · เนื้อหาอยู่ในเวอร์ชัน.
model Solution {
  id               String @id @default(uuid())
  companyId        String
  opportunityId    String
  /// คำขอ "ขอ Solution และประเมินต้นทุน" (CD-130) ที่เป็นโจทย์ของ Solution นี้.
  requestId        String @unique
  title            String
  currentVersionNo Int    @default(1)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  opportunity    Opportunity             @relation(fields: [opportunityId], references: [id])
  versions       SolutionVersion[]
  requirements   SolutionRequirement[]
  /// CD-140 — คำถาม-คำตอบทางเทคนิคกับลูกค้า.
  clarifications SolutionClarification[]
  /// CD-141 — ทะเบียนความเสี่ยงทางเทคนิค.
  risks          SolutionRisk[]
  /// CD-139 — Demo / POC ที่จัดให้ลูกค้า.
  demos          SolutionDemo[]
  /// CD-136 — ใบเสนอราคาจากคู่ค้าที่ใช้ประมาณต้นทุน.
  partnerQuotes  SolutionPartnerQuote[]
  /// CD-138 — TOR / RFP ของลูกค้า: ข้อมูลหลัก ไฟล์ต้นฉบับ และข้อกำหนดรายข้อ.
  tor            SolutionTor?
  torFiles       SolutionTorFile[]
  torClauses     SolutionTorClause[]

  @@index([companyId, opportunityId])
  @@map("solutions")
}

/// CD-132 — หนึ่งเวอร์ชันของ Solution: สรุป · รายละเอียดการออกแบบ · สมมติฐานรายข้อ
/// (`[{category, text}]` — ส่งต่อเป็นสมมติฐานในสัญญาได้) · ไฟล์แบบ.
model SolutionVersion {
  id                String                 @id @default(uuid())
  solutionId        String
  versionNo         Int
  status            SolutionVersionStatus  @default(draft)
  summary           String                 @default("")
  design            String                 @default("")
  assumptions       Json                   @default("[]")
  /// CD-134 ขอบเขตงาน (SOW) — ล็อกไปพร้อมเวอร์ชัน: งานในขอบเขต `[text]`,
  /// งานนอกขอบเขต `[text]`, รายการส่งมอบ `[{title, description, criteria: [text]}]`
  /// (เกณฑ์ตรวจรับอยู่กับรายการส่งมอบแต่ละชิ้น — ฐานของ Delivery CD-20).
  inScope           Json                   @default("[]")
  outOfScope        Json                   @default("[]")
  deliverables      Json                   @default("[]")
  /// CD-135 BOQ / BOM — ล็อกไปพร้อมเวอร์ชัน: `[{kind, productCode, name, description,
  /// model, quantity, unit, refUnitCost}]`. ยืนยันเวอร์ชันได้เมื่อทุกบรรทัดมีรหัสสินค้า
  /// ที่ยังขายอยู่ในรายการจาก SAP (จุดส่งต่อที่ 3 → Pricing).
  boq               Json                   @default("[]")
  /// CD-136 ต้นทุนแรงงาน `[{role, mandays, rate, note}]` — อัตราคัดลอกจากตั้งค่า ณ วันบันทึก.
  labor             Json                   @default("[]")
  /// CD-133 ผลประเมินความเป็นไปได้รวมของเวอร์ชัน — ต้องมีก่อนยืนยัน; เป็นไปได้
  /// แบบมีเงื่อนไข/ไม่เป็นไปได้ต้องมีเหตุผล; ไม่เป็นไปได้ขออนุมัติไม่ได้.
  feasibility       FeasibilityVerdict     @default(unassessed)
  feasibilityNote   String                 @default("")
  /// ทำไมถึงมีเวอร์ชันนี้ (เวอร์ชัน 2 ขึ้นไป).
  changeNote        String?
  lockedAt          DateTime?
  lockedBy          String?
  /// CD-143 — การอนุมัติของเวอร์ชันนี้ (คำขอ "ขออนุมัติ Solution"). เสนอลูกค้าได้
  /// เฉพาะเวอร์ชันที่ `approved`; แก้หลังอนุมัติคือเวอร์ชันใหม่ ซึ่งเริ่ม `none`.
  approvalStatus    SolutionApprovalStatus @default(none)
  approvalRequestId String?                @unique
  approvedAt        DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  solution  Solution        @relation(fields: [solutionId], references: [id])
  files     SolutionFile[]
  /// CD-144 — งานส่งมอบที่แนบเวอร์ชันนี้เป็นชุดเอกสารเทคนิค.
  handovers SalesHandover[]

  @@unique([solutionId, versionNo])
  @@map("solution_versions")
}

/// CD-132 — ไฟล์แบบ/ไดอะแกรมของเวอร์ชัน. เวอร์ชันใหม่คัดลอกแถว (อ้างไฟล์เดิม) —
/// ลบจากร่างเป็น soft delete และไม่ลบตัวไฟล์ เพราะเวอร์ชันเก่ายังอ้างอยู่.
model SolutionFile {
  id         String    @id @default(uuid())
  companyId  String
  versionId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  version SolutionVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
  @@map("solution_files")
}

/// CD-131 — ความต้องการเชิงธุรกิจหรือเชิงเทคนิค.
enum RequirementKind {
  business
  technical
}

/// CD-131 — ผลการประเมินของ Pre-Sales ต่อความต้องการหนึ่งข้อ.
enum RequirementAssessment {
  unassessed
  feasible
  not_feasible
  needs_info
}

/// CD-131 — วิเคราะห์ความต้องการ: หนึ่งข้อของ Solution แยกจากเวอร์ชัน (แก้ได้
/// ตลอดโดยไม่ต้องเปิดเวอร์ชันใหม่). ข้อที่ต้องขอข้อมูลเพิ่ม (`needs_info`) เก็บ
/// คำตอบของลูกค้าไว้ที่ข้อนั้น; ยืนยันเวอร์ชันไม่ได้ถ้ายังมีข้อที่ยังไม่ประเมิน
/// หรือยังรอลูกค้าตอบ. ลบคือ soft delete.
model SolutionRequirement {
  id         String                @id @default(uuid())
  companyId  String
  solutionId String
  seq        Int
  kind       RequirementKind
  text       String
  assessment RequirementAssessment @default(unassessed)
  /// เหตุผลของผลประเมิน หรือคำถามที่ต้องถามลูกค้าเมื่อเป็น `needs_info`.
  note       String                @default("")

  customerAnswer String?
  answeredAt     DateTime?
  answeredBy     String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@map("solution_requirements")
}

/// CD-143 — สถานะการอนุมัติของเวอร์ชัน Solution.
enum SolutionApprovalStatus {
  none
  pending
  approved
  rejected
  cancelled
}

/// CD-133 — ผลประเมินความเป็นไปได้ของ Solution เวอร์ชันหนึ่ง.
enum FeasibilityVerdict {
  unassessed
  feasible
  conditional
  not_feasible
}

/// CD-140 — ชี้แจงประเด็นเทคนิค: คำถาม-คำตอบกับลูกค้าเป็นรายข้อ (ไม่ผูกเวอร์ชัน).
/// คำตอบที่กระทบขอบเขต (`affectsScope`) ต้องแก้ SOW ในเวอร์ชันที่แก้หลังคำตอบ
/// แล้วปิดด้วยเลขเวอร์ชันนั้น (`scopeResolvedVersionNo`) — ค้างอยู่ขออนุมัติไม่ได้.
/// ลบคือ soft delete.
model SolutionClarification {
  id         String @id @default(uuid())
  companyId  String
  solutionId String
  seq        Int

  question String
  askedOn  DateTime @db.Date
  askedBy  String

  answer              String?
  /// ผู้ตอบฝั่งลูกค้า (ชื่อ · ตำแหน่ง).
  respondent          String?
  answeredOn          DateTime? @db.Date
  /// ใครบันทึกคำตอบ และเมื่อไร (เวลาจริง ใช้ตัดสินว่าเวอร์ชันแก้หลังคำตอบหรือไม่).
  answerRecordedBy    String?
  answerRecordedAt    DateTime?
  /// เวอร์ชันปัจจุบันของ Solution ขณะบันทึกคำตอบ.
  answeredOnVersionNo Int?
  affectsScope        Boolean   @default(false)

  scopeResolvedVersionNo Int?
  scopeResolvedAt        DateTime?
  scopeResolvedBy        String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@map("solution_clarifications")
}

/// CD-141 — สถานะของความเสี่ยงหนึ่งข้อ.
enum SolutionRiskStatus {
  open
  mitigated
  accepted
  closed
}

/// CD-141 — ความเสี่ยงทางเทคนิคของ Solution (ไม่ผูกเวอร์ชัน): โอกาสเกิด × ผลกระทบ
/// (1–5 แต่ละด้าน) = คะแนน → ระดับ; ความเสี่ยงระดับสูง/วิกฤติที่ยังเปิดต้องมีผู้รับผิดชอบ
/// และแนวทางลดความเสี่ยงก่อนขออนุมัติ. ส่งต่อไปกับงานส่งมอบเป็นความเสี่ยงของโครงการ.
/// ลบคือ soft delete.
model SolutionRisk {
  id          String             @id @default(uuid())
  companyId   String
  solutionId  String
  seq         Int
  title       String
  description String             @default("")
  likelihood  Int
  impact      Int
  owner       String             @default("")
  mitigation  String             @default("")
  status      SolutionRiskStatus @default(open)

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@map("solution_risks")
}

/// CD-139 — Demo หรือ POC.
enum SolutionDemoKind {
  demo
  poc
}

/// CD-139 — สถานะของ Demo/POC: วางแผน → จัดแล้ว หรือยกเลิก (ปิดได้เมื่อคืนอุปกรณ์ครบ).
enum SolutionDemoStatus {
  planned
  done
  cancelled
}

/// CD-139 — Demo / POC ของ Solution: แผน คน อุปกรณ์ที่เบิก-คืน ผลตามเกณฑ์ความสำเร็จ
/// และข้อค้นพบ. ผูกกับคำขอ "ขอจัด Demo หรือ POC" (ถ้ามี). ลบคือ soft delete.
model SolutionDemo {
  id          String             @id @default(uuid())
  companyId   String
  solutionId  String
  seq         Int
  /// คำขอ "ขอจัด Demo หรือ POC" ที่เป็นต้นเรื่อง.
  requestId   String?            @unique
  kind        SolutionDemoKind   @default(demo)
  title       String
  scheduledOn DateTime?          @db.Date
  site        String             @default("")
  /// คน/ทีมที่จองไว้.
  people      String             @default("")
  plan        String             @default("")
  /// [{text, result: pending|met|not_met, note}] — ผลตามเกณฑ์ความสำเร็จแต่ละข้อ.
  criteria    Json               @default("[]")
  outcome     String             @default("")
  status      SolutionDemoStatus @default(planned)
  closedAt    DateTime?
  closedBy    String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution  Solution                @relation(fields: [solutionId], references: [id])
  equipment SolutionDemoEquipment[]
  findings  SolutionDemoFinding[]

  @@index([solutionId])
  @@map("solution_demos")
}

/// CD-139 — อุปกรณ์ที่เบิกไปใช้ใน Demo/POC — ต้องบันทึกการคืน.
model SolutionDemoEquipment {
  id         String    @id @default(uuid())
  demoId     String
  name       String
  serial     String    @default("")
  quantity   Int       @default(1)
  takenBy    String    @default("")
  outOn      DateTime  @db.Date
  returnedOn DateTime? @db.Date

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  demo SolutionDemo @relation(fields: [demoId], references: [id])

  @@index([demoId])
  @@map("solution_demo_equipment")
}

/// CD-139 — ข้อค้นพบจาก Demo/POC. ข้อที่ต้องปรับ Solution (`requiresChange`) เปิดอยู่
/// จนกว่า Pre-Sales จะปิดด้วยเลขเวอร์ชันที่ปรับแล้ว — ค้างอยู่ขออนุมัติไม่ได้.
model SolutionDemoFinding {
  id                  String    @id @default(uuid())
  demoId              String
  seq                 Int
  text                String
  requiresChange      Boolean   @default(false)
  /// เวอร์ชันปัจจุบันของ Solution ขณะบันทึก (เวอร์ชันที่ปิดข้อต้องไม่เก่ากว่านี้).
  recordedOnVersionNo Int
  resolvedVersionNo   Int?
  resolvedAt          DateTime?
  resolvedBy          String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  demo SolutionDemo @relation(fields: [demoId], references: [id])

  @@index([demoId])
  @@map("solution_demo_findings")
}

/// CD-138 — การตอบข้อกำหนดของ TOR หนึ่งข้อ.
enum TorCompliance {
  unanswered
  comply
  partial
  not_comply
}

/// CD-138 — ข้อมูลหลักของ TOR / RFP (หนึ่งต่อ Solution) — ผู้ซื้อ เลขโครงการ กำหนดยื่น
/// หลักประกันซอง; ใช้ต่อในงาน Bid / No-Bid ภาครัฐภายหลัง.
model SolutionTor {
  id                 String    @id @default(uuid())
  companyId          String
  solutionId         String    @unique
  buyer              String    @default("")
  projectNo          String    @default("")
  submissionDeadline DateTime?
  bidBond            String    @default("")
  note               String    @default("")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@map("solution_tors")
}

/// CD-138 — ไฟล์ TOR / RFP ต้นฉบับ (และภาคผนวก/เอกสารชี้แจง).
model SolutionTorFile {
  id         String    @id @default(uuid())
  companyId  String
  solutionId String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@map("solution_tor_files")
}

/// CD-138 — ข้อกำหนดของ TOR รายข้อ พร้อมการตอบ. ข้อบังคับ (`mandatory`) ที่ยังไม่ตอบ
/// หรือตอบว่าไม่เป็นไปตาม ขออนุมัติ Solution ไม่ได้ (และส่งข้อเสนอไม่ได้ใน CD-137).
/// ลบคือ soft delete.
model SolutionTorClause {
  id         String        @id @default(uuid())
  companyId  String
  solutionId String
  seq        Int
  /// เลขข้อตาม TOR เช่น "3.2.1".
  clauseNo   String        @default("")
  text       String
  mandatory  Boolean       @default(true)
  compliance TorCompliance @default(unanswered)
  response   String        @default("")
  /// ตอบไว้ที่ไหน เช่น "SOW ข้อ 2" / "ภาคผนวก ข".
  reference  String        @default("")

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@map("solution_tor_clauses")
}

/// CD-165 — where signatures go on one kind of document: each field names
/// the party signing it (label), its page (first, last, a number, or a
/// signature page appended at the end) and a preset position, in signing
/// order. Editing a layout never changes an envelope already created.
model EsignLayout {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  /// contract · acceptance · other
  docType   String  @default("contract")
  /// [{ key, label, page: 'first'|'last'|'appendix'|number, position, order }]
  fields    Json    @default("[]")
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([companyId, code])
  @@map("esign_layouts")
}

/// CD-166..170 — one document sent for signing. The PDF is fixed when the
/// envelope is created (`originalHash`); signing it produces a sealed copy
/// (`signedHash`) with the signatures and the evidence pages, checked later
/// on the verification page by `verifyCode` (CD-173).
model EsignEnvelope {
  id        String @id @default(uuid())
  companyId String
  title     String
  layoutId  String?
  /// The layout's fields when the envelope was made.
  fields    Json   @default("[]")
  /// sequential (in field order) · parallel
  mode      String @default("sequential")
  /// draft · sent · completed · declined · cancelled · expired
  status    String @default("draft")
  message   String?

  /// What it signs and what it belongs to, for the owning module.
  sourceType String
  sourceId   String
  refType    String
  refId      String

  originalKey  String
  originalName String
  originalHash String
  signedKey    String?
  signedHash   String?  @unique
  verifyCode   String   @unique

  expiresAt   DateTime
  createdBy   String
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  /// CD-172 — what the authority check reads: the document's kind (from
  /// the layout) and its amount (e.g. the contract value).
  docType String   @default("contract")
  amount  Decimal? @db.Decimal(14, 2)

  signers EsignSigner[]
  events  EsignEvent[]

  @@index([companyId, status])
  @@index([refType, refId])
  @@map("esign_envelopes")
}

/// One party to an envelope. External signers open a single-use link
/// (only its hash is kept) and confirm a one-time code; internal signers
/// sign from their login.
model EsignSigner {
  id         String @id @default(uuid())
  envelopeId String
  fieldKey   String
  order      Int
  /// internal · external
  kind       String
  userId     String?
  name       String
  email      String?
  phone      String?

  /// pending · signed · declined
  status String @default("pending")

  tokenHash      String?   @unique
  /// CD-171 — the same secret, encrypted (AES-GCM, key from ESIGN_SECRET),
  /// so a reminder can send the link again; the hash is what is looked up.
  tokenCipher    String?
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime?

  otpHash       String?
  otpChannel    String?
  otpSentAt     DateTime?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpVerifiedAt DateTime?

  viewedAt       DateTime?
  signedAt       DateTime?
  /// draw · type · upload
  signatureKind  String?
  signatureKey   String?
  signatureText  String?
  /// keycloak · otp_email · otp_sms
  authMethod     String?
  ip             String?
  userAgent      String?
  declinedAt     DateTime?
  declinedReason String?

  envelope EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  events   EsignEvent[]

  @@unique([envelopeId, fieldKey])
  @@index([userId, status])
  @@map("esign_signers")
}

/// CD-170 — what happened to an envelope, for the evidence page: sent,
/// opened, code sent, code confirmed, read, signed, declined, sealed.
/// Written, never changed.
model EsignEvent {
  id         String   @id @default(uuid())
  envelopeId String
  signerId   String?
  type       String
  at         DateTime @default(now())
  ip         String?
  userAgent  String?
  detail     Json?

  envelope EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  signer   EsignSigner?  @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([envelopeId, at])
  @@map("esign_events")
}

/// CD-136 — ใบเสนอราคาจากคู่ค้าของเวอร์ชันหนึ่ง: ราคาต่อหน่วยของบรรทัด BOQ ที่เสนอ
/// `[{lineIndex, productCode, unitPrice}]` — ใช้แทนต้นทุนอ้างอิงของบรรทัดนั้น. รหัสผู้ขาย
/// จาก SAP ตรวจเมื่อเชื่อม SAP B1 (CD-28). ลบคือ soft delete.
model SolutionPartnerQuote {
  id         String    @id @default(uuid())
  companyId  String
  solutionId String
  versionId  String
  seq        Int
  vendorName String
  /// รหัสผู้ขายใน SAP (BP CardCode).
  vendorCode String    @default("")
  quoteNo    String    @default("")
  quoteDate  DateTime? @db.Date
  validUntil DateTime? @db.Date
  /// คำขอ "ขอราคาจากคู่ค้า" ที่เป็นต้นเรื่อง (ถ้ามี).
  requestId  String?
  lines      Json      @default("[]")
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  storageKey String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  solution Solution @relation(fields: [solutionId], references: [id])

  @@index([versionId])
  @@map("solution_partner_quotes")
}

/// CD-142 ข้อมูลคู่ค้าทางเทคนิค — ผูกกับผู้ขายใน SAP ด้วย CardCode. ข้อมูลเชิง
/// พาณิชย์ (ชื่อ เลขภาษี เงื่อนไขชำระ สถานะ) อ่านจาก SAP สดเสมอ ไม่เก็บซ้ำที่นี่.
model PresalesPartner {
  id             String @id @default(uuid())
  companyId      String
  /// รหัสผู้ขายใน SAP (BP CardCode).
  vendorCode     String
  /// ชื่อตอนบันทึกล่าสุด — ใช้แสดงเมื่ออ่าน SAP ไม่ได้เท่านั้น.
  vendorNameSeen String @default("")
  /// ความสามารถทางเทคนิคโดยสรุป.
  summary        String @default("")
  /// [{ brand, level, expiresOn }] — แบรนด์/สายผลิตภัณฑ์และระดับพาร์ทเนอร์.
  brands         Json   @default("[]")
  /// [{ name, holders, expiresOn }] — ใบรับรองของวิศวกร.
  certifications Json   @default("[]")
  /// [{ name, role, phone, email }] — ผู้ติดต่อฝ่ายเทคนิค/ซัพพอร์ต.
  contacts       Json   @default("[]")

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  files PresalesPartnerFile[]

  @@unique([companyId, vendorCode])
  @@map("presales_partners")
}

/// CD-142 เอกสารอ้างอิงของคู่ค้า (ใบรับรอง, datasheet, แคตตาล็อก) บน object storage.
model PresalesPartnerFile {
  id         String    @id @default(uuid())
  partnerId  String
  companyId  String
  /// certificate | datasheet | catalog | other
  category   String    @default("other")
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  partner PresalesPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("presales_partner_files")
}

/// CD-172 — ทะเบียนผู้มีอำนาจลงนาม: who may sign for the company, up to
/// what amount (NULL = no limit), on which kinds of document (empty = all),
/// and when. A layout field marked `authority` takes only a signer covered
/// here — checked when the envelope is made and again when they sign.
model EsignAuthority {
  id          String    @id @default(uuid())
  companyId   String
  userId      String
  /// ตำแหน่ง as it goes on paper, e.g. กรรมการผู้จัดการ
  title       String
  limitAmount Decimal?  @db.Decimal(14, 2)
  docTypes    String[]  @default([])
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  active      Boolean   @default(true)
  note        String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([companyId, userId])
  @@map("esign_authorities")
}

/// CD-18 PM — where a project stands.
enum ProjectStatus {
  active
  on_hold
  closed
  cancelled
}

/// CD-175 — a project, opened from a signed contract. `baseline` is what was
/// sold, copied when it opened: the contract, the approved Solution's scope,
/// deliverables, BOQ, labour and cost, the billing schedule. It does not
/// follow later edits to those — a change goes through a change request
/// (CD-185).
model Project {
  id                String        @id @default(uuid())
  companyId         String
  projectNo         String
  name              String
  contractId        String        @unique
  customerId        String?
  opportunityId     String?
  /// The approved Solution version the baseline came from, if there was one.
  solutionVersionId String?
  managerUserId     String
  status            ProjectStatus @default(active)
  startOn           DateTime?     @db.Date
  endOn             DateTime      @db.Date
  contractValue     Decimal?      @db.Decimal(14, 2)
  currency          String        @default("THB")
  baseline          Json
  /// What the baseline could not find (no approved Solution, no BOQ, …).
  missing           String[]      @default([])
  note              String?
  openedAt          DateTime      @default(now())
  openedBy          String
  updatedAt         DateTime      @updatedAt
  updatedBy         String?

  contract   CustomerContract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  members    ProjectMember[]
  /// CD-182 — หมุดหมายของโครงการ.
  milestones ProjectMilestone[]
  /// CD-177 — โครงสร้างงาน.
  tasks      ProjectTask[]
  /// CD-188 — ความคืบหน้าที่รายงาน.
  progressReports ProjectProgressReport[]
  /// CD-179 — งบอ้างอิง (ทุกฉบับ).
  budgets         ProjectBudget[]
  /// CD-185 — คำขอเปลี่ยนแปลง.
  changeRequests  ProjectChangeRequest[]
  /// CD-183 — ความเสี่ยงโครงการ.
  risks           ProjectRisk[]
  /// CD-184 — ปัญหาระหว่างทาง.
  issues          ProjectIssue[]
  /// CD-186 — การประสานงานลูกค้า.
  customerLogs    ProjectCustomerLog[]
  /// CD-191 — การปิดโครงการ เอกสารปิด และบทเรียน.
  closeout        ProjectCloseout?
  closeDocuments  ProjectCloseDocument[]
  lessons         ProjectLesson[]
  /// CD-192 — รายงานสถานะรายสัปดาห์.
  statusReports   ProjectStatusReport[]
  /// CD-221 — ข้อทดสอบตามขอบเขตงาน.
  testItems       ProjectTestItem[]
  /// CD-225 — รายการตรวจความพร้อมก่อนส่งมอบ.
  readinessItems  ProjectReadinessItem[]
  /// CD-226 — เอกสารสภาพจริง และจุดที่ต่างจากที่ขาย.
  asBuiltDocuments  ProjectAsBuiltDocument[]
  asBuiltDeviations ProjectAsBuiltDeviation[]
  /// CD-189 — รอบตรวจรับ.
  acceptances       ProjectAcceptance[]
  /// CD-222 — ประเด็นจากการทดสอบของลูกค้า (UAT).
  uatFindings       ProjectUatFinding[]
  /// CD-216 — จุดติดตั้ง.
  installations     ProjectInstallation[]
  /// CD-211 — แบบรายละเอียด (ทุกเวอร์ชัน).
  designs           ProjectDesign[]
  /// CD-210 — การสำรวจหน้างาน.
  surveys           ProjectSurvey[]
  defects           ProjectDefect[]
  environments      ProjectEnvironment[]
  releases          ProjectRelease[]
  softwareDocuments ProjectSoftwareDocument[]
  configItems       ProjectConfigItem[]
  integrations      ProjectIntegration[]
  techChanges       ProjectTechChange[]
  costs             ProjectCost[]
  costAlerts        ProjectCostAlert[]
  bookingPriorities ProjectBookingPriority[]
  resourceRequests  ProjectResourceRequest[]

  @@unique([companyId, projectNo])
  @@index([companyId, status])
  @@index([managerUserId])
  @@map("projects")
}

/// CD-175 — the project team. A member sees the project without
/// `pm.project.read`.
model ProjectMember {
  projectId String
  userId    String
  /// What they do on it, in words: วิศวกร, นักพัฒนา, ผู้ประสานงาน.
  role      String?
  addedAt   DateTime @default(now())
  addedBy   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// CD-182 — a project milestone: what must be true for it to count
/// (`criteria`, each ticked by the manager), when it is due, and — if it
/// unlocks a payment — the contract installment it is tied to. Achieving it
/// takes every criterion met plus evidence, and tells the contract's owner
/// that installment may be billed. `cancelled` instead of deleting.
model ProjectMilestone {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  seq           Int
  title         String
  description   String?
  /// [{ text, met, metAt, metBy }]
  criteria      Json      @default("[]")
  dueOn         DateTime? @db.Date
  installmentId String?   @unique
  /// CD-154 — the contract's delay penalty runs if it is late.
  penaltyApplies Boolean  @default(false)
  /// planned · achieved · cancelled
  status        String    @default("planned")
  achievedOn    DateTime? @db.Date
  achievedAt    DateTime?
  achievedBy    String?
  evidenceNote  String?
  evidenceKey   String?
  evidenceName  String?
  evidenceMime  String?
  evidenceSize  Int?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installment ContractInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  /// CD-177 — the work that delivers it.
  tasks       ProjectTask[]

  @@index([projectId, seq])
  @@index([companyId, status, dueOn])
  @@map("project_milestones")
}

/// CD-194 ราคาขายมาตรฐานต่อรหัสสินค้า SAP — Pricing เป็นเจ้าของ (SAP เป็นเจ้าของ
/// รายการสินค้าเท่านั้น). ช่วงเวลามีผลของรหัส+สกุลเงินเดียวกันห้ามซ้อนทับ.
model ProductPrice {
  id             String    @id @default(uuid())
  companyId      String
  /// B1 `ItemCode` — ตรงกับ `products.code`.
  productCode    String
  currency       String    @default("THB")
  unitPrice      Decimal   @db.Decimal(14, 2)
  /// CD-196 unit | lump_sum | monthly — ราคาต่อหน่วย / ราคาเหมา / ราคาต่อเดือน.
  priceModel     String    @default("unit")
  /// CD-197 standard | segment | customer | opportunity — ราคามาตรฐาน หรือ
  /// ราคาเฉพาะกลุ่มลูกค้า / ลูกค้า / ดีล (ราคาเฉพาะต้องมีวันสิ้นสุด).
  scope          String    @default("standard")
  /// CD-197 เป้าหมายของราคาเฉพาะ — ตรงกับ `scope` หนึ่งช่องเท่านั้น.
  customerId     String?
  segmentValueId String?
  opportunityId  String?
  /// วันแรกที่มีผล.
  validFrom      DateTime  @db.Date
  /// วันสุดท้ายที่มีผล (รวมวันนั้น) — NULL = ไม่มีกำหนดสิ้นสุด.
  validTo        DateTime? @db.Date
  note           String    @default("")

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  versions ProductPriceVersion[]

  @@index([companyId, productCode, currency])
  @@index([companyId, scope])
  @@map("product_prices")
}

/// CD-177 — one item of the project's work breakdown: a summary (it has
/// children, and spans them) or a piece of work lasting `durationDays`
/// working days, with an owner. Dates are not stored: they follow from the
/// project's start, the working calendar and the links (CD-178).
model ProjectTask {
  id           String    @id @default(uuid())
  companyId    String
  projectId    String
  parentId     String?
  /// Order among its siblings, from 1.
  seq          Int
  title        String
  description  String?
  ownerUserId  String?
  /// Working days; 0 marks a point in time (a hand-over, a sign-off).
  durationDays Int       @default(1)
  /// The milestone this work delivers, if any.
  milestoneId  String?
  /// CD-181 — open · in_progress · done · cancelled.
  status       String    @default("open")
  /// CD-185 — work that a change request adds: it may not start until the
  /// change is approved.
  changeRequestId String?
  /// CD-209 — who else works it, beside its owner.
  crewUserIds  String[]  @default([])
  /// CD-209 — the work needs equipment or tools; then they must be listed.
  needsEquipment Boolean @default(false)
  /// CD-212 — software work: `iteration` (a round of development, a
  /// summary task) or `item` (one line of the SOW under it).
  devKind      String?
  /// CD-212 — the SOW line a development item delivers: scope:i,
  /// deliverable:d or change:<id>.
  sowRef       String?
  /// CD-181 — when the work actually started and finished.
  startedAt    DateTime?
  doneAt       DateTime?
  doneBy       String?
  createdAt    DateTime  @default(now())
  createdBy    String
  updatedAt    DateTime  @updatedAt
  updatedBy    String?

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       ProjectTask?      @relation("TaskTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     ProjectTask[]     @relation("TaskTree")
  milestone    ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  predecessors ProjectTaskLink[] @relation("LinkSuccessor")
  successors   ProjectTaskLink[] @relation("LinkPredecessor")
  changeRequest ProjectChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  /// CD-181 — what was reported from the field, and the files with it.
  updates      ProjectTaskUpdate[]
  files        ProjectTaskFile[]
  /// CD-209 — the equipment and tools the work needs.
  equipment    ProjectTaskEquipment[]

  @@index([projectId, parentId, seq])
  @@map("project_tasks")
}

/// CD-177 — `predecessor` must finish before `successor` starts, `lagDays`
/// working days later.
model ProjectTaskLink {
  predecessorId String
  successorId   String
  lagDays       Int      @default(0)
  createdAt     DateTime @default(now())

  predecessor ProjectTask @relation("LinkPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ProjectTask @relation("LinkSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
  @@map("project_task_links")
}

/// CD-195 ประวัติทุกครั้งที่ราคาถูกบันทึก — snapshot หลังการเปลี่ยนแปลง ไม่มีการแก้/ลบ.
model ProductPriceVersion {
  id         String    @id @default(uuid())
  priceId    String
  companyId  String
  versionNo  Int
  /// created | updated | ended | revised | removed
  action     String
  unitPrice  Decimal   @db.Decimal(14, 2)
  /// CD-196
  priceModel String    @default("unit")
  currency   String
  validFrom  DateTime  @db.Date
  validTo    DateTime? @db.Date
  note       String    @default("")
  /// เหตุผลที่ผู้แก้ระบุ (บังคับเมื่อปรับหรือปิดราคาที่มีผลแล้ว).
  reason     String    @default("")
  changedBy  String
  changedAt  DateTime  @default(now())

  price ProductPrice @relation(fields: [priceId], references: [id])

  @@unique([priceId, versionNo])
  @@map("product_price_versions")
}

/// CD-181 — one report on a task from whoever does it (often on site, on a
/// phone): what was done, and the status it moved to.
model ProjectTaskUpdate {
  id         String   @id @default(uuid())
  companyId  String
  taskId     String
  authorId   String
  note       String
  statusFrom String?
  statusTo   String?
  createdAt  DateTime @default(now())

  task  ProjectTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  files ProjectTaskFile[]

  @@index([taskId, createdAt])
  @@map("project_task_updates")
}

/// CD-181 — a photo or document attached to a task (with the update it came
/// with, if any). The bytes live in object storage.
model ProjectTaskFile {
  id         String    @id @default(uuid())
  companyId  String
  taskId     String
  updateId   String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  task   ProjectTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  update ProjectTaskUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("project_task_files")
}

/// CD-188 — a progress figure someone reported (to the customer, to the
/// executives), kept beside what the system computed at that moment. A
/// figure far from the computed one carries the reason.
model ProjectProgressReport {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  reportedPct Decimal  @db.Decimal(5, 2)
  computedPct Decimal  @db.Decimal(5, 2)
  plannedPct  Decimal? @db.Decimal(5, 2)
  reason      String?
  note        String?
  reportedAt  DateTime @default(now())
  reportedBy  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, reportedAt])
  @@map("project_progress_reports")
}

/// CD-179 — the project's reference budget. Version 1 starts as a draft
/// drawn from the baseline (BOQ costs, labour); the manager completes it
/// and locks it. After that it changes only through a change request
/// (CD-185), which writes the next version and supersedes this one.
model ProjectBudget {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  versionNo       Int
  /// draft · locked · superseded
  status          String    @default("draft")
  /// [{ category, code, description, quantity, unit, unitCost, amount }]
  lines           Json      @default("[]")
  total           Decimal   @default(0) @db.Decimal(14, 2)
  contractValue   Decimal?  @db.Decimal(14, 2)
  note            String?
  /// CD-185 — the change request that made this version.
  changeRequestId String?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  lockedAt        DateTime?
  lockedBy        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNo])
  @@map("project_budgets")
}

/// CD-185 — a change to what was sold: its effect on scope (added and
/// removed), time (working days) and cost (budget lines added or taken
/// away), and the price change to the customer; the system works out the
/// new budget, value and margin. It goes to the change board as a request
/// (CrmConfig.projectChangeTypeCode); approved, it writes the next budget
/// version, and the work it adds may start.
model ProjectChangeRequest {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  /// CR-1, CR-2 … within the project.
  seq             Int
  title           String
  reason          String
  scopeAdded      String?
  scopeRemoved    String?
  /// Working days the change adds (negative: saves).
  scheduleDays    Int       @default(0)
  /// [{ category, code, description, quantity, unit, unitCost, amount }] —
  /// a negative quantity takes cost away.
  costLines       Json      @default("[]")
  costChange      Decimal   @default(0) @db.Decimal(14, 2)
  /// What the customer pays more (negative: less).
  priceChange     Decimal   @default(0) @db.Decimal(14, 2)
  /// draft · submitted · approved · rejected · cancelled
  status          String    @default("draft")
  requestId       String?
  error           String?
  submittedAt     DateTime?
  submittedBy     String?
  decidedAt       DateTime?
  /// The budget version the approval wrote.
  budgetId        String?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@unique([projectId, seq])
  @@index([requestId])
  @@map("project_change_requests")
}

/// CD-183 — a project risk: taken over from the technical team (CD-141
/// Solution risks) or Legal (CD-158 contract issues), or raised by the
/// project. Scored likelihood × impact like CD-141; an owner, a response
/// plan, and a review every `reviewEveryDays`. An open high or critical
/// risk without a plan is put before the executives.
model ProjectRisk {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  /// technical · legal · project
  source          String    @default("project")
  /// The risk or issue it was taken from, so it is taken once.
  sourceRef       String?
  title           String
  description     String?
  likelihood      Int
  impact          Int
  ownerUserId     String?
  response        String?
  /// open · mitigated · accepted · closed
  status          String    @default("open")
  reviewEveryDays Int       @default(14)
  lastReviewedAt  DateTime?
  nextReviewOn    DateTime? @db.Date
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews ProjectRiskReview[]

  @@unique([projectId, seq])
  @@unique([projectId, sourceRef])
  @@index([companyId, status])
  @@map("project_risks")
}

/// CD-183 — one review of a risk: what was found, and the score and status
/// it left.
model ProjectRiskReview {
  id         String   @id @default(uuid())
  riskId     String
  note       String
  likelihood Int
  impact     Int
  status     String
  reviewedBy String
  reviewedAt DateTime @default(now())

  risk ProjectRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId, reviewedAt])
  @@map("project_risk_reviews")
}

/// CD-184 — a problem met on the way: what it does to the schedule
/// (working days) and the cost (baht), who fixes it by when, and how it was
/// resolved. One that changes what was sold becomes a change request
/// (CD-185).
model ProjectIssue {
  id                 String    @id @default(uuid())
  companyId          String
  projectId          String
  seq                Int
  title              String
  description        String?
  /// low · medium · high · critical
  severity           String    @default("medium")
  scheduleImpactDays Int       @default(0)
  costImpact         Decimal   @default(0) @db.Decimal(14, 2)
  ownerUserId        String
  dueOn              DateTime  @db.Date
  /// The task it holds up, if any.
  taskId             String?
  /// open · resolved
  status             String    @default("open")
  resolution         String?
  resolvedAt         DateTime?
  resolvedBy         String?
  /// The change request it became (CD-185).
  changeRequestId    String?
  createdAt          DateTime  @default(now())
  createdBy          String
  updatedAt          DateTime  @updatedAt
  updatedBy          String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([companyId, status, dueOn])
  @@map("project_issues")
}

/// CD-186 — a contact with the customer that bears on the project (a
/// meeting, call, email, site visit): who, what was said, what the customer
/// decided. A decision that changes the scope must become a change request
/// (CD-185); until it has, it is flagged.
model ProjectCustomerLog {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  /// meeting · call · email · site_visit · other
  kind            String
  occurredOn      DateTime @db.Date
  /// Who spoke for the customer.
  contactName     String?
  summary         String
  decision        String?
  affectsScope    Boolean  @default(false)
  changeRequestId String?
  createdAt       DateTime @default(now())
  createdBy       String
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([projectId, occurredOn])
  @@map("project_customer_logs")
}

/// CD-193 — whether an installment was billed and paid: the invoice and
/// the receipt. Recorded by hand until the SAP connector (CD-89) reads them
/// (`source` = sap). Keyed by the installment's number, not its row, so it
/// survives Legal rewriting the schedule (CD-164 saves it whole).
model ContractInstallmentBilling {
  id             String    @id @default(uuid())
  companyId      String
  contractId     String
  seq            Int
  invoiceNo      String?
  invoicedOn     DateTime? @db.Date
  invoicedAmount Decimal?  @db.Decimal(14, 2)
  paidOn         DateTime? @db.Date
  paidAmount     Decimal?  @db.Decimal(14, 2)
  /// manual · sap
  source         String    @default("manual")
  note           String?
  recordedAt     DateTime  @default(now())
  recordedBy     String
  updatedAt      DateTime  @updatedAt

  @@unique([contractId, seq])
  @@map("contract_installment_billings")
}

/// CD-200 markup ตามประเภทงาน กลุ่มสินค้า หรือกลุ่มลูกค้า — ช่องที่ว่าง = ตรงทุกค่า.
/// ใช้เสนอราคา = ต้นทุน × (1 + markup) เมื่อไม่มีราคามาตรฐาน/ราคาเฉพาะ.
model MarkupRule {
  id               String  @id @default(uuid())
  companyId        String
  /// เลขน้อยทำก่อน; เท่ากันใช้กฎที่ระบุเงื่อนไขมากกว่า.
  priority         Int     @default(100)
  workType         String?
  productGroupCode String?
  segmentValueId   String?
  markupPct        Decimal @db.Decimal(7, 2)
  note             String  @default("")
  active           Boolean @default(true)

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  @@index([companyId, active])
  @@map("markup_rules")
}

/// CD-191 — closing a project: the request that asks the project's
/// executives to close it (CrmConfig.projectCloseTypeCode). Approved, the
/// project becomes `closed`; rejected, it can be fixed and asked again.
/// Asking is refused while anything is owed (contract obligations, open
/// issues, unconverted customer decisions, pending changes, milestones not
/// reached, required documents missing, no lessons written).
model ProjectCloseout {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String    @unique
  /// draft · submitted · approved · rejected
  status      String    @default("draft")
  summary     String?
  requestId   String?
  error       String?
  submittedAt DateTime?
  submittedBy String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String
  updatedAt   DateTime  @updatedAt
  updatedBy   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@map("project_closeouts")
}

/// CD-191 — a document the project leaves behind: one of the required
/// close-out documents (by `title`) or any other. Removed = `deletedAt`.
model ProjectCloseDocument {
  id         String    @id @default(uuid())
  companyId  String
  projectId  String
  title      String
  note       String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("project_close_documents")
}

/// CD-191 — a lesson learned, kept with the project until KBMS (CD-22)
/// takes it (`kbmsStatus` pending → sent, `kbmsRef` its id there).
model ProjectLesson {
  id         String    @id @default(uuid())
  companyId  String
  projectId  String
  /// went_well · improve · recommend
  kind       String
  text       String
  kbmsStatus String    @default("pending")
  kbmsRef    String?
  createdAt  DateTime  @default(now())
  createdBy  String
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([kbmsStatus])
  @@map("project_lessons")
}

/// CD-192 — a project's weekly status report: drafted by the system each
/// Monday from the project's own figures (health, progress, milestones,
/// risks, issues, budget, payments — `snapshot`), refreshed daily while a
/// draft; the manager adds what was done, what is next and what help is
/// needed, and submits it, which freezes the figures.
model ProjectStatusReport {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  /// The Monday of the week it covers (Bangkok).
  weekStart     DateTime  @db.Date
  /// draft · submitted
  status        String    @default("draft")
  /// green · amber · red
  healthLevel   String
  healthScore   Int
  workPct       Decimal?  @db.Decimal(5, 1)
  plannedPct    Decimal?  @db.Decimal(5, 1)
  snapshot      Json
  snapshotAt    DateTime
  accomplished  String?
  nextSteps     String?
  helpNeeded    String?
  submittedAt   DateTime?
  submittedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, weekStart])
  @@index([companyId, weekStart])
  @@map("project_status_reports")
}

/// CD-221 — one thing the project must prove works: a line of the sold
/// scope, an acceptance criterion of a deliverable (both from the baseline),
/// scope an approved change request added, or one the manager adds. Its
/// state is its latest result (`ProjectTestRun`); none = untested. The
/// manager may waive one (with the reason) that no longer applies.
model ProjectTestItem {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  seq           Int
  /// scope · criterion · change · manual · integration (CD-219)
  source        String
  /// Where it came from, unique per project: `scope:3`, `deliverable:1:2`,
  /// `change:<id>`; null for one added by hand.
  sourceRef     String?
  /// The deliverable a criterion belongs to.
  deliverable   String?
  text          String
  /// How to test it.
  steps         String?
  /// CD-218 — the plan task this item proves; it closes when its evidence holds.
  taskId        String?
  ownerUserId   String?
  waivedReason  String?
  waivedAt      DateTime?
  waivedBy      String?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?
  deletedAt     DateTime?

  project Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  runs    ProjectTestRun[]

  @@unique([projectId, seq])
  @@unique([projectId, sourceRef])
  @@index([taskId])
  @@map("project_test_items")
}

/// CD-221 — a test run of an item: passed or failed, with its evidence. A
/// failure opens a project issue (CD-184) for the manager; a later run
/// supersedes it — every run is kept.
model ProjectTestRun {
  id           String   @id @default(uuid())
  companyId    String
  itemId       String
  /// pass · fail
  result       String
  note         String?
  evidenceKey  String?
  evidenceName String?
  evidenceMime String?
  evidenceSize Int?
  /// The issue a failure opened.
  issueId      String?
  testedBy     String
  testedAt     DateTime @default(now())

  item ProjectTestItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, testedAt])
  @@map("project_test_runs")
}

/// CD-225 — one line of a project's readiness check before handover: copied
/// from the company checklist (CrmConfig.projectReadinessChecklist) when the
/// manager starts the check, or added by them; an inspector named by the
/// manager records it passed or failed, on a date. Together with the checks
/// the system makes itself (tests complete — CD-221, no issue open), every
/// line passed is what lets the acceptance be asked for (CD-189).
model ProjectReadinessItem {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  text            String
  inspectorUserId String?
  /// null = not checked yet · pass · fail
  result          String?
  checkedOn       DateTime? @db.Date
  note            String?
  checkedBy       String?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@index([inspectorUserId, result])
  @@map("project_readiness_items")
}

/// CD-226 — a document of the project as built: one of the required
/// as-built documents (by `title`, CrmConfig.projectAsBuiltDocuments) or any
/// other; a newer upload under the same title is the current one. Removed =
/// `deletedAt`.
model ProjectAsBuiltDocument {
  id         String    @id @default(uuid())
  companyId  String
  projectId  String
  title      String
  note       String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("project_as_built_documents")
}

/// CD-226 — where what was built differs from what was sold (a BOQ line or a
/// scope line of the baseline, or neither): what was planned, what was
/// built, and why. One that changes the scope is settled only by an approved
/// change request (CD-185).
model ProjectAsBuiltDeviation {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  /// `boq:<i>` or `scope:<i>` in the baseline; null = neither.
  reference       String?
  planned         String
  built           String
  reason          String?
  affectsScope    Boolean   @default(false)
  changeRequestId String?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@map("project_as_built_deviations")
}

/// CD-189 — an acceptance round with the customer (A-n): booked only once
/// the readiness review passes (CD-225 — tests, as-built, checklist, no open
/// issue), for the milestone it accepts; then its result — accepted,
/// accepted with conditions (the open points, each with a date, followed to
/// the end) or rejected (why; a new round follows) — with the certificate
/// the customer signed. Accepted, the milestone is achieved (CD-182).
model ProjectAcceptance {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  milestoneId     String?
  scheduledAt     DateTime
  location        String?
  /// Who attends for the customer.
  customerPeople  String?
  /// What is brought: documents, demonstrations.
  preparation     String?
  /// scheduled · accepted · conditional · rejected · cancelled
  status          String    @default("scheduled")
  decidedOn       DateTime? @db.Date
  outcomeNote     String?
  certificateKey  String?
  certificateName String?
  certificateMime String?
  certificateSize Int?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?

  project Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items   ProjectAcceptanceItem[]

  @@unique([projectId, seq])
  @@index([projectId, status])
  @@map("project_acceptances")
}

/// CD-189 — a point the customer accepted the work on condition of (or
/// rejected it for): what, by when, who — followed until done.
model ProjectAcceptanceItem {
  id           String    @id @default(uuid())
  companyId    String
  acceptanceId String
  seq          Int
  text         String
  dueOn        DateTime  @db.Date
  ownerUserId  String?
  /// open · done
  status       String    @default("open")
  doneNote     String?
  doneAt       DateTime?
  doneBy       String?
  createdAt    DateTime  @default(now())

  acceptance ProjectAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)

  @@unique([acceptanceId, seq])
  @@index([status, dueOn])
  @@map("project_acceptance_items")
}

/// CD-205 ทะเบียนข้อยกเว้นด้านราคา — margin ต่ำกว่าเกณฑ์ / แก้ราคาด้วยมือ / ผู้อนุมัติเลือกส่วนลดทางเลือก.
/// เขียนเมื่อคำขออนุมัติราคาของใบเสนอราคาได้ผล (คงภาพ ณ ตอนนั้น); หนึ่งแถวต่อชนิดและเรื่องบนคำขอเดียว.
model PricingException {
  id            String  @id @default(uuid())
  companyId     String
  /// margin_below | price_override | discount_option
  kind          String
  /// work type (margin_below) · "<lineNo>:<product>" (price_override) · "v<version>" (discount_option)
  subjectKey    String
  requestId     String
  requestNo     String?
  quotationId   String
  quotationNo   String
  version       Int
  opportunityId String
  customerId    String?
  partyName     String
  currency      String
  netTotal      Decimal @db.Decimal(14, 2)

  workType     String?
  /// ปกปิดเหมือน margin ของใบเสนอราคา (SensitiveResource quotation).
  marginPct    Decimal? @db.Decimal(7, 2)
  minMarginPct Decimal? @db.Decimal(7, 2)
  productCode  String?
  description  String?
  systemPrice  Decimal? @db.Decimal(14, 2)
  unitPrice    Decimal? @db.Decimal(14, 2)
  /// CD-203 เพดานส่วนลดที่ผู้อนุมัติเลือก { service: 12.5 }.
  caps         Json?

  reason          String?
  requestedBy     String?
  requestedByName String?
  /// pending | approved | rejected | cancelled | superseded
  decision        String
  decidedAt       DateTime?
  approverIds     String[]  @default([])
  approverNames   String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, kind, subjectKey])
  @@index([companyId, createdAt])
  @@index([companyId, customerId])
  @@index([opportunityId])
  @@map("pricing_exceptions")
}

/// CD-222 — a point the customer raised while testing (U-n), with how
/// serious it is: a blocker stops the work being used, so it must be fixed
/// and the fix confirmed by the customer before acceptance (a system check
/// of the readiness review, CD-225); a major or minor one may instead be
/// deferred past acceptance, with the reason. Fixed → confirmed records who
/// at the customer confirmed it and when; a fix the customer does not
/// accept reopens it.
model ProjectUatFinding {
  id              String    @id @default(uuid())
  companyId       String
  projectId       String
  seq             Int
  title           String
  description     String?
  /// blocker · major · minor
  severity        String
  /// The test item (CD-221) it was found under, if any.
  testItemId      String?
  /// Who at the customer raised it, and when.
  reportedBy      String?
  reportedOn      DateTime  @db.Date
  ownerUserId     String?
  /// open · fixed · confirmed · deferred
  status          String    @default("open")
  fixNote         String?
  fixedAt         DateTime?
  fixedBy         String?
  confirmedByName String?
  confirmedOn     DateTime? @db.Date
  deferReason     String?
  /// The last time the customer turned a fix down.
  reopenNote      String?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@index([projectId, status])
  @@map("project_uat_findings")
}

/// CD-206 ต้นทุนคู่ค้าจาก SAP (สำเนา sync) — ราคาซื้อล่าสุดจากใบสั่งซื้อ และราคาพิเศษของผู้ขาย
/// ต่อสินค้า × ผู้ขาย × แหล่ง พร้อมวันที่ของข้อมูล. SAP เป็นเจ้าของ; ที่นี่อ่านอย่างเดียว.
model VendorCost {
  id          String    @id @default(uuid())
  companyId   String
  productCode String
  vendorCode  String
  vendorName  String?
  /// purchase_order | special_price
  source      String
  unitCost    Decimal   @db.Decimal(14, 2)
  currency    String
  docNo       String?
  /// วันที่ของต้นทุน: วันที่ใบสั่งซื้อ หรือวันเริ่มราคาพิเศษ.
  costDate    DateTime  @db.Date
  validTo     DateTime? @db.Date
  syncedAt    DateTime

  @@unique([companyId, productCode, vendorCode, source])
  @@index([companyId, productCode])
  @@map("vendor_costs")
}

/// CD-216 — one installation point (P-n): where, which BOQ line of the
/// baseline it installs, the unit's serial number (typed in until the SAP
/// connector reads it, CD-28; unique in the project), and photos before and
/// after. Installed = `installedOn` set, which needs the after photo (and the
/// serial, for equipment). Installed units per equipment line are compared
/// with the BOQ; a line that does not match needs an as-built deviation
/// (CD-226) pointing at it.
model ProjectInstallation {
  id           String    @id @default(uuid())
  companyId    String
  projectId    String
  seq          Int
  location     String
  /// The BOQ line of the baseline (0-based); null = not a BOQ item.
  boqIndex     Int?
  /// CD-218 — the plan task this point delivers; it closes when its evidence holds.
  taskId       String?
  serialNo     String?
  note         String?
  installedOn  DateTime? @db.Date
  installedBy  String?
  beforeKey    String?
  beforeName   String?
  beforeMime   String?
  afterKey     String?
  afterName    String?
  afterMime    String?
  createdAt    DateTime  @default(now())
  createdBy    String
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@unique([projectId, serialNo])
  @@index([projectId, boqIndex])
  @@index([taskId])
  @@map("project_installations")
}


/// CD-207 (ส่วนหนึ่งของ CD-17 HR) ระดับตำแหน่งที่ใช้คิดต้นทุนคน เช่น SE-2 วิศวกรอาวุโส.
model HrLevel {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates     HrLaborRate[]
  employees HrEmployee[]

  @@unique([companyId, code])
  @@map("hr_levels")
}

/// CD-207 ประเภทงานของบุคลากร เช่น ติดตั้ง พัฒนา ที่ปรึกษา ดูแลระบบ.
model HrWorkType {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates HrLaborRate[]

  @@unique([companyId, code])
  @@map("hr_work_types")
}

/// CD-207 อัตราต้นทุนคนต่อ manday ตามระดับ × ประเภทงาน มีวันที่มีผล — แหล่งเดียวของต้นทุนแรงงาน.
/// เพิ่มอัตราใหม่ = ปิดอัตราเดิมของคู่เดียวกันวันก่อนหน้า (ประวัติคงอยู่).
model HrLaborRate {
  id            String    @id @default(uuid())
  companyId     String
  levelId       String
  workTypeId    String
  costPerManday Decimal   @db.Decimal(14, 2)
  /// ราคาขายต่อ manday (ถ้ามี) — ไว้ใช้ภายหลัง.
  sellPerManday Decimal?  @db.Decimal(14, 2)
  validFrom     DateTime  @db.Date
  validTo       DateTime? @db.Date
  note          String    @default("")
  createdBy     String
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  level    HrLevel    @relation(fields: [levelId], references: [id])
  workType HrWorkType @relation(fields: [workTypeId], references: [id])

  @@index([companyId, levelId, workTypeId, validFrom])
  @@map("hr_labor_rates")
}

/// CD-211 — a version of the project's detailed design (v1, v2, …): the
/// drawings (files), the key configuration values, and how it differs from
/// the approved Solution version it comes from (the project's baseline).
/// A draft is approved through the request type in CRM settings
/// (`projectDesignTypeCode`); the newest approved version is the design in
/// force, and changing it means a new version approved again — an approved
/// version never changes.
model ProjectDesign {
  id                  String    @id @default(uuid())
  companyId           String
  projectId           String
  versionNo           Int
  title               String
  summary             String?
  /// [{ key, value }] — the configuration values the design fixes.
  configuration       Json      @default("[]")
  /// The Solution version of the baseline it was drawn from.
  solutionVersionId   String?
  differsFromSolution Boolean   @default(false)
  differences         String?
  /// draft · submitted · approved · rejected · superseded
  status              String    @default("draft")
  requestId           String?
  error               String?
  submittedAt         DateTime?
  submittedBy         String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  createdBy           String
  updatedAt           DateTime  @updatedAt
  updatedBy           String?

  project Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  files   ProjectDesignFile[]

  @@unique([projectId, versionNo])
  @@index([requestId])
  @@map("project_designs")
}

/// CD-211 — a drawing or document of a design version. A new version
/// copied from the one in force starts with the same files (the same
/// stored objects).
model ProjectDesignFile {
  id         String    @id @default(uuid())
  companyId  String
  designId   String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  design ProjectDesign @relation(fields: [designId], references: [id], onDelete: Restrict)

  @@index([designId])
  @@map("project_design_files")
}

/// CD-209 — equipment or a tool a task needs: a BOQ line of the baseline
/// (by index) or anything else by name, how many. The technical plan sums
/// them week by week from the plan's dates (CD-178).
model ProjectTaskEquipment {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  taskId    String
  boqIndex  Int?
  name      String
  quantity  Decimal  @db.Decimal(12, 2)
  unit      String?
  note      String?
  createdAt DateTime @default(now())
  createdBy String

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@map("project_task_equipment")
}

/// CD-210 — a site survey (S-n), filled on a phone and kept there while
/// offline: its id is made on the device, so sending it again never makes a
/// second one. It walks the Solution's assumptions from the baseline —
/// each holds or does not (`assumptions`: [{ index, text, holds, note,
/// changeRequestId }]); one that does not must become a change request
/// (CD-185) before the survey is completed.
model ProjectSurvey {
  id          String    @id
  companyId   String
  projectId   String
  seq         Int
  site        String
  surveyedOn  DateTime  @db.Date
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  summary     String?
  assumptions Json      @default("[]")
  /// draft · completed
  status      String    @default("draft")
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  createdBy   String
  updatedAt   DateTime  @updatedAt
  updatedBy   String?

  project Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  photos  ProjectSurveyPhoto[]

  @@unique([projectId, seq])
  @@map("project_surveys")
}

/// CD-210 — a photo of a survey, with where it was taken. Its id is made on
/// the device too, so a photo synced twice is kept once.
model ProjectSurveyPhoto {
  id         String    @id
  companyId  String
  surveyId   String
  caption    String?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  takenAt    DateTime?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())

  survey ProjectSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)

  @@index([surveyId])
  @@map("project_survey_photos")
}

/// CD-229 ทะเบียนพนักงาน — ข้อมูลของ HR ต่อคน × บริษัท (ระดับ การจ้าง สถานะ).
/// ตัวตน ชื่อ อีเมล ตำแหน่ง สังกัด และวันเริ่มงานอยู่ที่ users (ซิงก์จาก LDAP) — ไม่สร้างซ้ำที่นี่.
model HrEmployee {
  id             String    @id @default(uuid())
  companyId      String
  userId         String
  levelId        String?
  /// permanent | contract | outsource | intern
  employmentType String    @default("permanent")
  /// active | on_leave | resigned
  status         String    @default("active")
  endDate        DateTime? @db.Date
  note           String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  updatedBy      String?

  level HrLevel? @relation(fields: [levelId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId, levelId])
  @@map("hr_employees")
}

/// CD-229 รายการทักษะที่ HR ดูแล — ใช้ร่วมทุกบริษัท.
model HrSkill {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  category  String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holders HrUserSkill[]

  @@map("hr_skills")
}

/// CD-229 ทักษะของคน (ติดตัวคน ใช้ได้ทุกบริษัท) ระดับความชำนาญ 1–3 พร้อมใบรับรอง.
model HrUserSkill {
  id            String    @id @default(uuid())
  userId        String
  skillId       String
  /// 1 พื้นฐาน · 2 ทำได้เอง · 3 เชี่ยวชาญ
  proficiency   Int
  certificate   String    @default("")
  certExpiresOn DateTime? @db.Date
  note          String    @default("")
  updatedAt     DateTime  @updatedAt
  updatedBy     String?
  /// ถอดออกจากโปรไฟล์ — คงแถวไว้ (ไม่ลบจริง).
  deletedAt     DateTime?

  skill HrSkill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("hr_user_skills")
}

/// CD-213 ข้อบกพร่องงานพัฒนา — a defect found in software work, tied to the
/// SOW line it breaks. Open defects hold the line's development task open
/// (CD-218); a fix is closed only by a retest.
model ProjectDefect {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  seq            Int
  title          String
  description    String?
  /// blocker · major · minor
  severity       String
  /// The SOW line: scope:i · deliverable:d · change:<id>.
  sowRef         String
  /// The development task it came from (CD-212), if any.
  taskId         String?
  foundOn        DateTime  @db.Date
  assigneeUserId String?
  /// open · fixed · verified · cancelled
  status         String    @default("open")
  fixNote        String?
  fixedAt        DateTime?
  fixedBy        String?
  verifyNote     String?
  verifiedAt     DateTime?
  verifiedBy     String?
  /// The last time a retest failed.
  reopenNote     String?
  cancelNote     String?
  createdAt      DateTime  @default(now())
  createdBy      String
  updatedAt      DateTime  @updatedAt
  updatedBy      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@index([projectId, status])
  @@map("project_defects")
}

/// CD-214 Environment — where a project's software runs for the customer:
/// development, UAT, production, each with its address.
model ProjectEnvironment {
  id        String    @id @default(uuid())
  companyId String
  projectId String
  /// dev · uat · production
  kind      String
  name      String
  url       String?
  note      String?
  createdAt DateTime  @default(now())
  createdBy String
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deployments ProjectDeployment[]

  @@index([projectId])
  @@map("project_environments")
}

/// CD-214 Release — a version of the software made for the customer.
model ProjectRelease {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  version   String
  notes     String?
  createdAt DateTime @default(now())
  createdBy String

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deployments ProjectDeployment[]
  documents   ProjectSoftwareDocument[]

  @@unique([projectId, version])
  @@map("project_releases")
}

/// CD-214 — a release put on an environment, by whom and when. The latest
/// one on an environment is what runs there.
model ProjectDeployment {
  id             String   @id @default(uuid())
  companyId      String
  releaseId      String
  environmentId  String
  deployedAt     DateTime
  deployedBy     String
  note           String?
  /// Production without the UAT gate (a hotfix): the manager's reason.
  overrideReason String?
  createdAt      DateTime @default(now())

  release     ProjectRelease     @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  environment ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@index([environmentId, deployedAt])
  @@map("project_deployments")
}

/// CD-215 เอกสารซอฟต์แวร์ — specifications, manuals, interface documents:
/// the software's as-built, each file for one release (CD-214). A file
/// carried to a later release shares the stored object.
model ProjectSoftwareDocument {
  id         String    @id @default(uuid())
  companyId  String
  projectId  String
  releaseId  String
  title      String
  note       String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  release ProjectRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([projectId, releaseId])
  @@map("project_software_documents")
}

/// CD-217 ตั้งค่าระบบ — a configuration value as searchable data, not only
/// an attachment: system + key + value, on an installation point (CD-216) or
/// a software environment (CD-214) or a named system. A secret is stored
/// encrypted (AES-256-GCM, CONFIG_SECRET_KEY) and never searched.
model ProjectConfigItem {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  /// C-n within the project
  seq            Int
  system         String
  installationId String?
  environmentId  String?
  key            String
  /// plain values only; null for a secret
  value          String?
  isSecret       Boolean   @default(false)
  /// the secret, sealed; null for a plain value
  secretSealed   String?
  note           String?
  createdAt      DateTime  @default(now())
  createdBy      String
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  project Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  history ProjectConfigHistory[]

  @@unique([projectId, seq])
  @@index([companyId, key])
  @@map("project_config_items")
}

/// CD-217 — every change to a value (old and new, sealed for a secret) with
/// its reason, and every time a secret was shown.
model ProjectConfigHistory {
  id        String   @id @default(uuid())
  companyId String
  itemId    String
  /// created · updated · restored · removed · revealed
  action    String
  oldValue  String?
  newValue  String?
  oldSealed String?
  newSealed String?
  reason    String?
  actorId   String
  at        DateTime @default(now())

  item ProjectConfigItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, at])
  @@map("project_config_history")
}

/// CD-219 เชื่อมต่อระบบ — a point where the delivered system meets another
/// system of the customer: what, which way, how, and who answers for it on
/// the customer's side (a CRM contact, or typed in). Its connection test is
/// a test item (CD-221, sourceRef `integration:<id>`); its addresses and
/// secrets live in the project configuration (CD-217) under the same name.
model ProjectIntegration {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  /// I-n within the project
  seq            Int
  name           String
  /// the customer's system on the other side
  targetSystem   String
  /// outbound · inbound · both
  direction      String
  protocol       String?
  endpoint       String?
  description    String?
  /// a contact of the project's customer (CRM), or the typed fields below
  contactId      String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  testItemId     String?
  createdAt      DateTime  @default(now())
  createdBy      String
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@map("project_integrations")
}

/// CD-224 ปรับแก้ทางเทคนิค — a technical change the engineers ask approval
/// for, with what it does to the BOQ, the cost and the scope. Approved under
/// CrmConfig.projectTechChangeTypeCode; one that changes the scope also
/// carries a change request (CD-185) and is in force only once both are
/// approved — then its BOQ lines become as-built deviations (CD-226).
model ProjectTechChange {
  id               String    @id @default(uuid())
  companyId        String
  projectId        String
  /// TC-n within the project
  seq              Int
  title            String
  reason           String?
  description      String?
  /// [{ref: 'boq:i'|null, name, unit, quantityFrom, quantityTo, unitCost}]
  boqLines         Json      @default("[]")
  costChange       Decimal   @default(0) @db.Decimal(14, 2)
  affectsScope     Boolean   @default(false)
  scopeAdded       String?
  scopeRemoved     String?
  changeRequestId  String?
  /// draft · submitted · approved · rejected · cancelled
  status           String    @default("draft")
  requestId        String?
  error            String?
  submittedAt      DateTime?
  submittedBy      String?
  decidedAt        DateTime?
  /// when its deviations went into the as-built
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  createdBy        String
  updatedAt        DateTime  @updatedAt
  updatedBy        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@index([requestId])
  @@map("project_tech_changes")
}

/// CD-231 Timesheet รายสัปดาห์ต่อคน (สัปดาห์เริ่มวันจันทร์) — ร่าง → ส่ง → อนุมัติ/ตีกลับ โดยหัวหน้าตามผัง.
model HrTimesheet {
  id           String    @id @default(uuid())
  companyId    String
  userId       String
  /// วันจันทร์ของสัปดาห์
  weekStart    DateTime  @db.Date
  /// draft | submitted | approved | returned
  status       String    @default("draft")
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String?
  returnReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines HrTimesheetLine[]

  @@unique([companyId, userId, weekStart])
  @@index([companyId, status])
  @@map("hr_timesheets")
}

/// CD-231 ชั่วโมงต่อวันต่องาน — โครงการ (+งานย่อย) / เคสบริการ (คำขอ) / Pre-Sales (Solution) / งานภายใน.
model HrTimesheetLine {
  id            String   @id @default(uuid())
  timesheetId   String
  workDate      DateTime @db.Date
  /// project | service | presales | internal
  kind          String
  projectId     String?
  projectTaskId String?
  /// เคสบริการ = คำขอ (CD-67)
  requestId     String?
  solutionId    String?
  internalCode  String?
  /// ประเภทงานของ HR (CD-207) — ใช้คิดต้นทุนแรงงาน
  workTypeId    String
  hours         Decimal  @db.Decimal(4, 1)
  billable      Boolean
  note          String   @default("")

  timesheet HrTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId, workDate])
  @@index([projectId, workDate])
  @@map("hr_timesheet_lines")
}

/// CD-231 งานภายใน (ไม่ billable) ที่ลงเวลาได้ เช่น อบรม ประชุม งานธุรการ — ใช้ร่วมทุกบริษัท.
model HrInternalActivity {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hr_internal_activities")
}

/// CD-232 ประเภทการลาของบริษัท (ลาพักร้อน ลาป่วย ลากิจ …) พร้อมสิทธิ์ตั้งต้นต่อปี (null = ไม่จำกัด).
model HrLeaveType {
  id         String   @id @default(uuid())
  companyId  String
  code       String
  name       String
  /// วันต่อปีปฏิทิน; null = ไม่นับโควตา.
  annualDays Decimal? @db.Decimal(4, 1)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leaves       HrLeave[]
  entitlements HrLeaveEntitlement[]

  @@unique([companyId, code])
  @@map("hr_leave_types")
}

/// CD-232 สิทธิ์วันลาของคนหนึ่งในปีหนึ่ง ที่ฝ่ายบุคคลตั้งแทนค่าตั้งต้นของประเภท.
model HrLeaveEntitlement {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  leaveTypeId String
  year        Int
  days        Decimal  @db.Decimal(4, 1)
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, leaveTypeId, year])
  @@map("hr_leave_entitlements")
}

/// CD-232 ใบลา — เต็มวันเป็นช่วง หรือครึ่งวัน (เช้า/บ่าย) วันเดียว; หัวหน้าตามผังหรือฝ่ายบุคคลอนุมัติ.
/// `days` = วันทำการในช่วง (ไม่นับวันหยุดบริษัท). รออนุมัติ/อนุมัติแล้ว ถือว่าไม่ว่าง.
model HrLeave {
  id           String    @id @default(uuid())
  companyId    String
  userId       String
  leaveTypeId  String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  /// full | am | pm
  part         String    @default("full")
  days         Decimal   @db.Decimal(4, 1)
  reason       String    @default("")
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId, userId, startDate])
  @@index([companyId, status])
  @@map("hr_leaves")
}

/// CD-232 การจองตัวคนเข้าโครงการเป็นช่วงวัน (ชั่วโมงต่อวันทำการ) — PM ของโครงการหรือฝ่ายบุคคลจอง.
/// ความพร้อม = 8 ชม. ในวันทำการ − ลา − ที่ถูกจอง; จองเกินได้แต่มีคำเตือน (CD-180 ตรวจการจองซ้อนต่อ).
model HrBooking {
  id          String    @id @default(uuid())
  companyId   String
  userId      String
  projectId   String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  hoursPerDay Decimal   @db.Decimal(3, 1)
  note        String    @default("")
  createdBy   String
  cancelledAt DateTime?
  cancelledBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, userId, startDate])
  @@index([projectId])
  @@map("hr_bookings")
}

/// CD-190 ติดตามต้นทุนโครงการ — an actual cost outside labour (labour comes
/// from approved timesheets, CD-231): read from the ERP by project code
/// (`erpKey` set, replaced on every sync) or entered by the manager with its
/// evidence.
model ProjectCost {
  id           String    @id @default(uuid())
  companyId    String
  projectId    String
  /// material · other
  category     String
  /// erp · manual
  source       String
  /// the ERP line's identity, unique per project; null for a manual entry
  erpKey       String?
  docNo        String?
  description  String
  amount       Decimal   @db.Decimal(14, 2)
  incurredOn   DateTime  @db.Date
  vendorName   String?
  evidenceKey  String?
  evidenceName String?
  evidenceMime String?
  evidenceSize Int?
  createdAt    DateTime  @default(now())
  createdBy    String
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, erpKey])
  @@index([projectId, incurredOn])
  @@map("project_costs")
}

/// CD-190 — a threshold crossed, told once per budget version and level.
model ProjectCostAlert {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  budgetVersionNo Int
  /// material · labor · other · total
  category        String
  /// warn · over
  level           String
  budget          Decimal  @db.Decimal(14, 2)
  actual          Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, budgetVersionNo, category, level])
  @@map("project_cost_alerts")
}

/// CD-233 manday เกินแผน — ขั้น (% ของแผน) ที่แจ้งไปแล้วต่อโครงการต่อเวอร์ชันงบ; threshold 0 = สรุปตอนปิดโครงการ.
/// งบเวอร์ชันใหม่ (CR) เริ่มนับขั้นใหม่.
model HrMandayAlert {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  budgetVersionNo Int      @default(0)
  threshold       Int
  plannedMandays  Decimal  @db.Decimal(10, 2)
  actualMandays   Decimal  @db.Decimal(10, 2)
  sentAt          DateTime @default(now())

  @@unique([projectId, budgetVersionNo, threshold])
  @@index([companyId])
  @@map("hr_manday_alerts")
}

/// CD-180 จัดสรรทรัพยากร — a booking (CD-232 `hr_bookings`) that puts someone
/// past what they have free: which project comes first, why, and the
/// projects it clashed with (their managers are told).
model ProjectBookingPriority {
  id                 String   @id @default(uuid())
  companyId          String
  projectId          String
  bookingId          String   @unique
  userId             String
  /// this_first · others_first
  priority           String
  reason             String
  conflictProjectIds String[] @default([])
  overbookedDays     Int
  createdBy          String
  createdAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("project_booking_priorities")
}

/// CD-180 — asking for more people when the team is not enough, approved
/// through the request engine (CrmConfig.projectResourceTypeCode).
model ProjectResourceRequest {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String
  /// RR-n within the project
  seq         Int
  role        String
  skillId     String?
  headcount   Int
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  hoursPerDay Decimal   @db.Decimal(3, 1)
  note        String?
  /// draft · submitted · approved · rejected · fulfilled · cancelled
  status      String    @default("draft")
  requestId   String?
  error       String?
  submittedAt DateTime?
  submittedBy String?
  decidedAt   DateTime?
  fulfilledAt DateTime?
  fulfilledBy String?
  createdAt   DateTime  @default(now())
  createdBy   String
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, seq])
  @@index([requestId])
  @@map("project_resource_requests")
}

/// CD-236 ทะเบียนอุปกรณ์ที่ติดตั้ง — what each customer has: equipment by
/// serial and location, and software by its production environment (the
/// version shown is what runs there now, CD-214). Made at acceptance from
/// the project's installation points (CD-216) and production environments;
/// the service team adds what predates the system, by hand or from a file.
model ServiceAsset {
  id             String    @id @default(uuid())
  companyId      String
  customerId     String?
  projectId      String?
  /// equipment · software
  kind           String
  /// project · manual · import
  source         String
  /// CD-216 point it came from; one asset per point
  installationId String?  @unique
  /// CD-214 production environment it came from; one asset per environment
  environmentId  String?   @unique
  productCode    String?
  name           String
  model          String?
  serialNo       String?
  location       String?
  /// software kept by hand: its version
  version        String?
  installedOn    DateTime? @db.Date
  acceptedOn     DateTime? @db.Date
  /// active · replaced · removed
  status         String    @default("active")
  note           String?
  createdAt      DateTime  @default(now())
  createdBy      String
  updatedAt      DateTime  @updatedAt
  updatedBy      String?

  history      ServiceAssetHistory[]
  entitlements ServiceEntitlementAsset[]

  @@unique([companyId, serialNo])
  @@index([companyId, customerId])
  @@index([projectId])
  @@map("service_assets")
}

/// CD-236 — every change to an asset: what it was, what it became, why.
model ServiceAssetHistory {
  id        String   @id @default(uuid())
  companyId String
  assetId   String
  /// created · updated · status
  action    String
  before    Json?
  after     Json?
  reason    String?
  actorId   String
  at        DateTime @default(now())

  asset ServiceAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, at])
  @@map("service_asset_history")
}

/// CD-237 สิทธิ์การรับบริการ — what covers a customer's installed assets: a
/// warranty (made at acceptance from the project's contract, CD-155) or a
/// service contract (MA) the service team sets from the contract register —
/// with its service level (CD-151: coverage hours and per-severity times),
/// its period, and its visit quotas, corrective and preventive apart.
model ServiceEntitlement {
  id                String       @id @default(uuid())
  companyId         String
  customerId        String
  contractId        String?
  projectId         String?
  /// warranty · service_contract
  kind              String
  title             String
  startOn           DateTime     @db.Date
  endOn             DateTime     @db.Date
  coverage          SlaCoverage?
  /// per severity: {critical: {responseHours, resolutionHours}, …}
  severityTargets   Json?
  /// null = unlimited
  correctiveQuota   Int?
  preventiveQuota   Int?
  /// counted by the service work orders (CD-239)
  correctiveUsed    Int          @default(0)
  preventiveUsed    Int          @default(0)
  note              String?
  /// acceptance round it came from, for a warranty
  source            String?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  createdAt         DateTime     @default(now())
  createdBy         String
  updatedAt         DateTime     @updatedAt
  updatedBy         String?

  assets ServiceEntitlementAsset[]

  @@index([companyId, customerId])
  @@index([contractId])
  @@map("service_entitlements")
}

/// CD-237 — an asset under an entitlement (taken off keeps the row).
model ServiceEntitlementAsset {
  entitlementId String
  assetId       String
  addedAt       DateTime  @default(now())
  addedBy       String
  removedAt     DateTime?
  removedBy     String?

  entitlement ServiceEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  asset       ServiceAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([entitlementId, assetId])
  @@index([assetId])
  @@map("service_entitlement_assets")
}

/// CD-250 แผนส่งมอบ — รอบส่งของหนึ่งรอบของหมุดหมาย (หมุดหมายหนึ่งส่งได้หลายรอบ):
/// วันที่ สถานที่ ผู้รับ และบรรทัด BOQ × จำนวน. planned · delivered · cancelled.
model ProjectDelivery {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  milestoneId   String
  seq           Int
  plannedOn     DateTime  @db.Date
  location      String
  receiverName  String    @default("")
  receiverPhone String    @default("")
  note          String    @default("")
  status        String    @default("planned")
  /// แจ้งเตือนของยังไม่พร้อมไปแล้ว (ครั้งเดียวต่อวันที่ตามแผน).
  warnedFor     DateTime? @db.Date
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  lines ProjectDeliveryLine[]

  @@unique([projectId, seq])
  @@index([companyId, status, plannedOn])
  @@index([milestoneId])
  @@map("project_deliveries")
}

/// CD-250 บรรทัดของรอบส่ง: บรรทัด BOQ ของฐานตั้งต้น (0-based) × จำนวน และความพร้อมของสินค้า
/// (บันทึกเองจนกว่าจะอ่านสต็อก SAP ได้ — CD-28). ไม่พร้อม/บางส่วนต้องมีแผนสำรอง.
model ProjectDeliveryLine {
  id           String    @id @default(uuid())
  deliveryId   String
  boqIndex     Int
  quantity     Decimal   @db.Decimal(12, 2)
  /// unknown · ready · partial · not_ready
  readiness    String    @default("unknown")
  readyQty     Decimal?  @db.Decimal(12, 2)
  expectedOn   DateTime? @db.Date
  fallbackPlan String    @default("")
  note         String    @default("")

  delivery ProjectDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("project_delivery_lines")
}

/// CD-254 ยืนยันงานติดตั้งของเฟส (หมุดหมาย) เสร็จ — ผู้จัดการโครงการยืนยันเมื่อการตรวจความพร้อม (CD-225)
/// ผ่าน (ยกเว้นข้อเอกสารส่งมอบ); เป็นข้อหนึ่งของการตรวจความพร้อมก่อนนัดตรวจรับเฟสนั้น.
/// `checks` = ผลการตรวจ ณ ตอนยืนยัน. ยกเลิกได้ก่อนเฟสบรรลุ (ลบแถว + audit).
model ProjectInstallConfirmation {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  milestoneId String   @unique
  note        String   @default("")
  checks      Json     @default("[]")
  confirmedAt DateTime @default(now())
  confirmedBy String

  @@index([projectId])
  @@map("project_install_confirmations")
}

/// CD-252 ใบรับรองการตรวจรับของรอบตรวจรับหนึ่ง (CD-189) — ระบบสร้าง PDF ตามแบบบริษัท ส่งลงนามอิเล็กทรอนิกส์
/// (CD-14) หรือรับฉบับกระดาษที่สแกนพร้อมเหตุผล. `signed` เท่านั้นที่ใช้วางบิลได้ (CD-253).
/// draft · sent · signed · cancelled ; source esign · paper
model AcceptanceCertificate {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  acceptanceId  String    @unique
  milestoneId   String?
  certificateNo String
  status        String    @default("draft")
  source        String    @default("esign")
  draftKey      String?
  envelopeId    String?   @unique
  signedKey     String?
  signedName    String?
  signedSize    Int?
  signedAt      DateTime?
  paperReason   String?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  @@index([projectId])
  @@map("acceptance_certificates")
}

/// CD-253 การวางบิลงวดของสัญญาเข้า SAP (ฉบับร่างใบแจ้งหนี้ — CD-242 ErpClient) — หนึ่งแถวต่องวด
/// (สัญญา + ลำดับงวด เหมือน CD-193). ผู้จัดการโครงการยืนยันเมื่อเงื่อนไขของชนิดงวดครบ
/// (มัดจำ: สัญญาลงนาม · ตามความคืบหน้า/สุดท้าย: หมุดหมายบรรลุ + ใบรับรองลงนาม + รายการค้างปิด
/// หรือคำขอยกเว้นอนุมัติ · คืนเงินประกัน: พ้นระยะประกัน). reference = NumAtCard `INS-<สัญญา>-<งวด>`.
/// status: sent · cancelled ; exceptionStatus: none · submitted · approved · rejected
model InstallmentInvoice {
  id                 String    @id @default(uuid())
  companyId          String
  projectId          String
  contractId         String
  seq                Int
  kind               String
  label              String
  reference          String
  customerId         String
  currency           String    @default("THB")
  /// before VAT — SAP adds VAT
  amount             Decimal   @db.Decimal(14, 2)
  acceptanceId       String?
  status             String    @default("none")
  note               String?
  exceptionStatus    String    @default("none")
  exceptionRequestId String?   @unique
  exceptionReason    String?
  confirmedBy        String?
  confirmedAt        DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  cancelReason       String?
  erpStatus          String    @default("none")
  erpDraftNo         String?
  erpLastError       String?
  erpSyncedAt        DateTime?
  erpInvoiceStatus   String?
  erpInvoiceNo       String?
  erpInvoiceTotal    Decimal?  @db.Decimal(14, 2)
  erpPaid            Decimal?  @db.Decimal(14, 2)
  erpCheckedAt       DateTime?
  createdAt          DateTime  @default(now())
  createdBy          String
  updatedAt          DateTime  @updatedAt
  updatedBy          String?

  @@unique([contractId, seq])
  @@unique([companyId, reference])
  @@index([projectId])
  @@index([erpStatus, erpCheckedAt])
  @@map("installment_invoices")
}

/// CD-253 เตือนคืนเงินประกันผลงานล่วงหน้าแล้ว (ครั้งเดียวต่องวดต่อวันสิ้นสุดประกัน).
model RetentionReminder {
  id         String   @id @default(uuid())
  companyId  String
  contractId String
  seq        Int
  dueOn      DateTime @db.Date
  sentAt     DateTime @default(now())

  @@unique([contractId, seq, dueOn])
  @@map("retention_reminders")
}

/// CD-255 ส่งมอบงานให้ทีมบริการหลังตรวจรับ (รอบตรวจรับละหนึ่ง) — ทีม Delivery ส่งชุดข้อมูล
/// (อุปกรณ์ สิทธิ์ประกัน ระดับบริการ เอกสาร ใบรับรอง ผู้ติดต่อ รายการค้าง) ทีมบริการรับทราบ
/// หรือถามกลับ; ค้างเกินกำหนดเตือนซ้ำ (CD-53 service.handover). sent · questioned · acknowledged
model ServiceHandover {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  acceptanceId   String    @unique
  milestoneId    String?
  status         String    @default("sent")
  note           String    @default("")
  /// ชุดข้อมูล ณ ตอนส่ง: { assetIds, entitlementIds, documentIds, certificateId, contactIds, openPoints }
  snapshot       Json      @default("{}")
  sentBy         String
  sentAt         DateTime  @default(now())
  question       String?
  questionedBy   String?
  questionedAt   DateTime?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  ackNote        String?
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([projectId])
  @@map("service_handovers")
}

/// CD-256 — when a person was last sent the overdue-installments digest (the
/// `receivable.overdue` rule repeats it every N days).
model ReceivableReminder {
  companyId String
  userId    String
  sentAt    DateTime
  count     Int
  amount    Decimal  @db.Decimal(18, 2)

  @@id([companyId, userId])
  @@map("receivable_reminders")
}

/// CD-259 (part of CD-22 KBMS) — a process category of the knowledge base,
/// kept by its owners (`kb.article.manage`); one level under another at most.
model KbCategory {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  parentId     String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  /// CD-260 — months between reviews of its articles (null = 12; a
  /// sub-category without its own takes its parent's).
  reviewMonths Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, parentId, name])
  @@index([companyId])
  @@map("kb_categories")
}

/// CD-259 — a knowledge article: Markdown, by product (SAP item codes and
/// item groups), process category and free symptom tags. draft · published
/// · archived. `source` is where it came from (manual now; closed service
/// jobs, project lessons and Pre-Sales answers later — CD-262..264).
model KbArticle {
  id               String    @id @default(uuid())
  companyId        String
  articleNo        String
  title            String
  summary          String?
  body             String    @default("")
  status           String    @default("draft")
  categoryId       String?
  tags             String[]  @default([])
  productCodes     String[]  @default([])
  productGroups    String[]  @default([])
  source           String    @default("manual")
  sourceRef        String?
  authorId         String
  publishedAt      DateTime?
  publishedBy      String?
  archivedAt       DateTime?
  archivedBy       String?
  views            Int       @default(0)
  helpfulYes       Int       @default(0)
  helpfulNo        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  updatedBy        String?
  /// CD-260 — who answers for it (reviews it); the author at first.
  ownerId          String?
  /// CD-260 — the published version's number (0 = never published).
  version          Int       @default(0)
  /// CD-260 — a first draft sent for review (in_review) and sent back.
  submittedAt      DateTime?
  reviewNote       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  nextReviewOn     DateTime? @db.Date
  lastReviewedAt   DateTime?
  lastReviewedBy   String?
  reviewRemindedOn DateTime? @db.Date
  /// CD-260 — merged into another article (archived, readers sent on).
  mergedIntoId     String?
  /// CD-261 — who it is for: internal (staff only) · customers (every
  /// customer, in the Portal too) · selected (only `customerIds`, and staff
  /// who can see one of them in CRM).
  audience         String    @default("internal")
  customerIds      String[]  @default([])
  /// CD-261 — Portal readers' views and votes, apart from staff's.
  portalViews      Int       @default(0)
  portalHelpfulYes Int       @default(0)
  portalHelpfulNo  Int       @default(0)

  @@unique([companyId, articleNo])
  @@index([companyId, status])
  @@index([categoryId])
  @@map("kb_articles")
}

/// CD-259 — one reader's say on whether an article helped (latest wins).
model KbArticleRating {
  articleId String
  userId    String
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([articleId, userId])
  @@map("kb_article_ratings")
}

/// CD-259 — an image or file an article shows or links (MinIO).
model KbArticleFile {
  id         String    @id @default(uuid())
  articleId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@index([articleId])
  @@map("kb_article_files")
}

/// CD-260 — a reworking of a published article: the published one stays
/// up while this is written and reviewed. draft · in_review · returned ·
/// approved · discarded; one open at a time per article.
model KbArticleRevision {
  id            String    @id @default(uuid())
  articleId     String
  status        String    @default("draft")
  title         String
  summary       String?
  body          String
  categoryId    String?
  tags          String[]  @default([])
  productCodes  String[]  @default([])
  productGroups String[]  @default([])
  changeNote    String    @default("")
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submittedAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  /// CD-261
  audience      String    @default("internal")
  customerIds   String[]  @default([])

  @@index([articleId, status])
  @@map("kb_article_revisions")
}

/// CD-260 — what was published, each time: the text, who approved it, when.
model KbArticleVersion {
  id            String   @id @default(uuid())
  articleId     String
  version       Int
  title         String
  summary       String?
  body          String
  categoryId    String?
  tags          String[] @default([])
  productCodes  String[] @default([])
  productGroups String[] @default([])
  changeNote    String   @default("")
  writtenBy     String
  approvedBy    String
  approvedAt    DateTime @default(now())
  /// CD-261
  audience      String   @default("internal")
  customerIds   String[] @default([])

  @@unique([articleId, version])
  @@map("kb_article_versions")
}

/// CD-261 — a Portal contact's say on whether an article helped (latest wins).
model KbPortalRating {
  articleId String
  contactId String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([articleId, contactId])
  @@map("kb_portal_ratings")
}

/// CD-262 — a closed service job waiting to become knowledge: its symptom,
/// cause and fix, picked by the service team or a knowledge owner into a
/// draft (several jobs into one), or skipped. pending · drafted · skipped.
model KbCandidate {
  id          String    @id @default(uuid())
  companyId   String
  /// work_order (CD-262) · presales (CD-264, a Solution's answered question)
  source      String    @default("work_order")
  /// the row it came from: the work order, or the clarification
  sourceId    String
  workOrderId String?
  requestId   String?
  /// what to show for where it came from: the job's request number, or the
  /// Solution's title (CD-264)
  requestNo   String?
  /// CD-264 — the Solution, to open it from the inbox
  solutionId  String?
  /// the symptom / the question
  title       String
  /// the cause (empty for a question)
  cause       String
  /// the fix / the answer
  resolution  String
  productCode String?
  groupCode   String?
  customerId  String?
  closedAt    DateTime
  status      String    @default("pending")
  articleId   String?
  decidedBy   String?
  decidedAt   DateTime?
  skipReason  String?
  createdAt   DateTime  @default(now())

  @@unique([source, sourceId])
  @@index([companyId, status])
  @@index([workOrderId])
  @@map("kb_candidates")
}

/// CD-262 — an article a technician used to fix a service job.
model KbArticleUse {
  articleId   String
  workOrderId String
  usedBy      String
  usedAt      DateTime @default(now())

  @@id([articleId, workOrderId])
  @@index([workOrderId])
  @@map("kb_article_uses")
}

/// CD-262 — the article kept in step with a root-cause problem (CD-246):
/// `syncedAt` is the problem's `updatedAt` its text was last taken from.
model KbProblemLink {
  problemId String   @id
  articleId String
  syncedAt  DateTime
  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("kb_problem_links")
}

/// CD-265 — one search an AI channel (AI CARE, AI SMART) made of the
/// knowledge base, what it got back, and what it answered with. The
/// question and answer texts are cleared after the retention period
/// (`textPurgedAt`); which articles were cited and whether it could answer
/// stay for the figures. pending · answered · unanswered
model KbAiQuery {
  id              String    @id @default(uuid())
  companyId       String
  channel         String
  conversationRef String?
  customerId      String?
  question        String?
  /// [{ articleId, version }] in the order returned
  results         Json      @default("[]")
  outcome         String    @default("pending")
  answer          String?
  answeredAt      DateTime?
  textPurgedAt    DateTime?
  /// CD-266 — the knowledge gap an unanswered question was counted into
  gapId           String?
  createdAt       DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, outcome])
  @@map("kb_ai_queries")
}

/// CD-265 — an article an AI answer cited, at the version it read.
model KbAiCitation {
  queryId   String
  articleId String
  version   Int
  createdAt DateTime @default(now())

  @@id([queryId, articleId])
  @@index([articleId])
  @@map("kb_ai_citations")
}

/// CD-266 — a gap in the knowledge base, for the team to fill:
/// ai_unanswered (a question an AI channel could not answer; the same
/// question counted once), low_rated (a published article readers found
/// unhelpful) or search_miss (a staff search that found nothing, counted).
/// open · assigned · resolved · dismissed. Closed by an article once it is
/// published (or, for a low-rated one, by its next version).
model KbGap {
  id                  String    @id @default(uuid())
  companyId           String
  kind                String
  /// what makes it the same gap: the question or search words normalised, or the article id
  key                 String
  title               String
  /// the latest wording seen (cleared with the AI texts past retention)
  detail              String?
  occurrences         Int       @default(1)
  /// low_rated — the article, and its version when the gap opened
  articleId           String?
  articleVersion      Int?
  /// low_rated — the article's votes (staff + Portal) when the gap last
  /// closed: only votes after count, so a fixed article starts afresh
  baseYes             Int       @default(0)
  baseNo              Int       @default(0)
  status              String    @default("open")
  assigneeId          String?
  dueOn               DateTime? @db.Date
  assignedBy          String?
  assignedAt          DateTime?
  /// the article that fills it (closes when published)
  resolutionArticleId String?
  resolvedAt          DateTime?
  resolvedBy          String?
  dismissReason       String?
  remindedOn          DateTime? @db.Date
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([companyId, kind, key])
  @@index([companyId, status])
  @@index([assigneeId, status])
  @@map("kb_gaps")
}

/// CD-239 ใบสั่งงานบริการ — the service side of a case (a request, CD-67):
/// which asset, corrective or preventive, and from the start whether it is
/// covered or billed — the system suggests from the asset's entitlements
/// (CD-237), a person confirms, a different answer needs its reason, and a
/// billed job needs the customer's acknowledgement before work starts. Closed
/// with its cause and fix.
model ServiceWorkOrder {
  id                     String    @id @default(uuid())
  companyId              String
  requestId              String    @unique
  customerId             String?
  assetId                String?
  /// corrective · preventive
  workKind               String
  /// what the system suggested at opening: in_contract · billable
  suggestedBilling       String
  suggestedEntitlementId String?
  suggestionNote         String?
  /// confirmed: in_contract · billable (null until confirmed)
  billing                String?
  entitlementId          String?
  billingReason          String?
  confirmedBy            String?
  confirmedAt            DateTime?
  /// the quota counter this order took (corrective · preventive), given back on cancel
  quotaTaken             String?
  /// a billed job: who agreed for the customer, when, the estimate
  ackName                String?
  ackOn                  DateTime? @db.Date
  ackEstimate            Decimal?  @db.Decimal(14, 2)
  ackBy                  String?
  cause                  String?
  resolution             String?
  createdAt              DateTime  @default(now())
  createdBy              String
  updatedAt              DateTime  @updatedAt
  updatedBy              String?

  @@index([companyId, customerId])
  @@index([assetId])
  @@map("service_work_orders")
}

/// CD-241 ตารางเวรนอกเวลา — a span of days (inclusive, the company's local
/// dates) with a primary on call and a backup. Out of hours is the company's
/// working calendar's: outside the day's window, weekends and holidays.
/// Spans may not overlap within a company. Removed = deletedAt.
model ServiceOnCallShift {
  id            String    @id @default(uuid())
  companyId     String
  startOn       DateTime  @db.Date
  endOn         DateTime  @db.Date
  primaryUserId String
  backupUserId  String?
  note          String?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?

  @@index([companyId, startOn])
  @@map("service_on_call_shifts")
}

/// CD-241 — an out-of-hours case sent to whoever was on call (made its
/// receiver), and handed to the backup when they did not receive it in time.
model ServiceOnCallDispatch {
  id                     String    @id @default(uuid())
  companyId              String
  requestId              String    @unique
  shiftId                String
  /// whoever it was sent to last; level primary · backup
  userId                 String
  level                  String
  /// the receiver the case had before it was sent to the rota
  previousReceiverUserId String?
  sentAt                 DateTime  @default(now())
  /// handed on: from whom (userId is then the backup)
  escalatedAt            DateTime?
  escalatedFromUserId    String?
  /// no longer watched: received, closed, handed on, or nobody to hand to
  settledAt              DateTime?

  @@index([settledAt, sentAt])
  @@map("service_on_call_dispatches")
}

/// CD-242 ส่งข้อมูลเรียกเก็บเงินงานบริการ — a billed service job's charge,
/// one per work order: lines the service team confirms (from the customer's
/// agreed estimate, edited; CD-243 adds time and materials), then sent to SAP
/// B1 as a draft A/R invoice that finance posts. Separate from project
/// installment billing (CD-164/193).
///   status: draft (being prepared) · confirmed (sent / to send) · cancelled
///   erpStatus: none · pending · synced · not_ready · failed · skipped
///   erpInvoiceStatus (read back): draft · open · paid · cancelled · missing
model ServiceBilling {
  id               String    @id @default(uuid())
  companyId        String
  workOrderId      String    @unique
  requestId        String
  customerId       String
  /// our reference in SAP (`NumAtCard`): SVB-<request number>
  reference        String
  status           String    @default("draft")
  currency         String    @default("THB")
  /// before VAT, the sum of the lines
  netTotal         Decimal   @default(0) @db.Decimal(14, 2)
  note             String?
  confirmedBy      String?
  confirmedAt      DateTime?
  cancelledBy      String?
  cancelledAt      DateTime?
  cancelReason     String?
  erpStatus        String    @default("none")
  /// the draft's key in SAP (B1 Drafts DocEntry)
  erpDraftNo       String?
  erpLastError     String?
  erpSyncedAt      DateTime?
  erpInvoiceStatus String?
  /// B1 DocNum of the A/R invoice finance posted from the draft
  erpInvoiceNo     String?
  erpInvoiceTotal  Decimal?  @db.Decimal(14, 2)
  erpPaid          Decimal?  @db.Decimal(14, 2)
  erpCheckedAt     DateTime?
  createdAt        DateTime  @default(now())
  createdBy        String
  updatedAt        DateTime  @updatedAt
  updatedBy        String?

  lines ServiceBillingLine[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([erpStatus, erpCheckedAt])
  @@map("service_billings")
}

/// CD-242 — one line of a service charge. source: estimate (from the
/// customer's acknowledgement) · manual · labour / material (CD-243).
model ServiceBillingLine {
  id          String  @id @default(uuid())
  billingId   String
  lineNo      Int
  /// SAP ItemCode — null = the general service item (ERP_B1_SERVICE_ITEM)
  productCode String?
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  source      String  @default("manual")

  billing ServiceBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@unique([billingId, lineNo])
  @@map("service_billing_lines")
}

/// CD-243 — what an hour of service work is charged to the customer, per HR
/// work type (CD-207): a selling rate, not the confidential cost rate. The
/// labour line on a charge carries `productCode` (SAP service item) when set.
model ServiceLabourRate {
  id          String   @id @default(uuid())
  companyId   String
  workTypeId  String
  hourlyRate  Decimal  @db.Decimal(12, 2)
  productCode String?
  note        String?
  createdAt   DateTime @default(now())
  createdBy   String
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@unique([companyId, workTypeId])
  @@map("service_labour_rates")
}

/// CD-243 บันทึกวัสดุที่ใช้จริง — an SAP item used on a service job: the
/// selling price from the standard price list (CD-194) when there is one,
/// edited; the cost from suppliers' SAP costs (CD-206) at the time, kept for
/// the job's margin. `billable` false = covered (in contract). Removed =
/// deletedAt.
model ServiceMaterialUse {
  id          String    @id @default(uuid())
  companyId   String
  workOrderId String
  requestId   String
  productCode String
  description String
  quantity    Decimal   @db.Decimal(14, 3)
  unit        String?
  serialNo    String?
  billable    Boolean   @default(true)
  unitPrice   Decimal?  @db.Decimal(14, 2)
  /// standard · manual
  priceSource String?
  unitCost    Decimal?  @db.Decimal(14, 2)
  usedOn      DateTime  @db.Date
  note        String?
  /// CD-245 — taken out of stock: a goods issue to SAP (store-and-forward)
  fromStock     Boolean   @default(false)
  warehouseCode String?
  /// none · pending · synced · failed
  erpStatus     String    @default("none")
  erpDocNo      String?
  erpLastError  String?
  erpSyncedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  @@index([workOrderId])
  @@index([companyId, usedOn])
  @@map("service_material_uses")
}

/// CD-244 แผนบำรุงรักษาตามรอบ — the preventive-maintenance plan of a
/// service contract entitlement (CD-237): how often, how many days ahead its
/// work order opens, and who it is opened under. The rounds follow from it,
/// from the cover's start to its end, no more than its preventive quota.
model ServicePmPlan {
  id            String   @id @default(uuid())
  companyId     String
  entitlementId String   @unique
  /// monthly · quarterly · semiannual · yearly
  interval      String
  leadDays      Int      @default(14)
  ownerUserId   String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  createdBy     String
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@index([companyId])
  @@map("service_pm_plans")
}

/// CD-244 — one PM round: due on a date, opened as a preventive work order
/// ahead of it, done when that order's case is done.
///   status: planned · opened · done · skipped · failed (could not be opened)
model ServicePmRound {
  id                String    @id @default(uuid())
  companyId         String
  entitlementId     String
  roundNo           Int
  dueOn             DateTime  @db.Date
  status            String    @default("planned")
  workOrderId       String?
  requestId         String?
  openedAt          DateTime?
  openError         String?
  doneAt            DateTime?
  skippedReason     String?
  skippedBy         String?
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([entitlementId, roundNo])
  @@index([companyId, status, dueOn])
  @@map("service_pm_rounds")
}

/// CD-244 — a cover with no contract behind it (a warranty, or a service
/// contract not in the contract register) nearing its end: a deal offering a
/// service contract opened for the customer's account owner, as CD-70 does
/// for contracts, and reminded while it is open.
model ServiceMaOffer {
  id            String   @id @default(uuid())
  companyId     String
  entitlementId String   @unique
  opportunityId String?
  openedAt      DateTime @default(now())
  remindedDays  Int[]    @default([])

  @@map("service_ma_offers")
}

/// CD-245 การส่งเคลมคืนคู่ค้า — a faulty unit (often the one a replacement
/// took out, CD-245) sent back to its supplier: who, their RMA number, when
/// it went and is expected back, and how it ended.
///   status: pending · sent · replaced · credited · rejected · cancelled
model ServiceClaim {
  id                String    @id @default(uuid())
  companyId         String
  workOrderId       String?
  requestId         String?
  assetId           String?
  productCode       String?
  description       String
  /// the faulty unit's serial
  serialNo          String?
  vendorCode        String
  vendorName        String
  rmaNo             String?
  status            String    @default("pending")
  sentOn            DateTime? @db.Date
  expectedOn        DateTime? @db.Date
  resolvedOn        DateTime? @db.Date
  replacementSerial String?
  creditAmount      Decimal?  @db.Decimal(14, 2)
  outcomeNote       String?
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  createdBy         String
  updatedAt         DateTime  @updatedAt
  updatedBy         String?

  @@index([companyId, status])
  @@index([workOrderId])
  @@map("service_claims")
}

/// CD-246 ปัญหาที่เกิดซ้ำ — a problem behind repeated faults (one unit, one
/// model, or one model at one customer), worked to its root cause instead of
/// repairing the same thing again.
///   status: open · investigating · known_error (a workaround) ·
///           resolved (root cause + permanent fix) · closed
model ServiceProblem {
  id            String    @id @default(uuid())
  companyId     String
  problemNo     String
  title         String
  /// asset · model · customer_model
  scope         String
  assetId       String?
  productCode   String?
  customerId    String?
  ownerUserId   String
  status        String    @default("open")
  workaround    String?
  rootCause     String?
  permanentFix  String?
  /// CD-224 — the technical change that fixes it, by reference
  techChangeRef String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime  @updatedAt
  updatedBy     String?

  @@unique([companyId, problemNo])
  @@index([companyId, status])
  @@map("service_problems")
}

/// CD-246 — a work order counted against a problem (one problem per order).
model ServiceProblemLink {
  id          String   @id @default(uuid())
  problemId   String
  workOrderId String   @unique
  linkedBy    String
  linkedAt    DateTime @default(now())

  @@index([problemId])
  @@map("service_problem_links")
}

/// CD-246 — a suggested group someone said is not one problem; it comes back
/// only when it has grown past the size it had then.
model ServiceProblemDismissal {
  id          String   @id @default(uuid())
  companyId   String
  groupKey    String
  size        Int
  dismissedBy String
  dismissedAt DateTime @default(now())

  @@unique([companyId, groupKey])
  @@map("service_problem_dismissals")
}

/// CD-247 รายงานผลบริการ — an issued service report: one cover (a service
/// contract or a warranty, CD-237) for one period, its figures frozen as they
/// were on issue (`data`), the penalty a person confirmed from the contract's
/// terms, the PDF sent to the customer, and when it was sent.
model ServiceReport {
  id             String    @id @default(uuid())
  companyId      String
  entitlementId  String
  customerId     String
  reportNo       String
  periodFrom     DateTime  @db.Date
  periodTo       DateTime  @db.Date
  /// the figures on issue: jobs, response/resolution met, PM rounds
  data           Json
  penaltyAmount  Decimal?  @db.Decimal(14, 2)
  penaltyNote    String?
  pdfKey         String
  issuedAt       DateTime  @default(now())
  issuedBy       String
  sentOn         DateTime? @db.Date
  sentTo         String?
  sentBy         String?

  @@unique([companyId, reportNo])
  @@index([entitlementId, periodFrom])
  @@map("service_reports")
}

/// CD-248 ความพึงพอใจหลังปิดงานบริการ — one survey per service job, sent
/// when its case is done: a private link (only its SHA-256 is kept) the
/// customer answers once before it expires. Overall 1–5 (required), speed /
/// technician / outcome 1–5 (optional), a comment. Feeds the service team's
/// figures and the customer's health (Keeper, CD-86).
model ServiceSurvey {
  id             String    @id @default(uuid())
  companyId      String
  workOrderId    String    @unique
  requestId      String
  customerId     String?
  /// who worked the case when it was done — the technician's figures
  assigneeUserId String?
  tokenHash      String    @unique
  expiresAt      DateTime
  /// email · line · none (the link is copied by hand)
  sentVia        String    @default("none")
  sentTo         String?
  sentAt         DateTime?
  answeredAt     DateTime?
  overall        Int?
  speed          Int?
  technician     Int?
  outcome        Int?
  comment        String?
  lowAlertedAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId, answeredAt])
  @@index([customerId, answeredAt])
  @@map("service_surveys")
}

/// CD-249 Customer Portal — a person at a customer the service team invited:
/// their private invite link (only its SHA-256 kept; 90 days; revocable,
/// reissued) opens a portal session that sees that customer's own things.
/// No password anywhere (AGENTS.md).
model ServicePortalContact {
  id             String    @id @default(uuid())
  companyId      String
  customerId     String
  name           String
  email          String?
  phone          String?
  inviteHash     String?   @unique
  inviteExpires  DateTime?
  invitedAt      DateTime  @default(now())
  invitedBy      String
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  revokedBy      String?

  @@index([companyId, customerId])
  @@map("service_portal_contacts")
}

/// CD-249 — a browser session opened from an invite link (8 hours; only the
/// token's SHA-256 kept, in an httpOnly cookie on the web app's side).
model ServicePortalSession {
  id        String   @id @default(uuid())
  contactId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("service_portal_sessions")
}

/// CD-251 เอกสารส่งมอบของเฟส (หมุดหมาย) — แนบต่อชื่อเอกสาร; ชื่อที่ตรงกับเอกสารบังคับของประเภทงาน
/// ในรอบส่งของเฟสนั้นนับเป็นเอกสารบังคับ ที่เหลือเป็นเอกสารเพิ่มเติม. ลบ = deletedAt.
model ProjectDeliveryDocument {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String
  milestoneId String
  title       String
  note        String?
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  deletedAt   DateTime?
  deletedBy   String?

  @@index([projectId, milestoneId])
  @@map("project_delivery_documents")
}
