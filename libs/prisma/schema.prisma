// Single Prisma schema for the whole monorepo. The generated client is
// consumed through libs/prisma by every service in services/*.
//
// Models follow the CTD Foundation Sprint spec §10. Rules that hold
// throughout, and that reviews should enforce:
//
//   * every transactional table carries companyId + created/updated audit columns
//   * transactional data is NEVER hard-deleted — status columns only
//   * per-request form data is Json validated against the JSON Schema declared
//     in RequestType, so adding a request type needs no migration
//   * OrgClosure is recomputed on org edits, never traversed at query time

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// The five levels of the chart: บริษัท → ฝ่าย → แผนก → ทีม → ตำแหน่ง.
///
/// **The order is declared in `libs/share/src/org/org-levels.ts`, not here.**
/// This list is not in chart order — `TEAM` predates `DIVISION` and `POSITION`,
/// which were appended as the chart grew, and Postgres cannot reorder an enum
/// without swapping the whole type. Anything that needs to know which level is
/// above which reads `ORG_UNIT_LEVELS`; reading this declaration instead ranks
/// ทีม below ตำแหน่ง, which is wrong.
///
/// `OrgService` enforces two rules over those levels on every write: a unit's
/// parent is the level immediately above it, and people sit at แผนก or below.
/// ทีม and ตำแหน่ง are optional — a chart that stops at แผนก is complete.
enum OrgUnitKind {
  COMPANY
  DIVISION
  DEPARTMENT
  POSITION
  TEAM
}

/// How a role reached a user: mapped from a Keycloak claim (ROLE-03) or bound
/// by hand in the admin screen (ROLE-02). Mapped grants are re-evaluated on
/// every login; manual ones persist until removed.
enum RoleGrantSource {
  KEYCLOAK_MAPPING
  MANUAL
}

/// §6.1 data scope levels.
enum ScopeLevel {
  own
  team
  department
  company
  all
}

/// §7.1 request state machine. Transitions outside the declared paths must be
/// impossible through every channel, including direct API calls.
enum RequestStatus {
  draft
  submitted
  returned
  pending_approval
  approved
  rejected
  in_progress
  on_hold
  completed
  closed
  cancelled
}

/// REQ-10: requests raised by an integration are marked, so "who started
/// this" is answerable without guessing.
enum RequestSource {
  USER
  SYSTEM
}

enum ApprovalCaseStatus {
  pending
  approved
  rejected
  returned
  voided
  cancelled
}

enum ApprovalStepStatus {
  waiting
  pending
  approved
  rejected
  returned
  skipped
}

enum ApprovalDecision {
  approve
  reject
  return
}

/// How much of the clock counts, per request type (SUP-01).
///
/// `H24X7` is elapsed time, the only mode the clock ever actually implemented.
/// The other two count `HolidayCalendar`'s working window, and `H8X5` also
/// skips non-working weekdays and holidays.
///
/// Replaces the boolean `businessHours` on 31 Aug 2026: it could not tell
/// "office hours every day" from "office hours on working days", which the
/// support desk and the back office need to mean different things.
enum SlaCoverage {
  H24X7
  H8X7
  H8X5
}

enum SlaState {
  running
  paused
  met
  breached
  cancelled
}

enum NotificationChannel {
  in_app
  email
}

enum DeliveryStatus {
  queued
  sent
  failed
}

/// CM-01: นิติบุคคล / บุคคลธรรมดา / หน่วยงานรัฐ.
enum CustomerType {
  corporate
  individual
  government
}

/// CM-04 customer lifecycle. KYC is deliberately NOT a status: the PO
/// confirmed (8 ก.ย. 2569) that a customer is active the moment it is
/// created, and KYC is forced per product via the `kycVerified` flag —
/// a `pending_kyc` state would block customers who never touch a KYC
/// product.
enum CustomerStatus {
  draft
  active
  suspended
  inactive
}

/// CM-06 — สถานะงานในคิว sync ของชั้น integration (SAP + workflow วันนี้ ระบบอื่นภายหลัง).
enum IntegrationJobStatus {
  pending
  succeeded
  failed
}

/// CRM — ชนิดของสถานะ Lead. ตัวสถานะเองเป็น **ข้อมูล** ไม่ใช่ enum (ตั้งค่า CRM →
/// แท็บ "สถานะ Lead" เพิ่ม/ลบได้เอง, D-09); ชนิดคือสิ่งที่โค้ดตัดสินใจด้วย —
/// `open` = ยังทำงานต่อได้, `won` = ปลายทางเมื่อแปลงเป็นโอกาสการขาย,
/// `lost` = ปลายทางเมื่อคัดออก. หนึ่งบริษัทมี `won`/`lost` อย่างละหนึ่งเสมอ.
enum LeadStatusKind {
  open
  won
  lost
}

/// CRM — กิจกรรมบน Lead: โทร / อีเมล / นัดหมาย / งาน / บันทึก.
enum LeadActivityType {
  call
  email
  meeting
  task
  note
}

/// CRM — ขั้นของโอกาสการขาย. `won`/`lost` เป็นสถานะปิด; ปิดแพ้ต้องมีเหตุผลมาตรฐาน
/// (spec: "ปิดแพ้ต้องระบุเหตุผลจากรายการมาตรฐานเพื่อนำมาวิเคราะห์ได้").
enum OpportunityStage {
  qualifying
  proposing
  negotiating
  won
  lost
}

/// CRM — สถานะใบสั่งขาย (Sale Order). PO 10 ก.ย. 2569: ลูกค้าในทะเบียน "เกิด"
/// ที่จุดเปิดใบสั่งขายเท่านั้น — ขั้นตอนก่อนหน้า (Lead, โอกาสการขาย) เป็นผู้มุ่งหวัง.
enum SaleOrderStatus {
  open
  cancelled
}

/// สถานะการส่งใบสั่งขายเข้า SAP (CD-88) — แยกจากสถานะของใบเอง: ใบเปิดอยู่แต่ยัง
/// ไม่ถึง SAP ได้ และ SAP ล่มต้องไม่ทำให้ใบหายหรือเปิดไม่ได้.
///   not_ready — ยังไม่มีรายการสินค้า ส่งไม่ได้ (เปิดตรงจากโอกาสการขาย)
///   pending   — อยู่ในคิว (รวมถึงรอลูกค้าได้เลข BP ก่อน)
///   synced    — SAP ตอบเลขใบสั่งขายแล้ว (ถ้าใบถูกยกเลิก = SAP ยกเลิกแล้วด้วย)
///   failed    — ลองครบรอบแล้วไม่สำเร็จ ต้องให้ผู้ดูแลดู `erpLastError`
///   skipped   — ใบถูกยกเลิกก่อนถึง SAP ไม่มีอะไรต้องส่ง
enum ErpSyncStatus {
  not_ready
  pending
  synced
  failed
  skipped
}

/// CRM — สถานะใบเสนอราคา (CD-76). แก้ได้เฉพาะ `draft`; ส่งลูกค้าแล้วแก้ไม่ได้ ต้อง
/// ออกเวอร์ชันใหม่ (`superseded` คือฉบับที่ถูกเวอร์ชันใหม่แทน). margin ต่ำกว่าเกณฑ์ =
/// `pending_approval` รอคำขออนุมัติ (ประเภทตาม CrmCompanyConfig) ผ่านก่อนเป็น `approved`.
enum QuotationStatus {
  draft
  pending_approval
  approved
  sent
  accepted
  declined
  superseded
  cancelled
}

/// CM-05: บทบาทผู้ติดต่อตามสเปค.
enum CustomerContactRole {
  decision_maker
  user
  procurement
  finance
  other
}

/// รอบที่ลำดับเลขรันกลับไปเริ่มที่ `startNumber` ใหม่ — คุมค่า `periodKey` ของ
/// `RunNumberCounter`. `none` = นับต่อไปเรื่อย ๆ ไม่มีรีเซ็ต.
enum RunNumberResetPeriod {
  none
  yearly
  monthly
  daily
}

// ---------------------------------------------------------------------------
// Identity & Org
// ---------------------------------------------------------------------------

/// D-11: multi-company from day one. `docPrefix` feeds the request number
/// (REQ-02, e.g. the OSD in OSD-DSC-202608-0042).
model Company {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  docPrefix    String
  baseCurrency String   @default("THB")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                   UserCompany[]
  primaryUsers            User[]                     @relation("PrimaryCompany")
  lastActiveUsers         User[]                     @relation("LastCompany")
  orgUnits                OrgUnit[]
  roles                   Role[]
  userRoles               UserRole[]
  keycloakMappings        KeycloakRoleMapping[]
  requestTypes            RequestTypeCompany[]
  requests                Request[]
  docNumberConfigs        DocNumberConfig[]
  docNumberCounter        DocNumberCounter[]
  runNumberSettings       RunNumberSetting[]
  runNumberCounters       RunNumberCounter[]
  approvalMatrices        ApprovalMatrix[]
  approvalCases           ApprovalCase[]
  delegations             Delegation[]
  slaConfigs              SlaConfig[]
  holidayCalendar         HolidayCalendar?
  notifications           Notification[]
  auditLogs               AuditLog[]
  biDashboards            BiDashboard[]
  orgUnitScopes           OrgUnitScope[]
  notificationPreferences NotificationPreference[]
  customers               Customer[]
  customerSegmentDims     CustomerSegmentDimension[]
  customerCodeCounter     CustomerCodeCounter?
  crmConfig               CrmCompanyConfig?
  kycProductRules         KycProductRule[]
  leadStatuses            LeadStatusSetting[]
  leads                   Lead[]
  opportunities           Opportunity[]
  opportunityLostReasons  OpportunityLostReason[]
  opportunityCodeCounter  OpportunityCodeCounter?
  saleOrders              SaleOrder[]
  products                Product[]
  saleOrderCodeCounter    SaleOrderCodeCounter?
  quotations              Quotation[]
  quotationCodeCounter    QuotationCodeCounter?

  @@map("companies")
}

/// Local mirror of the Keycloak-authenticated user (AUTH-04, JIT-provisioned
/// on first login). Keycloak owns credentials and roles; org placement —
/// `orgUnitId` and `supervisorUserId` — is owned *here* and edited through the
/// admin screen, because LDAP is used for authentication only (D-07/D-08).
model User {
  id          String     @id @default(uuid())
  keycloakId  String     @unique
  username    String     @unique
  email       String?    @unique
  displayName String
  firstName   String?
  lastName    String?
  status      UserStatus @default(ACTIVE)

  primaryCompanyId String?
  primaryCompany   Company? @relation("PrimaryCompany", fields: [primaryCompanyId], references: [id])

  /// บริษัทที่ผู้ใช้สลับไปล่าสุด — บริษัทตั้งต้นเมื่อ login ครั้งถัดไป (AUTH-05).
  ///
  /// คนละความหมายกับ `primaryCompanyId` ซึ่งเป็นสังกัดหลักที่ผู้ดูแลกำหนดให้ อันนี้คือ
  /// ที่ที่เจ้าตัวเลือกทำงานอยู่ตอนนี้ และเปลี่ยนเองได้จาก company switcher
  /// null = ยังไม่เคยสลับ จึงตกไปใช้ `primaryCompanyId` เหมือนเดิม
  lastCompanyId String?
  lastCompany   Company? @relation("LastCompany", fields: [lastCompanyId], references: [id])

  /// Job title as HR records it, e.g. `Senior Purchasing Officer`.
  ///
  /// Kept as text *as well as* being a level of the chart (31 Aug 2026). The
  /// title is a fact about the person — `roleForPosition` maps it to a system
  /// role at import, and the user directory prints it — while `OrgUnitKind.
  /// POSITION` is where that person sits, scoped to one department.
  ///
  /// The two are not the same thing and must not be collapsed: the staff
  /// register holds 67 distinct titles across 102 people, so the same title
  /// appears under several departments and each is its own box on the chart.
  position String?

  /// HR's own staff number, e.g. `EMP-094`.
  ///
  /// Not unique and not validated, because the source register genuinely is not
  /// uniform: 98 of 101 rows are `EMP-NNN`, the rest are `Consult-005`, `M-008`
  /// and a bare `888`. A format check here would reject real people.
  ///
  /// `import-osd-catalog.ts` already reads this concept as `employeeCode` but
  /// only as a join key — it was never persisted. This column is its home; do
  /// not add a third name for it.
  employeeId String?

  /// Desk phone extension, four digits.
  ///
  /// Deliberately **not** unique: 14 of the 75 known values are shared, because
  /// a team sitting around one handset all give out the same number.
  extension String?

  /// The day the person started work.
  ///
  /// Only the date carries meaning — every value in the source register is
  /// midnight — but stored as a timestamp because nothing else in this schema
  /// uses `@db.Date` and one exception would be the surprising thing.
  startWork DateTime?

  /// Contact number carried over from the previous system.
  ///
  /// Stored exactly as the source wrote it, without normalising: the register
  /// mixes `66` country prefixes with bare nine-digit numbers, and guessing
  /// which is which would invent data.
  phone String?

  /// Null until an admin assigns the user — these are the "รอจัดสังกัด" queue.
  orgUnitId String?
  orgUnit   OrgUnit? @relation("OrgUnitMembers", fields: [orgUnitId], references: [id])

  supervisorUserId String?
  supervisor       User?   @relation("Supervision", fields: [supervisorUserId], references: [id])
  subordinates     User[]  @relation("Supervision")

  /// Realm roles seen on the token at the last login (ROLE-03).
  ///
  /// Cached here so screen A3 can show "role จาก Keycloak: sales" for someone
  /// who has not been assigned yet — it comes free from the token and needs no
  /// Admin API call. Never authoritative: permissions always resolve through
  /// keycloak_role_mappings, this is display only.
  keycloakRoles String[] @default([])

  firstLoginAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companies               UserCompany[]
  roles                   UserRole[]               @relation("RoleHolder")
  grantedRoles            UserRole[]               @relation("RoleGranter")
  managedUnits            OrgUnit[]                @relation("OrgUnitManager")
  requests                Request[]                @relation("Requester")
  receivedRequests        Request[]                @relation("Receiver")
  receiverOfTypes         RequestType[]            @relation("TypeReceiver")
  assignedRequests        Request[]                @relation("Assignee")
  requestEvents           RequestEvent[]
  requestComments         RequestComment[]
  attachments             RequestAttachment[]
  approvalSteps           ApprovalStep[]           @relation("StepApprover")
  decidedSteps            ApprovalStep[]           @relation("StepDecider")
  delegationsOut          Delegation[]             @relation("Delegator")
  delegationsIn           Delegation[]             @relation("Delegate")
  notifications           Notification[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  scopesGranted           OrgUnitScope[]           @relation("ScopeViewerUser")
  scopesOn                OrgUnitScope[]           @relation("ScopeTargetUser")
  ownedCustomers          Customer[]               @relation("CustomerAccountOwner")

  @@index([orgUnitId])
  @@index([supervisorUserId])
  @@index([lastCompanyId])
  @@map("users")
}

/// AUTH-05: one person can belong to several companies, with exactly one
/// primary. Roles are held per company (ROLE-04), never globally.
model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

/// The org chart, maintained in this system (D-08). It is the source of truth
/// for "who reports to whom", which drives data scope (§6), approval step 1
/// (§8.1), and escalation (SUP-02).
model OrgUnit {
  id        String      @id @default(uuid())
  companyId String
  code      String
  name      String
  kind      OrgUnitKind @default(TEAM)

  parentId String?
  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgTree")

  managerUserId String?
  manager       User?   @relation("OrgUnitManager", fields: [managerUserId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company       Company               @relation(fields: [companyId], references: [id])
  members       User[]                @relation("OrgUnitMembers")
  ancestors     OrgClosure[]          @relation("ClosureDescendant")
  descendants   OrgClosure[]          @relation("ClosureAncestor")
  receivedTypes RequestType[]         @relation("ReceiverUnit")
  eligibleTypes RequestTypeOrgUnit[]
  biAudiences   BiDashboardAudience[]
  scopesGranted OrgUnitScope[]        @relation("ScopeViewer")
  scopesOn      OrgUnitScope[]        @relation("ScopeTarget")

  @@unique([companyId, code])
  @@index([parentId])
  @@map("org_units")
}

/// Transitive closure of `OrgUnit`, recomputed inside the same transaction as
/// any org edit. Scope `team` and `department` resolve to an `IN (…)` against
/// this table rather than walking the tree per query (§6.2 note) — the reason
/// list endpoints can still meet NFR-02 at 100k rows.
model OrgClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   OrgUnit @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant OrgUnit @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("org_closure")
}

/// One group may see — and optionally work on — another group's requests.
///
/// The replacement for `ScopeRule`, which tied visibility to a *role* and was
/// withdrawn on 31 ส.ค. 2569 because a `(role, resource) → level` rule cannot
/// say "ฝ่ายขาย sees ฝ่ายการตลาด's work". This says exactly that, and nothing
/// more general.
///
/// The level an administrator picks on screen (บริษัท / ฝ่าย / แผนก / ตำแหน่ง)
/// is `OrgUnit.kind` of the viewer, so it is not stored again here — a group's
/// level is already a property of the group.
///
/// A grant is inherited downwards: it is matched against the viewer's own unit
/// **and every unit above it**, which is what makes a grant written at the
/// company level apply to everybody in the company.
model OrgUnitScope {
  id        String @id @default(uuid())
  companyId String

  /// The group being granted the view, when the grant is written to a group.
  ///
  /// Exactly one of `viewerOrgUnitId` / `viewerUserId` is set — a CHECK
  /// constraint enforces it, because a row with neither reaches nobody and a
  /// row with both would have to pick one silently.
  viewerOrgUnitId String?
  /// The one person being granted the view, when the grant is written to a
  /// person rather than to their whole group (4 ก.ย. 2569).
  viewerUserId    String?

  /// The group whose work becomes visible, when the target is a group.
  ///
  /// Exactly one of `targetOrgUnitId` / `targetUserId` is set.
  targetOrgUnitId String?
  /// The one person whose work becomes visible — "ให้คนนี้เห็นงานของคนนั้น",
  /// which naming a whole group could never express.
  targetUserId    String?

  /// Whether the grant reaches the groups beneath `target`.
  ///
  /// Defaults to true because the org chart is บริษัท → ฝ่าย → แผนก and naming
  /// a ฝ่าย almost always means its แผนก too. Turning it off is the narrow
  /// case, so it is the one that has to be asked for.
  ///
  /// Meaningless when the target is a person — a person has no subtree — so
  /// the service forces it to `false` there rather than storing a flag that
  /// reads as if it did something.
  includeDescendants Boolean @default(true)

  /// What the viewer may *do* with those requests, beyond reading them.
  ///
  /// Codes from `SCOPE_PERMISSIONS` in
  /// `libs/share/src/policy/permissions.ts` — a closed set drawn from the
  /// catalog, validated at the DTO. Empty is the default and means read-only:
  /// `assertMayAct` in core-service is the only thing standing between a person
  /// and somebody else's ticket, and a grant that silently widened it would
  /// hand the whole chart to whoever was granted a view.
  ///
  /// Always intersected with what the holder's roles already grant, never added
  /// to them — that is what keeps `assertSeparationOfDuties` meaningful, since
  /// it runs on role permission sets and never sees this column.
  ///
  /// A `String[]` rather than a join table like `RolePermission`, because
  /// `scopedAccessOf` reads these on **every request** while resolving the
  /// principal, and the codes are declared in code rather than by an admin.
  /// `ApprovalStep.candidateUserIds` and `User.keycloakRoles` are stored the
  /// same way for the same reason.
  permissions String[] @default([])

  /// Whether the viewer may move those requests, or only read them.
  ///
  /// **Derived from `permissions` since 7 ก.ย. 2569** and kept only so that a
  /// core-service still running the previous release answers as it did during a
  /// rolling deploy. Nothing decides anything from it in this release; the next
  /// one drops the column.
  canAct Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company    Company  @relation(fields: [companyId], references: [id])
  viewer     OrgUnit? @relation("ScopeViewer", fields: [viewerOrgUnitId], references: [id], onDelete: Cascade)
  viewerUser User?    @relation("ScopeViewerUser", fields: [viewerUserId], references: [id], onDelete: Cascade)
  target     OrgUnit? @relation("ScopeTarget", fields: [targetOrgUnitId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ScopeTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// The uniqueness of a grant is four partial indexes, created in
  /// `20260904120000_scope_user_grants` — not `@@unique`. Postgres treats every
  /// NULL as distinct, so a composite unique over four nullable columns would
  /// permit the same grant to be written any number of times.
  @@index([companyId, viewerOrgUnitId])
  @@index([companyId, viewerUserId])
  @@map("org_unit_scopes")
}

/// ROLE-02. `companyId` null means a group-wide template role; bound roles are
/// deactivated, never deleted.
model Role {
  id          String  @id @default(uuid())
  companyId   String?
  code        String
  name        String
  description String?
  /// Seed roles from §5.2 — cannot be renamed away or removed.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  /// How far up the holder's own branch their view starts, `null` for none.
  ///
  /// **Not the `ScopeLevel` withdrawn on 31 ส.ค. 2569.** That was an absolute
  /// rank per `(role, resource)` — it could say "this role sees its
  /// department" but never "ฝ่ายขาย sees ฝ่ายการตลาด", which is why
  /// `OrgUnitScope` replaced it and still owns every cross-branch grant.
  ///
  /// This is relative to whoever holds the role: walk up the holder's own
  /// ancestors, take the nearest unit whose `kind` matches, and read that
  /// unit's whole subtree. Somebody under `ตำแหน่ง: software dev` with
  /// `DEPARTMENT` sees all of RND; with `DIVISION`, all of INF. It follows
  /// them when they move, which a grant naming a target unit cannot.
  ///
  /// No ancestor of that kind means **no extra units at all** — never a wider
  /// one. When `POSITION` nodes leave the chart, a role set to `POSITION` goes
  /// quiet rather than silently widening to the department above it.
  ///
  /// Read only. Acting on somebody else's request still comes from leading
  /// their group or from a scope grant ticked to allow it.
  visibilityLevel OrgUnitKind?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company          Company?              @relation(fields: [companyId], references: [id])
  permissions      RolePermission[]
  users            UserRole[]
  scopeRules       ScopeRule[]
  keycloakMappings KeycloakRoleMapping[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Mirror of the code-declared catalog in `libs/share/src/policy/permissions.ts`,
/// synced at boot. The table exists for referential integrity only — admins
/// compose roles from these but cannot create new ones (§11.3).
model Permission {
  code        String  @id
  module      String
  /// human = สิทธิ์ของคนใน role · service = scope ของบัญชีบริการ (AUTH-06)
  type        String  @default("human")
  description String?

  roles RolePermission[]

  @@index([module])
  @@index([type])
  @@map("permissions")
}

model RolePermission {
  roleId         String
  permissionCode String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

/// ROLE-04: a role binding is always scoped to one company.
model UserRole {
  id        String          @id @default(uuid())
  userId    String
  roleId    String
  companyId String
  source    RoleGrantSource @default(MANUAL)

  grantedByUserId String?
  grantedAt       DateTime @default(now())

  user      User    @relation("RoleHolder", fields: [userId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  grantedBy User?   @relation("RoleGranter", fields: [grantedByUserId], references: [id])

  @@unique([userId, roleId, companyId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// ROLE-03: "Keycloak role → role in this system", per company. Re-evaluated
/// on every login and refresh, so revoking in Keycloak revokes here within one
/// access-token lifetime.
model KeycloakRoleMapping {
  id             String   @id @default(uuid())
  /// The realm role's **name** — what a token carries, so this is what
  /// `syncFromKeycloakRoles` matches on at sign-in.
  keycloakRole   String
  /// The realm role's **id**, which a rename does not change.
  ///
  /// Without it a rename in Keycloak was invisible here: the next token
  /// carried the new name, this row still held the old one, no mapping
  /// matched, and every holder of that role lost it with nothing on screen to
  /// say why. Nullable because rows written before 2 ก.ย. 2569 have no id yet
  /// — `syncNamesFromKeycloak` fills it in on its first run.
  keycloakRoleId String?
  roleId         String
  companyId      String
  createdAt      DateTime @default(now())
  createdBy      String?

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([keycloakRole, roleId, companyId])
  @@index([companyId])
  @@index([keycloakRoleId])
  @@map("keycloak_role_mappings")
}

/// SCOPE-01: (role, resource) → scope level, editable from the admin screen
/// with no deploy.
model ScopeRule {
  id       String     @id @default(uuid())
  roleId   String
  resource String
  scope    ScopeLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("scope_rules")
}

/// SCOPE-04: which fields of which resource are sensitive, and the permission
/// that unmasks them. Enforced on the API response, not just the UI.
model SensitiveFieldRule {
  id                  String @id @default(uuid())
  resource            String
  field               String
  visibleToPermission String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([resource, field])
  @@map("sensitive_field_rules")
}

// ---------------------------------------------------------------------------
// Request
// ---------------------------------------------------------------------------

/// REQ-01: a request type is *configuration*, not code. Adding the 3rd..30th
/// type is an admin screen action.
model RequestType {
  id                String  @id @default(uuid())
  code              String  @unique
  name              String
  receiverOrgUnitId String? 
  receiverUserId    String?

  /// JSON Schema for the form the **requester** fills in.
  formSchema         Json
  /// JSON Schema for the form the **receiver** fills in before completing.
  ///
  /// Null means the type has no second form, and `complete` then asks for
  /// nothing extra — which is most of the forty imported types, so this stays
  /// optional rather than defaulting to an empty schema that would render as
  /// a blank required step.
  receiverFormSchema Json?
  /// [{ code, name }] — attachments that block submit (REQ-03).
  requiredDocs       Json  @default("[]")
  /// [{ code, name }] — the standard return reasons (REQ-04).
  returnReasonCodes  Json  @default("[]")
  /// { mode: "standard_chain", amount_field: "deal_value" } — how APV-02
  /// derives the approval chain.
  approvalPolicy     Json

  slaHours    Int?
  slaCoverage SlaCoverage @default(H24X7)

  /// Whether ยื่นคำขอ demands `refId` — §16 marks it required, but only on the
  /// DSC mockup, and most types have no opportunity to point at. Per type rather than
  /// hard-coded on the screen, which is what it was until 1 ก.ย. 2569.
  refRequired Boolean @default(false)

  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  receiverOrgUnit OrgUnit?             @relation("ReceiverUnit", fields: [receiverOrgUnitId], references: [id])
  receiverUser    User?                @relation("TypeReceiver", fields: [receiverUserId], references: [id], onDelete: SetNull)
  companies       RequestTypeCompany[]
  eligibleUnits   RequestTypeOrgUnit[]
  requests        Request[]

  @@map("request_types")
}

/// Which groups may raise a request of this type.
///
/// **No rows means every group may.** That is the default and what all forty
/// imported types carry, so switching this on is opt-in per type rather than a
/// migration that has to guess.
///
/// A group named here covers its whole subtree: naming a department lets every
/// position under it raise the type, resolved through `OrgClosure` rather than
/// listing descendants, so moving a group in the chart cannot silently revoke
/// what it could raise.
model RequestTypeOrgUnit {
  requestTypeId String
  orgUnitId     String

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([requestTypeId, orgUnitId])
  @@index([orgUnitId])
  @@map("request_type_org_units")
}

/// Which companies have a given request type switched on.
model RequestTypeCompany {
  requestTypeId String
  companyId     String
  active        Boolean @default(true)

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id])

  @@id([requestTypeId, companyId])
  @@map("request_type_companies")
}

model Request {
  id String @id @default(uuid())

  /// Issued at submit, never before (REQ-02). Null while draft.
  requestNo String? @unique

  requestTypeId String
  typeCode      String
  companyId     String

  requesterId        String
  /// Snapshotted at submit so later org moves do not rewrite history or
  /// silently change who can see the row.
  requesterOrgUnitId String?

  /// The person the requester sent this to, named when the request is raised.
  ///
  /// A request is a ticket handed to somebody, not a job dropped in a
  /// department's queue: `06_EXAMPLE` shows every row being received by a named
  /// person and the source keeps a `ผู้รับผิดชอบที่แผนกปลายทาง` column for it.
  /// Only this person can accept the request (`submitted → in_progress`).
  receiverUserId String?

  /// Who is actually doing the work, once the receiver hands it on.
  ///
  /// Separate from `receiverUserId` because the source records `ASSIGNED` and
  /// `HANDOVER` as their own events — the person who accepted a ticket and the
  /// person who finished it are frequently not the same, and the timeline has
  /// to keep both.
  assigneeUserId String?

  /// The team this request was sent to.
  ///
  /// Seeded from `RequestType.receiverOrgUnitId` when the request is created,
  /// but the requester may pick a different team — the type's value is a
  /// starting point, not a routing rule. Held on the request so that editing
  /// the type later cannot re-route work already in flight (REQ-01).
  ///
  /// Deliberately a plain column with no relation, exactly like
  /// `requesterOrgUnitId` above it: both record where the work sat at the
  /// time, and a foreign key would let an org-chart edit rewrite that.
  receiverOrgUnitId String?

  /// Every request above this one, root first.
  ///
  /// Written once at create from the parent's own path, so "everything under
  /// request 1" is a single indexed lookup rather than a query per level. The
  /// screen draws several levels at once — `06_EXAMPLE` traces ten requests
  /// across eight departments from one customer order — and walking that a
  /// level at a time is a query per level on every page view.
  ///
  /// Empty for a request nobody spawned.
  ancestorIds String[] @default([])

  /// The request this one was spawned from, if any.
  ///
  /// One piece of work commonly breaks into several across departments —
  /// `06_EXAMPLE` traces ten requests over eight of them from a single customer
  /// order. A parent cannot be completed while any child is still open, which
  /// is what stops a chain being closed from the top while work continues
  /// underneath it.
  parentRequestId String?

  /// When the requester accepted the result. `completedAt` is when the work
  /// finished; the two are different moments and the gap between them is how
  /// long an answer sat unread.
  closedAt DateTime?

  status   RequestStatus @default(draft)
  formData Json          @default("{}")

  /// Answers to the type's `receiverFormSchema`, filled in at `complete`.
  ///
  /// Its own column rather than more keys in `formData`: the two forms are
  /// authored separately, answered by different people at different moments,
  /// and masking rules are declared per field — merging them would make
  /// "who wrote this value" unanswerable from the row.
  ///
  /// `{}` for a type with no second form, which is most of them.
  receiverFormData Json @default("{}")

  /// REQ-06: link back to the originating entity (opportunity, customer, …).
  refType String?
  refId   String?

  /// The RequestType config as it stood at submit — a running request keeps
  /// its rules even after an admin edits the type (REQ-01).
  typeSnapshot Json?

  source RequestSource @default(USER)

  submittedAt  DateTime?
  dueAt        DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  requestType   RequestType           @relation(fields: [requestTypeId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requester     User                  @relation("Requester", fields: [requesterId], references: [id])
  receiver      User?                 @relation("Receiver", fields: [receiverUserId], references: [id])
  assignee      User?                 @relation("Assignee", fields: [assigneeUserId], references: [id])
  parent        Request?              @relation("RequestTree", fields: [parentRequestId], references: [id])
  children      Request[]             @relation("RequestTree")
  attachments   RequestAttachment[]
  events        RequestEvent[]
  comments      RequestComment[]
  returnReasons RequestReturnReason[]
  approvalCases ApprovalCase[]
  slaClock      SlaClock?

  @@index([companyId, status])
  @@index([companyId, requesterId])
  /// The receiver's queue — "what is waiting for me to accept".
  @@index([companyId, receiverUserId, status])
  /// A team's queue — "what has been sent to us".
  @@index([companyId, receiverOrgUnitId, status])
  @@index([companyId, assigneeUserId, status])
  /// Counting a parent's open children on every complete.
  @@index([parentRequestId])
  /// "Everything under this request", for the สายคำขอ panel.
  @@index([ancestorIds], type: Gin)
  @@index([companyId, requesterOrgUnitId])
  @@index([companyId, dueAt])
  @@index([refType, refId])
  @@map("requests")
}

/// A note somebody left on a request (H2.2).
///
/// Separate from `RequestEvent` because the two answer different questions: an
/// event is something the system recorded happening, a comment is something a
/// person chose to say. They are drawn on one timeline, in time order, which is
/// how the people on a request read them — but merging them into one table
/// would mean either events with an author who did not write them, or comments
/// that pretend to be state changes.
///
/// Append-only, like the audit log: no update path, no delete path, no route
/// that reaches one. What was said on a request is part of its history.
model RequestComment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_comments")
}

model RequestAttachment {
  id        String  @id @default(uuid())
  requestId String
  /// Matches a code in RequestType.requiredDocs, or null for extra files.
  docCode   String?

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedById String
  uploadedAt   DateTime  @default(now())
  /// Soft delete — draft/returned only; the row survives for the audit trail.
  deletedAt    DateTime?

  request    Request @relation(fields: [requestId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@map("request_attachments")
}

/// REQ-04: return reasons are picked from a standard list, not free text, so
/// "why do requests bounce" is a reportable question.
model RequestReturnReason {
  id        String   @id @default(uuid())
  requestId String
  eventId   String?
  code      String
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  request Request       @relation(fields: [requestId], references: [id])
  event   RequestEvent? @relation(fields: [eventId], references: [id])

  @@index([requestId])
  @@index([code])
  @@map("request_return_reasons")
}

/// REQ-07: the append-only timeline. No update or delete path exists for these
/// rows — that is the acceptance criterion, not an implementation detail.
model RequestEvent {
  id        String @id @default(uuid())
  requestId String
  seq       Int

  type       String
  actorId    String?
  /// Set when the actor is the system (escalation, auto-transition).
  actorLabel String?

  fromStatus RequestStatus?
  toStatus   RequestStatus?
  data       Json?

  createdAt DateTime @default(now())

  request       Request               @relation(fields: [requestId], references: [id])
  actor         User?                 @relation(fields: [actorId], references: [id])
  returnReasons RequestReturnReason[]

  @@unique([requestId, seq])
  @@index([requestId, createdAt])
  @@map("request_events")
}

/// D-02/D-19 + REQ-02: the number format is configuration per company and
/// document type, e.g. `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}`.
model DocNumberConfig {
  id         String  @id @default(uuid())
  companyId  String
  typeCode   String
  /// `REQ-OSD-PS01-26090001`. `{YYYYMM}` is still understood, for rows an
  /// administrator set to the older `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}` form.
  pattern    String  @default("REQ-{PREFIX}-{TYPE}-{YYMM}{SEQ}")
  seqPadding Int     @default(4)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode])
  @@map("doc_number_configs")
}

/// The sequence itself, reset every month. Incremented inside the submit
/// transaction under a row lock — this is what makes 50 concurrent submits
/// produce 50 distinct numbers (REQ-02, NFR-03).
model DocNumberCounter {
  id        String @id @default(uuid())
  companyId String
  typeCode  String
  /// `YYYYMM`, e.g. 202608.
  yearMonth Int
  lastSeq   Int    @default(0)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode, yearMonth])
  @@map("doc_number_counters")
}

// ---------------------------------------------------------------------------
// Run number  (เลขรันทุกชนิดเอกสาร — run-number-service เท่านั้นที่แตะสองตารางนี้)
// ---------------------------------------------------------------------------

/// รูปแบบเลขรันต่อบริษัทต่อชนิดเอกสาร แก้ได้จากหน้าตั้งค่าโดยไม่ deploy.
///
/// §03: เจ้าของตารางนี้คือ `run-number-service` — service อื่นออกเลขผ่าน
/// `POST internal/run-numbers/issue` ห้าม query ตรง. `doc_number_configs` และ
/// `crm_company_configs.codePrefix/codePadding` คือที่เก่าของข้อมูลนี้ ยังไม่ถูกลบ
/// (ดู docs/run-number.md).
model RunNumberSetting {
  id        String @id @default(uuid())
  companyId String
  /// `REQUEST` | `CUSTOMER` | `OPPORTUNITY` | `SALE_ORDER` | `QUOTATION`
  docType   String
  /// แยกรูปแบบย่อยในชนิดเดียวกัน — `typeCode` ของคำขอ, หรือ `*` = ใช้กับทุกตัว
  scopeKey  String @default("*")

  /// เช่น `REQ-{COMPANY_PREFIX}-{M:REQUEST_TYPE}-{BYY}{MM}{SEQ}`
  pattern     String
  seqPadding  Int                  @default(4)
  startNumber Int                  @default(1)
  resetPeriod RunNumberResetPeriod @default(none)
  active      Boolean              @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, docType, scopeKey])
  @@index([companyId, docType])
  @@map("run_number_settings")
}

/// ลำดับเลขเอง หนึ่งแถวต่อหนึ่งช่วงรีเซ็ต.
///
/// **ไม่มี FK ไป `RunNumberSetting` โดยตั้งใจ** — ถ้าผูกไว้ การลบ setting แล้วสร้าง
/// ใหม่จะพาลำดับกลับไปเริ่มที่ 1 แล้วออกเลขซ้ำกับเอกสารที่ส่งออกไปแล้ว (NFR-03).
model RunNumberCounter {
  id        String @id @default(uuid())
  companyId String
  docType   String
  scopeKey  String
  /// `-` (ไม่รีเซ็ต) | `2026` | `202609` | `20260922`
  periodKey String
  lastSeq   Int    @default(0)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, docType, scopeKey, periodKey])
  @@map("run_number_counters")
}

// ---------------------------------------------------------------------------
// Approval  (D-31: a central service, callable without a Platform Request)
// ---------------------------------------------------------------------------

/// APV-01. Published versions are immutable — a change is a new version with
/// its own effective date, so a running case keeps the rules it started under
/// (D-18: each company has its own set).
model ApprovalMatrix {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  currency    String @default("THB")
  version     Int

  /// **Superseded by `levels` (31 Aug 2026).** Kept so versions published
  /// before that date still read, and so the cases routed under them can still
  /// be explained: `[{ upto: "100000.00" | null, chain: ["team_lead","cfo"] }]`
  /// ordered by ceiling ascending, `upto: null` being the top tier.
  tiers Json

  /// The approval ladder, one entry per level, in order.
  ///
  /// ```jsonc
  /// [ { "type": "supervisor", "up": 1 },
  ///   { "type": "org", "orgUnitIds": ["…"], "userIds": ["…"] } ]
  /// ```
  ///
  /// `supervisor.up` counts levels of the chart above the requester: 1 is the
  /// head of the group they sit in, 2 the department, and so on. `org` names
  /// groups; with `userIds` those people approve, without it the groups' heads
  /// do. Either way a level may resolve to **several** people, any one of whom
  /// can decide — see `ApprovalStep.candidateUserIds`.
  ///
  /// Null on a version published before the change, which is what makes this a
  /// new column rather than a rewrite of `tiers`: nothing already published is
  /// migrated, and a case in flight keeps the ladder it was routed under
  /// (§7 — running work keeps the rules it started under).
  levels Json?

  effectiveFrom DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  createdBy     String?

  company Company        @relation(fields: [companyId], references: [id])
  cases   ApprovalCase[]

  @@unique([companyId, subjectType, version])
  @@index([companyId, subjectType, effectiveFrom])
  @@map("approval_matrices")
}

/// One thing awaiting approval. `subjectType`/`subjectId` keep this generic:
/// APV-07 lets any module raise a case without creating a Request.
model ApprovalCase {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  subjectId   String

  /// Null for subjects with no monetary dimension (e.g. lead handover).
  amount   Decimal? @db.Decimal(18, 2)
  currency String?

  /// APV-05: hash of the approved payload. A material edit voids approvals.
  snapshotHash    String
  snapshotVersion Int    @default(1)

  matrixId      String?
  matrixVersion Int?

  status      ApprovalCaseStatus @default(pending)
  currentStep Int                @default(1)

  /// APV-07: event name published when the outcome lands.
  callbackEvent String?
  payload       Json?

  requestId String?

  createdAt DateTime  @default(now())
  createdBy String?
  decidedAt DateTime?

  company Company         @relation(fields: [companyId], references: [id])
  matrix  ApprovalMatrix? @relation(fields: [matrixId], references: [id])
  request Request?        @relation(fields: [requestId], references: [id])
  steps   ApprovalStep[]

  @@index([companyId, status])
  @@index([subjectType, subjectId])
  @@index([requestId])
  @@map("approval_cases")
}

/// The resolved chain, frozen at submit (APV-02). Changing the matrix later
/// does not reroute a case already in flight.
model ApprovalStep {
  id     String @id @default(uuid())
  caseId String
  stepNo Int

  /// Position in the matrix chain: `team_lead`, `cfo`, `ceo`, …
  approverRole   String
  /// The person that position resolved to at submit time.
  approverUserId String?

  /// Everyone allowed to decide this step. Any one of them is enough.
  ///
  /// A level can name several people — the heads of two groups, or a list
  /// chosen on screen A1 — and `approverUserId` holds only the first, for
  /// display and for the cases routed before this column existed.
  /// `authorise` reads this; `decidedByUserId` records who actually acted.
  candidateUserIds String[] @default([])

  status   ApprovalStepStatus @default(waiting)
  decision ApprovalDecision?
  note     String?

  /// APV-03: set when someone decided under a delegation — the history shows
  /// both names, never just the delegate's.
  decidedByUserId String?
  delegationId    String?

  dueAt     DateTime?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  case       ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approver   User?        @relation("StepApprover", fields: [approverUserId], references: [id])
  decidedBy  User?        @relation("StepDecider", fields: [decidedByUserId], references: [id])
  delegation Delegation?  @relation(fields: [delegationId], references: [id])

  @@unique([caseId, stepNo])
  @@index([candidateUserIds], type: Gin)
  @@index([approverUserId, status])
  @@map("approval_steps")
}

/// APV-03: temporary hand-over of approval authority. Sub-delegation is
/// rejected, and overlapping windows for the same delegator are rejected.
model Delegation {
  id              String   @id @default(uuid())
  companyId       String
  delegatorUserId String
  delegateUserId  String
  fromDate        DateTime
  toDate          DateTime
  note            String?
  active          Boolean  @default(true)

  createdAt DateTime  @default(now())
  createdBy String?
  revokedAt DateTime?

  company   Company        @relation(fields: [companyId], references: [id])
  delegator User           @relation("Delegator", fields: [delegatorUserId], references: [id])
  delegate  User           @relation("Delegate", fields: [delegateUserId], references: [id])
  steps     ApprovalStep[]

  @@index([companyId, delegatorUserId, fromDate, toDate])
  @@map("delegations")
}

// ---------------------------------------------------------------------------
// Support  (SLA / notification / audit — minimum viable per §09)
// ---------------------------------------------------------------------------

/// D-09/SUP-01: SLA is configuration, never hardcoded.
model SlaConfig {
  id              String      @id @default(uuid())
  companyId       String
  requestTypeCode String
  hours           Int
  coverage        SlaCoverage @default(H24X7)
  warnBeforeHours Int         @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, requestTypeCode])
  @@map("sla_configs")
}

/// SUP-01: the clock stops while a request sits returned with the requester,
/// so the elapsed time reported in REQ-09 is time the request was actually
/// somebody's to act on.
model SlaClock {
  id        String @id @default(uuid())
  requestId String @unique

  startedAt     DateTime
  pausedAt      DateTime?
  accumulatedMs Int       @default(0)
  dueAt         DateTime
  state         SlaState  @default(running)
  warnedAt      DateTime?
  breachedAt    DateTime?
  escalatedAt   DateTime?

  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id])

  @@index([state, dueAt])
  @@map("sla_clocks")
}

/// One working-hours + holiday set per company for this sprint; shifts and
/// multiple calendars are explicitly out of scope (§09).
model HolidayCalendar {
  id        String @id @default(uuid())
  companyId String @unique
  name      String @default("default")

  /// Minutes from midnight, e.g. 510 = 08:30.
  workdayStartMinute Int   @default(510)
  workdayEndMinute   Int   @default(1050)
  /// ISO weekday numbers that are working days (1 = Monday).
  workingWeekdays    Int[] @default([1, 2, 3, 4, 5])
  /// ["2026-01-01", …]
  holidays           Json  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("holiday_calendars")
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  companyId String

  eventType String
  title     String
  body      String

  resourceType String?
  resourceId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user       User                      @relation(fields: [userId], references: [id])
  company    Company                   @relation(fields: [companyId], references: [id])
  deliveries NotificationDeliveryLog[]

  @@index([userId, readAt])
  @@map("notifications")
}

/// SUP-03: which optional channels a person wants, per company.
///
/// In-app delivery is deliberately **not** representable here — §09 makes it
/// mandatory, because a request that nobody can be told about is a request
/// that silently misses its SLA. Only email is a choice, and while SMTP is
/// unresolved (open question B) the value is recorded and honoured by nothing.
model NotificationPreference {
  id        String @id @default(uuid())
  userId    String
  companyId String

  emailEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("notification_preferences")
}

/// SUP-03: every send is logged, which is what settles "I never got notified".
model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  target         String
  status         DeliveryStatus      @default(queued)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_logs")
}

/// SUP-04: one append-only log for permission changes, status transitions,
/// approvals, sensitive-field reads, and admin configuration. There is no API
/// that updates or deletes a row here, by design.
model AuditLog {
  id        String  @id @default(uuid())
  companyId String?

  actorId       String?
  actorUsername String?

  eventType    String
  resourceType String?
  resourceId   String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  actor   User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// CD-92 v2: BI dashboards are configuration rows, not env constants — an
/// admin adds or retires dashboards and scopes each to org units without a
/// deploy (configuration over code). `active` is the soft-delete flag; a
/// retired dashboard stays findable, per the no-hard-delete rule.
model BiDashboard {
  id                  String  @id @default(uuid())
  companyId           String
  title               String
  /// The numeric id Metabase shows in the dashboard URL.
  metabaseDashboardId Int
  sortOrder           Int     @default(0)
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company   Company               @relation(fields: [companyId], references: [id])
  audiences BiDashboardAudience[]

  @@index([companyId])
  @@map("bi_dashboards")
}

/// Which org units may see a dashboard. No rows = the whole company sees it.
/// An assigned unit covers its entire subtree (`OrgClosure`), so a department
/// row includes every team beneath it — the same maths as data scope (§6.2).
model BiDashboardAudience {
  dashboardId String
  orgUnitId   String

  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([dashboardId, orgUnitId])
  @@index([orgUnitId])
  @@map("bi_dashboard_audiences")
}

/// NFR-03: replay protection for state-changing POSTs carrying an
/// `Idempotency-Key`.
model IdempotencyKey {
  key         String   @id
  requestHash String
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// AUTH-06 — a credential an integration holds instead of fetching a Keycloak
/// token before every burst of calls.
///
/// The key is **not** a token and is never presented to user-service: core-
/// service exchanges it for a real client-credentials token and forwards that,
/// so token verification stays in one place (§03) and every downstream rule is
/// unchanged.
///
/// Only the hash is stored. A key is shown once, at issue, and is
/// unrecoverable afterwards — a database dump does not yield a working
/// credential.
model ApiKey {
  id      String @id @default(uuid())
  /// Who holds it, in words a person can act on: "Aiyara chatbot (prod)".
  name    String
  /// The first characters of the key, so a key can be named in a ticket or a
  /// log without quoting the secret. Display only — lookup is by hash.
  prefix  String @unique
  /// sha256 of the whole key. Unique, and the only thing looked up.
  keyHash String @unique

  active    Boolean   @default(true)
  /// Null means it never expires — the property this table exists to provide.
  ///
  /// Revocation, not expiry, is how such a key is taken away, and it takes
  /// effect on the very next request: the key is read from this table before
  /// the 60-second principal cache is consulted, so nothing cached can keep a
  /// revoked key working. The migration comment beside this table says
  /// "within the 60-second principal cache" — it was written before that was
  /// measured, and is left as-is because editing an applied migration changes
  /// its checksum.
  expiresAt DateTime?

  /// บริษัทที่ key นี้ทำงานแทน (14 ก.ย. 2569).
  ///
  /// ย้ายมาไว้ที่ key เพราะช่องทางภายนอก — เว็บฟอร์ม, LINE OA — ยิงเข้ามาโดยไม่มี
  /// คนคอยใส่ header ให้ และ `X-Company-Id` ที่ผู้เรียกกรอกเองคือช่องที่กรอกผิด
  /// แล้วข้อมูลไปโผล่ผิดบริษัท. ตั้งที่นี่ = ผู้ถือ key เลือกไม่ได้.
  ///
  /// NULL = key แบบเดิมที่ผู้เรียกต้องส่ง `X-Company-Id` เอง (chatbot ซึ่งทำงาน
  /// ให้หลายบริษัทผ่าน key ใบเดียว) — ยังใช้ได้เหมือนเดิมทุกประการ.
  companyId String?

  /// ช่องทางที่ key ใบนี้ *เป็น* — `website`, `line-oa`, `event-2026-q4`.
  ///
  /// หนึ่ง key ต่อหนึ่งช่องทาง คือเหตุผลที่คอลัมน์นี้อยู่ตรงนี้: แหล่งที่มาของ
  /// Lead เป็นข้อเท็จจริงที่ *กุญแจ* รู้ ไม่ใช่ค่าที่ผู้เรียกพิมพ์มาใน body
  /// ซึ่งพิมพ์ผิดได้ พิมพ์ปลอมได้ และพอตัวเลขการตลาดผิดก็ไล่ไม่ได้ว่าใบไหนมาจากไหน.
  sourceCode String?

  /// สิทธิ์ที่ key ใบนี้ใช้ได้ — ตัดจากสิทธิ์ที่บัญชีบริการถืออยู่ ไม่ใช่เพิ่มให้.
  ///
  /// ว่าง = ไม่จำกัด คือ key เดิมทุกใบก่อน 14 ก.ย. 2569 ซึ่งได้สิทธิ์เต็มชุดของ
  /// integration client ตามเดิม. ใส่ค่า = key ใบนั้นทำได้เท่าที่ระบุ เช่น key ของ
  /// เว็บฟอร์มถือแค่ `integration.crm.lead.create` — หลุดออกไปก็เปิด Lead ได้
  /// อย่างเดียว อ่านคำขอของบริษัทไม่ได้.
  ///
  /// **ตัดอย่างเดียว ไม่เคยเพิ่ม** — คำตอบว่า "ทำอะไรได้" ยังมาจาก role ของ
  /// บัญชีบริการที่เดียวเหมือนเดิม (ดู `ApiKeyService`); คอลัมน์นี้เป็น intersect
  /// ไม่ใช่แหล่งสิทธิ์ที่สอง จึงไม่มีทางที่สองที่จะขัดกัน.
  scopes String[] @default([])

  /// Written at most once a minute, not on every call: an audit trail worth
  /// having, not a write amplifier on the hot path.
  lastUsedAt DateTime?

  revokedAt DateTime?
  revokedBy String?

  createdBy String
  createdAt DateTime @default(now())

  @@index([active])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// CRM — Customer Master (CM-xx) + มุมมอง 360° (C360-xx)
// Spec: artifact 856c08fd (8 ก.ย. 2569). One customer registry for every
// module and for SAP — no module may keep its own (D-30).
// ---------------------------------------------------------------------------

/// CM-01/02/04 — the single customer registry.
///
/// `customerCode` is issued by THIS system (PO decision #1, 8 ก.ย. 2569):
/// SAP receives it and answers with its Business Partner number, stored in
/// `CustomerExternalCode` — never the other way round.
///
/// No hard delete: `inactive` + `deactivateReason` is the only way out, and a
/// deactivated customer still blocks its tax id (CM-03) — the duplicate rule
/// points at the existing row so it can be reactivated instead of recreated.
model Customer {
  id String @id @default(uuid())

  /// Issued atomically at create (CM-02) — unique across the whole database,
  /// like `Request.requestNo`, because SAP and 7 accounting systems key on it.
  customerCode String @unique

  companyId String
  type      CustomerType

  nameTh String
  nameEn String?

  /// `nameTh` with the legal-form prefixes (บจก./บมจ./หจก./…) and whitespace
  /// stripped — written on every create/update so the CM-03 similarity check
  /// is a column comparison, not a per-row computation at query time.
  normalizedName String

  /// เลขผู้เสียภาษี 13 หลัก, checksum-validated at the API (CM-01). Optional:
  /// a walk-in individual may not have provided one yet.
  taxId String?

  /// รหัสสาขาสรรพากร 5 หลัก. `00000` = สำนักงานใหญ่ (redesign #2, 8 ก.ย. 2569:
  /// the PO wants each branch to BE a customer row — separate opportunities, separate
  /// billing identity — not a child record under one customer).
  branchCode String @default("00000")

  /// ชื่อสาขาเพื่อการแสดงผล เช่น "สาขาราชวงศ์" — the legal name (`nameTh`)
  /// is identical across an entity's branches, this is what tells them apart.
  branchName String?

  /// สาขาผูกกับรายหลัก (สำนักงานใหญ่) อัตโนมัติด้วยเลขภาษีตอนสร้าง — the HQ
  /// page lists its branches through this, and the future 360° rollup sums
  /// across it. NULL = รายหลักเอง หรือรายเดี่ยวที่ไม่มีเครือ.
  headOfficeId String?

  status CustomerStatus @default(draft)

  /// CM-04: set by the KYC request callback (ชุดงาน B), never directly by a
  /// screen. A customer is usable without it until a KYC-flagged product
  /// enters a opportunity.
  kycVerified   Boolean   @default(false)
  kycVerifiedAt DateTime?

  /// CM-01/08 — ผู้รับผิดชอบบัญชี. Scope pivots on this and on
  /// `ownerOrgUnitId` below.
  accountOwnerUserId String?

  /// Where the account owner sat when assigned — a snapshot column with no FK,
  /// exactly like `Request.requesterOrgUnitId`: team visibility must not be
  /// rewritten by a later org-chart edit.
  ownerOrgUnitId String?

  deactivatedAt    DateTime?
  deactivateReason String?
  suspendReason    String?

  /// CM-09 (โครงเท่านั้น — PO เลื่อน merge ออกจาก MVP, 8 ก.ย. 2569): when a
  /// duplicate slips through and is later merged, the losing row stays as an
  /// alias pointing at the survivor. Lookups by the old code follow this.
  mergedIntoCustomerId String?
  mergedAt             DateTime?

  /// CM-03: a similar-name warning that was overridden records who confirmed
  /// and why — beside the audit row, so the fact travels with the customer.
  dedupOverrideReason String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company         Company    @relation(fields: [companyId], references: [id])
  accountOwner    User?      @relation("CustomerAccountOwner", fields: [accountOwnerUserId], references: [id])
  mergedInto      Customer?  @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id])
  aliases         Customer[] @relation("CustomerMerge")
  headOffice      Customer?  @relation("CustomerHeadOffice", fields: [headOfficeId], references: [id])
  branchCustomers Customer[] @relation("CustomerHeadOffice")

  leads          Lead[]
  opportunities  Opportunity[]
  saleOrders     SaleOrder[]
  quotations     Quotation[]
  locations      CustomerLocation[]
  contacts       CustomerContact[]
  externalCodes  CustomerExternalCode[]
  fieldChanges   CustomerFieldChange[]
  segments       CustomerSegmentAssignment[]
  timelineEvents CustomerTimelineEvent[]

  /// CM-03 hard block — the same juristic person appears once PER BRANCH
  /// (redesign #2: a branch is its own customer row, linked to the head
  /// office by `headOfficeId`). Postgres treats NULL tax ids as distinct, so
  /// customers without one never collide here.
  @@unique([companyId, taxId, branchCode])
  @@index([companyId, headOfficeId])
  @@index([companyId, status])
  @@index([companyId, accountOwnerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([companyId, normalizedName])
  @@map("customers")
}

/// CM-01 — ที่อยู่/ไซต์ของลูกค้ารายนั้น (redesign #2, 8 ก.ย. 2569: branches
/// became customer rows, so this table holds LOCATIONS — the addresses and
/// installation sites of one branch-customer). A branch-customer usually has
/// one billing address and any number of sites (a rented warehouse, a
/// customer's server room):
///
///   - `isBilling` — this address goes on the tax invoice of THIS customer.
///   - `isSite` — จุดติดตั้ง/รับของ. Both may be true on one row.
///
/// Installed-base rows (Service & Support, a later phase) will FK here, which
/// is why retirement is `active=false`, never delete: an asset's site and an
/// issued invoice's address must stay resolvable.
model CustomerLocation {
  id         String @id @default(uuid())
  customerId String

  /// ชื่อที่อยู่/ไซต์ — "สำนักงาน", "ไซต์โรงงานบางปู", "ห้องเซิร์ฟเวอร์ชั้น 3".
  name String?

  line1       String
  line2       String?
  subDistrict String?
  district    String?
  province    String?
  postalCode  String?
  country     String  @default("TH")

  /// ใช้ออกใบกำกับของลูกค้ารายนี้.
  isBilling Boolean @default(false)
  /// เป็นจุดติดตั้ง/รับของ.
  isSite    Boolean @default(true)
  /// ที่อยู่หลัก — the default pick on documents.
  isPrimary Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_locations")
}

/// CM-05 — ผู้ติดต่อ. Consent status is deliberately ABSENT: it is read live
/// from the central PDPA service and rendered as a badge, never copied here
/// (spec: "ห้ามเก็บซ้ำในตาราง contact").
model CustomerContact {
  id         String              @id @default(uuid())
  customerId String
  name       String
  role       CustomerContactRole @default(other)
  position   String?

  phone  String?
  email  String?
  lineId String?
  note   String?

  isPrimary Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_contacts")
}

/// CM-02 — รหัสภายนอก: `system` = `sap` for the BP number, plus the 7
/// accounting-line systems (D-30). `payload` keeps whatever else the external
/// system answered at create (PO decision #1) so nothing is lost to a
/// narrower column later.
model CustomerExternalCode {
  id           String @id @default(uuid())
  customerId   String
  system       String
  externalCode String
  payload      Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, system])
  @@index([system, externalCode])
  @@map("customer_external_codes")
}

/// CM-01 AC — "แก้ field ใดเก็บประวัติ ใคร–เมื่อไร–ค่าก่อน/หลัง". Append-only,
/// one row per changed field per edit, written in the same transaction as the
/// update. Kept beside (not instead of) the shared audit log: this one is the
/// per-customer history tab, queryable by field.
model CustomerFieldChange {
  id         String @id @default(uuid())
  customerId String
  field      String
  before     Json?
  after      Json?

  changedBy String?
  changedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, changedAt])
  @@map("customer_field_changes")
}

/// CM-07 — segmentation dimensions (ประเภท ขนาด อุตสาหกรรม ศักยภาพ …) are
/// rows, not code: adding the 5th dimension is an insert from the admin
/// screen, the same rule that governs request types (REQ-01 / D-09).
model CustomerSegmentDimension {
  id        String  @id @default(uuid())
  companyId String
  code      String
  nameTh    String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company                @relation(fields: [companyId], references: [id])
  values  CustomerSegmentValue[]

  @@unique([companyId, code])
  @@map("customer_segment_dimensions")
}

model CustomerSegmentValue {
  id          String  @id @default(uuid())
  dimensionId String
  code        String
  nameTh      String
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  dimension   CustomerSegmentDimension    @relation(fields: [dimensionId], references: [id])
  assignments CustomerSegmentAssignment[]

  @@unique([dimensionId, code])
  @@map("customer_segment_values")
}

/// Which segments a customer sits in. Several dimensions at once (CM-07 AC),
/// keyed so Pricing (ระยะ 2) can query "customers in value X" as one indexed
/// lookup.
model CustomerSegmentAssignment {
  customerId String
  valueId    String

  assignedAt DateTime @default(now())
  assignedBy String?

  customer Customer             @relation(fields: [customerId], references: [id])
  value    CustomerSegmentValue @relation(fields: [valueId], references: [id])

  @@id([customerId, valueId])
  @@index([valueId])
  @@map("customer_segment_assignments")
}

/// CM-02 — one continuously increasing counter per company, bumped by the
/// same single-statement upsert as `DocNumberCounter`. No monthly reset: a
/// customer code is permanent and 7 external systems key on it.
model CustomerCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("customer_code_counters")
}

/// Per-company CRM configuration, editable from the admin screen without a
/// deploy: the customer-code shape (CM-02 AC) and the similar-name threshold
/// (CM-03, PO decision #4 — "ระดับความคล้ายเป็นค่า config จูนได้").
model CrmCompanyConfig {
  id        String @id @default(uuid())
  companyId String @unique

  /// Code prefix, e.g. `CUS`. The company's `docPrefix` is appended by the
  /// pattern, so OSD gets `CUS-OSD-000001`.
  codePrefix  String @default("CUS")
  codePadding Int    @default(6)

  /// 0..1 — Dice-coefficient threshold above which two normalized names are
  /// reported as "similar" by check-duplicate.
  dedupThreshold Float @default(0.85)

  /// CD-76: margin ขั้นต่ำ (%) ของใบเสนอราคา — ต่ำกว่านี้ต้องผ่านคำขออนุมัติก่อนส่ง
  /// ลูกค้า. ตั้งค่าได้แทนการรอเกณฑ์จาก CD-26 (ยังไม่ยืนยัน).
  minMarginPct              Float  @default(15)
  /// จำนวนวันที่ใบเสนอราคาใหม่มีผล — ค่าตั้งต้นของ `Quotation.validUntil`.
  quotationValidityDays     Int    @default(30)
  vatPct                    Float  @default(7)
  /// ประเภทคำขอที่ระบบสร้างร่างให้เมื่อ margin ต่ำ — ต้องเปิดให้บริษัทนี้ใช้อยู่.
  quotationApprovalTypeCode String @default("DSC")

  /// CD-65: โอกาสการขายที่เปิดอยู่และไม่มีกิจกรรมเสร็จนานเกินจำนวนวันนี้ = "เงียบ"
  /// → แจ้งหัวหน้าของเจ้าของดีล. 0 = ปิดการแจ้งเตือน.
  staleOpportunityDays Int @default(14)

  /// หัวกระดาษเอกสารขาย (ใบเสนอราคา) — ข้อมูลตามทะเบียนของบริษัทผู้ขาย ตั้งค่าได้
  /// ในหน้า admin CRM; ว่าง = ใช้ `Company.name` และไม่แสดงบรรทัดนั้น.
  letterheadNameTh  String?
  letterheadNameEn  String?
  letterheadTaxId   String?
  /// เช่น "สำนักงานใหญ่" หรือ "สาขาที่ 00001".
  letterheadBranch  String?
  letterheadAddress String?
  letterheadPhone   String?
  letterheadEmail   String?
  letterheadWebsite String?
  /// data URL (png/jpeg/webp base64) — เล็กพอเก็บในแถวได้ (จำกัด ~375KB).
  letterheadLogo    String?
  /// เงื่อนไขมาตรฐานท้ายใบเสนอราคา (หลายบรรทัด).
  quotationTerms    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@map("crm_company_configs")
}

/// C360-03 — the cross-module customer timeline, append-only. Modules publish
/// through `CustomerTimelineService`, never by writing this table directly;
/// there is no update or delete path. `requiredPermission` filters the feed:
/// an event whose source the viewer may not read does not appear.
///
/// Designed as the generic event schema the spec asks for because ระยะ 4
/// (AI CARE conversations) will land in this same feed.
model CustomerTimelineEvent {
  id         String @id @default(uuid())
  companyId  String
  customerId String

  /// What the event points back at: `customer`, `request`, `opportunity`, … plus the
  /// row id, the same ref mechanism as REQ-06.
  refType String
  refId   String?

  eventType String
  summary   String

  actorId   String?
  actorName String?

  /// Permission needed to see this event, or NULL for anyone who can open the
  /// customer.
  requiredPermission String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, occurredAt])
  @@index([companyId, occurredAt])
  @@map("customer_timeline_events")
}

/// CM-06 — the retry queue behind the ERP integration layer (PO 8 ก.ย. 2569;
/// ERP = SAP since 24 ก.ย. 2569: data is saved here first, then a customer
/// create calls SAP and gets the BP number back; when SAP is down the work
/// lands here instead of blocking the create, and a sweeper retries with
/// backoff). Rows are kept after they finish — the
/// "ทุกรอบ sync มี log" AC is answered by this table plus the audit trail.
model IntegrationSyncJob {
  id String @id @default(uuid())

  /// 'sap' | 'workflow' — one queue for every external system the layer fronts.
  system     String
  /// sap: 'customer_upsert' | 'receivables_refresh' | 'sale_order_create' | 'sale_order_cancel'
  /// workflow: 'lead_start'
  kind       String
  /// The row being synced — customerId for the sap customer kinds, saleOrderId
  /// for the sale_order kinds, leadId for 'lead_start'.
  resourceId String

  status    IntegrationJobStatus @default(pending)
  attempts  Int                  @default(0)
  /// The last failure, verbatim — what an operator reads first.
  lastError String?
  runAfter  DateTime             @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system, status, runAfter])
  @@index([system, kind, resourceId])
  @@map("integration_sync_jobs")
}

/// CM-04 (ชุดงาน B) — product ใดต้องยืนยันตัวตน (KYC). Configuration แก้จาก
/// หน้าจอผู้ดูแลไม่ต้อง deploy; PO ยืนยัน 8 ก.ย. 2569 ว่า KYC ไม่ block —
/// โมดูลโอกาสการขาย (CRM ระยะถัดไป) อ่านตารางนี้เพื่อ "แจ้งเตือน" เมื่อโอกาสการขายมี product
/// ที่เข้าเงื่อนไขและลูกค้ายังไม่ kycVerified. รายการจริงยังรอ PO/การเงิน —
/// นี่คือโครง + หน้าจอกรอกที่พร้อมรับค่าวันเปิดใช้.
model KycProductRule {
  id        String @id @default(uuid())
  companyId String

  /// รหัสสินค้า/บริการ — ต้องตรงกับรหัส material ใน SAP (D-30, งาน mapping ระยะ 0).
  productCode String
  name        String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, productCode])
  @@map("kyc_product_rules")
}

/// CRM — รายการสถานะของ Lead ต่อบริษัท. หน้า "ตั้งค่า CRM → สถานะ Lead" เพิ่ม
/// ลบ เปลี่ยนชื่อ สลับลำดับได้เอง โดยไม่ต้อง migrate (D-09).
///
/// ตารางนี้คือ **รายการขั้น** เท่านั้น — *กฎ* ว่าเลื่อนจากขั้นไหนไปขั้นไหนได้
/// เมื่อไร ไม่ได้อยู่ที่นี่และไม่ได้อยู่ใน core-service เลย: PO ตัดสิน 10 ก.ย. 2569
/// ว่า workflow ของ CRM อยู่บน service `workflowable` ตามหลัก "Workflow owns
/// Process, Core owns Data". ถ้ามีคนกำลังจะเพิ่มคอลัมน์ประเภท "ขั้นนี้ต้องมี X
/// ก่อน" หรือ "ขั้นนี้ไปต่อได้" ลงตารางนี้ — นั่นคือ process กำลังงอกที่สอง
/// และจะ drift กับ workflow แน่นอน.
///
/// สามแถวเป็น **สถานะระบบ** (`isSystem`): สถานะเริ่มต้นของ Lead ใหม่, ปลายทาง
/// `won` (แปลงเป็นโอกาสการขาย) และปลายทาง `lost` (คัดออก) — ลบไม่ได้และปิดไม่ได้
/// เพราะ `convert`/`disqualify` ต้องมีปลายทางเสมอ. ที่เหลือเป็นขั้นระหว่างทางที่
/// ผู้ดูแลกำหนดเองทั้งหมด.
model LeadStatusSetting {
  id        String @id @default(uuid())
  companyId String

  /// รหัสที่ `leads.status` เก็บ — ตั้งครั้งเดียว แก้ไม่ได้ (Lead เดิมอ้างอยู่).
  code   String
  nameTh String

  kind LeadStatusKind @default(open)

  /// สีป้ายบนหน้าจอ (ชื่อสีของ antd Tag เช่น `blue`, `green`).
  color String @default("default")

  /// สถานะตั้งต้นของ Lead ที่เพิ่งรับเข้า — มีได้หนึ่งเดียวต่อบริษัท.
  isDefault Boolean @default(false)

  /// สถานะระบบ: ลบไม่ได้ ปิดไม่ได้ เปลี่ยนชนิดไม่ได้.
  isSystem Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, sortOrder])
  @@map("lead_statuses")
}

/// CRM Lead — รับ Lead ทุกช่องทาง บันทึกแหล่งที่มา คัดกรอง แล้วแปลงเป็น
/// โอกาสการขายโดยข้อมูลไหลต่อ (spec CRM ฟีเจอร์ Lead). No hard delete:
/// `disqualified` + เหตุผล คือทางออกเดียว. Ownership columns mirror
/// customers so `visibleSalesWhere` scopes both the same way.
model Lead {
  id        String @id @default(uuid())
  companyId String

  name        String
  contactName String?
  phone       String?
  email       String?
  note        String?

  /// ตำแหน่ง/ฝ่ายของผู้ติดต่อ (หน้ารายละเอียด Lead, 10 ก.ย. 2569).
  contactPosition String?

  /// ข้อมูลบริษัท/ลูกค้าเป้าหมาย — กรอกได้ระหว่างคัดกรอง ก่อนที่ Lead จะกลาย
  /// เป็นลูกค้าในทะเบียน; free text ทั้งหมด ไม่ผูก master ใด.
  nameEn         String?
  taxId          String?
  industry       String?
  companySize    String?
  employeeCount  Int?
  productGroup   String?
  subProduct     String?
  projectRevenue Decimal? @db.Decimal(14, 2)

  /// ที่อยู่ 1 ชุด — พอสำหรับ Lead; ที่อยู่หลายชุดอยู่บนลูกค้า (CustomerLocation).
  addressLine String?
  district    String?
  province    String?
  postalCode  String?
  country     String  @default("TH")

  /// แหล่งที่มา — free code วันนี้ (LINE OA, เว็บไซต์, งานอีเวนต์, AI SMART
  /// จะเข้ามาเป็นค่าหนึ่งในระยะ 2).
  sourceCode String?

  /// รหัสสถานะ — อ้าง `lead_statuses.code` ของบริษัทเดียวกัน. เก็บเป็น text
  /// ไม่ใช่ enum เพราะรายการสถานะแก้ได้จากหน้าตั้งค่าโดยไม่ต้อง migrate; ความ
  /// ถูกต้องบังคับที่ `LeadStatusService` (และการลบสถานะที่ยังมี Lead ใช้อยู่
  /// ถูกปฏิเสธ) แทน FK เพราะคีย์ต้องเป็นคู่ (companyId, code) ซึ่ง Prisma
  /// ผูกซ้ำกับ `company` ไม่ได้.
  status           String  @default("new")
  disqualifyReason String?

  /// ลูกค้าเดิมที่ Lead นี้เป็นเรื่องของเขา (ถ้า match ได้).
  customerId String?

  /// โอกาสการขายที่เกิดจากการแปลง — ข้อมูลไหลต่อ ไม่พิมพ์ซ้ำ.
  convertedOpportunityId String? @unique

  /// instance ของ workflow `lwf-0001` บน OSD Workflow ที่กำลังเดิน Lead ใบนี้
  /// (PO 10 ก.ย. 2569: "Workflow owns Process, Core owns Data").
  ///
  /// ต้องเก็บเพราะการส่ง signal เข้าไปบอกว่า "มีกิจกรรมเสร็จแล้ว" ยิงไปที่
  /// `POST /workflow-instances/{id}/signal` ซึ่งอ้าง instance ตรง ๆ ไม่ได้อ้าง
  /// business key. NULL = ยังไม่ได้ start (หรือ start ไม่สำเร็จและยังค้างในคิว
  /// `integration_sync_jobs`) — Lead ยังใช้งานได้ตามปกติ ไม่ผูกชะตากับ workflow.
  workflowInstanceId String?

  /// NULL = **กองกลาง** — ใบที่ยังไม่มีเจ้าของ. เกิดจาก Lead ที่ระบบภายนอกยิง
  /// เข้ามาเอง (`POST /integrations/crm/leads`, 14 ก.ย. 2569): ผู้ยิงเป็น
  /// service account ไม่ใช่คน จึงไม่มีพนักงานขายคนไหนที่จะเป็นเจ้าของได้ตอนนั้น
  /// และการยัดบัญชีบริการลงช่องนี้จะได้ Lead ที่ "มีเจ้าของ" ซึ่งไม่มีใครดูแลจริง.
  /// ใบกองกลางทุกคนในบริษัทที่อ่าน Lead ได้เห็น (`visibleSalesWhere`) จนกว่าจะ
  /// ถูก assign — ดู `LeadsService.assign`.
  ownerUserId    String?
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company              Company        @relation(fields: [companyId], references: [id])
  customer             Customer?      @relation(fields: [customerId], references: [id])
  convertedOpportunity Opportunity?   @relation(fields: [convertedOpportunityId], references: [id])
  activities           LeadActivity[]

  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@map("leads")
}

/// CRM — กิจกรรมที่ลงบน Lead (โทร / อีเมล / นัดหมาย / งาน / บันทึก). A row is
/// either a log of something done (no `dueAt`, completed on creation) or a
/// planned item (`dueAt` set, `completedAt` null until ticked). Nothing is
/// deleted: a wrong entry is completed or left as history.
model LeadActivity {
  id        String @id @default(uuid())
  companyId String
  leadId    String

  type    LeadActivityType
  subject String
  detail  String?

  dueAt       DateTime?
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, dueAt])
  @@index([companyId, createdAt])
  @@map("lead_activities")
}

/// CRM โอกาสการขาย (Opportunity) — ขั้น มูลค่า ความน่าจะเป็น วันคาดปิด. `opportunityCode`
/// is what requests reference (`ref_type=opportunity`, e.g. the D-501 the request
/// form always suggested). Won/lost are closed states; reopening is a later
/// decision, not an accident.
model Opportunity {
  id              String @id @default(uuid())
  opportunityCode String @unique

  companyId String

  /// PO 10 ก.ย. 2569: การเปิดโอกาสการขาย **ยังไม่ถือเป็นลูกค้า** — NULL จนกว่าจะ
  /// เปิดใบสั่งขาย (`SaleOrder`) ซึ่งเป็นจุดเดียวที่สร้างลูกค้าในทะเบียนแล้วผูกกลับ
  /// มาที่นี่. ไม่ NULL ตั้งแต่ต้นได้เมื่อเป็นโอกาสการขายของลูกค้าเดิม (repeat business).
  customerId String?

  /// ผู้มุ่งหวัง (prospect) — ใช้แทนลูกค้าระหว่างที่ `customerId` ยัง NULL; copy มา
  /// จาก Lead ตอน convert หรือกรอกตรงเมื่อเปิดด้วยมือ. DB CHECK บังคับว่าต้องมี
  /// อย่างใดอย่างหนึ่ง (`customerId` หรือ `prospectName`). เมื่อเปิดใบสั่งขาย
  /// ค่าเหล่านี้กลายเป็นค่าตั้งต้นของทะเบียนลูกค้า แล้วคงไว้เป็นประวัติ.
  prospectName        String?
  prospectTaxId       String?
  prospectContactName String?
  prospectPhone       String?
  prospectEmail       String?

  title String

  stage           OpportunityStage @default(qualifying)
  amount          Decimal?         @db.Decimal(14, 2)
  currency        String           @default("THB")
  /// 0–100.
  probability     Int?
  expectedCloseAt DateTime?

  wonAt          DateTime?
  lostAt         DateTime?
  /// From `OpportunityLostReason` — เหตุผลมาตรฐาน วิเคราะห์ได้.
  lostReasonCode String?
  lostReasonText String?

  ownerUserId    String
  ownerOrgUnitId String?

  /// CD-65 — กิจกรรมที่ทำเสร็จล่าสุด (NULL = ยังไม่เคยมี นับความเงียบจาก `createdAt`).
  /// เก็บซ้ำไว้บนแถวเพื่อให้ sweeper และหน้ารายการหาดีลเงียบได้ด้วย index เดียว
  /// แทนการ group กิจกรรมทุกครั้ง. เขียนโดย `OpportunityActivitiesService` เท่านั้น.
  lastActivityAt DateTime?
  /// กำหนดติดตามที่ใกล้ที่สุดของกิจกรรมที่ยังไม่เสร็จ — NULL = ไม่มีนัดค้าง.
  nextFollowUpAt DateTime?
  /// ครั้งล่าสุดที่แจ้งหัวหน้าว่าดีลนี้เงียบ; ล้างเป็น NULL เมื่อมีกิจกรรมใหม่
  /// ทำเสร็จ — กันแจ้งซ้ำทุกรอบ sweep แบบเดียวกับ `SlaClock.escalatedAt`.
  staleAlertedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company    Company               @relation(fields: [companyId], references: [id])
  customer   Customer?             @relation(fields: [customerId], references: [id])
  activities OpportunityActivity[]
  products   OpportunityProduct[]
  saleOrders SaleOrder[]
  quotations Quotation[]
  fromLead   Lead?

  @@index([companyId, stage])
  @@index([companyId, customerId])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([stage, lastActivityAt])
  @@map("opportunities")
}

/// CD-65 กิจกรรมบนโอกาสการขาย — รูปเดียวกับ `LeadActivity` (ใช้ enum เดียวกัน):
/// ไม่มี `dueAt` = บันทึกสิ่งที่ทำไปแล้ว (เสร็จทันที), มี `dueAt` = นัดติดตาม.
/// append-mostly: ติ๊กเสร็จ/เปิดกลับได้ ไม่มีการลบ.
model OpportunityActivity {
  id            String @id @default(uuid())
  companyId     String
  opportunityId String

  type    LeadActivityType
  subject String
  detail  String?

  dueAt       DateTime?
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId, dueAt])
  @@index([companyId, createdAt])
  @@map("opportunity_activities")
}

/// สินค้า/บริการที่เกี่ยวกับโอกาสการขาย — รหัสต้องตรง material ใน SAP (D-30). ชุดงาน B ใช้คู่กับ
/// `kyc_product_rules`: โอกาสการขายที่มี product เข้าเงื่อนไข + ลูกค้ายังไม่
/// kycVerified = banner แจ้งเตือน (ไม่ block).
model OpportunityProduct {
  id            String  @id @default(uuid())
  opportunityId String
  productCode   String
  name          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([opportunityId, productCode])
  @@map("opportunity_products")
}

/// เหตุผลปิดแพ้มาตรฐาน — configuration ต่อบริษัท seeded with defaults.
model OpportunityLostReason {
  id        String  @id @default(uuid())
  companyId String
  code      String
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("opportunity_lost_reasons")
}

/// ตัวนับ opportunityCode ต่อบริษัท — atomic แบบเดียวกับ CustomerCodeCounter.
model OpportunityCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("opportunity_code_counters")
}

/// CRM ใบสั่งขาย (Sale Order) — โครงระยะ 1 (CD-77): ออกเลข SO-{docPrefix}-xxxxxx
/// จากโอกาสการขายที่เปิดอยู่, และเป็น **จุดเดียวที่สร้างลูกค้าในทะเบียน** (PO 10 ก.ย.
/// 2569): ถ้าโอกาสการขายยังไม่มีลูกค้า ระบบสร้างจากข้อมูลผู้มุ่งหวังแล้วผูกกลับ
/// ทั้งโอกาสการขายและ Lead ต้นทาง; เปิดใบสั่งขายถือว่าปิดโอกาสการขายแบบชนะ.
/// รายการสินค้า/ราคาต่อบรรทัดยังไม่อยู่ที่นี่ — มาจากใบเสนอราคา/BOQ ของโมดูล Sales
/// (ระยะถัดไป) และการส่งเข้า SAP ใช้คิว integration_sync_jobs เดิม.
model SaleOrder {
  id            String @id @default(uuid())
  saleOrderCode String @unique

  companyId     String
  opportunityId String
  customerId    String

  status SaleOrderStatus @default(open)

  amount   Decimal? @db.Decimal(14, 2)
  currency String   @default("THB")
  note     String?

  orderedAt    DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  /// Scope columns identical to Opportunity/Lead so `visibleSalesWhere` applies.
  ownerUserId    String
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  /// CD-77: ใบเสนอราคาที่ลูกค้ายอมรับซึ่งใบสั่งขายนี้เปิดตาม — ว่างได้ (ใบสั่งขายที่
  /// เปิดก่อนมีโมดูลใบเสนอราคา หรือเปิดตรงจากโอกาสการขาย).
  quotationId String?

  /// CD-88 — การส่งเข้า SAP. เก็บที่ CTD ก่อนเสมอ แล้วค่อยส่งผ่านคิว
  /// `integration_sync_jobs` (kind `sale_order_create` / `sale_order_cancel`).
  erpStatus    ErpSyncStatus @default(not_ready)
  /// เลขใบสั่งขายที่ SAP ตอบกลับ.
  erpOrderNo   String?
  erpSyncedAt  DateTime?
  /// ข้อผิดพลาดล่าสุดตามที่ได้รับ — สิ่งแรกที่ผู้ดูแลอ่าน.
  erpLastError String?

  company     Company         @relation(fields: [companyId], references: [id])
  opportunity Opportunity     @relation(fields: [opportunityId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  quotation   Quotation?      @relation(fields: [quotationId], references: [id])
  lines       SaleOrderLine[]

  @@index([companyId, opportunityId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([quotationId])
  @@index([erpStatus])
  @@map("sale_orders")
}

/// CD-88 — รายการสินค้าของใบสั่งขาย: snapshot จาก `QuotationLine` ตอนเปิดใบ
/// (แก้ใบเสนอราคาภายหลังต้องไม่เปลี่ยนสิ่งที่สั่งไปแล้ว). ไม่มีต้นทุน — ใบสั่งขาย
/// คือสิ่งที่ส่งให้ SAP และลูกค้า ต้นทุน/margin อยู่ที่ใบเสนอราคา.
model SaleOrderLine {
  id              String  @id @default(uuid())
  saleOrderId     String
  lineNo          Int
  /// รหัส material ใน SAP — ว่างได้สำหรับบรรทัดบริการ/ค่าแรง.
  productCode     String?
  description     String
  quantity        Decimal @db.Decimal(14, 3)
  unit            String?
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPct     Decimal @default(0) @db.Decimal(5, 2)
  /// จำนวน × ราคา × (1 − ส่วนลด%) — ค่าเดียวกับบรรทัดต้นทาง.
  lineTotal       Decimal @db.Decimal(14, 2)
  /// บรรทัดใบเสนอราคาที่ copy มา.
  quotationLineId String?

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@unique([saleOrderId, lineNo])
  @@map("sale_order_lines")
}

model SaleOrderCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("sale_order_code_counters")
}

/// CRM ใบเสนอราคา (CD-76) — เลข QT-{docPrefix}-xxxxxx ต่อโอกาสการขาย, **หนึ่งเลขมี
/// หลายเวอร์ชัน** (`@@unique([quotationNo, version])`). แก้ได้เฉพาะ draft; ฉบับที่
/// ส่ง/อนุมัติแล้วแก้ไม่ได้ — `revise` ออกเวอร์ชันใหม่เป็น draft และติด `superseded`
/// ให้ฉบับเดิม. ยอดรวม/ต้นทุน/margin คำนวณตอนบันทึกแล้วเก็บเป็น snapshot ของเวอร์ชัน
/// นั้น (ต้นทุนกรอกเองต่อบรรทัดจนกว่าจะมี BOQ/ทะเบียนสินค้า, ผู้ใช้ 15 ก.ย. 2569).
/// ต้นทุนและ margin เป็นข้อมูลอ่อนไหว — ปกปิดผ่าน sensitive_field_rules resource `quotation`.
model Quotation {
  id          String @id @default(uuid())
  quotationNo String
  version     Int    @default(1)

  companyId     String
  opportunityId String
  /// ลูกค้าในทะเบียน ถ้าโอกาสการขายผูกอยู่แล้วตอนสร้างเวอร์ชันนี้ — ผู้มุ่งหวังเป็น NULL.
  customerId    String?

  /// คู่ค้าที่พิมพ์บนเอกสาร — snapshot จากลูกค้า/ผู้มุ่งหวังตอนสร้างเวอร์ชัน.
  partyName   String
  partyTaxId  String?
  contactName String?

  title        String
  status       QuotationStatus @default(draft)
  currency     String          @default("THB")
  validUntil   DateTime?
  paymentTerms String?
  note         String?

  /// ผลรวม จำนวน × ราคาต่อหน่วย ก่อนส่วนลด.
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  /// หลังส่วนลด ก่อน VAT — ฐานของ margin และมูลค่าที่ส่งต่อไปใบสั่งขาย.
  netTotal      Decimal  @default(0) @db.Decimal(14, 2)
  vatPct        Decimal  @default(7) @db.Decimal(5, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal  @default(0) @db.Decimal(14, 2)
  costTotal     Decimal  @default(0) @db.Decimal(14, 2)
  marginAmount  Decimal  @default(0) @db.Decimal(14, 2)
  /// NULL เมื่อ netTotal = 0 (หารไม่ได้).
  marginPct     Decimal? @db.Decimal(7, 2)

  /// เกณฑ์ที่ใช้ตัดสินตอนยื่น — เก็บไว้ เพราะแก้ค่าในหน้าตั้งค่าภายหลังต้องไม่ตัดสินใหม่.
  minMarginPct      Decimal? @db.Decimal(5, 2)
  approvalRequired  Boolean  @default(false)
  /// คำขอขออนุมัติ margin ต่ำ (`requests.id`) — sync กลับด้วย request.approved/rejected.
  approvalRequestId String?

  submittedAt  DateTime?
  approvedAt   DateTime?
  sentAt       DateTime?
  respondedAt  DateTime?
  /// หมายเหตุตอนลูกค้าตอบรับ/ปฏิเสธ (เช่น เลข PO ลูกค้า).
  responseNote String?
  cancelledAt  DateTime?
  cancelReason String?

  /// Scope columns identical to Opportunity so `visibleSalesWhere` applies.
  ownerUserId    String
  ownerOrgUnitId String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company     Company         @relation(fields: [companyId], references: [id])
  opportunity Opportunity     @relation(fields: [opportunityId], references: [id])
  customer    Customer?       @relation(fields: [customerId], references: [id])
  lines       QuotationLine[]
  saleOrders  SaleOrder[]

  @@unique([quotationNo, version])
  @@index([companyId, opportunityId])
  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, ownerOrgUnitId])
  @@index([approvalRequestId])
  @@map("quotations")
}

/// บรรทัดใบเสนอราคา — แทนที่ทั้งชุดได้เฉพาะตอนใบยังเป็น draft (แก้ร่าง ไม่ใช่ลบธุรกรรม).
model QuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  lineNo      Int
  /// รหัสสินค้า/บริการ (ตรง material ใน SAP ถ้ามี) — ว่างได้สำหรับบรรทัดบริการ/ค่าแรง.
  productCode String?
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  unitCost    Decimal @default(0) @db.Decimal(14, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  /// จำนวน × ราคา × (1 − ส่วนลด%).
  lineTotal   Decimal @db.Decimal(14, 2)
  lineCost    Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, lineNo])
  @@map("quotation_lines")
}

/// ตัวนับ quotationNo ต่อบริษัท — atomic แบบเดียวกับ SaleOrderCodeCounter.
model QuotationCodeCounter {
  id        String   @id @default(uuid())
  companyId String   @unique
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("quotation_code_counters")
}

/// CD-27 — สินค้า/บริการที่ดึงสำเนามาจาก SAP (B1 `Items`, เฉพาะที่ขายได้) ต่อบริษัท.
/// SAP เป็นเจ้าของ — ที่นี่อ่านอย่างเดียว เติมด้วยรอบ sync (รายชั่วโมง + ปุ่มในหน้า
/// ผู้ดูแล). เก็บไว้ที่ CTD เพื่อให้ออกใบเสนอราคา/ใบสั่งขายได้แม้ SAP ล่ม และให้รหัส
/// บนบรรทัดเป็นรหัสที่ SAP รู้จักจริง. หายไปจาก SAP = `active = false` ไม่ลบ.
model Product {
  id        String @id @default(uuid())
  companyId String

  /// B1 `ItemCode` — ค่าที่ใส่ใน `productCode` ของบรรทัดใบเสนอราคา/ใบสั่งขาย.
  code   String
  name   String
  /// หน่วยขาย (B1 `SalesUnit`) — เติมลงบรรทัดตอนเลือกสินค้า.
  unit   String?
  active Boolean @default(true)

  /// รอบ sync ล่าสุดที่เห็นรายการนี้ใน SAP.
  syncedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("products")
}
