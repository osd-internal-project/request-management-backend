// Single Prisma schema for the whole monorepo. The generated client is
// consumed through libs/prisma by every service in services/*.
//
// Models follow the CTD Foundation Sprint spec §10. Rules that hold
// throughout, and that reviews should enforce:
//
//   * every transactional table carries companyId + created/updated audit columns
//   * transactional data is NEVER hard-deleted — status columns only
//   * per-request form data is Json validated against the JSON Schema declared
//     in RequestType, so adding a request type needs no migration
//   * OrgClosure is recomputed on org edits, never traversed at query time

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Ordered widest first, so the enum reads like the chart it describes:
/// บริษัท → ฝ่าย → แผนก → ตำแหน่ง. `DIVISION` was added on 28 Aug 2026 when the
/// real OSD org chart arrived — the staff register keeps `ฝ่าย` and `แผนก` in
/// separate columns and flattening them lost a whole level.
///
/// `POSITION` is the fourth level: people sit in a position, not directly in a
/// department. `TEAM` is kept because the demo company and `seed.ts` are built
/// on it and it is still this column's default; new charts should not use it.
enum OrgUnitKind {
  COMPANY
  DIVISION
  DEPARTMENT
  POSITION
  TEAM
}

/// How a role reached a user: mapped from a Keycloak claim (ROLE-03) or bound
/// by hand in the admin screen (ROLE-02). Mapped grants are re-evaluated on
/// every login; manual ones persist until removed.
enum RoleGrantSource {
  KEYCLOAK_MAPPING
  MANUAL
}

/// §6.1 data scope levels.
enum ScopeLevel {
  own
  team
  department
  company
  all
}

/// §7.1 request state machine. Transitions outside the declared paths must be
/// impossible through every channel, including direct API calls.
enum RequestStatus {
  draft
  submitted
  returned
  pending_approval
  approved
  rejected
  in_progress
  on_hold
  completed
  closed
  cancelled
}

/// REQ-10: requests raised by an integration are marked, so "who started
/// this" is answerable without guessing.
enum RequestSource {
  USER
  SYSTEM
}

enum ApprovalCaseStatus {
  pending
  approved
  rejected
  returned
  voided
  cancelled
}

enum ApprovalStepStatus {
  waiting
  pending
  approved
  rejected
  returned
  skipped
}

enum ApprovalDecision {
  approve
  reject
  return
}

/// How much of the clock counts, per request type (SUP-01).
///
/// `H24X7` is elapsed time, the only mode the clock ever actually implemented.
/// The other two count `HolidayCalendar`'s working window, and `H8X5` also
/// skips non-working weekdays and holidays.
///
/// Replaces the boolean `businessHours` on 31 Aug 2026: it could not tell
/// "office hours every day" from "office hours on working days", which the
/// support desk and the back office need to mean different things.
enum SlaCoverage {
  H24X7
  H8X7
  H8X5
}

enum SlaState {
  running
  paused
  met
  breached
  cancelled
}

/// Whether a request type's route comes from the hard-coded state machine or
/// from a workflow an administrator assembled (`WorkflowDefinition`).
///
/// **`legacy` is the default and every type carries it.** The workflow engine
/// is built alongside the state machine, not on top of it: a type moves only
/// when somebody switches it, and a request already in flight keeps the mode it
/// started under. Deliberately an enum rather than "has a published workflow",
/// so publishing a draft to look at it cannot re-route live work.
enum WorkflowMode {
  legacy
  flowable
}

/// A workflow version's publication state.
///
/// `published` is immutable — the same rule `ApprovalMatrix` follows, and for
/// the same reason (§7: running work keeps the rules it started under). Editing
/// means publishing version N+1. `retired` replaces deletion, which the schema
/// forbids for transactional data and which would strand every instance still
/// pointing at the version.
enum WorkflowDefinitionStatus {
  draft
  published
  retired
}

/// What a node in the workflow does.
///
/// `user_task` waits for a person to press one of its actions. `approval`
/// resolves an approval ladder and waits for the decision — the people are
/// resolved at runtime from the org chart, never stored in the BPMN. `end`
/// terminates the instance.
enum WorkflowStateKind {
  user_task
  approval
  end
}

enum NotificationChannel {
  in_app
  email
}

enum DeliveryStatus {
  queued
  sent
  failed
}

// ---------------------------------------------------------------------------
// Identity & Org
// ---------------------------------------------------------------------------

/// D-11: multi-company from day one. `docPrefix` feeds the request number
/// (REQ-02, e.g. the OSD in OSD-DSC-202608-0042).
model Company {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  docPrefix    String
  baseCurrency String   @default("THB")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                   UserCompany[]
  primaryUsers            User[]                   @relation("PrimaryCompany")
  orgUnits                OrgUnit[]
  roles                   Role[]
  userRoles               UserRole[]
  keycloakMappings        KeycloakRoleMapping[]
  requestTypes            RequestTypeCompany[]
  requests                Request[]
  docNumberConfigs        DocNumberConfig[]
  docNumberCounter        DocNumberCounter[]
  approvalMatrices        ApprovalMatrix[]
  workflowDefinitions     WorkflowDefinition[]
  approvalCases           ApprovalCase[]
  delegations             Delegation[]
  slaConfigs              SlaConfig[]
  holidayCalendar         HolidayCalendar?
  notifications           Notification[]
  auditLogs               AuditLog[]
  biDashboards            BiDashboard[]
  orgUnitScopes           OrgUnitScope[]
  notificationPreferences NotificationPreference[]

  @@map("companies")
}

/// Local mirror of the Keycloak-authenticated user (AUTH-04, JIT-provisioned
/// on first login). Keycloak owns credentials and roles; org placement —
/// `orgUnitId` and `supervisorUserId` — is owned *here* and edited through the
/// admin screen, because LDAP is used for authentication only (D-07/D-08).
model User {
  id          String     @id @default(uuid())
  keycloakId  String     @unique
  username    String     @unique
  email       String?    @unique
  displayName String
  firstName   String?
  lastName    String?
  status      UserStatus @default(ACTIVE)

  primaryCompanyId String?
  primaryCompany   Company? @relation("PrimaryCompany", fields: [primaryCompanyId], references: [id])

  /// Job title as HR records it, e.g. `Senior Purchasing Officer`.
  ///
  /// Kept as text *as well as* being a level of the chart (31 Aug 2026). The
  /// title is a fact about the person — `roleForPosition` maps it to a system
  /// role at import, and the user directory prints it — while `OrgUnitKind.
  /// POSITION` is where that person sits, scoped to one department.
  ///
  /// The two are not the same thing and must not be collapsed: the staff
  /// register holds 67 distinct titles across 102 people, so the same title
  /// appears under several departments and each is its own box on the chart.
  position String?

  /// Null until an admin assigns the user — these are the "รอจัดสังกัด" queue.
  orgUnitId String?
  orgUnit   OrgUnit? @relation("OrgUnitMembers", fields: [orgUnitId], references: [id])

  supervisorUserId String?
  supervisor       User?   @relation("Supervision", fields: [supervisorUserId], references: [id])
  subordinates     User[]  @relation("Supervision")

  /// Realm roles seen on the token at the last login (ROLE-03).
  ///
  /// Cached here so screen A3 can show "role จาก Keycloak: sales" for someone
  /// who has not been assigned yet — it comes free from the token and needs no
  /// Admin API call. Never authoritative: permissions always resolve through
  /// keycloak_role_mappings, this is display only.
  keycloakRoles String[] @default([])

  firstLoginAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companies               UserCompany[]
  roles                   UserRole[]               @relation("RoleHolder")
  grantedRoles            UserRole[]               @relation("RoleGranter")
  managedUnits            OrgUnit[]                @relation("OrgUnitManager")
  requests                Request[]                @relation("Requester")
  receivedRequests        Request[]                @relation("Receiver")
  assignedRequests        Request[]                @relation("Assignee")
  requestEvents           RequestEvent[]
  requestComments         RequestComment[]
  attachments             RequestAttachment[]
  approvalSteps           ApprovalStep[]           @relation("StepApprover")
  decidedSteps            ApprovalStep[]           @relation("StepDecider")
  delegationsOut          Delegation[]             @relation("Delegator")
  delegationsIn           Delegation[]             @relation("Delegate")
  notifications           Notification[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]

  @@index([orgUnitId])
  @@index([supervisorUserId])
  @@map("users")
}

/// AUTH-05: one person can belong to several companies, with exactly one
/// primary. Roles are held per company (ROLE-04), never globally.
model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

/// The org chart, maintained in this system (D-08). It is the source of truth
/// for "who reports to whom", which drives data scope (§6), approval step 1
/// (§8.1), and escalation (SUP-02).
model OrgUnit {
  id        String      @id @default(uuid())
  companyId String
  code      String
  name      String
  kind      OrgUnitKind @default(TEAM)

  parentId String?
  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgTree")

  managerUserId String?
  manager       User?   @relation("OrgUnitManager", fields: [managerUserId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company       Company               @relation(fields: [companyId], references: [id])
  members       User[]                @relation("OrgUnitMembers")
  ancestors     OrgClosure[]          @relation("ClosureDescendant")
  descendants   OrgClosure[]          @relation("ClosureAncestor")
  receivedTypes RequestType[]         @relation("ReceiverUnit")
  eligibleTypes RequestTypeOrgUnit[]
  biAudiences   BiDashboardAudience[]
  scopesGranted OrgUnitScope[]        @relation("ScopeViewer")
  scopesOn      OrgUnitScope[]        @relation("ScopeTarget")

  @@unique([companyId, code])
  @@index([parentId])
  @@map("org_units")
}

/// Transitive closure of `OrgUnit`, recomputed inside the same transaction as
/// any org edit. Scope `team` and `department` resolve to an `IN (…)` against
/// this table rather than walking the tree per query (§6.2 note) — the reason
/// list endpoints can still meet NFR-02 at 100k rows.
model OrgClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   OrgUnit @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant OrgUnit @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("org_closure")
}

/// One group may see — and optionally work on — another group's requests.
///
/// The replacement for `ScopeRule`, which tied visibility to a *role* and was
/// withdrawn on 31 ส.ค. 2569 because a `(role, resource) → level` rule cannot
/// say "ฝ่ายขาย sees ฝ่ายการตลาด's work". This says exactly that, and nothing
/// more general.
///
/// The level an administrator picks on screen (บริษัท / ฝ่าย / แผนก / ตำแหน่ง)
/// is `OrgUnit.kind` of the viewer, so it is not stored again here — a group's
/// level is already a property of the group.
///
/// A grant is inherited downwards: it is matched against the viewer's own unit
/// **and every unit above it**, which is what makes a grant written at the
/// company level apply to everybody in the company.
model OrgUnitScope {
  id        String @id @default(uuid())
  companyId String

  /// The group being granted the view.
  viewerOrgUnitId String
  /// The group whose work becomes visible.
  targetOrgUnitId String

  /// Whether the grant reaches the groups beneath `target`.
  ///
  /// Defaults to true because the org chart is บริษัท → ฝ่าย → แผนก and naming
  /// a ฝ่าย almost always means its แผนก too. Turning it off is the narrow
  /// case, so it is the one that has to be asked for.
  includeDescendants Boolean @default(true)

  /// Whether the viewer may move those requests, or only read them.
  ///
  /// Defaults to **false**: `assertMayAct` in core-service is the only thing
  /// standing between a person and somebody else's ticket, and a scope grant
  /// that silently widened it would hand the whole chart to whoever was
  /// granted a view. Granting the ability to act is a separate, deliberate
  /// tick.
  canAct Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])
  viewer  OrgUnit @relation("ScopeViewer", fields: [viewerOrgUnitId], references: [id], onDelete: Cascade)
  target  OrgUnit @relation("ScopeTarget", fields: [targetOrgUnitId], references: [id], onDelete: Cascade)

  @@unique([viewerOrgUnitId, targetOrgUnitId])
  @@index([companyId, viewerOrgUnitId])
  @@map("org_unit_scopes")
}

/// ROLE-02. `companyId` null means a group-wide template role; bound roles are
/// deactivated, never deleted.
model Role {
  id          String  @id @default(uuid())
  companyId   String?
  code        String
  name        String
  description String?
  /// Seed roles from §5.2 — cannot be renamed away or removed.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company          Company?              @relation(fields: [companyId], references: [id])
  permissions      RolePermission[]
  users            UserRole[]
  scopeRules       ScopeRule[]
  keycloakMappings KeycloakRoleMapping[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Mirror of the code-declared catalog in `libs/share/src/policy/permissions.ts`,
/// synced at boot. The table exists for referential integrity only — admins
/// compose roles from these but cannot create new ones (§11.3).
model Permission {
  code        String  @id
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId         String
  permissionCode String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

/// ROLE-04: a role binding is always scoped to one company.
model UserRole {
  id        String          @id @default(uuid())
  userId    String
  roleId    String
  companyId String
  source    RoleGrantSource @default(MANUAL)

  grantedByUserId String?
  grantedAt       DateTime @default(now())

  user      User    @relation("RoleHolder", fields: [userId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  grantedBy User?   @relation("RoleGranter", fields: [grantedByUserId], references: [id])

  @@unique([userId, roleId, companyId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// ROLE-03: "Keycloak role → role in this system", per company. Re-evaluated
/// on every login and refresh, so revoking in Keycloak revokes here within one
/// access-token lifetime.
model KeycloakRoleMapping {
  id             String   @id @default(uuid())
  /// The realm role's **name** — what a token carries, so this is what
  /// `syncFromKeycloakRoles` matches on at sign-in.
  keycloakRole   String
  /// The realm role's **id**, which a rename does not change.
  ///
  /// Without it a rename in Keycloak was invisible here: the next token
  /// carried the new name, this row still held the old one, no mapping
  /// matched, and every holder of that role lost it with nothing on screen to
  /// say why. Nullable because rows written before 2 ก.ย. 2569 have no id yet
  /// — `syncNamesFromKeycloak` fills it in on its first run.
  keycloakRoleId String?
  roleId         String
  companyId      String
  createdAt      DateTime @default(now())
  createdBy      String?

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([keycloakRole, roleId, companyId])
  @@index([companyId])
  @@index([keycloakRoleId])
  @@map("keycloak_role_mappings")
}

/// SCOPE-01: (role, resource) → scope level, editable from the admin screen
/// with no deploy.
model ScopeRule {
  id       String     @id @default(uuid())
  roleId   String
  resource String
  scope    ScopeLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("scope_rules")
}

/// SCOPE-04: which fields of which resource are sensitive, and the permission
/// that unmasks them. Enforced on the API response, not just the UI.
model SensitiveFieldRule {
  id                  String @id @default(uuid())
  resource            String
  field               String
  visibleToPermission String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([resource, field])
  @@map("sensitive_field_rules")
}

// ---------------------------------------------------------------------------
// Request
// ---------------------------------------------------------------------------

/// REQ-01: a request type is *configuration*, not code. Adding the 3rd..30th
/// type is an admin screen action.
model RequestType {
  id                String  @id @default(uuid())
  code              String  @unique
  name              String
  receiverOrgUnitId String?

  /// JSON Schema for the form the **requester** fills in.
  formSchema         Json
  /// JSON Schema for the form the **receiver** fills in before completing.
  ///
  /// Null means the type has no second form, and `complete` then asks for
  /// nothing extra — which is most of the forty imported types, so this stays
  /// optional rather than defaulting to an empty schema that would render as
  /// a blank required step.
  receiverFormSchema Json?
  /// [{ code, name }] — attachments that block submit (REQ-03).
  requiredDocs       Json  @default("[]")
  /// [{ code, name }] — the standard return reasons (REQ-04).
  returnReasonCodes  Json  @default("[]")
  /// { mode: "standard_chain", amount_field: "deal_value" } — how APV-02
  /// derives the approval chain.
  approvalPolicy     Json

  slaHours    Int?
  slaCoverage SlaCoverage @default(H24X7)

  /// Whether ยื่นคำขอ demands `refId` — §16 marks it required, but only on the
  /// DSC mockup, and most types have no deal to point at. Per type rather than
  /// hard-coded on the screen, which is what it was until 1 ก.ย. 2569.
  refRequired Boolean @default(false)

  /// Whether this type's route comes from §7.1's state machine or from a
  /// workflow assembled on screen. Every type carries `legacy` until somebody
  /// switches it — see `WorkflowMode`.
  workflowMode WorkflowMode @default(legacy)

  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  receiverOrgUnit OrgUnit?             @relation("ReceiverUnit", fields: [receiverOrgUnitId], references: [id])
  companies       RequestTypeCompany[]
  eligibleUnits   RequestTypeOrgUnit[]
  requests        Request[]
  workflows       WorkflowDefinition[]

  @@map("request_types")
}

/// Which groups may raise a request of this type.
///
/// **No rows means every group may.** That is the default and what all forty
/// imported types carry, so switching this on is opt-in per type rather than a
/// migration that has to guess.
///
/// A group named here covers its whole subtree: naming a department lets every
/// position under it raise the type, resolved through `OrgClosure` rather than
/// listing descendants, so moving a group in the chart cannot silently revoke
/// what it could raise.
model RequestTypeOrgUnit {
  requestTypeId String
  orgUnitId     String

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([requestTypeId, orgUnitId])
  @@index([orgUnitId])
  @@map("request_type_org_units")
}

/// Which companies have a given request type switched on.
model RequestTypeCompany {
  requestTypeId String
  companyId     String
  active        Boolean @default(true)

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id])

  @@id([requestTypeId, companyId])
  @@map("request_type_companies")
}

model Request {
  id String @id @default(uuid())

  /// Issued at submit, never before (REQ-02). Null while draft.
  requestNo String? @unique

  requestTypeId String
  typeCode      String
  companyId     String

  requesterId        String
  /// Snapshotted at submit so later org moves do not rewrite history or
  /// silently change who can see the row.
  requesterOrgUnitId String?

  /// The person the requester sent this to, named when the request is raised.
  ///
  /// A request is a ticket handed to somebody, not a job dropped in a
  /// department's queue: `06_EXAMPLE` shows every row being received by a named
  /// person and the source keeps a `ผู้รับผิดชอบที่แผนกปลายทาง` column for it.
  /// Only this person can accept the request (`submitted → in_progress`).
  receiverUserId String?

  /// Who is actually doing the work, once the receiver hands it on.
  ///
  /// Separate from `receiverUserId` because the source records `ASSIGNED` and
  /// `HANDOVER` as their own events — the person who accepted a ticket and the
  /// person who finished it are frequently not the same, and the timeline has
  /// to keep both.
  assigneeUserId String?

  /// The team this request was sent to.
  ///
  /// Seeded from `RequestType.receiverOrgUnitId` when the request is created,
  /// but the requester may pick a different team — the type's value is a
  /// starting point, not a routing rule. Held on the request so that editing
  /// the type later cannot re-route work already in flight (REQ-01).
  ///
  /// Deliberately a plain column with no relation, exactly like
  /// `requesterOrgUnitId` above it: both record where the work sat at the
  /// time, and a foreign key would let an org-chart edit rewrite that.
  receiverOrgUnitId String?

  /// Every request above this one, root first.
  ///
  /// Written once at create from the parent's own path, so "everything under
  /// request 1" is a single indexed lookup rather than a query per level. The
  /// screen draws several levels at once — `06_EXAMPLE` traces ten requests
  /// across eight departments from one customer order — and walking that a
  /// level at a time is a query per level on every page view.
  ///
  /// Empty for a request nobody spawned.
  ancestorIds String[] @default([])

  /// The request this one was spawned from, if any.
  ///
  /// One piece of work commonly breaks into several across departments —
  /// `06_EXAMPLE` traces ten requests over eight of them from a single customer
  /// order. A parent cannot be completed while any child is still open, which
  /// is what stops a chain being closed from the top while work continues
  /// underneath it.
  parentRequestId String?

  /// When the requester accepted the result. `completedAt` is when the work
  /// finished; the two are different moments and the gap between them is how
  /// long an answer sat unread.
  closedAt DateTime?

  status RequestStatus @default(draft)

  /// The workflow state this request is actually in, for a type running on a
  /// workflow. `status` above stays the §7.1 phase that state maps to, and
  /// remains what SLA, the reports and every screen read — this only names the
  /// step more precisely. Null for a type still on the state machine.
  workflowStateKey String?

  formData Json @default("{}")

  /// Answers to the type's `receiverFormSchema`, filled in at `complete`.
  ///
  /// Its own column rather than more keys in `formData`: the two forms are
  /// authored separately, answered by different people at different moments,
  /// and masking rules are declared per field — merging them would make
  /// "who wrote this value" unanswerable from the row.
  ///
  /// `{}` for a type with no second form, which is most of them.
  receiverFormData Json @default("{}")

  /// REQ-06: link back to the originating entity (deal, customer, …).
  refType String?
  refId   String?

  /// The RequestType config as it stood at submit — a running request keeps
  /// its rules even after an admin edits the type (REQ-01).
  typeSnapshot Json?

  source RequestSource @default(USER)

  submittedAt  DateTime?
  dueAt        DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  requestType   RequestType           @relation(fields: [requestTypeId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requester     User                  @relation("Requester", fields: [requesterId], references: [id])
  receiver      User?                 @relation("Receiver", fields: [receiverUserId], references: [id])
  assignee      User?                 @relation("Assignee", fields: [assigneeUserId], references: [id])
  parent        Request?              @relation("RequestTree", fields: [parentRequestId], references: [id])
  children      Request[]             @relation("RequestTree")
  attachments   RequestAttachment[]
  events        RequestEvent[]
  comments      RequestComment[]
  returnReasons RequestReturnReason[]
  approvalCases ApprovalCase[]
  slaClock      SlaClock?
  workflow      WorkflowInstance?

  @@index([companyId, status])
  @@index([companyId, requesterId])
  /// The receiver's queue — "what is waiting for me to accept".
  @@index([companyId, receiverUserId, status])
  /// A team's queue — "what has been sent to us".
  @@index([companyId, receiverOrgUnitId, status])
  @@index([companyId, assigneeUserId, status])
  /// Counting a parent's open children on every complete.
  @@index([parentRequestId])
  /// "Everything under this request", for the สายคำขอ panel.
  @@index([ancestorIds], type: Gin)
  @@index([companyId, requesterOrgUnitId])
  @@index([companyId, dueAt])
  @@index([refType, refId])
  @@map("requests")
}

/// A note somebody left on a request (H2.2).
///
/// Separate from `RequestEvent` because the two answer different questions: an
/// event is something the system recorded happening, a comment is something a
/// person chose to say. They are drawn on one timeline, in time order, which is
/// how the people on a request read them — but merging them into one table
/// would mean either events with an author who did not write them, or comments
/// that pretend to be state changes.
///
/// Append-only, like the audit log: no update path, no delete path, no route
/// that reaches one. What was said on a request is part of its history.
model RequestComment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_comments")
}

model RequestAttachment {
  id        String  @id @default(uuid())
  requestId String
  /// Matches a code in RequestType.requiredDocs, or null for extra files.
  docCode   String?

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedById String
  uploadedAt   DateTime  @default(now())
  /// Soft delete — draft/returned only; the row survives for the audit trail.
  deletedAt    DateTime?

  request    Request @relation(fields: [requestId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@map("request_attachments")
}

/// REQ-04: return reasons are picked from a standard list, not free text, so
/// "why do requests bounce" is a reportable question.
model RequestReturnReason {
  id        String   @id @default(uuid())
  requestId String
  eventId   String?
  code      String
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  request Request       @relation(fields: [requestId], references: [id])
  event   RequestEvent? @relation(fields: [eventId], references: [id])

  @@index([requestId])
  @@index([code])
  @@map("request_return_reasons")
}

/// REQ-07: the append-only timeline. No update or delete path exists for these
/// rows — that is the acceptance criterion, not an implementation detail.
model RequestEvent {
  id        String @id @default(uuid())
  requestId String
  seq       Int

  type       String
  actorId    String?
  /// Set when the actor is the system (escalation, auto-transition).
  actorLabel String?

  fromStatus RequestStatus?
  toStatus   RequestStatus?
  data       Json?

  createdAt DateTime @default(now())

  request       Request               @relation(fields: [requestId], references: [id])
  actor         User?                 @relation(fields: [actorId], references: [id])
  returnReasons RequestReturnReason[]

  @@unique([requestId, seq])
  @@index([requestId, createdAt])
  @@map("request_events")
}

/// D-02/D-19 + REQ-02: the number format is configuration per company and
/// document type, e.g. `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}`.
model DocNumberConfig {
  id         String  @id @default(uuid())
  companyId  String
  typeCode   String
  /// `REQ-OSD-PS01-26090001`. `{YYYYMM}` is still understood, for rows an
  /// administrator set to the older `{PREFIX}-{TYPE}-{YYYYMM}-{SEQ}` form.
  pattern    String  @default("REQ-{PREFIX}-{TYPE}-{YYMM}{SEQ}")
  seqPadding Int     @default(4)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode])
  @@map("doc_number_configs")
}

/// The sequence itself, reset every month. Incremented inside the submit
/// transaction under a row lock — this is what makes 50 concurrent submits
/// produce 50 distinct numbers (REQ-02, NFR-03).
model DocNumberCounter {
  id        String @id @default(uuid())
  companyId String
  typeCode  String
  /// `YYYYMM`, e.g. 202608.
  yearMonth Int
  lastSeq   Int    @default(0)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, typeCode, yearMonth])
  @@map("doc_number_counters")
}

// ---------------------------------------------------------------------------
// Approval  (D-31: a central service, callable without a Platform Request)
// ---------------------------------------------------------------------------

/// APV-01. Published versions are immutable — a change is a new version with
/// its own effective date, so a running case keeps the rules it started under
/// (D-18: each company has its own set).
model ApprovalMatrix {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  currency    String @default("THB")
  version     Int

  /// **Superseded by `levels` (31 Aug 2026).** Kept so versions published
  /// before that date still read, and so the cases routed under them can still
  /// be explained: `[{ upto: "100000.00" | null, chain: ["team_lead","cfo"] }]`
  /// ordered by ceiling ascending, `upto: null` being the top tier.
  tiers Json

  /// The approval ladder, one entry per level, in order.
  ///
  /// ```jsonc
  /// [ { "type": "supervisor", "up": 1 },
  ///   { "type": "org", "orgUnitIds": ["…"], "userIds": ["…"] } ]
  /// ```
  ///
  /// `supervisor.up` counts levels of the chart above the requester: 1 is the
  /// head of the group they sit in, 2 the department, and so on. `org` names
  /// groups; with `userIds` those people approve, without it the groups' heads
  /// do. Either way a level may resolve to **several** people, any one of whom
  /// can decide — see `ApprovalStep.candidateUserIds`.
  ///
  /// Null on a version published before the change, which is what makes this a
  /// new column rather than a rewrite of `tiers`: nothing already published is
  /// migrated, and a case in flight keeps the ladder it was routed under
  /// (§7 — running work keeps the rules it started under).
  levels Json?

  effectiveFrom DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  createdBy     String?

  company Company        @relation(fields: [companyId], references: [id])
  cases   ApprovalCase[]

  @@unique([companyId, subjectType, version])
  @@index([companyId, subjectType, effectiveFrom])
  @@map("approval_matrices")
}

/// One thing awaiting approval. `subjectType`/`subjectId` keep this generic:
/// APV-07 lets any module raise a case without creating a Request.
model ApprovalCase {
  id          String @id @default(uuid())
  companyId   String
  subjectType String
  subjectId   String

  /// Null for subjects with no monetary dimension (e.g. lead handover).
  amount   Decimal? @db.Decimal(18, 2)
  currency String?

  /// APV-05: hash of the approved payload. A material edit voids approvals.
  snapshotHash    String
  snapshotVersion Int    @default(1)

  matrixId      String?
  matrixVersion Int?

  status      ApprovalCaseStatus @default(pending)
  currentStep Int                @default(1)

  /// APV-07: event name published when the outcome lands.
  callbackEvent String?
  payload       Json?

  requestId String?

  createdAt DateTime  @default(now())
  createdBy String?
  decidedAt DateTime?

  company Company         @relation(fields: [companyId], references: [id])
  matrix  ApprovalMatrix? @relation(fields: [matrixId], references: [id])
  request Request?        @relation(fields: [requestId], references: [id])
  steps   ApprovalStep[]

  @@index([companyId, status])
  @@index([subjectType, subjectId])
  @@index([requestId])
  @@map("approval_cases")
}

/// The resolved chain, frozen at submit (APV-02). Changing the matrix later
/// does not reroute a case already in flight.
model ApprovalStep {
  id     String @id @default(uuid())
  caseId String
  stepNo Int

  /// Position in the matrix chain: `team_lead`, `cfo`, `ceo`, …
  approverRole   String
  /// The person that position resolved to at submit time.
  approverUserId String?

  /// Everyone allowed to decide this step. Any one of them is enough.
  ///
  /// A level can name several people — the heads of two groups, or a list
  /// chosen on screen A1 — and `approverUserId` holds only the first, for
  /// display and for the cases routed before this column existed.
  /// `authorise` reads this; `decidedByUserId` records who actually acted.
  candidateUserIds String[] @default([])

  status   ApprovalStepStatus @default(waiting)
  decision ApprovalDecision?
  note     String?

  /// APV-03: set when someone decided under a delegation — the history shows
  /// both names, never just the delegate's.
  decidedByUserId String?
  delegationId    String?

  dueAt     DateTime?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  case       ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approver   User?        @relation("StepApprover", fields: [approverUserId], references: [id])
  decidedBy  User?        @relation("StepDecider", fields: [decidedByUserId], references: [id])
  delegation Delegation?  @relation(fields: [delegationId], references: [id])

  @@unique([caseId, stepNo])
  @@index([candidateUserIds], type: Gin)
  @@index([approverUserId, status])
  @@map("approval_steps")
}

/// APV-03: temporary hand-over of approval authority. Sub-delegation is
/// rejected, and overlapping windows for the same delegator are rejected.
model Delegation {
  id              String   @id @default(uuid())
  companyId       String
  delegatorUserId String
  delegateUserId  String
  fromDate        DateTime
  toDate          DateTime
  note            String?
  active          Boolean  @default(true)

  createdAt DateTime  @default(now())
  createdBy String?
  revokedAt DateTime?

  company   Company        @relation(fields: [companyId], references: [id])
  delegator User           @relation("Delegator", fields: [delegatorUserId], references: [id])
  delegate  User           @relation("Delegate", fields: [delegateUserId], references: [id])
  steps     ApprovalStep[]

  @@index([companyId, delegatorUserId, fromDate, toDate])
  @@map("delegations")
}

// ---------------------------------------------------------------------------
// Support  (SLA / notification / audit — minimum viable per §09)
// ---------------------------------------------------------------------------

/// D-09/SUP-01: SLA is configuration, never hardcoded.
model SlaConfig {
  id              String      @id @default(uuid())
  companyId       String
  requestTypeCode String
  hours           Int
  coverage        SlaCoverage @default(H24X7)
  warnBeforeHours Int         @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, requestTypeCode])
  @@map("sla_configs")
}

/// SUP-01: the clock stops while a request sits returned with the requester,
/// so the elapsed time reported in REQ-09 is time the request was actually
/// somebody's to act on.
model SlaClock {
  id        String @id @default(uuid())
  requestId String @unique

  startedAt     DateTime
  pausedAt      DateTime?
  accumulatedMs Int       @default(0)
  dueAt         DateTime
  state         SlaState  @default(running)
  warnedAt      DateTime?
  breachedAt    DateTime?
  escalatedAt   DateTime?

  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id])

  @@index([state, dueAt])
  @@map("sla_clocks")
}

/// One working-hours + holiday set per company for this sprint; shifts and
/// multiple calendars are explicitly out of scope (§09).
model HolidayCalendar {
  id        String @id @default(uuid())
  companyId String @unique
  name      String @default("default")

  /// Minutes from midnight, e.g. 510 = 08:30.
  workdayStartMinute Int   @default(510)
  workdayEndMinute   Int   @default(1050)
  /// ISO weekday numbers that are working days (1 = Monday).
  workingWeekdays    Int[] @default([1, 2, 3, 4, 5])
  /// ["2026-01-01", …]
  holidays           Json  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("holiday_calendars")
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  companyId String

  eventType String
  title     String
  body      String

  resourceType String?
  resourceId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user       User                      @relation(fields: [userId], references: [id])
  company    Company                   @relation(fields: [companyId], references: [id])
  deliveries NotificationDeliveryLog[]

  @@index([userId, readAt])
  @@map("notifications")
}

/// SUP-03: which optional channels a person wants, per company.
///
/// In-app delivery is deliberately **not** representable here — §09 makes it
/// mandatory, because a request that nobody can be told about is a request
/// that silently misses its SLA. Only email is a choice, and while SMTP is
/// unresolved (open question B) the value is recorded and honoured by nothing.
model NotificationPreference {
  id        String @id @default(uuid())
  userId    String
  companyId String

  emailEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("notification_preferences")
}

/// SUP-03: every send is logged, which is what settles "I never got notified".
model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  target         String
  status         DeliveryStatus      @default(queued)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_logs")
}

/// SUP-04: one append-only log for permission changes, status transitions,
/// approvals, sensitive-field reads, and admin configuration. There is no API
/// that updates or deletes a row here, by design.
model AuditLog {
  id        String  @id @default(uuid())
  companyId String?

  actorId       String?
  actorUsername String?

  eventType    String
  resourceType String?
  resourceId   String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  actor   User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// CD-92 v2: BI dashboards are configuration rows, not env constants — an
/// admin adds or retires dashboards and scopes each to org units without a
/// deploy (configuration over code). `active` is the soft-delete flag; a
/// retired dashboard stays findable, per the no-hard-delete rule.
model BiDashboard {
  id                  String  @id @default(uuid())
  companyId           String
  title               String
  /// The numeric id Metabase shows in the dashboard URL.
  metabaseDashboardId Int
  sortOrder           Int     @default(0)
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  company   Company               @relation(fields: [companyId], references: [id])
  audiences BiDashboardAudience[]

  @@index([companyId])
  @@map("bi_dashboards")
}

/// Which org units may see a dashboard. No rows = the whole company sees it.
/// An assigned unit covers its entire subtree (`OrgClosure`), so a department
/// row includes every team beneath it — the same maths as data scope (§6.2).
model BiDashboardAudience {
  dashboardId String
  orgUnitId   String

  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([dashboardId, orgUnitId])
  @@index([orgUnitId])
  @@map("bi_dashboard_audiences")
}

/// NFR-03: replay protection for state-changing POSTs carrying an
/// `Idempotency-Key`.
model IdempotencyKey {
  key         String   @id
  requestHash String
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Workflow (Flowable)
// ---------------------------------------------------------------------------

/// One published route a request type can travel, as configuration.
///
/// §7.1's state machine is one table of transitions shared by all forty types.
/// This is the same idea made per-type and editable from a screen: the states,
/// the actions out of each, and the form each asks for. `bpmnXml` is
/// **generated** from the rows below at publish and deployed to Flowable —
/// nobody authors BPMN by hand, so these tables stay the single source of
/// truth and the engine holds a projection of them.
///
/// Versioned and immutable once published, exactly like `ApprovalMatrix`:
/// editing means publishing N+1, which is what lets a request already running
/// keep the route it started on (§7 — running work keeps the rules it started
/// under). `WorkflowInstance` pins the version it began with.
model WorkflowDefinition {
  id        String @id @default(uuid())
  companyId String

  /// Which type this routes. A type may have many versions; only one is
  /// `published` at a time per company.
  requestTypeId String
  version       Int

  name   String
  status WorkflowDefinitionStatus @default(draft)

  /// Generated at publish from `states`/`actions`. Kept rather than rebuilt on
  /// demand so the exact XML a running instance was deployed from can still be
  /// read back when its behaviour is questioned.
  bpmnXml String?

  /// What Flowable answered at deploy. Null while the version is a draft.
  flowableDeploymentId String?
  flowableProcessKey   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?
  updatedAt   DateTime  @updatedAt
  updatedBy   String?

  company     Company            @relation(fields: [companyId], references: [id])
  requestType RequestType        @relation(fields: [requestTypeId], references: [id])
  states      WorkflowState[]
  actions     WorkflowAction[]
  instances   WorkflowInstance[]

  @@unique([requestTypeId, companyId, version])
  @@index([companyId, status])
  @@map("workflow_definitions")
}

/// A node: somewhere a request sits and waits for somebody.
///
/// `phase` is what keeps the rest of the system working. Every state maps onto
/// one of §7.1's eleven statuses, and that is what `Request.status` is set to —
/// so SLA (`CLOCK_PAUSED_IN`), the bottleneck report, the work queues and every
/// §16 screen keep reading the column they always read, while the state a
/// request is *actually* in can be named anything an administrator likes.
///
/// `workflow-rules.ts` refuses to publish a definition whose phases imply a
/// move `REQUEST_TRANSITIONS` forbids — the guard that stops the two models
/// drifting apart.
model WorkflowState {
  id           String @id @default(uuid())
  definitionId String

  /// Stable identifier, and the BPMN element id. Unique within the definition.
  key  String
  name String

  phase RequestStatus
  kind  WorkflowStateKind @default(user_task)

  /// JSON Schema for what this state shows. Null means it asks nothing.
  formSchema Json?

  /// Overrides the type's SLA for the time spent in this state. Null inherits.
  slaHours Int?

  /// Where the instance starts. Exactly one per definition, enforced at publish.
  isStart Boolean @default(false)

  /// Draw order on the admin screen — not semantics. The route comes from
  /// `WorkflowAction`, never from this.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  actions    WorkflowAction[]

  @@unique([definitionId, key])
  @@map("workflow_states")
}

/// One button, and where pressing it goes.
///
/// `fromStateKey`/`toStateKey` are plain columns rather than foreign keys, the
/// same choice `Request.requesterOrgUnitId` makes and for a related reason: the
/// pair is only meaningful inside one definition, and `workflow-rules.ts`
/// already has to walk the whole graph at publish to prove every state is
/// reachable. A key that names nothing is caught there, with a message that
/// says which action is broken.
///
/// `authority` reuses the `Authority` union in `available-actions.ts` —
/// requester / receiver / carrier / decider and so on. It is **not** a second
/// permission system: `hasAuthority` is still the one implementation, and the
/// handler re-checks it however the action was offered (ROLE-01).
model WorkflowAction {
  id           String @id @default(uuid())
  definitionId String

  fromStateKey String
  actionKey    String
  toStateKey   String

  /// The Thai text on the button.
  label String

  /// A value of the `Authority` union in `requests/available-actions.ts`.
  authority String

  /// JSON Schema for what pressing it asks for. Null means it asks nothing.
  formSchema Json?

  /// Optional guard on workflow variables, e.g. `amount > 100000`. Becomes the
  /// condition on the BPMN sequence flow.
  condition String?

  /// Whether the screen asks "are you sure" first — for the irreversible ones.
  confirmRequired Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromState  WorkflowState      @relation(fields: [definitionId, fromStateKey], references: [definitionId, key], onDelete: Cascade)
  dataMaps   WorkflowDataMap[]

  @@unique([definitionId, fromStateKey, actionKey])
  @@index([definitionId, toStateKey])
  @@map("workflow_actions")
}

/// The data flow: which answer becomes which workflow variable, and which
/// column the workflow writes it back to.
///
/// Its own table rather than more JSON on the action because this is the part
/// administrators change most often and the part that must be answerable
/// afterwards — "why did this land in `receiver_form_data`" is a question about
/// a row, not about a blob.
///
/// `targetColumn` is checked against an allow-list at publish. Without that a
/// workflow could be configured to overwrite `status`, `requestNo` or
/// `requesterId` — the columns the whole permission and numbering model rests
/// on — from a form field.
model WorkflowDataMap {
  id       String @id @default(uuid())
  actionId String

  /// Key in the action's `formSchema`.
  sourceField  String
  /// Variable name inside the workflow instance.
  variableName String
  /// Where the callback writes it back. Allow-listed at publish.
  targetColumn String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  action WorkflowAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, sourceField])
  @@map("workflow_data_maps")
}

/// One request's journey through one workflow version.
///
/// The join between a row in this database and a process instance in Flowable.
/// `currentStateKey` mirrors what the engine says so the screens and the action
/// list can be answered without an HTTP call on every page view; the engine
/// stays authoritative about where the instance actually is, and the callback
/// is what keeps this row honest.
model WorkflowInstance {
  id String @id @default(uuid())

  requestId    String @unique
  definitionId String

  flowableProcessInstanceId String  @unique
  currentStateKey           String
  /// The open Flowable task, when the instance is waiting on a person.
  currentTaskId             String?

  /// Last known process variables — a cache of the engine's copy, for display.
  variables Json @default("{}")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  request    Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])

  @@index([definitionId])
  @@map("workflow_instances")
}
