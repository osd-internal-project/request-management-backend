# Template for /etc/request-management/.backend.env on the labs VM.
#
# COMMITTED FILE — PLACEHOLDERS ONLY. Copy it to the VM and fill it in there.
# Real values must never reach this repo or a workflow log.
#
# Mode 640 with the runner's group: compose reads this as the runner's user, and
# a root-owned 600 file fails the deploy with `env file … not found`.
#
#   scp .env.labs.example <vm>:/tmp/backend.env
#   sudo install -m 640 -g "$(id -gn)" /tmp/backend.env /etc/request-management/.backend.env
#
# infra/labs/docker-compose.yml reads it through `env_file`, so BOTH services
# see every variable here. That is fine — each ignores what it does not read.

NODE_ENV=production

# --- Database ---
# Reached across the network from the container, so `localhost` is never right.
DATABASE_URL="postgresql://USER:PASSWORD@192.168.31.55:5432/DATABASE?schema=public"

# --- Keycloak ---
# 3500 is the HOST port the frontend is published on — a browser follows these,
# so they carry the host's port, not the container's.
#
# The realm's redirect URIs must list http://<LABS_HOST>:3500/* as an ABSOLUTE
# url, or login fails with "Invalid parameter: redirect_uri".
KEYCLOAK_BASE_URL=http://192.168.31.51:8180
KEYCLOAK_REALM=enterprise-request
KEYCLOAK_CLIENT_ID=request-form
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://<LABS_HOST>:3500/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://<LABS_HOST>:3500/

# --- Service discovery ---
# `rm-user` is the container name on the shared `rm-net` network, and 3001 is
# the port INSIDE that container — this call never leaves the network, so the
# published 3501 has nothing to do with it.
#
# The `/api/v1` prefix is PART OF THIS VALUE. The frontend stack has a variable
# of the same name that means the opposite (origin only) — which is exactly why
# the two stacks do not share an env file.
USER_SERVICE_URL=http://rm-user:3001/api/v1

# --- Optional ---
# AUTH-06 API keys. Leave blank until an integration needs one; core-service
# only reads them when an `rfk_…` key is presented.
INTEGRATION_CLIENT_ID=
INTEGRATION_CLIENT_SECRET=

# Embedded BI. Left blank, GET /bi/menu answers configured:false and the
# frontend hides the section — no error.
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
